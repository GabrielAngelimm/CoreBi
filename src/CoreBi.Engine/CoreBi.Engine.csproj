<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="11.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CoreBi.Tests"/>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Performance/Shaders/*.hlsl" LogicalName="CoreBi.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Reports/Assets/*" LogicalName="CoreBi.Reports.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
