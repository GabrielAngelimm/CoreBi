<Window x:Class="CoreBi.Desktop.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreBi aviso" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Opacity="0">
    <!--
        O aviso aparece sobre qualquer coisa (inclusive jogos), então usa a paleta fixa Hud* (grafite) em vez de seguir o tema:
        fica legível em fundo claro ou escuro. O ícone acende no sinal da marca.
    -->
    <Window.Resources>
        <ResourceDictionary Source="/CoreBi.Desktop;component/Shell/HudPalette.xaml"/>
    </Window.Resources>
    <Border Background="{StaticResource HudPanel}" BorderBrush="{StaticResource HudLine}" BorderThickness="1" CornerRadius="10" Padding="16,14" Width="348" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{StaticResource HudSignalSoft}" CornerRadius="8" VerticalAlignment="Top" Margin="0,1,14,0">
                <TextBlock x:Name="TIcon" Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource HudSignal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TTitle" Foreground="{StaticResource HudFg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TText" Foreground="{StaticResource HudMuted}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
                           TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"/>
                <TextBlock Text="CoreBi" Foreground="{StaticResource HudFaint}" FontFamily="Bahnschrift" FontStretch="SemiCondensed" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
