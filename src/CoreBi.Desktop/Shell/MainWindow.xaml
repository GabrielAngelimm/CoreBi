<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:CoreBi.Desktop.Views" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.MainWindow" Title="CoreBi" Icon="/CoreBi.Desktop;component/Assets/corebi.ico" Width="1360" Height="860" MinWidth="1120" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Root" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Barra lateral ================= -->
            <Border x:Name="Sidebar" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Marca: símbolo vetorial (brand/geometry.json) + assinatura -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,0,0,0" Height="68" VerticalAlignment="Center">
                        <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                            <Canvas Width="256" Height="256">
                                <Polygon Points="141,35 81,35 34,82 34,174 81,221 141,221 141,195 93,195 60,162 60,94 93,61 141,61" Fill="{DynamicResource Fg}" />
                                <Polygon Points="155,35 184,35 218,69 218,108 202,124 222,144 222,185 186,221 155,221 155,195 175,195 196,174 196,156 178,138 155,138 155,112 177,112 192,97 192,81 173,61 155,61" Fill="{DynamicResource Fg}" />
                                <Polygon Points="95,84 117,84 117,106 95,106" Fill="{DynamicResource Accent}" />
                                <Polygon Points="95,121 117,121 117,172 95,172" Fill="{DynamicResource Accent}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="CoreBi" FontFamily="{StaticResource Readout}" FontWeight="SemiBold" FontSize="27" Margin="12,4,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Rodapé: aviso de sensores, tema e central de monitoramento -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,6,14,14">
                        <Border x:Name="CpuSensorWarn" Visibility="Collapsed" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="CPU sem temperatura e consumo" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CpuSensorWarnText" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="21,3,0,8" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Corrigir" MinHeight="28" Padding="12,4" FontSize="12" HorizontalAlignment="Left" Margin="21,0,0,0" Click="BtnFixCpuSensors_Click" />
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="ThemeSwitch" Style="{StaticResource ThemeToggle}" Content="Modo escuro" Margin="0,0,0,8" Click="Theme_Click" AutomationProperties.Name="Modo escuro" />
                        <!-- Central de monitoramento: some na Visão geral, que já mostra tudo isso em tamanho grande -->
                        <Border x:Name="SideMonitor" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,11,14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SideTemp" Grid.Column="1" Text="—" Style="{StaticResource ReadoutText}" FontSize="15" />
                                    <TextBlock x:Name="SideLoad" Grid.Column="2" Text="—" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource Num}" />
                                </Grid>
                                <Grid Height="5" Margin="0,5,0,10" OpacityMask="{StaticResource SegmentMask}">
                                    <Border Background="{DynamicResource Line}" />
                                    <Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="SideCpuBar" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SideGpuTemp" Grid.Column="1" Text="—" Style="{StaticResource ReadoutText}" FontSize="15" />
                                    <TextBlock x:Name="SideGpuLoad" Grid.Column="2" Text="—" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource Num}" />
                                </Grid>
                                <Grid Height="5" Margin="0,5,0,10" OpacityMask="{StaticResource SegmentMask}">
                                    <Border Background="{DynamicResource Line}" />
                                    <Border Background="{DynamicResource Copper}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="SideGpuBar" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SideRam" Grid.Column="1" Text="—" Style="{StaticResource ReadoutText}" FontSize="15" />
                                    <TextBlock x:Name="SideRamLoad" Grid.Column="2" Text="—" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource Num}" />
                                </Grid>
                                <Grid Height="5" Margin="0,5,0,10" OpacityMask="{StaticResource SegmentMask}">
                                    <Border Background="{DynamicResource Line}" />
                                    <Border Background="{DynamicResource Steel}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="SideRamBar" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid x:Name="SideDiskRow" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Disco" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SideDisk" Grid.Column="1" Text="—" Style="{StaticResource ReadoutText}" FontSize="15" />
                                    <TextBlock x:Name="SideDiskLoad" Grid.Column="2" Text="—" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource Num}" />
                                </Grid>
                                <Grid Height="5" Margin="0,5,0,0" OpacityMask="{StaticResource SegmentMask}">
                                    <Border Background="{DynamicResource Line}" />
                                    <Border Background="{DynamicResource Steel}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="SideDiskBar" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Navegação -->
                    <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="NavPanel" Margin="0,4,0,12">
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}" Tag="PageDash" local:Ui.Icon="&#xE80F;" Content="Visão geral" Checked="Nav_Checked" IsChecked="True" />
                            <TextBlock Text="Monitoramento" Style="{StaticResource NavHeader}" />
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="PageSystem" local:Ui.Icon="&#xE7F8;" Content="Sistema" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSensors" Style="{StaticResource NavItem}" Tag="PageSensors" local:Ui.Icon="&#xE9D9;" Content="Sensores" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" Tag="PageGpu" local:Ui.Icon="&#xE7F4;" Content="Placa de vídeo" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavDisks" Style="{StaticResource NavItem}" Tag="PageDisks" local:Ui.Icon="&#xEDA2;" Content="Discos" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavEnergy" Style="{StaticResource NavItem}" Tag="PageEnergy" local:Ui.Icon="&#xE7E8;" Content="Energia" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavNet" Style="{StaticResource NavItem}" Tag="PageNet" local:Ui.Icon="&#xE839;" Content="Rede" Checked="Nav_Checked" />
                            <TextBlock Text="Jogos" Style="{StaticResource NavHeader}" />
                            <RadioButton x:Name="NavOverlay" Style="{StaticResource NavItem}" Tag="PageOverlay" local:Ui.Icon="&#xE81E;" Content="OverlayBi" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}" Tag="PageGames" local:Ui.Icon="&#xEC49;" Content="FPS estimado" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavBottleneck" Style="{StaticResource NavItem}" Tag="PageBottleneck" local:Ui.Icon="&#xE9D2;" Content="Gargalo" Checked="Nav_Checked" />
                            <TextBlock Text="Desempenho" Style="{StaticResource NavHeader}" />
                            <RadioButton x:Name="NavBench" Style="{StaticResource NavItem}" Tag="PageBench" local:Ui.Icon="&#xE8B9;" Content="Benchmark" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavStress" Style="{StaticResource NavItem}" Tag="PageStress" local:Ui.Icon="&#xE945;" Content="Teste de carga" Checked="Nav_Checked" />
                            <TextBlock Text="Ferramentas" Style="{StaticResource NavHeader}" />
                            <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="PageStartup" local:Ui.Icon="&#xE823;" Content="Inicialização" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="PageApps" local:Ui.Icon="&#xE719;" Content="Instalar apps" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavDriver" Style="{StaticResource NavItem}" Tag="PageDriver" local:Ui.Icon="&#xE896;" Content="Drivers" Checked="Nav_Checked" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= Área de conteúdo ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Barra de título: atalho de navegação, versão e controles da janela -->
                <Button x:Name="BtnCommand" Style="{StaticResource CommandButton}" Content="Ir para uma página ou ação" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,9,0,0" WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnCommand_Click" ToolTip="Paleta de comandos (Ctrl + K)" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="SideVersion" Text="0.2.2" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Top" Padding="0,12,0,0" Style="{StaticResource Num}" ToolTip="Versão do CoreBi" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimizar" />
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximizar" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar" />
                </StackPanel>

                <Grid x:Name="PageHost" Grid.Row="1">
                    <views:OverviewView x:Name="PageDash" Visibility="Visible" />
                    <views:SystemView x:Name="PageSystem" Visibility="Collapsed" />
                    <views:DisksView x:Name="PageDisks" Visibility="Collapsed" />
                    <views:PowerView x:Name="PageEnergy" Visibility="Collapsed" />
                    <views:NetworkView x:Name="PageNet" Visibility="Collapsed" />
                    <views:DriversView x:Name="PageDriver" Visibility="Collapsed" />
                    <views:SensorsView x:Name="PageSensors" Visibility="Collapsed" />
                    <views:GraphicsView x:Name="PageGpu" Visibility="Collapsed" />
                    <views:ForecastView x:Name="PageGames" Visibility="Collapsed" />
                    <views:BottleneckView x:Name="PageBottleneck" Visibility="Collapsed" />
                    <views:OverlayView x:Name="PageOverlay" Visibility="Collapsed" />
                    <views:BenchmarksView x:Name="PageBench" Visibility="Collapsed" />
                    <views:StartupView x:Name="PageStartup" Visibility="Collapsed" />
                    <views:AppsView x:Name="PageApps" Visibility="Collapsed" />
                    <views:StressView x:Name="PageStress" Visibility="Collapsed" />

                    <!-- Esqueleto de carregamento: cobre a página na primeira visita enquanto ela monta e lê os dados -->
                    <Grid x:Name="LoadingVeil" Visibility="Collapsed" Background="{DynamicResource Bg}" Style="{StaticResource PageGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="LoadingBars" Grid.RowSpan="2">
                            <Border Width="170" Height="26" HorizontalAlignment="Left" CornerRadius="6" Background="{DynamicResource Line}" />
                            <Border Width="260" Height="12" HorizontalAlignment="Left" CornerRadius="6" Background="{DynamicResource Line}" Margin="0,12,0,26" />
                            <Border Style="{StaticResource CardBorder}" Padding="24,22">
                                <StackPanel>
                                    <Border Width="140" Height="12" HorizontalAlignment="Left" CornerRadius="6" Background="{DynamicResource LineStrong}" Margin="0,0,0,22" />
                                    <Border Height="10" CornerRadius="5" Background="{DynamicResource Line}" Margin="0,0,120,18" />
                                    <Border Height="10" CornerRadius="5" Background="{DynamicResource Line}" Margin="0,0,40,18" />
                                    <Border Height="10" CornerRadius="5" Background="{DynamicResource Line}" Margin="0,0,220,18" />
                                    <Border Height="10" CornerRadius="5" Background="{DynamicResource Line}" Margin="0,0,80,18" />
                                    <Border Height="10" CornerRadius="5" Background="{DynamicResource Line}" Margin="0,0,160,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LoadingText" Grid.Row="1" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= Paleta de comandos (Ctrl + K) ================= -->
            <Grid x:Name="PaletteLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Scrim}" MouseLeftButtonDown="PaletteScrim_MouseDown">
                <Border x:Name="PalettePanel" Width="580" VerticalAlignment="Top" Margin="0,84,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="PalettePanel_MouseDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="14" Direction="270" Opacity="0.45" Color="#000000" />
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="18,12,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                            <TextBox x:Name="PaletteSearch" Grid.Column="1" FontSize="15" BorderThickness="0" Background="Transparent" MinHeight="36" Padding="10,0" local:Ui.Placeholder="Buscar páginas e ações" TextChanged="PaletteSearch_TextChanged" PreviewKeyDown="PaletteSearch_PreviewKeyDown" />
                            <Border Grid.Column="2" Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="Esc" Style="{StaticResource KeyCapText}" /></Border>
                        </Grid>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Divider}" />
                        <Grid DockPanel.Dock="Bottom" Margin="18,10,18,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" Style="{StaticResource KeyCapText}" FontSize="9" Margin="0,2,0,1" /></Border>
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" Style="{StaticResource KeyCapText}" FontSize="9" Margin="0,2,0,1" /></Border>
                                <TextBlock Text="navegar" Style="{StaticResource Caption}" Margin="4,0,16,0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" Style="{StaticResource KeyCapText}" /></Border>
                                <TextBlock Text="abrir" Style="{StaticResource Caption}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Divider}" />
                        <Grid>
                            <ListBox x:Name="PaletteList" MaxHeight="400" Margin="8,8,8,6" ItemContainerStyle="{StaticResource ListNavItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseLeftButtonUp="PaletteList_MouseUp" Focusable="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource ListNavIcon}" FontSize="14" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Section}" Foreground="{DynamicResource Faint}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="PaletteEmpty" Text="Nada encontrado. Tente o nome de uma página, como “discos” ou “overlay”." Style="{StaticResource Caption}" Margin="20,18" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
