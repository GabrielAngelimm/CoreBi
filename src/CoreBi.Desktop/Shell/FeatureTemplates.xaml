<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Máscara de segmentos: grandezas medidas aparecem em medidor segmentado (como um instrumento de bancada);
        progresso de uma tarefa usa barra contínua. A máscara fica no trilho, então o preenchimento escala por baixo.
    -->
    <DrawingBrush x:Key="SegmentMask" TileMode="Tile" Stretch="None" Viewport="0,0,5,8" ViewportUnits="Absolute" Viewbox="0,0,5,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,5,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Black">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,3.5,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Ficha técnica da placa de vídeo: uma linha chave/valor, com o fio em cima (como as linhas da ficha de Sistema).
         Linhas da mesma altura; a nota curta ("referência") fica ao lado do valor, num tom abaixo. -->
    <DataTemplate x:Key="GpuSpecRow">
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8" Background="Transparent" ToolTip="{Binding Tip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="58*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular">
                    <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Fg}"/><Run Text="  "/><Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Ficha técnica da placa de vídeo: um grupo (título de grupo e as linhas) -->
    <DataTemplate x:Key="GpuSection">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitle}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource GpuSpecRow}" Focusable="False"/>
        </StackPanel>
    </DataTemplate>

    <!-- Par chave/valor em lista compacta -->
    <DataTemplate x:Key="KeyValueRow">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Style="{StaticResource Num}"/>
        </Grid>
    </DataTemplate>

    <!-- Medidor segmentado: rótulo, valor e fração 0–1 -->
    <DataTemplate x:Key="Meter">
        <Grid Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Style="{StaticResource Num}"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="0,7,0,0" OpacityMask="{StaticResource SegmentMask}">
                <Border Background="{DynamicResource Line}"/>
                <Border Background="{DynamicResource Signal}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Fraction}"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <Style x:Key="MonoCell" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="ValueCell" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MutedCell" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style x:Key="MutedMonoCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
</ResourceDictionary>
