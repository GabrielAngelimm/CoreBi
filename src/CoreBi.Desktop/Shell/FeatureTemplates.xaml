<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:inventory="clr-namespace:CoreBi.Engine.Monitoring.Inventory;assembly=CoreBi.Engine">

    <!--
        Máscara de segmentos: grandezas medidas aparecem em medidor segmentado (como um instrumento de bancada);
        progresso de uma tarefa usa barra contínua. A máscara fica no trilho, então o preenchimento escala por baixo.
    -->
    <DrawingBrush x:Key="SegmentMask" TileMode="Tile" Stretch="None" Viewport="0,0,5,8" ViewportUnits="Absolute" Viewbox="0,0,5,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,5,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Black">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,3.5,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Inventário (Sistema): linha chave/valor ou grupo com título -->
    <DataTemplate DataType="{x:Type inventory:InfoNode}">
        <StackPanel>
            <Border x:Name="leaf" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Style="{StaticResource Num}"/>
                </Grid>
            </Border>
            <StackPanel x:Name="group" Visibility="Collapsed" Margin="0,24,0,0">
                <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Children}"/>
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                <Setter TargetName="leaf" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="group" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Especificação da GPU: uma célula -->
    <DataTemplate x:Key="GpuTile">
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,18,10">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource StatLabel}"/>
                <TextBlock Text="{Binding Value}" FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0" Style="{StaticResource Num}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Especificação da GPU: uma seção -->
    <DataTemplate x:Key="GpuSection">
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="22,18,22,8">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource GpuTile}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Par chave/valor em lista compacta -->
    <DataTemplate x:Key="KeyValueRow">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Style="{StaticResource Num}"/>
        </Grid>
    </DataTemplate>

    <!-- Medidor segmentado: rótulo, valor e fração 0–1 -->
    <DataTemplate x:Key="Meter">
        <Grid Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Style="{StaticResource Num}"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="0,7,0,0" OpacityMask="{StaticResource SegmentMask}">
                <Border Background="{DynamicResource Line}"/>
                <Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Fraction}"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <Style x:Key="MonoCell" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="ValueCell" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MutedCell" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style x:Key="MutedMonoCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <local:DriveArcConverter x:Key="DriveArc"/>
</ResourceDictionary>
