<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CoreBi.Desktop">

    <!--
        CoreBi · design system "Bancada" (docs/DESIGN.md)
        Um instrumento de bancada iluminado: painéis de grafite (ou papel) com luz de cima, a marca acendendo o que é
        interativo e cada componente com a sua cor e o seu brilho. Saudável é discreto; o que pede atenção salta aos olhos.
        Os pincéis abaixo são os do tema escuro, para o designer do XAML; ThemeManager é a fonte e troca todos em tempo de
        execução (inclusive os gradientes e brilhos, que existem só lá).
    -->

    <!-- Paleta fixa do overlay e do aviso (Hud*), que não acompanha o tema: fica em HudPalette.xaml -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CoreBi.Desktop;component/Shell/HudPalette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================== Paleta (DynamicResource; gerada da tabela do ThemeManager) ===================== -->
    <!-- paleta:início (gerado por tools/sync_theme.py a partir do ThemeManager.cs; não editar à mão) -->
    <!-- Superfícies: bancada → painel → elevado -->
    <SolidColorBrush x:Key="Bg" Color="#0E1214"/>
    <SolidColorBrush x:Key="Sidebar" Color="#0A0D0F"/>
    <SolidColorBrush x:Key="Surface" Color="#15191C"/>
    <SolidColorBrush x:Key="Raised" Color="#1C2022"/>
    <SolidColorBrush x:Key="Hover" Color="#1F2427"/>
    <SolidColorBrush x:Key="Selected" Color="#282D31"/>
    <SolidColorBrush x:Key="Well" Color="#050708"/>
    <SolidColorBrush x:Key="Scrim" Color="#B8050708"/>
    <!-- Fios -->
    <SolidColorBrush x:Key="Line" Color="#24282B"/>
    <SolidColorBrush x:Key="LineStrong" Color="#353A3D"/>
    <!-- Texto -->
    <SolidColorBrush x:Key="Fg" Color="#E6EAEC"/>
    <SolidColorBrush x:Key="Muted" Color="#A3AAAE"/>
    <SolidColorBrush x:Key="Faint" Color="#737A7E"/>
    <!-- Sinal: a marca. Ação principal, controles ligados, item escolhido na navegação, foco e o que está ao vivo -->
    <SolidColorBrush x:Key="Signal" Color="#27C9BC"/>
    <SolidColorBrush x:Key="SignalDeep" Color="#12AA9D"/>
    <SolidColorBrush x:Key="SignalHi" Color="#6FE3D6"/>
    <SolidColorBrush x:Key="SignalFg" Color="#03201D"/>
    <SolidColorBrush x:Key="SignalSoft" Color="#2427C9BC"/>
    <SolidColorBrush x:Key="Focus" Color="#5FDCCF"/>
    <!-- Tinta: leituras neutras (bateria, sessão atual) e o miolo dos controles -->
    <SolidColorBrush x:Key="Ink" Color="#E3E7E9"/>
    <SolidColorBrush x:Key="InkFg" Color="#101315"/>
    <!-- Canais: o que cada componente mede (gráficos, medidores, anéis, legendas e o ícone do componente) -->
    <SolidColorBrush x:Key="Cpu" Color="#0CB7A4"/>
    <SolidColorBrush x:Key="CpuDeep" Color="#079B8B"/>
    <SolidColorBrush x:Key="CpuHi" Color="#67D9C8"/>
    <SolidColorBrush x:Key="CpuSoft" Color="#2A0CB7A4"/>
    <SolidColorBrush x:Key="Gpu" Color="#E8894A"/>
    <SolidColorBrush x:Key="GpuDeep" Color="#C9682F"/>
    <SolidColorBrush x:Key="GpuHi" Color="#F5B07C"/>
    <SolidColorBrush x:Key="GpuSoft" Color="#28E8894A"/>
    <SolidColorBrush x:Key="Memory" Color="#B296FF"/>
    <SolidColorBrush x:Key="MemoryDeep" Color="#9573EC"/>
    <SolidColorBrush x:Key="MemoryHi" Color="#D6C6FF"/>
    <SolidColorBrush x:Key="MemorySoft" Color="#2AB296FF"/>
    <SolidColorBrush x:Key="Storage" Color="#4A82CC"/>
    <SolidColorBrush x:Key="StorageDeep" Color="#2F64AE"/>
    <SolidColorBrush x:Key="StorageHi" Color="#86B4EE"/>
    <SolidColorBrush x:Key="StorageSoft" Color="#304A82CC"/>
    <SolidColorBrush x:Key="NetDown" Color="#0CB7A4"/>
    <SolidColorBrush x:Key="NetDownDeep" Color="#079B8B"/>
    <SolidColorBrush x:Key="NetDownHi" Color="#67D9C8"/>
    <SolidColorBrush x:Key="NetUp" Color="#E8894A"/>
    <SolidColorBrush x:Key="NetUpDeep" Color="#C9682F"/>
    <SolidColorBrush x:Key="NetUpHi" Color="#F5B07C"/>
    <SolidColorBrush x:Key="Steel" Color="#8696A2"/>
    <SolidColorBrush x:Key="SteelSoft" Color="#268696A2"/>
    <!-- Veredito: só quando algo pede atenção ganha cor cheia; saudável é um LED discreto -->
    <SolidColorBrush x:Key="Ok" Color="#6FC889"/>
    <SolidColorBrush x:Key="OkSoft" Color="#226FC889"/>
    <SolidColorBrush x:Key="Warn" Color="#EDB755"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#26EDB755"/>
    <SolidColorBrush x:Key="Danger" Color="#EE6E63"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26EE6E63"/>
    <!-- Rolagem -->
    <SolidColorBrush x:Key="ThumbBrush" Color="#353A3D"/>
    <SolidColorBrush x:Key="ThumbHover" Color="#50575B"/>
    <SolidColorBrush x:Key="ThumbDrag" Color="#6E7579"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0E1214"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#282D31"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#282D31"/>
    <!-- Gradientes (a luz dos painéis, a tecla acesa e o preenchimento dos canais) -->
    <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#181C1F" Offset="0"/>
        <GradientStop Color="#14181B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2D3236" Offset="0"/>
        <GradientStop Color="#212528" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SignalFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#45D6C9" Offset="0"/>
        <GradientStop Color="#1DB5A8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SignalFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6AE2D6" Offset="0"/>
        <GradientStop Color="#2BC4B7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavSelFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E27C9BC" Offset="0"/>
        <GradientStop Color="#0A27C9BC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SignalGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#12AA9D" Offset="0"/>
        <GradientStop Color="#6FE3D6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CpuGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#079B8B" Offset="0"/>
        <GradientStop Color="#67D9C8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GpuGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C9682F" Offset="0"/>
        <GradientStop Color="#F5B07C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MemoryGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#9573EC" Offset="0"/>
        <GradientStop Color="#D6C6FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StorageGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2F64AE" Offset="0"/>
        <GradientStop Color="#86B4EE" Offset="1"/>
    </LinearGradientBrush>
    <!-- Brilhos (luz radial do canal atrás de uma leitura) -->
    <RadialGradientBrush x:Key="SignalGlow">
        <GradientStop Color="#3027C9BC" Offset="0"/>
        <GradientStop Color="#1027C9BC" Offset="0.55"/>
        <GradientStop Color="#0027C9BC" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CpuGlow">
        <GradientStop Color="#340CB7A4" Offset="0"/>
        <GradientStop Color="#110CB7A4" Offset="0.55"/>
        <GradientStop Color="#000CB7A4" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GpuGlow">
        <GradientStop Color="#30E8894A" Offset="0"/>
        <GradientStop Color="#10E8894A" Offset="0.55"/>
        <GradientStop Color="#00E8894A" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="MemoryGlow">
        <GradientStop Color="#30B296FF" Offset="0"/>
        <GradientStop Color="#10B296FF" Offset="0.55"/>
        <GradientStop Color="#00B296FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="StorageGlow">
        <GradientStop Color="#384A82CC" Offset="0"/>
        <GradientStop Color="#124A82CC" Offset="0.55"/>
        <GradientStop Color="#004A82CC" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SteelGlow">
        <GradientStop Color="#268696A2" Offset="0"/>
        <GradientStop Color="#0C8696A2" Offset="0.55"/>
        <GradientStop Color="#008696A2" Offset="1"/>
    </RadialGradientBrush>
    <!-- paleta:fim -->

    <!-- ===================== Forma ===================== -->
    <!-- Raios por hierarquia: painel > poço > controle > selo. Pílulas (filtros) são inteiramente redondas. -->
    <CornerRadius x:Key="RadiusPanel">10</CornerRadius>
    <CornerRadius x:Key="RadiusInset">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">7</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <!-- Respiro padrão de um painel (24 nas laterais, 20 em cima e embaixo) -->
    <Thickness x:Key="PanelPadding">24,20</Thickness>

    <!-- ===================== Tipografia ===================== -->
    <!--
        Duas vozes. Bahnschrift (DIN 1451, a letra de instrumentos, placas e da assinatura CoreBi) é a estrutura: títulos,
        navegação, botões, rótulos e leituras. Segoe UI Variable é o conteúdo: nomes, descrições e textos, no tamanho óptico
        certo (Small até 12 px).
    -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="LabelFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Readout">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:StringNotEmptyConverter x:Key="NotEmptyVis"/>
    <local:SentenceCaseConverter x:Key="Sentence"/>

    <!-- Título da página: a mesma voz da assinatura -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="720"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <!-- Título de painel -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Título de grupo dentro de uma ficha (Sensores, Sistema): um degrau abaixo do painel -->
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Rótulo de grupo: frase curta, sem caixa alta, na letra da estrutura -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Nota de rodapé: fonte dos dados e limites da medição -->
    <Style x:Key="Footnote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="MaxWidth" Value="760"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Num" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Leituras de instrumento: Bahnschrift semicondensada, algarismos tabulares -->
    <Style x:Key="ReadoutText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Readout}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="ReadoutLarge" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="FontWeight" Value="Light"/>
    </Style>
    <Style x:Key="ReadoutHero" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
        <Setter Property="FontSize" Value="54"/>
        <Setter Property="FontWeight" Value="Light"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="5,0,0,5"/>
    </Style>
    <!-- Rótulo de uma leitura (Temp., Clock, Desgaste): gravado no painel, na letra do instrumento -->
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="StatSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Foco de teclado ===================== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource Focus}" BorderThickness="2" CornerRadius="9" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Superfícies ===================== -->
    <!-- Página: margens únicas para todas as telas -->
    <Style x:Key="Page" TargetType="StackPanel">
        <Setter Property="Margin" Value="36,10,36,36"/>
    </Style>
    <Style x:Key="PageGrid" TargetType="Grid">
        <Setter Property="Margin" Value="36,10,36,28"/>
    </Style>
    <Style x:Key="PageHeader" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <!--
        Painel: agrupa um instrumento. Sem sombra; a profundidade vem da luz de cima (o fundo clareia um passo no topo e o fio
        de cima é mais claro que o de baixo, como um módulo de alumínio).
    -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
        <Setter Property="Padding" Value="{StaticResource PanelPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- Poço: área rebaixada dentro de um painel (lista curta, leitura secundária) -->
    <Style x:Key="InsetBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusInset}"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>
    <!-- Palco escuro para imagens renderizadas pelos benchmarks -->
    <Style x:Key="StageBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Well}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusInset}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Line}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- Ícone em ladrilho neutro (ações, nós de um caminho). O ladrilho de um componente usa o tom do canal (ChannelTile). -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!--
        Ladrilho de componente: fundo no tom suave do canal e o ícone na cor dele (Ui.Channel = Cpu, Gpu, Memory, Storage,
        Signal; vazio = Steel). É o mesmo em Sistema, Sensores, Visão geral e OverlayBi, para cada peça ter um rosto só.
    -->
    <Style x:Key="ChannelTile" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Background" Value="{DynamicResource SteelSoft}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Steel}"/>
        <Style.Triggers>
            <Trigger Property="local:Ui.Channel" Value="Cpu">
                <Setter Property="Background" Value="{DynamicResource CpuSoft}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Cpu}"/>
            </Trigger>
            <Trigger Property="local:Ui.Channel" Value="Gpu">
                <Setter Property="Background" Value="{DynamicResource GpuSoft}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Gpu}"/>
            </Trigger>
            <Trigger Property="local:Ui.Channel" Value="Memory">
                <Setter Property="Background" Value="{DynamicResource MemorySoft}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Memory}"/>
            </Trigger>
            <Trigger Property="local:Ui.Channel" Value="Storage">
                <Setter Property="Background" Value="{DynamicResource StorageSoft}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource StorageHi}"/>
            </Trigger>
            <Trigger Property="local:Ui.Channel" Value="Signal">
                <Setter Property="Background" Value="{DynamicResource SignalSoft}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Signal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Marca de canal: o traço curto na cor do componente, ao lado do nome (legendas, cartões, listas) -->
    <Style x:Key="ChannelMark" TargetType="Border">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- LED: veredito ou "ao vivo" num ponto, como num painel de instrumento -->
    <Style x:Key="StatusLed" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource Faint}"/>
    </Style>
    <!--
        Selo de veredito: LED + texto. Saudável fica em tinta com o LED verde; atenção e crítico ganham fundo e texto na cor
        (Ui.SetTone). Sem LED, o selo é só uma etiqueta neutra.
    -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,2,9,3"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeLed" TargetType="Ellipse" BasedOn="{StaticResource StatusLed}">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Margin" Value="0,1,7,0"/>
    </Style>
    <!-- Tecla (atalhos) -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <!-- Barra de progresso de uma tarefa: trilho + preenchimento no sinal (o ScaleTransform nomeado fica na página) -->
    <Style x:Key="ProgressTrack" TargetType="Grid">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Line}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="ProgressFill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SignalGrad}"/>
        <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
    </Style>
    <!-- Brilho de instrumento: luz radial do canal atrás da leitura principal de um painel (Ui.Channel escolhe o canal) -->
    <Style x:Key="Glow" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource SignalGlow}"/>
        <Style.Triggers>
            <Trigger Property="local:Ui.Channel" Value="Cpu"><Setter Property="Background" Value="{DynamicResource CpuGlow}"/></Trigger>
            <Trigger Property="local:Ui.Channel" Value="Gpu"><Setter Property="Background" Value="{DynamicResource GpuGlow}"/></Trigger>
            <Trigger Property="local:Ui.Channel" Value="Memory"><Setter Property="Background" Value="{DynamicResource MemoryGlow}"/></Trigger>
            <Trigger Property="local:Ui.Channel" Value="Storage"><Setter Property="Background" Value="{DynamicResource StorageGlow}"/></Trigger>
            <Trigger Property="local:Ui.Channel" Value="Steel"><Setter Property="Background" Value="{DynamicResource SteelGlow}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Botões ===================== -->
    <!-- O mouse acende uma camada por cima (transição curta); o clique afunda 1 px -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Grid x:Name="root">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True"/>
            <Border x:Name="lit" Background="{Binding Path=(local:Ui.HoverFill), RelativeSource={RelativeSource TemplatedParent}}"
                    CornerRadius="{StaticResource RadiusControl}" Opacity="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{Binding Path=(local:Ui.IconBrush), RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="local:Ui.Icon" Value="">
                <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <!-- Sem cor própria, o glifo acompanha o texto -->
            <Trigger Property="local:Ui.IconBrush" Value="{x:Null}">
                <Setter TargetName="ic" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="lit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="lit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="root" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
    </Style>

    <!-- Ação principal da página: uma por tela, a tecla acesa da marca -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource SignalFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SignalDeep}"/>
        <Setter Property="Foreground" Value="{DynamicResource SignalFg}"/>
        <Setter Property="local:Ui.HoverFill" Value="{DynamicResource SignalFillHover}"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="local:Ui.HoverFill" Value="{DynamicResource Selected}"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="local:Ui.HoverFill" Value="{DynamicResource Hover}"/>
        <!-- O glifo acende no sinal: é o que diz "isto é uma ação" num botão sem fundo -->
        <Setter Property="local:Ui.IconBrush" Value="{DynamicResource Signal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Linha de lista que leva a outra página: sem cara de botão até o mouse passar -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="hover" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource Hover}" Opacity="0"/>
                        <ContentPresenter Margin="8,5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interromper um teste em andamento -->
    <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="local:Ui.HoverFill" Value="{DynamicResource DangerSoft}"/>
    </Style>

    <!-- Ação destrutiva discreta dentro de listas (remover) -->
    <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="local:Ui.HoverFill" Value="{DynamicResource DangerSoft}"/>
        <Setter Property="local:Ui.IconBrush" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botão só com glifo -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Signal}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de título -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource CloseHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource HudFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Atalho "Ir para…" da barra de título (abre a paleta de comandos) -->
    <Style x:Key="CommandButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="320"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="10,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="glass" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Style="{StaticResource KeyCapText}"/></Border>
                                <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="K" Style="{StaticResource KeyCapText}"/></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/>
                            <Setter TargetName="glass" Property="Foreground" Value="{DynamicResource Signal}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Navegação lateral ===================== -->
    <!--
        Item da navegação, em Bahnschrift. O escolhido acende o ícone no sinal e ganha uma pílula tingida; dentro de um
        SlidingSelectionPanel a pílula é uma só e desliza até o item escolhido (Ui.SlidingGroup), sem barra lateral.
    -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Margin" Value="12,1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Height="34">
                        <Border x:Name="hover" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource Hover}" Opacity="0"/>
                        <Border x:Name="sel" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource NavSelFill}" Opacity="0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Icons}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                            <TextBlock x:Name="icOn" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Icons}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="4,0,0,0" Foreground="{DynamicResource Signal}" Opacity="0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,1"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="icOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="ic" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="icOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="ic" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="hover" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="local:Ui.SlidingGroup" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="sel" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Trilho da navegação: um destaque só, tingido de sinal, que desliza até a página aberta -->
    <Style x:Key="NavRail" TargetType="local:SlidingSelectionPanel">
        <Setter Property="Highlight" Value="{DynamicResource NavSelFill}"/>
        <Setter Property="HighlightRadius" Value="7"/>
    </Style>

    <Style x:Key="NavHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="Margin" Value="24,18,0,6"/>
    </Style>

    <!-- ===================== Seleção de opções ===================== -->
    <!-- Controle segmentado: um poço com teclas; a escolhida sobe (fundo elevado, fio e texto em tinta) e, num
         SlidingSelectionPanel, a tecla acesa desliza de uma opção para a outra -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusInset}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Trilho do controle segmentado (dentro do SegmentGroup): a tecla elevada desliza até a opção escolhida -->
    <Style x:Key="SegmentRail" TargetType="local:SlidingSelectionPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Highlight" Value="{DynamicResource Selected}"/>
        <Setter Property="HighlightBorder" Value="{DynamicResource LineStrong}"/>
        <Setter Property="HighlightRadius" Value="5"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="12,4" MinHeight="26">
                        <Grid>
                            <!-- Cópia invisível em seminegrito: o segmento já nasce com a largura do escolhido, então marcar um não desloca os vizinhos -->
                            <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" Visibility="Hidden" HorizontalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="local:Ui.SlidingGroup" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filtro em pílula (listas geradas: tipos de sensor, GPUs, unidades). Marcado = fundo elevado, fio e texto em tinta. -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="14"
                            Padding="12,4,12,5" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SignalSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SignalDeep}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Escolha do teste (Benchmark): ladrilho com glifo, nome e legenda; o escolhido acende o glifo no sinal -->
    <Style x:Key="TestTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{DynamicResource PanelFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusInset}" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"/>
                            <ContentPresenter Margin="0,10,0,0" TextElement.FontWeight="SemiBold" TextElement.FontSize="13.5" TextElement.FontFamily="{StaticResource LabelFont}"/>
                            <TextBlock Text="{Binding Path=(local:Ui.Caption), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Faint}" FontFamily="{StaticResource SmallFont}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SignalDeep}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Signal}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Caixas de seleção ===================== -->
    <!-- Padrão: caixa quadrada (seleção múltipla em listas); marcada = cheia no sinal -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="{StaticResource RadiusSmall}" BorderThickness="1.5"
                                BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Raised}" VerticalAlignment="Center">
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                                       Foreground="{DynamicResource SignalFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="cp" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="cp" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Signal}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Signal}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Chave de tema (rodapé da barra lateral): a linha inteira é clicável; ligada = modo escuro. O botão desliza e o ícone troca
        entre o sol (cobre) e a lua (lavanda) com um giro curto, só em resposta ao clique.
    -->
    <Style x:Key="ThemeToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="row" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Height="36" Padding="12,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="spin" Angle="0"/>
                                </Grid.RenderTransform>
                                <TextBlock x:Name="sun" Text="&#xE706;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="{DynamicResource Gpu}"/>
                                <TextBlock x:Name="moon" Text="&#xE708;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Memory}" Opacity="0"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,1"/>
                            <Grid Grid.Column="2" Width="36" Height="20" VerticalAlignment="Center">
                                <Border CornerRadius="10" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"/>
                                <Border x:Name="on" CornerRadius="10" Background="{DynamicResource SignalFill}" Opacity="0"/>
                                <Ellipse x:Name="knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="slide" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource SignalFg}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="spin" Storyboard.TargetProperty="Angle" From="-90" To="0" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetName="moon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="sun" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetName="spin" Storyboard.TargetProperty="Angle" From="90" To="0" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor: liga e desliga algo na hora. Ligado = trilho aceso no sinal, botão desliza para a direita. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="38" Height="20" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Raised}"/>
                            <Border x:Name="on" CornerRadius="10" Background="{DynamicResource SignalFill}" Opacity="0"/>
                            <Ellipse x:Name="knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="slide" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter x:Name="cp" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="cp" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource SignalFg}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Componente selecionável em cartão (Teste de carga: CPU, RAM, GPU) -->
    <Style x:Key="ToggleCard" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="b" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusInset}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="tile" Style="{StaticResource IconTile}" Width="32" Height="32">
                                <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Muted}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <ContentPresenter TextElement.FontWeight="SemiBold" TextElement.FontFamily="{StaticResource LabelFont}" TextElement.FontSize="13.5"/>
                                <TextBlock Text="{Binding Path=(local:Ui.Caption), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource SmallFont}" FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border x:Name="dot" Grid.Column="2" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource LineStrong}" VerticalAlignment="Center">
                                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                           Foreground="{DynamicResource SignalFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SignalDeep}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Signal}"/>
                            <Setter TargetName="dot" Property="Background" Value="{DynamicResource Signal}"/>
                            <Setter TargetName="dot" Property="BorderBrush" Value="{DynamicResource Signal}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Opção em pílula (itens do overlay): ligada = fundo elevado com visto aceso no sinal; desligada = contorno e "+".
        O estado fica claro pela forma e pelo glifo, não só pela cor.
    -->
    <Style x:Key="OptionChip" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="b" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="14"
                            Padding="9,4,12,5" Background="Transparent" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="mark" Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="10"
                                       Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                            <Setter TargetName="mark" Property="Text" Value="&#xE73E;"/>
                            <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Signal}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Campos ===================== -->
    <!-- Ui.Placeholder = texto de espera · Ui.Icon = glifo à esquerda · Ui.Suffix = unidade à direita -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Signal}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Signal}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Faint}"
                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                            <TextBlock x:Name="ph" Grid.Column="1" Text="{Binding Path=(local:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Faint}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="sx" Grid.Column="2" Text="{Binding Path=(local:Ui.Suffix), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- O texto de espera some quando o campo tem o foco: o cursor pisca sozinho, nunca em cima da primeira letra dele -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="local:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="local:Ui.Suffix" Value="">
                            <Setter TargetName="sx" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Signal}"/>
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Signal}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Signal}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Signal}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Signal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Rolagem ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{DynamicResource ThumbBrush}" CornerRadius="3" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHover}"/>
                            <Setter TargetName="t" Property="Margin" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbDrag}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Dicas ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}" Padding="10,6" MaxWidth="340" Margin="2">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="17"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Listas ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="PlainItem" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter Margin="0,2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista de itens selecionáveis (rack de Discos, paleta de comandos): a mesma seleção da navegação lateral -->
    <Style x:Key="ListNavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" Margin="0,0,0,2">
                        <Border x:Name="hover" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource Hover}" Opacity="0"/>
                        <Border x:Name="sel" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource Selected}" Opacity="0"/>
                        <ContentPresenter Margin="10,8"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Ícone de item em ListNavItem: cinza, aceso no sinal quando o item está selecionado -->
    <Style x:Key="ListNavIcon" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Signal}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Tabela ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="MinRowHeight" Value="34"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,0,14,10" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Bottom" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
