<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CoreBi.Desktop">

    <!--
        CoreBi · design system "Bancada"
        Um instrumento de medição: superfícies em grafite azulado, leitura em verde-sinal (canal A, CPU)
        e cobre (canal B, GPU). Cores de estado (ok, atenção, crítico) só aparecem em vereditos.
        Os pincéis abaixo são os do tema escuro; ThemeManager troca todos em tempo de execução.
    -->

    <!-- ===================== Paleta (DynamicResource) ===================== -->
    <SolidColorBrush x:Key="Bg" Color="#0D141A"/>
    <SolidColorBrush x:Key="Sidebar" Color="#0A1015"/>
    <SolidColorBrush x:Key="Surface" Color="#121B23"/>
    <SolidColorBrush x:Key="Raised" Color="#18232D"/>
    <SolidColorBrush x:Key="Hover" Color="#1B2731"/>
    <SolidColorBrush x:Key="Selected" Color="#21303C"/>
    <SolidColorBrush x:Key="Line" Color="#1F2B35"/>
    <SolidColorBrush x:Key="LineStrong" Color="#2D3D4A"/>
    <SolidColorBrush x:Key="Fg" Color="#E6EEF1"/>
    <SolidColorBrush x:Key="Muted" Color="#93A4B0"/>
    <SolidColorBrush x:Key="Faint" Color="#61717D"/>
    <SolidColorBrush x:Key="Accent" Color="#27C9BC"/>
    <SolidColorBrush x:Key="AccentHover" Color="#45D8CC"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2427C9BC"/>
    <SolidColorBrush x:Key="AccentFg" Color="#04211E"/>
    <SolidColorBrush x:Key="Copper" Color="#D99067"/>
    <SolidColorBrush x:Key="CopperSoft" Color="#24D99067"/>
    <SolidColorBrush x:Key="Steel" Color="#7F93A2"/>
    <SolidColorBrush x:Key="Ok" Color="#5FC385"/>
    <SolidColorBrush x:Key="OkSoft" Color="#245FC385"/>
    <SolidColorBrush x:Key="Warn" Color="#E8B550"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#26E8B550"/>
    <SolidColorBrush x:Key="Danger" Color="#EF6B5E"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26EF6B5E"/>
    <SolidColorBrush x:Key="Scrim" Color="#B8050A0E"/>
    <SolidColorBrush x:Key="Well" Color="#080C10"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#2D3D4A"/>
    <SolidColorBrush x:Key="ThumbHover" Color="#4A5D6B"/>
    <SolidColorBrush x:Key="ThumbDrag" Color="#6F8391"/>

    <!-- Canto entre as barras de rolagem, seleção nativa de texto e afins -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0D141A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#21303C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#21303C"/>

    <!-- ===================== Tipografia ===================== -->
    <!-- Texto: Segoe UI Variable. Leituras e marca: Bahnschrift (DIN, desenho de instrumento). Comandos e registro: Cascadia. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Readout">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:CategoryIconConverter x:Key="CategoryIcon"/>
    <local:StringNotEmptyConverter x:Key="NotEmptyVis"/>
    <local:SentenceCaseConverter x:Key="Sentence"/>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="720"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Rótulo de grupo: frase curta, sem caixa alta -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Nota de rodapé: fonte dos dados e limites da medição -->
    <Style x:Key="Footnote" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="MaxWidth" Value="760"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="Num" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Leituras de instrumento -->
    <Style x:Key="ReadoutText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Readout}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="ReadoutLarge" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Light"/>
    </Style>
    <Style x:Key="ReadoutHero" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
        <Setter Property="FontSize" Value="52"/>
        <Setter Property="FontWeight" Value="Light"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="5,0,0,5"/>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="StatSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Foco de teclado ===================== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="9" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Superfícies ===================== -->
    <!-- Página: margens únicas para todas as telas -->
    <Style x:Key="Page" TargetType="StackPanel">
        <Setter Property="Margin" Value="36,10,36,36"/>
    </Style>
    <Style x:Key="PageGrid" TargetType="Grid">
        <Setter Property="Margin" Value="36,10,36,28"/>
    </Style>
    <Style x:Key="PageHeader" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,26"/>
    </Style>
    <!-- Painel: agrupa um instrumento. Sem sombra; a profundidade vem do tom. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="22,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- Poço: área rebaixada dentro de um painel (lista curta, leitura secundária) -->
    <Style x:Key="InsetBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>
    <!-- Palco escuro para imagens renderizadas pelos benchmarks -->
    <Style x:Key="StageBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Well}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Line}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- Ícone em ladrilho (componentes, eventos) -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- Selo neutro; vereditos trocam a cor por gatilho no template -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="8,2,8,3"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <!-- Tecla (atalhos) -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <!-- Barra de progresso: trilho + preenchimento (o ScaleTransform nomeado fica na página) -->
    <Style x:Key="ProgressTrack" TargetType="Grid">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Line}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="ProgressFill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
    </Style>

    <!-- ===================== Botões ===================== -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="local:Ui.Icon" Value="">
                <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
    </Style>

    <!-- Ação principal da página: uma por tela -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selected}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Steel}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Interromper um teste em andamento -->
    <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Danger}"/>
                <Setter Property="Foreground" Value="{DynamicResource Bg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ação destrutiva discreta dentro de listas (remover) -->
    <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botão só com glifo -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de título -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Atalho "Ir para…" da barra de título (abre a paleta de comandos) -->
    <Style x:Key="CommandButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="320"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Style="{StaticResource KeyCapText}"/></Border>
                                <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="K" Style="{StaticResource KeyCapText}"/></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Navegação lateral ===================== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Margin" Value="12,1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bg" Background="Transparent" Height="34" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="bar" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Margin="-1,0,0,0" Visibility="Hidden"/>
                            <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Icons}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="Margin" Value="24,18,0,6"/>
    </Style>

    <!-- ===================== Seleção de opções ===================== -->
    <!-- Controle segmentado: contêiner + RadioButton "Segment" -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,5" MinHeight="26">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filtro em pílula (listas geradas: categorias de sensores, GPUs, unidades) -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="14"
                            Padding="12,4,12,5" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Steel}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Escolha do teste (Benchmark): ladrilho com glifo, nome e legenda -->
    <Style x:Key="TestTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"/>
                            <ContentPresenter Margin="0,10,0,0" TextElement.FontWeight="SemiBold" TextElement.FontSize="13"/>
                            <TextBlock Text="{Binding Path=(local:Ui.Caption), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Faint}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Caixas de seleção ===================== -->
    <!-- Padrão: caixa quadrada (seleção múltipla em listas) -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Raised}" VerticalAlignment="Center">
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                                       Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="cp" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="cp" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Steel}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor: liga e desliga algo na hora -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="track" Width="38" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Raised}" VerticalAlignment="Center">
                            <Ellipse x:Name="knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}"/>
                        </Border>
                        <ContentPresenter x:Name="cp" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="cp" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Steel}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Width" Value="14"/>
                            <Setter TargetName="knob" Property="Height" Value="14"/>
                            <Setter TargetName="knob" Property="Margin" Value="3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Componente selecionável em cartão (Stress: CPU, RAM, GPU) -->
    <Style x:Key="ToggleCard" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="b" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="tile" Style="{StaticResource IconTile}" Width="32" Height="32">
                                <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Muted}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <ContentPresenter TextElement.FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Path=(local:Ui.Caption), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border x:Name="dot" Grid.Column="2" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource LineStrong}" VerticalAlignment="Center">
                                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                           Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="dot" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="dot" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Campos ===================== -->
    <!-- Ui.Placeholder = texto de espera · Ui.Icon = glifo à esquerda · Ui.Suffix = unidade à direita -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ic" Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Faint}"
                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                            <TextBlock x:Name="ph" Grid.Column="1" Text="{Binding Path=(local:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Faint}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="sx" Grid.Column="2" Text="{Binding Path=(local:Ui.Suffix), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="local:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="local:Ui.Suffix" Value="">
                            <Setter TargetName="sx" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Steel}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Steel}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Rolagem ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{DynamicResource ThumbBrush}" CornerRadius="3" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHover}"/>
                            <Setter TargetName="t" Property="Margin" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbDrag}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Dicas ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                            CornerRadius="7" Padding="10,6" MaxWidth="340" Margin="2">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Listas ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="PlainItem" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter Margin="0,2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista de categorias (Sistema) e resultados da paleta de comandos -->
    <Style x:Key="ListNavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="10,8" CornerRadius="8" Margin="0,0,0,2">
                        <Grid>
                            <Border x:Name="bar" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Margin="-9,0,0,0" Visibility="Hidden"/>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tabela ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="MinRowHeight" Value="34"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,0,14,10" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Bottom" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="14,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Cartão de veredito (Discos, Energia, Rede) ===================== -->
    <DataTemplate x:Key="CardTemplate">
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Faixa lateral: cor do veredito -->
                <Border x:Name="stripe" CornerRadius="12,0,0,12" Background="{DynamicResource LineStrong}"/>
                <StackPanel Grid.Column="1" Margin="20,18,22,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border x:Name="badge" Grid.Column="1" Style="{StaticResource Badge}">
                            <TextBlock x:Name="badgeText" Text="{Binding VerdictText, Converter={StaticResource Sentence}}" Style="{StaticResource BadgeText}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Reasons}" Style="{StaticResource Body}" Margin="0,12,0,14"
                               Visibility="{Binding Reasons, Converter={StaticResource NotEmptyVis}}"/>
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9,16,9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Key}" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,3,0,0" Style="{StaticResource Num}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Verdict}" Value="Good">
                <Setter TargetName="stripe" Property="Background" Value="{DynamicResource Ok}"/>
                <Setter TargetName="badge" Property="Background" Value="{DynamicResource OkSoft}"/>
                <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Ok}"/>
                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Ok}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Verdict}" Value="Warning">
                <Setter TargetName="stripe" Property="Background" Value="{DynamicResource Warn}"/>
                <Setter TargetName="badge" Property="Background" Value="{DynamicResource WarnSoft}"/>
                <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Warn}"/>
                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Warn}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Verdict}" Value="Critical">
                <Setter TargetName="stripe" Property="Background" Value="{DynamicResource Danger}"/>
                <Setter TargetName="badge" Property="Background" Value="{DynamicResource DangerSoft}"/>
                <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Danger}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
