<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta fixa (não acompanha o tema): o overlay e o aviso aparecem por cima de jogos e da área de trabalho, então são
        sempre grafite. Os tons são os do tema escuro do app (ThemeManager); o FPS, o gráfico e o ícone do aviso usam o sinal
        da marca. O Theme.xaml inclui este arquivo, e o overlay e o aviso o carregam por conta própria (funcionam sem o app).
    -->
    <SolidColorBrush x:Key="HudBg" Color="#0E1214"/>
    <SolidColorBrush x:Key="HudPanel" Color="#F215191C"/>
    <SolidColorBrush x:Key="HudLine" Color="#30363A"/>
    <SolidColorBrush x:Key="HudSep" Color="#3B4246"/>
    <SolidColorBrush x:Key="HudFg" Color="#E6EAEC"/>
    <SolidColorBrush x:Key="HudMuted" Color="#8F979C"/>
    <SolidColorBrush x:Key="HudFaint" Color="#646B6F"/>
    <SolidColorBrush x:Key="HudSignal" Color="#27C9BC"/>
    <SolidColorBrush x:Key="HudSignalSoft" Color="#2027C9BC"/>
    <!-- Cantos livres sobre a cena do monitor (OverlayBi): contorno tracejado claro e o realce sob o mouse -->
    <SolidColorBrush x:Key="HudZone" Color="#66C9CFD2"/>
    <SolidColorBrush x:Key="HudZoneMark" Color="#99C9CFD2"/>
    <SolidColorBrush x:Key="HudZoneFill" Color="#260A0D0F"/>
    <SolidColorBrush x:Key="HudZoneHover" Color="#1FE6EAEC"/>
    <!-- Fechar a janela: o vermelho do próprio Windows, igual em qualquer tema -->
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C"/>
    <!--
        Monitor desenhado em OverlayBi: um monitor de bordas finas (moldura de 8 px, queixo com o LED à direita, haste com o furo
        do cabo e base ovalada) e uma cena de jogo à noite, em planos chapados (sem degradê, brilho nem vinheta): céu com estrelas,
        lua, duas serras, lago com o reflexo da lua, margens com pinheiros e a mira no centro. Do céu para o chão os planos
        escurecem, para o overlay, grafite, se destacar por cima em qualquer canto.
    -->
    <SolidColorBrush x:Key="HudScreenBezel" Color="#07090B"/>
    <SolidColorBrush x:Key="HudScreenEdge" Color="#2C3235"/>
    <SolidColorBrush x:Key="HudScene" Color="#3A5262"/>
    <SolidColorBrush x:Key="HudSceneStar" Color="#80DCE6EA"/>
    <SolidColorBrush x:Key="HudSceneMoon" Color="#C7D3D8"/>
    <SolidColorBrush x:Key="HudSceneHalo" Color="#5C7684"/>
    <SolidColorBrush x:Key="HudSceneFar" Color="#30475A"/>
    <SolidColorBrush x:Key="HudSceneNear" Color="#253A4A"/>
    <SolidColorBrush x:Key="HudSceneLake" Color="#2C4352"/>
    <SolidColorBrush x:Key="HudSceneRipple" Color="#4E6878"/>
    <SolidColorBrush x:Key="HudSceneGlint" Color="#B39FB2BB"/>
    <SolidColorBrush x:Key="HudSceneGround" Color="#14212B"/>
    <SolidColorBrush x:Key="HudSceneShore" Color="#111C25"/>
    <SolidColorBrush x:Key="HudScenePine" Color="#0F1922"/>
    <SolidColorBrush x:Key="HudSceneAim" Color="#BFE6EAEC"/>
    <SolidColorBrush x:Key="HudStand" Color="#22292D"/>
    <SolidColorBrush x:Key="HudStandSide" Color="#191E21"/>
    <SolidColorBrush x:Key="HudStandHole" Color="#101416"/>
    <SolidColorBrush x:Key="HudStandBase" Color="#2B3237"/>
    <SolidColorBrush x:Key="HudStandEdge" Color="#181C1F"/>
</ResourceDictionary>
