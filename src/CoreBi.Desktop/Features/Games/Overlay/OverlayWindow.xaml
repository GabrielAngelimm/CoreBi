<Window x:Class="CoreBi.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreBi overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!--
        Por cima do jogo: paleta fixa de grafite translúcido (independe do tema do app) e números em Bahnschrift
        com algarismos de largura fixa, para os valores não "dançarem" a cada atualização.
    -->
    <Border x:Name="Box" Background="#D90D141A" BorderBrush="#2C3B47" BorderThickness="1" CornerRadius="8" Padding="12,10">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel TextElement.FontFamily="Bahnschrift" TextElement.FontStretch="SemiCondensed" TextElement.FontSize="13"
                    TextElement.Foreground="#E6EEF1" Typography.NumeralAlignment="Tabular">
            <!-- FPS em destaque (cada parte aparece só se escolhida na aba Overlay) -->
            <StackPanel x:Name="OFpsRow" Orientation="Horizontal">
                <TextBlock x:Name="OFps" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#27C9BC"/>
                <TextBlock x:Name="OFpsUnit" Text=" FPS" Foreground="#8297A6" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                <TextBlock x:Name="OFrameTime" Text="" Foreground="#8297A6" VerticalAlignment="Bottom" Margin="12,0,0,5"/>
            </StackPanel>
            <TextBlock x:Name="OLow" Text="1% low —" Foreground="#8297A6"/>
            <!-- Gráfico de frametime -->
            <Canvas x:Name="OGraph" Width="190" Height="30" Margin="0,6,0,4" ClipToBounds="True"/>
            <!-- Linhas de sensores: GPU, VRAM, CPU, RAM... montadas pelo que foi escolhido -->
            <ItemsControl x:Name="ORows" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="#8297A6" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="OGame" Text="" Foreground="#5E6E7A" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>
