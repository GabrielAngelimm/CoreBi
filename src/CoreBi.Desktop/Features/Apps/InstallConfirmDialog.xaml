<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.InstallConfirmDialog" xmlns:local="clr-namespace:CoreBi.Desktop"
             Visibility="Collapsed" Focusable="False" PreviewKeyDown="Dialog_PreviewKeyDown">
    <UserControl.Resources>
        <!--
            Um app do pacote, como ficha: a posição na fila em mostrador, o ícone oficial num quadro suave (sem o PNG, a inicial), o nome
            e a categoria embaixo. Três por linha; a ordem é a da instalação.
        -->
        <DataTemplate x:Key="ConfirmItem">
            <Border Height="56" Margin="0,0,10,10" CornerRadius="{StaticResource RadiusInset}" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" Padding="12,0,14,0" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Order, StringFormat={}{0:00}}" FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="14"
                               Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Hover}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Image Source="{Binding Tile.Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Tile.Monogram}" FontFamily="{StaticResource LabelFont}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Tile.ShowMonogram, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tile.App.Name}" Style="{StaticResource ItemTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Tile.App.Category}" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Scrim" Background="{DynamicResource Scrim}" MouseLeftButtonDown="Scrim_MouseDown">
        <Border x:Name="Panel" Width="880" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" MouseLeftButtonDown="Panel_MouseDown" RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="14" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelShift" />
            </Border.RenderTransform>
            <DockPanel>
                <!-- Título com a quantidade, fechar e uma frase com o que vai acontecer -->
                <StackPanel DockPanel.Dock="Top" Margin="24,16,16,4">
                    <Grid Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Confirmar o pacote" /><InlineUIContainer><Border Width="10" /></InlineUIContainer><Run x:Name="CountRun"
                                FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource Faint}"
                                Typography.NumeralAlignment="Tabular" />
                        </TextBlock>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="Fechar (Esc)" />
                    </Grid>
                    <TextBlock x:Name="Lead" Style="{StaticResource Caption}" Margin="0,0,8,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Rodapé: de onde vem cada instalador à esquerda; Voltar e Instalar à direita -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                        CornerRadius="{StaticResource RadiusPanelBottom}" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"
                                   Text="Cada instalador vem do site oficial do fabricante, pelo winget, e é conferido antes de abrir." />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Voltar" Click="Cancel_Click" Margin="0,0,10,0" ToolTip="Volta ao catálogo sem instalar (Esc)" />
                            <Button x:Name="BtnConfirm" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE896;" MinWidth="160" Click="Confirm_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- O pacote inteiro, na ordem da fila, em três colunas; rola por dentro quando é grande -->
                <ScrollViewer MaxHeight="440" Margin="24,14,14,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="Items" ItemTemplate="{StaticResource ConfirmItem}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
