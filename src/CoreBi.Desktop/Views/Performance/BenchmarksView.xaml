                                    <TextBlock Text="Configurações do benchmark" Style="{StaticResource CardTitle}" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <Button x:Name="BtnDiskBench" Style="{StaticResource ConfigStart}" local:Ui.Icon="&#xE768;" Content="Iniciar teste" Click="BtnDiskBench_Click"
                                            ToolTip="Grava um arquivo temporário na unidade escolhida, mede sem o cache do Windows e apaga o arquivo no final. Feche outros programas pesados antes." />
                                </StackPanel>
                                <local:ConfigStack MinGap="24" MaxGap="32" Margin="0,16,0,24">
                                    <StackPanel Style="{StaticResource ConfigSection}">
                                        <TextBlock Text="Unidade" Style="{StaticResource ConfigName}" ToolTip="Onde o arquivo de teste é gravado." />
                                        <Border Style="{StaticResource ConfigSegmentGroup}">
                                            <local:SlidingSelectionPanel x:Name="DiskDrivePanel" Style="{StaticResource ConfigSegmentRail}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource ConfigSection}">
                                        <TextBlock Text="Tamanho do arquivo" Style="{StaticResource ConfigName}" ToolTip="Arquivos maiores passam do cache do próprio disco e mostram a velocidade sustentada." />
                                        <Border Style="{StaticResource ConfigSegmentGroup}">
                                            <local:SlidingSelectionPanel x:Name="DiskSizePanel" Style="{StaticResource ConfigSegmentRail}">
                                            <RadioButton Style="{StaticResource ConfigSegment}" GroupName="DiskSize" Content="512 MB" Tag="512" />
                                            <RadioButton Style="{StaticResource ConfigSegment}" GroupName="DiskSize" Content="1 GB" Tag="1024" IsChecked="True" />
                                            <RadioButton Style="{StaticResource ConfigSegment}" GroupName="DiskSize" Content="4 GB" Tag="4096" />
                                            </local:SlidingSelectionPanel>
                                        </Border>
                                    </StackPanel>
                                </local:ConfigStack>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource BenchHistoryCard}">
                            <DockPanel>
                                <Grid Style="{StaticResource HistoryHeader}">
                                    <TextBlock Text="Histórico" Style="{StaticResource CardTitle}" Background="Transparent"
                                               ToolTip="Cada barra compara com o melhor resultado da mesma unidade." />
                                    <Button x:Name="DiskHistoryClear" Style="{StaticResource HistoryClear}" Click="DiskHistoryClear_Click" />
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                    <ItemsControl x:Name="DiskHistory" Style="{StaticResource HistoryList}" local:Ui.Channel="Storage" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
