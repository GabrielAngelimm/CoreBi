<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.BenchmarksView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Resultado de teste de memória e disco: nome, explicação curta e a leitura à direita -->
        <DataTemplate x:Key="ResultRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Footnote}" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ReadoutText}" FontSize="24" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Benchmark" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="BenchSub" Text="Renderização 3D por path tracing no processador, no mesmo princípio do Cinebench." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Grid>

        <!-- Escolha do teste: seis bancadas, cada uma com o componente que mede -->
        <UniformGrid x:Name="BenchTestPanel" Grid.Row="1" Rows="1" Margin="0,0,-10,18">
            <RadioButton Style="{StaticResource TestTile}" GroupName="BenchTest" Content="Render" local:Ui.Icon="cpu" local:Ui.Channel="Cpu" local:Ui.Caption="Processador" Tag="render" IsChecked="True" Checked="BenchTest_Checked" />
            <RadioButton Style="{StaticResource TestTile}" GroupName="BenchTest" Content="Cena de jogo" local:Ui.Icon="gpu" local:Ui.Channel="Gpu" local:Ui.Caption="Placa de vídeo" Tag="gpu" Checked="BenchTest_Checked" />
            <RadioButton Style="{StaticResource TestTile}" GroupName="BenchTest" Content="Ray tracing" local:Ui.Icon="&#xE706;" local:Ui.Channel="Gpu" local:Ui.Caption="Placa de vídeo" Tag="rt" Checked="BenchTest_Checked" />
            <RadioButton Style="{StaticResource TestTile}" GroupName="BenchTest" Content="Simulação" local:Ui.Icon="&#xE7FC;" local:Ui.Channel="Cpu" local:Ui.Caption="Processador" Tag="sim" Checked="BenchTest_Checked" />
            <RadioButton Style="{StaticResource TestTile}" GroupName="BenchTest" Content="Memória" local:Ui.Icon="ram" local:Ui.Channel="Memory" local:Ui.Caption="RAM e carregamento" Tag="mem" Checked="BenchTest_Checked" />
            <RadioButton Style="{StaticResource TestTile}" GroupName="BenchTest" Content="Disco" local:Ui.Icon="storage" local:Ui.Channel="Storage" local:Ui.Caption="Leitura e escrita" Tag="disk" Checked="BenchTest_Checked" />
        </UniformGrid>

        <!-- ============ Render (CPU) ============ -->
        <Grid x:Name="BenchPanelRender" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14,14,14,16" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource StageBorder}">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="960" Height="540">
                                <Image x:Name="BenchImage" Width="960" Height="540" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas x:Name="BenchBuckets" Width="960" Height="540" />
                                <TextBlock x:Name="BenchIdle" Text="A cena aparece aqui, bloco a bloco, enquanto é renderizada" Foreground="#5E6E7A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <Grid Style="{StaticResource ProgressTrack}" Margin="2,14,2,10">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BenchProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Margin="2,0">
                        <TextBlock x:Name="BenchStatus" Text="Pronto" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="BenchElapsed" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Teste" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="BenchModePanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BenchMode" Content="Multi-core" Tag="mt" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BenchMode" Content="Single-core" Tag="st" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BenchMode" Content="Ambos" Tag="both" IsChecked="True" />
                                </WrapPanel>
                            </Border>
                            <TextBlock Text="Duração" Style="{StaticResource Label}" Margin="0,14,0,8" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="BenchDurationPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BenchDur" Content="Uma passada" Tag="0" IsChecked="True" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BenchDur" Content="Mínimo de 10 min" Tag="10" />
                                </WrapPanel>
                            </Border>
                            <Button x:Name="BtnBench" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="BtnBench_Click" />
                            <TextBlock x:Name="BenchHint" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resultado" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <Grid>
                                <TextBlock Text="Multi-core" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="BenchMt" Text="—" Style="{StaticResource ReadoutLarge}" />
                                    <TextBlock Text="pts" Style="{StaticResource Unit}" Margin="6,0,0,7" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,6" />
                            <Grid>
                                <TextBlock Text="Single-core" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="BenchSt" Text="—" Style="{StaticResource ReadoutLarge}" />
                                    <TextBlock Text="pts" Style="{StaticResource Unit}" Margin="6,0,0,7" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BenchRatio" Style="{StaticResource Caption}" Margin="0,10,0,0" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Durante o teste" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="BenchLive" ItemTemplate="{StaticResource KeyValueRow}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Histórico" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <TextBlock x:Name="BenchHistoryEmpty" Text="Nenhum resultado ainda. O primeiro teste vira a referência." Style="{StaticResource Caption}" />
                            <ItemsControl x:Name="BenchHistory" ItemTemplate="{StaticResource Meter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Cena de jogo (GPU) ============ -->
        <Grid x:Name="BenchPanelGpu" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="Vale, cena de jogo" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Text="Sobrevoo de um vale com terreno gerado por ruído fractal (cerca de 500 mil triângulos), 40 mil árvores por instancing, sombras em tempo real (mapa de 4096² com bordas suaves), água com ondas, neblina, céu e pós-processamento HDR. A câmera segue um trajeto fixo e a resolução é fixa: o trabalho é o mesmo em qualquer PC. A cena abre numa janela própria; Esc cancela." />
                    <Border Style="{StaticResource InsetBorder}" Margin="0,22,0,0" Padding="20,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="FPS agora" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="GbFpsNow" Text="—" Style="{StaticResource ReadoutHero}" Foreground="{DynamicResource Signal}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <TextBlock Text="Placa de vídeo" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="GbGpuNow" Text="—" Style="{StaticResource ReadoutText}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Style="{StaticResource ProgressTrack}" Margin="0,18,0,10">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GbProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="GbStatus" Text="Pronto" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resolução" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="GbResPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="GbRes" Content="1080p" Tag="1920x1080" IsChecked="True" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="GbRes" Content="1440p" Tag="2560x1440" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="GbRes" Content="4K" Tag="3840x2160" />
                                </WrapPanel>
                            </Border>
                            <TextBlock Text="Duração" Style="{StaticResource Label}" Margin="0,14,0,8" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="GbDurPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="GbDur" Content="30 s" Tag="30" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="GbDur" Content="60 s" Tag="60" IsChecked="True" />
                                </WrapPanel>
                            </Border>
                            <Button x:Name="BtnGpuBench" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="BtnGpuBench_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resultado" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="GbResult" ItemTemplate="{StaticResource KeyValueRow}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Histórico" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="GbHistory" ItemTemplate="{StaticResource Meter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Ray tracing (GPU) ============ -->
        <Grid x:Name="BenchPanelRt" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="26,22" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cidade de objetos, ray tracing por hardware" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Text="Direct3D 12 com DXR 1.1, nos núcleos de ray tracing da placa (RTX 20 ou mais nova, Radeon RX 6000 ou mais nova, Intel Arc). São 4 mil objetos em materiais fosco, metal e espelho; cada pixel recebe path tracing com sombras suaves, oclusão de ambiente, reflexos de reflexos e iluminação indireta. A estrutura de aceleração é refeita a cada frame, com objetos girando, como nos jogos. Abre numa janela própria; Esc cancela." />
                            <Border Style="{StaticResource InsetBorder}" Margin="0,22,0,0" Padding="20,16">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="FPS agora" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="RtFpsNow" Text="—" Style="{StaticResource ReadoutHero}" Foreground="{DynamicResource Signal}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                        <TextBlock Text="Etapa" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="RtPhase" Text="—" Style="{StaticResource ReadoutText}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Style="{StaticResource ProgressTrack}" Margin="0,18,0,10">
                                <Border Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="RtProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="RtStatus" Text="Pronto" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="26,20">
                        <StackPanel>
                            <TextBlock Text="Como comparar com confiança" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Text="O teste aquece a placa sem medir (clock e temperatura se estabilizam) e depois roda 3 passadas iguais. A nota usa a mediana das passadas, e a variação entre elas mostra se o resultado é confiável (abaixo de 3%). O tempo de cada frame vem do relógio da própria GPU. Compare só resultados com a mesma resolução e o mesmo preset, com o PC na tomada, sem outros programas pesados abertos e com o mesmo driver. A cena é sempre a mesma (sementes fixas), em qualquer PC." />
                            <Border Style="{StaticResource InsetBorder}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Referência medida" Style="{StaticResource StatLabel}" />
                                    <TextBlock Style="{StaticResource Body}" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" Text="AMD Radeon RX 9070, preset Alta em 1440p, modo Padrão: 878 pts (87,8 FPS, 1% low 77), variação de 0,5%." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resolução" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="RtResPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtRes" Content="1080p" Tag="1920x1080" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtRes" Content="1440p" Tag="2560x1440" IsChecked="True" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtRes" Content="4K" Tag="3840x2160" />
                                </WrapPanel>
                            </Border>
                            <TextBlock Text="Preset" Style="{StaticResource Label}" Margin="0,14,0,8" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="RtPresetPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtPreset" Content="Normal" Tag="normal" ToolTip="2 amostras e 2 rebatidas por pixel" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtPreset" Content="Alta" Tag="alta" IsChecked="True" ToolTip="4 amostras e 3 rebatidas por pixel" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtPreset" Content="Extrema" Tag="extrema" ToolTip="8 amostras e 4 rebatidas por pixel" />
                                </WrapPanel>
                            </Border>
                            <TextBlock Text="Amostras e rebatidas por pixel: Normal 2 e 2, Alta 4 e 3, Extrema 8 e 4." Style="{StaticResource Footnote}" Margin="0,6,0,0" />
                            <TextBlock Text="Modo" Style="{StaticResource Label}" Margin="0,14,0,8" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="RtModePanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtMode" Content="Padrão" Tag="std" IsChecked="True" ToolTip="Aquece 20 s e mede 3 passadas de 30 s (cerca de 2 min). Use para comparar." />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RtMode" Content="Rápido" Tag="quick" ToolTip="Aquece 5 s e mede 3 passadas de 10 s (cerca de 35 s). Só para uma ideia rápida." />
                                </WrapPanel>
                            </Border>
                            <Button x:Name="BtnRtBench" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="BtnRtBench_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resultado" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <TextBlock x:Name="RtVerdict" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                            <ItemsControl x:Name="RtResult" ItemTemplate="{StaticResource KeyValueRow}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Histórico" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="RtHistory" ItemTemplate="{StaticResource Meter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Simulação de jogo (CPU) ============ -->
        <Grid x:Name="BenchPanelSim" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14,14,14,16" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource StageBorder}" Padding="0,16">
                        <Grid>
                            <Image x:Name="SimImage" Width="440" Height="440" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SimIdle" Text="30 mil unidades em batalha" Foreground="#5E6E7A" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid Style="{StaticResource ProgressTrack}" Margin="2,14,2,10">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="SimProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Margin="2,0">
                        <TextBlock x:Name="SimStatus" Text="Pronto" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="SimFpsNow" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" Text="Simula o trabalho de CPU de um jogo: a thread principal monta a grade espacial, roda a lógica e prepara o desenho; as outras calculam física, colisão e IA de 30 mil unidades. A nota é quantos frames por segundo o processador aguenta." />
                            <TextBlock Text="Duração" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="SimDurPanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="SimDur" Content="20 s" Tag="20" IsChecked="True" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="SimDur" Content="60 s" Tag="60" />
                                </WrapPanel>
                            </Border>
                            <Button x:Name="BtnSimBench" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="BtnSimBench_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resultado" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="SimResult" ItemTemplate="{StaticResource KeyValueRow}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Histórico" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="SimHistory" ItemTemplate="{StaticResource Meter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Memória e carregamento ============ -->
        <Grid x:Name="BenchPanelMem" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="26,20">
                <StackPanel>
                    <TextBlock Text="Resultados" Style="{StaticResource SectionTitle}" />
                    <ItemsControl x:Name="MemResult" ItemTemplate="{StaticResource ResultRow}" Margin="0,4,0,0" />
                    <Grid Style="{StaticResource ProgressTrack}" Margin="0,18,0,10">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="MemProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="MemStatus" Text="Pronto" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16" Text="Mede a latência e a banda da RAM e simula o carregamento de um mapa: um pacote de 512 MB e mil arquivos de 64 KB, lidos do disco sem o cache do Windows. Os arquivos de teste ficam na pasta temporária e são apagados no final." />
                            <Button x:Name="BtnMemBench" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar" HorizontalAlignment="Stretch" Click="BtnMemBench_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Histórico" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="MemHistory" ItemTemplate="{StaticResource Meter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Disco ============ -->
        <Grid x:Name="BenchPanelDisk" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="26,20">
                <StackPanel>
                    <TextBlock Text="Resultados" Style="{StaticResource SectionTitle}" />
                    <ItemsControl x:Name="DiskResult" ItemTemplate="{StaticResource ResultRow}" Margin="0,4,0,0" />
                    <Grid Style="{StaticResource ProgressTrack}" Margin="0,18,0,10">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DiskProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="DiskStatus" Text="Pronto" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Unidade" Style="{StaticResource Label}" />
                            <WrapPanel x:Name="DiskDrivePanel" />
                            <TextBlock Text="Tamanho do teste" Style="{StaticResource Label}" Margin="0,8,0,8" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="DiskSizePanel">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DiskSize" Content="512 MB" Tag="512" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DiskSize" Content="1 GB" Tag="1024" IsChecked="True" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DiskSize" Content="4 GB" Tag="4096" />
                                </WrapPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,16" Text="Mede leitura e escrita sequenciais e acessos aleatórios de 4 KB direto no disco, sem o cache do Windows. Grava um arquivo temporário na unidade escolhida e o apaga no final. Feche outros programas pesados antes." />
                            <Button x:Name="BtnDiskBench" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar" HorizontalAlignment="Stretch" Click="BtnDiskBench_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Histórico" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="DiskHistory" ItemTemplate="{StaticResource Meter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
