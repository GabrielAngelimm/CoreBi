<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.BenchmarksView" xmlns:local="clr-namespace:CoreBi.Desktop"
             SizeChanged="View_SizeChanged">
    <!--
        Bancada de teste (a mesma composição do Teste de carga): as teclas do teste numa faixa em cima; embaixo, à esquerda, o
        palco e, à direita, numa coluna de 360 px, as configurações do teste (seções espalhadas na altura, o botão no pé) e o histórico, de altura fixa. O palco tem a placa (o que
        está sendo medido, as leituras ao vivo e o estado do teste), a barra de progresso no lugar do fio, a régua do resultado
        logo abaixo, com a nota no maior número da tela, e embaixo o visual do teste (a imagem ou o traço do FPS). O palco nunca
        abre vazio: a página mostra o último resultado de cada teste, a cena ou a formação do teste esmaecida com uma legenda, e a
        última passada guardada do FPS. Cabe numa tela com a janela maximizada; em janelas menores a página rola.
    -->
    <UserControl.Resources>
        <Style x:Key="StageCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- Placa da peça: em cima 21, porque o nome em DIN 24 deixa uns 4 px acima das maiúsculas (a letra fica a 24 da borda, como à esquerda) -->
        <Style x:Key="Plate" TargetType="Grid">
            <Setter Property="Margin" Value="24,21,24,24" />
        </Style>
        <Style x:Key="PlateSpec" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <!--
            Placa alinhada pelo topo: o nome da peça, as leituras e o estado começam na mesma linha, e uma terceira linha à esquerda
            (a leitura da placa de vídeo) não empurra o resto. O estado usa o bloco de 30 do nome (TestPlateTitle): mesma família,
            mesma altura em bloco, mesma linha de base; o detalhe embaixo dele fica na linha da especificação (os dois são Caption
            com 3 de margem depois de um bloco de 30).
        -->
        <Style x:Key="PlateState" TargetType="StackPanel">
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="PlateStatus" TargetType="TextBlock" BasedOn="{StaticResource TestStatus}">
            <Setter Property="LineHeight" Value="30" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <!-- LED do estado: aceso no sinal só enquanto um teste roda (as teclas dos testes ficam travadas durante o teste) -->
        <Style x:Key="RunLed" TargetType="Ellipse" BasedOn="{StaticResource TestStatusLed}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, ElementName=BenchTestPanel}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            Leitura ao vivo na placa: some quando não há leitura (Tag recebe o texto do número). 3 de cima: o alto das maiúsculas
            do rótulo (12,5, cerca de 2 px abaixo do topo da caixa) cai na mesma linha do alto do nome da peça (24 num bloco de 30,
            cerca de 5 px), medido nas capturas.
        -->
        <Style x:Key="PlateLive" TargetType="StackPanel" BasedOn="{StaticResource TestLiveCell}">
            <Setter Property="Margin" Value="0,3,32,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="—">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Régua do resultado, logo abaixo da placa; o fio de baixo a separa do visual do teste -->
        <Style x:Key="Ruler" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="Cell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="CellSub" TargetType="TextBlock" BasedOn="{StaticResource StatSub}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <!--
            Legenda do palco parado: uma pílula no pé da imagem esmaecida (a cena ou a formação do teste), fora do Viewbox para
            não escalar com a imagem. Some quando o teste começa.
        -->
        <Style x:Key="StageNote" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="24,0,24,20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="StageNoteText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!-- Imagem do palco parado: a prévia esmaecida, para não passar por resultado -->
        <Style x:Key="StagePreview" TargetType="Image">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <ItemsPanelTemplate x:Key="RulerPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <!-- Célula da régua do resultado (BenchStat): a primeira é a nota do teste, no número maior, e não tem fio à esquerda;
             a unidade some junto com o travessão; a linha de contexto reserva a altura -->
        <DataTemplate x:Key="StatCell">
            <Border x:Name="cell" Style="{StaticResource Cell}" ToolTip="{Binding Tip}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource TestCellValue}" />
                        <TextBlock x:Name="unit" Text="{Binding Unit}" Style="{StaticResource TestCellUnit}" />
                    </StackPanel>
                    <!-- O LED vai dentro da linha de contexto: o pé dele na linha de base, o centro (3 px acima) no meio da altura-x da Segoe 11,5 -->
                    <TextBlock x:Name="sub" Style="{StaticResource StatSub}" Margin="0,3,0,0">
                        <InlineUIContainer><Ellipse x:Name="led" Style="{StaticResource StatusLed}" Width="6" Height="6" Margin="0,0,6,0" Visibility="Collapsed" /></InlineUIContainer><Run Text="{Binding Sub, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                    <Setter TargetName="cell" Property="BorderThickness" Value="0" />
                    <Setter TargetName="value" Property="Style" Value="{StaticResource TestResult}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Unit}" Value="">
                    <Setter TargetName="unit" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="—">
                    <Setter TargetName="unit" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Ok">
                    <Setter TargetName="led" Property="Visibility" Value="Visible" />
                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Ok}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter TargetName="led" Property="Visibility" Value="Visible" />
                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Warn}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            Leitura ao vivo na placa (BenchStat): rótulo em cima e número embaixo, lado a lado; o código só põe as que o sensor dá.
            Número e unidade são Runs do mesmo TextBlock, então dividem a linha de base; o espaço vai no tamanho do número (5 px).
        -->
        <DataTemplate x:Key="LiveCell">
            <StackPanel Style="{StaticResource PlateLive}" Background="Transparent" ToolTip="{Binding Tip}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" />
                <TextBlock Style="{StaticResource TestLiveValue}"><Run Text="{Binding Value, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" FontFamily="{StaticResource LabelFont}" FontStretch="Normal" FontSize="13" Foreground="{DynamicResource Muted}" /></TextBlock>
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="LivePanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!--
            Medição de memória e disco (MemRow): as linhas dividem a altura do palco (UniformGrid), com o fio entre elas. À
            esquerda o nome (DIN 14) e, embaixo, o que a medida quer dizer em palavras simples; à direita o número (mostrador 30)
            com a unidade numa coluna fixa, para os números ficarem alinhados, e o contexto da medição embaixo.
        -->
        <DataTemplate x:Key="MeasureRow">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="Transparent">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,32,0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource ItemTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource TestCellValue}" />
                            <TextBlock x:Name="unit" Text="{Binding Unit}" Tag="{Binding Value}" Style="{StaticResource TestCellUnit}" Width="52" />
                        </StackPanel>
                        <TextBlock x:Name="sub" Text="{Binding Sub}" Style="{StaticResource StatSub}" HorizontalAlignment="Right" Margin="0,-4,0,0"
                                   Visibility="{Binding Sub, Converter={StaticResource NotEmptyVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="MeasurePanel">
            <UniformGrid Columns="1" />
        </ItemsPanelTemplate>

        <!-- Histórico (BenchHistoryRow): resultado, detalhe e data; o medidor segmentado na cor do componente compara com o
             melhor resultado comparável (Ui.Channel da lista escolhe a cor) -->
        <Style x:Key="HistoryBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Steel}" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(local:Ui.Channel), RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Cpu">
                    <Setter Property="Background" Value="{DynamicResource Cpu}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(local:Ui.Channel), RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Gpu">
                    <Setter Property="Background" Value="{DynamicResource Gpu}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(local:Ui.Channel), RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Memory">
                    <Setter Property="Background" Value="{DynamicResource Memory}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(local:Ui.Channel), RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Storage">
                    <Setter Property="Background" Value="{DynamicResource Storage}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            Linha do histórico: o resultado (mostrador 17) e o detalhe são Runs de um TextBlock só, e a data é outro TextBlock com a
            mesma fonte de base (Segoe Small 11,5) e o mesmo bloco de 22, alinhados pelo topo. A base de um bloco vem da fonte do
            próprio TextBlock, então as duas caixas têm a base no mesmo y e o resultado assenta nela (antes, 1 px de diferença).
        -->
        <Style x:Key="HistoryLine" TargetType="TextBlock" BasedOn="{StaticResource StatSub}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <DataTemplate x:Key="HistoryRow">
            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource HistoryLine}" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" ToolTip="{Binding Detail}"><Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="17" Foreground="{DynamicResource Fg}" /><Run Text="  " FontSize="17" /><Run Text="{Binding Detail, Mode=OneWay}" /></TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource HistoryLine}" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,7,0,0" OpacityMask="{StaticResource SegmentMask}">
                    <Border Background="{DynamicResource Line}" />
                    <Border Style="{StaticResource HistoryBar}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
        <Style x:Key="HistoryList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource HistoryRow}" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ItemsControl">
                                <TextBlock Text="Nenhum resultado ainda." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="BenchScroll" VerticalScrollBarVisibility="Auto">
        <!-- Altura da janela (e não mínima): assim a lista longa rola dentro do painel; abaixo de 780 px a página rola -->
        <Grid Height="{Binding ViewportHeight, ElementName=BenchScroll}" MinHeight="780">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" MinHeight="560" />
                </Grid.RowDefinitions>
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Benchmark" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Mede o desempenho de cada peça com o mesmo teste em qualquer PC." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                </local:PageHeaderPanel>

                <!-- Escolha do teste: uma tecla por teste, agrupadas pelo componente que medem -->
                <UniformGrid x:Name="BenchTestPanel" Grid.Row="1" Rows="1" Margin="-8">
                    <RadioButton Style="{StaticResource TestTab}" Margin="8" GroupName="BenchTest" Content="Render 3D" local:Ui.Icon="cpu" local:Ui.Channel="Cpu" local:Ui.Caption="Processador" Tag="render" IsChecked="True" Checked="BenchTest_Checked"
                                 ToolTip="Uma cena 3D renderizada por path tracing no processador, bloco a bloco, em todos os núcleos e em um núcleo só." />
                    <RadioButton Style="{StaticResource TestTab}" Margin="8" GroupName="BenchTest" Content="Simulação de jogo" local:Ui.Icon="cpu" local:Ui.Channel="Cpu" local:Ui.Caption="Processador" Tag="sim" Checked="BenchTest_Checked"
                                 ToolTip="Lógica, física, colisão e IA de 30 mil unidades. A nota é quantos quadros por segundo o processador aguenta." />
                    <RadioButton Style="{StaticResource TestTab}" Margin="8" GroupName="BenchTest" Content="Cena de jogo" local:Ui.Icon="gpu" local:Ui.Channel="Gpu" local:Ui.Caption="Placa de vídeo" Tag="gpu" Checked="BenchTest_Checked"
                                 ToolTip="Sobrevoo de um vale em Direct3D 11 (terreno, 40 mil árvores, sombras, água e HDR), com trajeto e resolução fixos: o trabalho é o mesmo em qualquer PC." />
                    <RadioButton Style="{StaticResource TestTab}" Margin="8" GroupName="BenchTest" Content="Ray tracing" local:Ui.Icon="gpu" local:Ui.Channel="Gpu" local:Ui.Caption="Placa de vídeo" Tag="rt" Checked="BenchTest_Checked"
                                 ToolTip="Ray tracing por hardware (DXR 1.1, Direct3D 12) nos núcleos de RT da placa: aquecimento e 3 passadas, com a nota pela mediana." />
                    <RadioButton Style="{StaticResource TestTab}" Margin="8" GroupName="BenchTest" Content="Memória" local:Ui.Icon="ram" local:Ui.Channel="Memory" local:Ui.Caption="RAM e carregamento" Tag="mem" Checked="BenchTest_Checked"
                                 ToolTip="Latência e banda da memória RAM e o tempo para carregar um mapa de jogo do disco." />
                    <RadioButton Style="{StaticResource TestTab}" Margin="8" GroupName="BenchTest" Content="Disco" local:Ui.Icon="storage" local:Ui.Channel="Storage" local:Ui.Caption="Armazenamento" Tag="disk" Checked="BenchTest_Checked"
                                 ToolTip="Leitura e escrita sequenciais e aleatórias de 4 KB, direto no disco, sem o cache do Windows." />
                </UniformGrid>

                <!-- ============ Render 3D (processador) ============ -->
                <Grid x:Name="BenchPanelRender" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StageCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource Plate}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock x:Name="BenchDevice" Text="Processador" Style="{StaticResource TestPlateTitle}" />
                                    <TextBlock x:Name="BenchDeviceSpec" Style="{StaticResource PlateSpec}" />
                                </StackPanel>
                                <ItemsControl x:Name="BenchLive" Grid.Column="1" ItemTemplate="{StaticResource LiveCell}" ItemsPanel="{StaticResource LivePanel}" VerticalAlignment="Top" Margin="24,0,0,0" Focusable="False" />
                                <StackPanel Grid.Column="2" Style="{StaticResource PlateState}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource PlateStatus}"><InlineUIContainer><Ellipse Style="{StaticResource RunLed}" /></InlineUIContainer></TextBlock>
                                        <TextBlock x:Name="BenchStatus" Style="{StaticResource PlateStatus}" />
                                    </StackPanel>
                                    <TextBlock x:Name="BenchElapsed" Style="{StaticResource TestDetail}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Style="{StaticResource ProgressTrack}">
                                <Border Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BenchProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource Ruler}">
                                <UniformGrid Rows="1">
                                    <Border Style="{StaticResource Cell}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="Multi-core" Style="{StaticResource StatLabel}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock x:Name="BenchMt" Text="—" Style="{StaticResource TestResult}" />
                                                <TextBlock Text="pts" Style="{StaticResource TestCellUnit}" Tag="{Binding Text, ElementName=BenchMt}" />
                                            </StackPanel>
                                            <TextBlock x:Name="BenchMtVs" Style="{StaticResource CellSub}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Cell}">
                                        <StackPanel>
                                            <TextBlock Text="Single-core" Style="{StaticResource StatLabel}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock x:Name="BenchSt" Text="—" Style="{StaticResource TestResult}" />
                                                <TextBlock Text="pts" Style="{StaticResource TestCellUnit}" Tag="{Binding Text, ElementName=BenchSt}" />
                                            </StackPanel>
                                            <TextBlock x:Name="BenchStVs" Style="{StaticResource CellSub}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Cell}" ToolTip="Multi-core dividido pelo single-core: quantas vezes todos os núcleos juntos rendem mais que um só. Aparece quando o teste roda os dois.">
                                        <StackPanel>
                                            <TextBlock Text="Ganho com todos os núcleos" Style="{StaticResource StatLabel}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock x:Name="BenchRatio" Text="—" Style="{StaticResource TestCellValue}" />
                                                <TextBlock Text="×" Style="{StaticResource TestCellUnit}" Tag="{Binding Text, ElementName=BenchRatio}" />
                                            </StackPanel>
                                            <TextBlock x:Name="BenchRatioSub" Style="{StaticResource CellSub}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Border>
                            <!-- O poço ocupa o palco no recuo do painel; a imagem 16:9 fica centrada nele, na proporção -->
                            <local:FillBox Grid.Row="3" Margin="{StaticResource PanelPadding}" MinHeight="200">
                                <Border Style="{StaticResource TestStage}" Tag="{Binding ElementName=BenchIdle}">
                                    <Grid>
                                        <Viewbox Stretch="Uniform">
                                            <Grid Width="960" Height="540">
                                                <!-- A cena do teste, renderizada uma vez pelo próprio Render 3D (Assets/bench-scene.jpg) -->
                                                <Image x:Name="BenchPreview" Width="960" Height="540" Source="/CoreBi.Desktop;component/Assets/bench-scene.jpg" Style="{StaticResource StagePreview}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Image x:Name="BenchImage" Width="960" Height="540" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Canvas x:Name="BenchBuckets" Width="960" Height="540" />
                                            </Grid>
                                        </Viewbox>
                                        <Border x:Name="BenchIdle" Style="{StaticResource StageNote}">
                                            <TextBlock Text="A cena do teste, redesenhada bloco a bloco durante a medição." Style="{StaticResource StageNoteText}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </local:FillBox>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource ConfigCard}" x:Name="BenchConfigCard" local:Skeleton.Layout="row 34: h 190; foot 42: btn *^42; footgap 24; gap 12; bands 2; row 17: c 70; gap 10; row 42: pill *^42; endbands">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                    <TextBlock Text="Configurações do benchmark" Style="{StaticResource CardTitle}" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock x:Name="BenchHint" Style="{StaticResource ConfigHint}" />
                                    <Button x:Name="BtnBench" Style="{StaticResource ConfigStart}" local:Ui.Icon="&#xE768;" Content="Iniciar teste" Click="BtnBench_Click" />
                                </StackPanel>
                                <local:ConfigStack MinGap="24" MaxGap="32" Margin="0,16,0,24">
                                    <StackPanel x:Name="BenchOptions" Style="{StaticResource ConfigSection}">
                                        <TextBlock Text="Núcleos" Style="{StaticResource ConfigName}" ToolTip="Multi-core usa todos os núcleos ao mesmo tempo; single-core, um só. Os dois mede um depois do outro." />
                                        <Border Style="{StaticResource ConfigSegmentGroup}">
                                            <local:SlidingSelectionPanel x:Name="BenchModePanel" Style="{StaticResource ConfigSegmentRail}">
                                            <RadioButton Style="{StaticResource ConfigSegment}" GroupName="BenchMode" Content="Multi-core" Tag="mt" ToolTip="Todos os núcleos juntos" />
                                            <RadioButton Style="{StaticResource ConfigSegment}" GroupName="BenchMode" Content="Single-core" Tag="st" ToolTip="Um núcleo só" />
                                            <RadioButton Style="{StaticResource ConfigSegment}" GroupName="BenchMode" Content="Os dois" Tag="both" IsChecked="True" ToolTip="Todos os núcleos e depois um só" />
                                            </local:SlidingSelectionPanel>
                                        </Border>
