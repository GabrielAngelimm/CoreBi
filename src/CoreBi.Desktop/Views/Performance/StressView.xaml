<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.StressView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <!--
        Bancada de teste (a mesma composição do Benchmark): os componentes a carregar numa faixa em cima; embaixo, à esquerda, o
        palco e, à direita, numa coluna de 330 px, a configuração com a ação principal e o registro. O palco tem a placa (estado e
        tempo), a barra de progresso no lugar do fio, uma coluna de leituras ao vivo por componente escolhido e a temperatura dos
        últimos 5 minutos com os limites. Cabe numa tela com a janela maximizada; em janelas menores a página rola.
    -->
    <UserControl.Resources>
        <Style x:Key="StageCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="PlateSpec" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <!-- Coluna de um componente: fio à esquerda (o código tira o da primeira visível) -->
        <Style x:Key="ComponentColumn" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="24,18,24,16" />
        </Style>
        <Style x:Key="ComponentName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,2,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeroLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="HeroUnit" TargetType="TextBlock" BasedOn="{StaticResource Unit}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="6,0,0,10" />
        </Style>
        <!-- Leitura secundária: rótulo à esquerda e valor à direita; a linha some quando o sensor não dá a leitura -->
        <Style x:Key="LiveRow" TargetType="Grid">
            <Setter Property="Height" Value="26" />
        </Style>
        <Style x:Key="LiveRowLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LiveRowValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="ConfigLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="LimitRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="StressScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=StressScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" MinHeight="620" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource PageHeader}">
                    <TextBlock Text="Teste de carga" Style="{StaticResource PageTitle}" />
                </Grid>

                <!-- O que carregar: uma tecla por componente, várias ao mesmo tempo -->
                <UniformGrid Grid.Row="1" Rows="1" Margin="-5,0">
                    <CheckBox x:Name="ChkCpu" Style="{StaticResource TestToggle}" Margin="5,0" Content="Processador" local:Ui.Icon="cpu" local:Ui.Channel="Cpu" local:Ui.Caption="Todos os núcleos" IsChecked="True"
                              Checked="ChkCpu_Click" Unchecked="ChkCpu_Click" />
                    <CheckBox x:Name="ChkRam" Style="{StaticResource TestToggle}" Margin="5,0" Content="Memória RAM" local:Ui.Icon="ram" local:Ui.Channel="Memory" local:Ui.Caption="Procura erros de memória"
                              Checked="ChkRam_Click" Unchecked="ChkRam_Click" />
                    <CheckBox x:Name="ChkGpu" Style="{StaticResource TestToggle}" Margin="5,0" Content="Placa de vídeo" local:Ui.Icon="gpu" local:Ui.Channel="Gpu" local:Ui.Caption="Abre uma janela 3D"
                              Checked="ChkGpu_Click" Unchecked="ChkGpu_Click" />
                </UniformGrid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <!-- Palco -->
                    <Border Style="{StaticResource StageCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Placa: estado do teste (LED no sinal rodando, vermelho no corte) e o tempo decorrido -->
                            <Grid Margin="24,18,24,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StLed" Style="{StaticResource StatusLed}" Width="8" Height="8" Margin="0,2,10,0" />
                                        <TextBlock x:Name="StStatus" Text="Pronto" Style="{StaticResource TestPlateTitle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="StDetail" Style="{StaticResource PlateSpec}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tempo" Style="{StaticResource StatLabel}" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="StElapsed" Text="00:00:00" Style="{StaticResource TestCellValue}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Style="{StaticResource ProgressTrack}">
                                <Border Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="StProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <!-- Leituras ao vivo dos componentes escolhidos -->
                            <UniformGrid Grid.Row="2" Rows="1">
                                <Border x:Name="CpuColumn" Style="{StaticResource ComponentColumn}" BorderThickness="0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Cpu" Kind="cpu" Width="26" Height="26" />
                                            <TextBlock Text="Processador" Style="{StaticResource ComponentName}" />
                                        </StackPanel>
                                        <TextBlock Text="Temperatura" Style="{StaticResource HeroLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="StTemp" Text="—" Style="{StaticResource TestHero}" />
                                            <TextBlock Text="°C" Style="{StaticResource HeroUnit}" />
                                        </StackPanel>
                                        <Grid Style="{StaticResource LiveRow}" Margin="0,8,0,0" Visibility="{Binding Text, ElementName=StTempMax, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Máxima no teste" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StTempMax" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StClock, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Clock médio" Style="{StaticResource LiveRowLabel}" ToolTip="Média dos núcleos" />
                                            <TextBlock x:Name="StClock" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StPower, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Consumo" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StPower" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StLoad, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Carga" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StLoad" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RamColumn" Style="{StaticResource ComponentColumn}" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Memory" Kind="ram" Width="26" Height="26" />
                                            <TextBlock Text="Memória RAM" Style="{StaticResource ComponentName}" />
                                        </StackPanel>
                                        <TextBlock Text="Erros" Style="{StaticResource HeroLabel}" ToolTip="O teste grava padrões na memória e confere a leitura; um erro só já interrompe o teste." />
                                        <TextBlock x:Name="StRamErrors" Text="—" Style="{StaticResource TestHero}" />
                                        <Grid Style="{StaticResource LiveRow}" Margin="0,8,0,0" Visibility="{Binding Text, ElementName=StRam, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Passadas" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StRam" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StRamSize, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Memória em teste" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StRamSize" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="GpuColumn" Style="{StaticResource ComponentColumn}" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Gpu" Kind="gpu" Width="26" Height="26" />
                                            <TextBlock Text="Placa de vídeo" Style="{StaticResource ComponentName}" />
                                        </StackPanel>
                                        <TextBlock Text="Temperatura" Style="{StaticResource HeroLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="StGpuTemp" Text="—" Style="{StaticResource TestHero}" />
                                            <TextBlock Text="°C" Style="{StaticResource HeroUnit}" />
                                        </StackPanel>
                                        <Grid Style="{StaticResource LiveRow}" Margin="0,8,0,0" Visibility="{Binding Text, ElementName=StGpuTempMax, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Máxima no teste" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StGpuTempMax" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StGpuPower, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Consumo" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StGpuPower" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StFps, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="FPS" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StFps" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StFpsAvg, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="FPS médio" Style="{StaticResource LiveRowLabel}" />
                                            <TextBlock x:Name="StFpsAvg" Style="{StaticResource LiveRowValue}" />
                                        </Grid>
                                        <Grid Style="{StaticResource LiveRow}" Visibility="{Binding Text, ElementName=StGpuCap, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock Text="Limitador" Style="{StaticResource LiveRowLabel}" ToolTip="O que o driver diz que está segurando o clock agora (energia, temperatura, tensão)." />
                                            <TextBlock x:Name="StGpuCap" Style="{StaticResource LiveRowValue}" FontSize="14" FontFamily="{StaticResource UiFont}" FontStretch="Normal" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Temperatura dos últimos 5 minutos, com os nomes e os limites rotulados no próprio gráfico -->
                            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,16,24,14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Temperatura" Style="{StaticResource Label}" Margin="0,0,0,10" />
                                    <Canvas x:Name="TempChart" MinHeight="160" ClipToBounds="True" SizeChanged="TempChart_SizeChanged" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Configuração e registro -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" MinHeight="140" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Duração" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <local:SlidingSelectionPanel x:Name="StressDurationPanel" Style="{StaticResource SegmentRail}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="StressDur" Content="10 min" Tag="10" IsChecked="True" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="StressDur" Content="30 min" Tag="30" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="StressDur" Content="1 h" Tag="60" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="StressDur" Content="Sem limite" Tag="0" ToolTip="Roda até você parar." />
                                    </local:SlidingSelectionPanel>
                                </Border>
                                <TextBlock Text="Corte por temperatura" Style="{StaticResource ConfigLabel}" ToolTip="O teste para sozinho quando um componente chega ao limite." />
                                <Grid Style="{StaticResource LimitRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Processador" VerticalAlignment="Center" />
                                    <TextBox x:Name="TempLimit" Grid.Column="1" Text="90" local:Ui.Suffix="°C" />
                                </Grid>
                                <Grid Style="{StaticResource LimitRow}" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Placa de vídeo" VerticalAlignment="Center" />
                                    <TextBox x:Name="GpuTempLimit" Grid.Column="1" Text="85" local:Ui.Suffix="°C" IsEnabled="False" />
                                </Grid>
                                <TextBlock Text="RAM livre em teste" Style="{StaticResource ConfigLabel}" />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <local:SlidingSelectionPanel x:Name="RamFractionPanel" IsEnabled="False" Style="{StaticResource SegmentRail}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Ram" Content="40 %" Tag="0.4" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Ram" Content="60 %" Tag="0.6" IsChecked="True" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Ram" Content="80 %" Tag="0.8" />
                                    </local:SlidingSelectionPanel>
                                </Border>
                                <StackPanel x:Name="GpuOptions" IsEnabled="False">
                                    <TextBlock Text="Janela da placa de vídeo" Style="{StaticResource ConfigLabel}" />
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <local:SlidingSelectionPanel x:Name="GpuResPanel" Style="{StaticResource SegmentRail}">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="720p" Tag="1280x720" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="1080p" Tag="1920x1080" IsChecked="True" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="1440p" Tag="2560x1440" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="Tela cheia" Tag="full" />
                                        </local:SlidingSelectionPanel>
                                    </Border>
                                    <TextBlock Text="Anti-aliasing" Style="{StaticResource ConfigLabel}" />
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <local:SlidingSelectionPanel x:Name="GpuMsaaPanel" Style="{StaticResource SegmentRail}">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuMsaa" Content="Desligado" Tag="1" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuMsaa" Content="4x MSAA" Tag="4" IsChecked="True" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuMsaa" Content="8x MSAA" Tag="8" />
                                        </local:SlidingSelectionPanel>
                                    </Border>
                                    <TextBlock Text="Intensidade" Style="{StaticResource ConfigLabel}" />
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <local:SlidingSelectionPanel x:Name="GpuIntensityPanel" Style="{StaticResource SegmentRail}">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuInt" Content="Normal" Tag="96,32" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuInt" Content="Alta" Tag="128,48" IsChecked="True" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GpuInt" Content="Extrema" Tag="160,64" />
                                        </local:SlidingSelectionPanel>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="BtnStress" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,20,0,0" HorizontalAlignment="Stretch" local:Ui.Icon="&#xE768;" Content="Iniciar teste" Click="BtnStress_Click" />
                                <TextBlock x:Name="StressHint" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}" Margin="0,10,0,0" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="24,20,8,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Registro" Style="{StaticResource SectionTitle}" Margin="0,0,16,12" />
                                <ListBox x:Name="StressLog" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Faint}" ItemContainerStyle="{StaticResource PlainItem}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,16,4" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
