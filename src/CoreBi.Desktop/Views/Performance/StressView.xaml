<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.StressView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Coluna de leitura ao vivo: separada da vizinha por um fio, como mostradores lado a lado -->
        <Style x:Key="ReadingCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="18,2,12,2" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}">
                <StackPanel>
                    <TextBlock Text="Teste de carga" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Carga máxima no processador, na memória e na placa de vídeo, com corte automático por temperatura." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </Grid>

            <!-- Configuração: o que carregar (esquerda) e os limites de segurança com a ação (direita) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Componentes" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <UniformGrid Rows="1" Margin="0,0,-10,0">
                            <CheckBox x:Name="ChkCpu" Style="{StaticResource ToggleCard}" Content="Processador" local:Ui.Icon="cpu" local:Ui.Channel="Cpu" local:Ui.Caption="Todos os núcleos" IsChecked="True" Margin="0,0,10,0" />
                            <CheckBox x:Name="ChkRam" Style="{StaticResource ToggleCard}" Content="Memória RAM" local:Ui.Icon="ram" local:Ui.Channel="Memory" local:Ui.Caption="Verifica erros" Checked="ChkRam_Click" Unchecked="ChkRam_Click" Margin="0,0,10,0" />
                            <CheckBox x:Name="ChkGpu" Style="{StaticResource ToggleCard}" Content="Placa de vídeo" local:Ui.Icon="gpu" local:Ui.Channel="Gpu" local:Ui.Caption="Janela 3D própria" Checked="ChkGpu_Click" Unchecked="ChkGpu_Click" Margin="0,0,10,0" />
                        </UniformGrid>
                        <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,28,12">
                                <TextBlock Text="Uso da RAM livre" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <local:SlidingSelectionPanel x:Name="RamFractionPanel" IsEnabled="False" Style="{StaticResource SegmentRail}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Ram" Content="40%" Tag="0.4" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Ram" Content="60%" Tag="0.6" IsChecked="True" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Ram" Content="80%" Tag="0.8" />
                                    </local:SlidingSelectionPanel>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel x:Name="GpuOptions" IsEnabled="False">
                            <StackPanel Margin="0,0,28,12">
                                <TextBlock Text="Placa de vídeo: resolução" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <local:SlidingSelectionPanel x:Name="GpuResPanel" Style="{StaticResource SegmentRail}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="720p" Tag="1280x720" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="1080p" Tag="1920x1080" IsChecked="True" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="1440p" Tag="2560x1440" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuRes" Content="Tela cheia" Tag="full" />
                                    </local:SlidingSelectionPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,12">
                                <TextBlock Text="Anti-aliasing" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <local:SlidingSelectionPanel x:Name="GpuMsaaPanel" Style="{StaticResource SegmentRail}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuMsaa" Content="Desligado" Tag="1" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuMsaa" Content="4x MSAA" Tag="4" IsChecked="True" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuMsaa" Content="8x MSAA" Tag="8" />
                                    </local:SlidingSelectionPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,12">
                                <TextBlock Text="Intensidade" Style="{StaticResource Label}" />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <local:SlidingSelectionPanel x:Name="GpuIntensityPanel" Style="{StaticResource SegmentRail}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuInt" Content="Normal" Tag="96,32" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuInt" Content="Alta" Tag="128,48" IsChecked="True" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="GpuInt" Content="Extrema" Tag="160,64" />
                                    </local:SlidingSelectionPanel>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Limites de segurança" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="O teste para sozinho quando um limite é atingido." Style="{StaticResource Caption}" Margin="0,3,0,14" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="108" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Corte do processador" VerticalAlignment="Center" />
                            <TextBox x:Name="TempLimit" Grid.Column="1" Text="90" local:Ui.Suffix="°C" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="108" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Corte da placa de vídeo" VerticalAlignment="Center" />
                            <TextBox x:Name="GpuTempLimit" Grid.Column="1" Text="85" local:Ui.Suffix="°C" IsEnabled="False" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="108" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Duração" />
                                <TextBlock Text="0 roda até você parar" Style="{StaticResource Footnote}" />
                            </StackPanel>
                            <TextBox x:Name="TxtDuration" Grid.Column="1" Text="10" local:Ui.Suffix="min" />
                        </Grid>
                        <Button x:Name="BtnStress" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar teste" HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="BtnStress_Click" />
                        <TextBlock x:Name="StressHint" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}" Margin="0,10,0,0" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Painel ao vivo: estado + mostradores por canal -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusCard" Style="{StaticResource CardBorder}" Padding="22,18">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StStatusLabel" Text="Estado" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="StStatus" Text="Parado" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StElapsed" Text="00:00:00" Style="{StaticResource ReadoutText}" FontSize="18" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="4,18,10,18">
                    <UniformGrid Rows="1">
                        <Border Style="{StaticResource ReadingCell}" BorderThickness="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Swatch}" Background="{DynamicResource Cpu}" />
                                    <TextBlock Text="Temp. CPU" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="StTemp" Text="—" Style="{StaticResource StatValue}" />
                                <TextBlock x:Name="StTempMax" Text="máx. —" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReadingCell}">
                            <StackPanel>
                                <TextBlock Text="Consumo CPU" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="StPower" Text="—" Style="{StaticResource StatValue}" />
                                <TextBlock x:Name="StLoad" Text="carga —" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReadingCell}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Swatch}" Background="{DynamicResource Gpu}" />
                                    <TextBlock Text="Temp. GPU" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="StGpuTemp" Text="—" Style="{StaticResource StatValue}" />
                                <TextBlock x:Name="StGpuTempMax" Text="máx. —" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReadingCell}">
                            <StackPanel>
                                <TextBlock Text="Consumo GPU" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="StGpuPower" Text="—" Style="{StaticResource StatValue}" />
                                <TextBlock x:Name="StGpuCap" Text="—" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReadingCell}">
                            <StackPanel>
                                <TextBlock Text="FPS da GPU" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="StFps" Text="—" Style="{StaticResource StatValue}" />
                                <TextBlock x:Name="StFpsAvg" Text="média —" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReadingCell}">
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="StRam" Text="—" Style="{StaticResource StatValue}" />
                                <TextBlock Text="passadas / erros" Style="{StaticResource StatSub}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="22,18,22,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Temperatura nos últimos 5 minutos" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource Swatch}" Background="{DynamicResource Cpu}" />
                            <TextBlock Text="Processador" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                            <Border Style="{StaticResource Swatch}" Background="{DynamicResource Gpu}" />
                            <TextBlock Text="Placa de vídeo" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                            <Line X1="0" X2="16" Stroke="{DynamicResource Warn}" StrokeThickness="1.5" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Limites" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>
                    <Canvas x:Name="TempChart" Height="240" ClipToBounds="True" SizeChanged="TempChart_SizeChanged" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22,18,12,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Registro" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <ListBox x:Name="StressLog" Height="150" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" ItemContainerStyle="{StaticResource PlainItem}" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
