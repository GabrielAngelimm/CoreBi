<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.StressView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <!--
        Bancada de teste (a mesma composição do Benchmark): os componentes a carregar numa faixa em cima; embaixo, à esquerda, o
        palco e, à direita, numa coluna de 360 px, as configurações do teste e o histórico (de altura fixa). O palco tem a placa (o
        tempo decorrido de quanto, e o estado à direita), a barra de progresso no lugar do fio, as leituras ao vivo em três colunas
        fixas (processador, memória e placa de vídeo, sempre as três e sempre do mesmo tamanho; a que não entra no teste fica um
        tom abaixo) e a temperatura dos últimos 5 minutos, com a legenda e os cortes em cima. A configuração mostra só o que vale
        para os componentes marcados. O histórico guarda cada teste encerrado (como terminou, quanto durou e as máximas), e a
        página abre com ele. Cabe numa tela com a janela maximizada; em janelas menores a página rola.
    -->
    <UserControl.Resources>
        <Style x:Key="StageCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="PlateSpec" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <!--
            Coluna de um componente nas leituras ao vivo: sempre as três (processador, placa de vídeo e memória, a ordem das teclas),
            do mesmo tamanho, com fio entre elas. Em cima o ícone, o nome e, só na que não entra no teste, "Fora do teste"; embaixo, à esquerda, a leitura principal no mostrador grande e, à direita, quatro
            linhas fixas de rótulo e valor (travessão sem leitura), então nada muda de lugar com a escolha das peças. A que não
            entra no teste fica um tom abaixo.
        -->
        <Style x:Key="ComponentColumn" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="24,20,24,22" />
        </Style>
        <Style x:Key="ComponentName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="10,2,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ComponentState" TargetType="TextBlock" BasedOn="{StaticResource StatSub}">
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Mostrador principal da coluna: 48 em bloco de 56, a unidade (14) na mesma linha de base -->
        <Style x:Key="ColumnHero" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="48" />
            <Setter Property="LineHeight" Value="56" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="-2,2,0,0" />
        </Style>
        <Style x:Key="ColumnHeroUnit" TargetType="TextBlock" BasedOn="{StaticResource TestUnit}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="56" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="6,2,0,0" />
        </Style>
        <!-- Linhas fixas ao lado do mostrador: rótulo em legenda, valor em mostrador 16 à direita, 26 de altura cada -->
        <Style x:Key="FactName" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value="—"><Setter Property="Foreground" Value="{DynamicResource Faint}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Facts" TargetType="Grid">
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--
            Placa: o rótulo "Tempo decorrido" e o estado à direita dividem a primeira linha. Os dois são DIN no mesmo bloco de 17,
            alinhados pelo topo, então assentam na mesma linha de base; o detalhe fica embaixo do estado.
        -->
        <Style x:Key="PlateLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <Style x:Key="PlateStatus" TargetType="TextBlock" BasedOn="{StaticResource TestStatus}">
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <!--
            Linha do histórico (StressHistoryRow), em duas linhas curtas: o LED de como terminou (verde estável, âmbar parado,
            vermelho interrompido), o título em DIN 14 e a data à direita; embaixo, as máximas por sigla em legenda. O motivo e os
            números completos ficam na dica. Fio entre as linhas, nunca antes da primeira.
        -->
        <DataTemplate x:Key="StressHistoryRow">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,0,16,0" Background="Transparent" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="led" Style="{StaticResource StatusLed}" Width="8" Height="8" Fill="{DynamicResource Ok}" VerticalAlignment="Top" Margin="0,6,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Caption}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   Visibility="{Binding Facts, Converter={StaticResource NotEmptyVis}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource StatSub}" Margin="12,2,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                    <Setter TargetName="row" Property="Padding" Value="0,0,0,10" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger">
                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="StressHistoryList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource StressHistoryRow}" />
            <Setter Property="AlternationCount" Value="64" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ItemsControl">
                                <TextBlock Text="Nenhum teste ainda. Cada teste encerrado fica aqui, com como terminou e as temperaturas máximas." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="StressScroll" VerticalScrollBarVisibility="Auto">
        <!-- Altura da janela (e não mínima): assim a lista longa rola dentro do painel; abaixo de 780 px a página rola -->
        <Grid Height="{Binding ViewportHeight, ElementName=StressScroll}" MinHeight="780">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" MinHeight="620" />
                </Grid.RowDefinitions>
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Teste de carga" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Põe as peças no limite para conferir estabilidade e temperatura." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                    <!-- Depois de um teste, o painel guarda o tempo e as máximas até você zerar (o teste continua no histórico) -->
                    <StackPanel Style="{StaticResource PageActions}">
                        <Button x:Name="BtnStressReset" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE777;" Content="Zerar painel" Click="BtnStressReset_Click"
                                IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Volta o tempo, as máximas e o estado ao início, pronto para outro teste. O que terminou continua no histórico." />
                    </StackPanel>
                </local:PageHeaderPanel>

                <!-- O que carregar: uma tecla por componente, várias ao mesmo tempo -->
                <UniformGrid Grid.Row="1" Rows="1" Margin="-8">
                    <CheckBox x:Name="ChkCpu" Style="{StaticResource TestToggle}" Margin="8" Content="Processador" local:Ui.Icon="cpu" local:Ui.Channel="Cpu" local:Ui.Caption="Todos os núcleos" IsChecked="True"
                              Checked="ChkCpu_Click" Unchecked="ChkCpu_Click" />
                    <CheckBox x:Name="ChkGpu" Style="{StaticResource TestToggle}" Margin="8" Content="Placa de vídeo" local:Ui.Icon="gpu" local:Ui.Channel="Gpu" local:Ui.Caption="Abre uma janela 3D"
                              Checked="ChkGpu_Click" Unchecked="ChkGpu_Click" />
                    <CheckBox x:Name="ChkRam" Style="{StaticResource TestToggle}" Margin="8" Content="Memória RAM" local:Ui.Icon="ram" local:Ui.Channel="Memory" local:Ui.Caption="Procura erros de memória"
                              Checked="ChkRam_Click" Unchecked="ChkRam_Click" />
                </UniformGrid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Palco -->
                    <Border Style="{StaticResource StageCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Placa: o tempo decorrido de quanto à esquerda; à direita, na linha do rótulo, o estado (LED no sinal rodando, vermelho no corte) e o detalhe -->
                            <Grid Margin="24,21,24,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Tempo decorrido" Style="{StaticResource PlateLabel}" />
                                    <!-- "de 10:00" no bloco de 46 do número (TestCellUnit): mesma base que "00:00" -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="StElapsed" Text="00:00" Style="{StaticResource TestCellValue}" />
                                        <TextBlock x:Name="StTotal" Text="de 10:00" Style="{StaticResource TestCellUnit}" FontSize="14" Margin="8,0,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource PlateStatus}"><InlineUIContainer><Ellipse x:Name="StLed" Style="{StaticResource TestStatusLed}" Visibility="Collapsed" /></InlineUIContainer></TextBlock>
                                        <TextBlock x:Name="StStatus" Text="Pronto" Style="{StaticResource PlateStatus}" />
                                    </StackPanel>
                                    <TextBlock x:Name="StDetail" Style="{StaticResource TestDetail}" TextWrapping="Wrap" MaxWidth="460" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Style="{StaticResource ProgressTrack}">
                                <Border Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="StProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <!-- Leituras ao vivo: as três peças sempre, em colunas iguais e fixas -->
                            <UniformGrid Grid.Row="2" Rows="1">
                                <Border x:Name="CpuColumn" Style="{StaticResource ComponentColumn}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                                            <TextBlock x:Name="CpuState" Text="Fora do teste" Style="{StaticResource ComponentState}" DockPanel.Dock="Right" Visibility="Collapsed" />
                                            <StackPanel Orientation="Horizontal">
                                                <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Cpu" Kind="cpu" Width="24" Height="24" />
                                                <TextBlock Text="Processador" Style="{StaticResource ComponentName}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" MinWidth="128">
                                            <TextBlock Text="Temperatura" Style="{StaticResource StatLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="StTemp" Text="—" Style="{StaticResource ColumnHero}" />
                                                <TextBlock Text="°C" Style="{StaticResource ColumnHeroUnit}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Facts}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Máxima no teste" Style="{StaticResource FactName}" />
                                            <TextBlock x:Name="StTempMax" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="1" Text="Clock médio" Style="{StaticResource FactName}" Background="Transparent" ToolTip="Média dos núcleos" />
                                            <TextBlock x:Name="StClock" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="2" Text="Consumo" Style="{StaticResource FactName}" />
                                            <TextBlock x:Name="StPower" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="3" Text="Carga" Style="{StaticResource FactName}" />
                                            <TextBlock x:Name="StLoad" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border x:Name="GpuColumn" Style="{StaticResource ComponentColumn}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                                            <TextBlock x:Name="GpuState" Text="Fora do teste" Style="{StaticResource ComponentState}" DockPanel.Dock="Right" Visibility="Collapsed" />
                                            <StackPanel Orientation="Horizontal">
                                                <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Gpu" Kind="gpu" Width="24" Height="24" />
                                                <TextBlock Text="Placa de vídeo" Style="{StaticResource ComponentName}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" MinWidth="128">
                                            <TextBlock Text="Temperatura" Style="{StaticResource StatLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="StGpuTemp" Text="—" Style="{StaticResource ColumnHero}" />
                                                <TextBlock Text="°C" Style="{StaticResource ColumnHeroUnit}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Facts}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Máxima no teste" Style="{StaticResource FactName}" />
                                            <TextBlock x:Name="StGpuTempMax" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="1" Text="Consumo" Style="{StaticResource FactName}" />
                                            <TextBlock x:Name="StGpuPower" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="2" Text="FPS · média" Style="{StaticResource FactName}" Background="Transparent" ToolTip="Os quadros por segundo da janela 3D agora e a média do teste." />
                                            <TextBlock x:Name="StFps" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="3" Text="Limitador" Style="{StaticResource FactName}" Background="Transparent" ToolTip="O que o driver diz que está segurando o clock agora (energia, temperatura, tensão)." />
                                            <TextBlock x:Name="StGpuCap" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border x:Name="RamColumn" Style="{StaticResource ComponentColumn}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                                            <TextBlock x:Name="RamState" Text="Fora do teste" Style="{StaticResource ComponentState}" DockPanel.Dock="Right" Visibility="Collapsed" />
                                            <StackPanel Orientation="Horizontal">
                                                <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Memory" Kind="ram" Width="24" Height="24" />
                                                <TextBlock Text="Memória RAM" Style="{StaticResource ComponentName}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" MinWidth="128" Background="Transparent" ToolTip="O teste grava padrões na memória e confere a leitura; um erro só já interrompe o teste.">
                                            <TextBlock Text="Erros" Style="{StaticResource StatLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="StRamErrors" Text="—" Style="{StaticResource ColumnHero}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource Facts}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="26" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Passadas" Style="{StaticResource FactName}" Background="Transparent" ToolTip="Quantas vezes o teste já gravou e conferiu toda a memória separada." />
                                            <TextBlock x:Name="StRam" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="1" Text="Em teste" Style="{StaticResource FactName}" Background="Transparent" ToolTip="A parte da RAM livre que o teste separou." />
                                            <TextBlock x:Name="StRamSize" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="2" Text="RAM em uso" Style="{StaticResource FactName}" />
                                            <TextBlock x:Name="StRamUse" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                            <TextBlock Grid.Row="3" Text="RAM livre" Style="{StaticResource FactName}" />
                                            <TextBlock x:Name="StRamFree" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource FactValue}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- Temperatura dos últimos 5 minutos, com os nomes e os limites rotulados no próprio gráfico -->
                            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="{StaticResource PanelPadding}">
                                <DockPanel>
                                    <!-- Legenda em cima: cada peça na cor dela com a leitura de agora e o corte (o tracejado da mesma cor) -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <StackPanel x:Name="TempLegend" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                                        <TextBlock Text="Temperatura" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Canvas x:Name="TempChart" MinHeight="160" ClipToBounds="True" SizeChanged="TempChart_SizeChanged" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Configurações e histórico -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--
                            Configurações: as cinco sempre à vista, na ordem das peças (processador, placa de vídeo, memória), então o
                            cartão nunca muda de tamanho; o ajuste de uma peça fora do teste esmaece e trava. Esqueleto da primeira
                            visita: a página espera a primeira leitura dos sensores (os outros cartões o acompanham).
                        -->
                        <Border x:Name="StressConfigCard" Style="{StaticResource ConfigCard}"
                                local:Skeleton.Layout="row 34: h 230; foot 42: btn *^42; footgap 24; gap 12; bands 5; row 17: c 40%, - *, c 15%&gt;; gap 10; row 24: pill *^8; endbands">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                    <TextBlock Text="Configurações do teste de carga" Style="{StaticResource CardTitle}" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock x:Name="StressHint" Style="{StaticResource ConfigHint}" />
                                    <Button x:Name="BtnStress" Style="{StaticResource ConfigStart}" local:Ui.Icon="&#xE768;" Content="Iniciar teste" Click="BtnStress_Click"
                                            ToolTip="Põe as peças marcadas no máximo e acompanha a temperatura, para ver se o PC aguenta sem travar." />
                                </StackPanel>
                                <local:ConfigStack Divider="{DynamicResource Line}" MinGap="28" Margin="0,12,0,24">
                                    <StackPanel x:Name="StressDurationSection" Style="{StaticResource ConfigSection}">
                                        <DockPanel Style="{StaticResource ConfigHead}">
                                            <TextBlock x:Name="StressDurationText" Text="10 min" Style="{StaticResource ConfigValue}" />
                                            <TextBlock Text="Duração" Style="{StaticResource ConfigName}" Margin="0" ToolTip="O teste para sozinho no fim do tempo, ou antes, no corte de temperatura." />
                                        </DockPanel>
                                        <!-- Passos: 5, 10, 15, 20, 30 e 45 min, 1 h, 1 h 30, 2 h e sem limite (StressView.DurationSteps) -->
                                        <local:ValueSlider x:Name="StressDuration" Style="{StaticResource ConfigSlider}" Minimum="0" Maximum="9" Value="1"
                                                           ValueChanged="StressDuration_Changed" AutomationProperties.Name="Duração" />
                                    </StackPanel>
                                    <StackPanel x:Name="CpuLimitSection" Style="{StaticResource ConfigSection}" ToolTipService.ShowOnDisabled="True">
                                        <DockPanel Style="{StaticResource ConfigHead}">
                                            <TextBlock x:Name="CpuLimitText" Text="90 °C" Style="{StaticResource ConfigValue}" />
                                            <TextBlock Text="Corte do processador" Style="{StaticResource ConfigName}" Margin="0"
                                                       ToolTip="O teste para sozinho quando o processador chega a esta temperatura. Vale também no teste de memória, que o esquenta." />
                                        </DockPanel>
                                        <local:ValueSlider x:Name="TempLimit" Style="{StaticResource ConfigSlider}" Fill="{DynamicResource Cpu}" Minimum="60" Maximum="105" Value="90"
                                                           ValueChanged="TempLimit_Changed" AutomationProperties.Name="Corte do processador" />
                                    </StackPanel>
                                    <StackPanel x:Name="GpuLimitSection" Style="{StaticResource ConfigSection}" ToolTipService.ShowOnDisabled="True">
                                        <DockPanel Style="{StaticResource ConfigHead}">
                                            <TextBlock x:Name="GpuLimitText" Text="85 °C" Style="{StaticResource ConfigValue}" />
                                            <TextBlock Text="Corte da placa de vídeo" Style="{StaticResource ConfigName}" Margin="0"
                                                       ToolTip="O teste para sozinho quando a placa de vídeo chega a esta temperatura." />
                                        </DockPanel>
                                        <local:ValueSlider x:Name="GpuTempLimit" Style="{StaticResource ConfigSlider}" Fill="{DynamicResource Gpu}" Minimum="60" Maximum="100" Value="85"
                                                           ValueChanged="TempLimit_Changed" AutomationProperties.Name="Corte da placa de vídeo" />
                                    </StackPanel>
                                    <!-- Carga da placa de vídeo: resolução da janela, anti-aliasing e camadas num só ajuste (StressView.GpuLoads) -->
                                    <StackPanel x:Name="GpuOptions" Style="{StaticResource ConfigSection}" ToolTipService.ShowOnDisabled="True">
                                        <DockPanel Style="{StaticResource ConfigHead}">
                                            <TextBlock x:Name="GpuLoadText" Text="Alta" Style="{StaticResource ConfigValue}" />
                                            <TextBlock Text="Carga da placa de vídeo" Style="{StaticResource ConfigName}" Margin="0"
                                                       ToolTip="A janela 3D fica aberta ao lado do CoreBi, para você acompanhar a temperatura. Normal: 720p e anti-aliasing 4x. Alta: 1080p, 4x e mais camadas. Extrema: 1440p, 8x e o máximo de camadas." />
                                        </DockPanel>
                                        <local:ValueSlider x:Name="GpuLoad" Style="{StaticResource ConfigSlider}" Fill="{DynamicResource Gpu}" Minimum="0" Maximum="2" Value="1"
                                                           ValueChanged="StressOption_Changed" AutomationProperties.Name="Carga da placa de vídeo" />
                                    </StackPanel>
                                    <StackPanel x:Name="RamSection" Style="{StaticResource ConfigSection}" ToolTipService.ShowOnDisabled="True">
                                        <DockPanel Style="{StaticResource ConfigHead}">
                                            <TextBlock x:Name="RamFractionText" Text="60 %" Style="{StaticResource ConfigValue}" />
                                            <TextBlock Text="RAM livre em teste" Style="{StaticResource ConfigName}" Margin="0" ToolTip="Quanto da memória livre o teste separa para gravar e conferir." />
                                        </DockPanel>
                                        <local:ValueSlider x:Name="RamFraction" Style="{StaticResource ConfigSlider}" Fill="{DynamicResource Memory}" Minimum="40" Maximum="80" Step="10" Value="60"
                                                           SmallChange="10" LargeChange="10" ValueChanged="StressOption_Changed" AutomationProperties.Name="RAM livre em teste" />
                                    </StackPanel>
                                </local:ConfigStack>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource HistoryCard}">
                            <DockPanel>
                                <Grid Style="{StaticResource HistoryHeader}">
                                    <TextBlock Text="Histórico" Style="{StaticResource CardTitle}" Background="Transparent" ToolTip="Os últimos 30 testes encerrados, o mais recente em cima." />
                                    <Button x:Name="StressHistoryClear" Style="{StaticResource HistoryClear}" Click="StressHistoryClear_Click" />
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl x:Name="StressHistory" Style="{StaticResource StressHistoryList}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
