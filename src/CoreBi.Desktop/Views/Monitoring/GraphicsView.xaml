<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.GraphicsView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- Leitura ao vivo, na faixa da placa: rótulo, número de mostrador, medidor segmentado no canal Gpu (a fração da escala:
             100 %, o clock máximo, o limite de energia, a VRAM total) e o complemento (linha reservada, para as sete terem a mesma
             altura). Sem gráfico do último minuto: não dava para ler valor nenhum nele, e a ficha técnica ganha a altura que ele
             ocupava. Separadas por fios, como eram as leituras da placa; a primeira não tem fio. -->
        <DataTemplate x:Key="GaugeTile">
            <Border x:Name="cell" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,0,0" Padding="18,0,0,0" Margin="18,0,0,0" ToolTip="{Binding Tip}" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource LabelFont}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                    <!-- Número e unidade no mesmo TextBlock: a mesma linha de base -->
                    <TextBlock x:Name="value" Margin="0,4,0,0" Foreground="{DynamicResource Fg}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="32" FontWeight="Light" /><Run x:Name="gap" Text=" " FontFamily="{StaticResource LabelFont}" FontSize="18" /><Run Text="{Binding Unit, Mode=OneWay}" FontFamily="{StaticResource LabelFont}" FontSize="13" Foreground="{DynamicResource Muted}" />
                    </TextBlock>
                    <!-- Trilho neutro (o texto em 14 %, que aparece nos dois temas sobre o fundo da faixa) e o preenchimento cheio no canal -->
                    <Grid Height="8" Margin="0,7,0,0" OpacityMask="{StaticResource SegmentMask}">
                        <Border Background="{DynamicResource Fg}" Opacity="0.14" />
                        <Border x:Name="meter" Background="{DynamicResource Gpu}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Fraction}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource StatSub}" Height="16" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="cell" Property="BorderThickness" Value="0" />
                    <Setter TargetName="cell" Property="Padding" Value="0" />
                    <Setter TargetName="cell" Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Unit}" Value="">
                    <Setter TargetName="gap" Property="Text" Value="" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                    <Setter TargetName="meter" Property="Background" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Leitura do driver na faixa de baixo: rótulo em cima (DIN 12,5, tom secundário) e valor embaixo (Segoe 13,5), cada uma
             numa célula de largura fixa (UniformGrid), para o valor mudar sem empurrar as vizinhas para o lado -->
        <DataTemplate x:Key="FactCell">
            <StackPanel Margin="0,0,16,0" ToolTip="{Binding Tip}" Background="Transparent">
                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource LabelFont}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="value" Text="{Binding Value}" FontSize="13.5" Foreground="{DynamicResource Fg}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Warn}" Value="True">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:PageHeaderPanel Style="{StaticResource PageHead}">
            <TextBlock Text="Placa de vídeo" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Clocks, temperatura e memória da sua placa de vídeo, ao vivo." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
            <!-- Barra de ações: uma pílula por placa, só quando há mais de uma (MainWindow.LoadGpu), e o atalho para os sensores da
                 placa (saiu de baixo do nome para a placa de identificação ficar baixa) -->
            <StackPanel Style="{StaticResource PageActions}">
                <WrapPanel x:Name="GpuChips" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="GpuSensorsLink" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE9D9;" Content="Todos os sensores da placa" Click="GpuSensorsLink_Click" />
            </StackPanel>
        </local:PageHeaderPanel>

        <!-- O painel ao vivo: numa faixa só, a identificação da placa à esquerda e as leituras ao vivo à direita (abaixo de 1500 px
             de largura, as leituras descem para uma segunda linha, GraphicsView.FitColumns); embaixo, as leituras do driver. Os números
             fixos da placa (memória, núcleos, clocks, limite) ficam só na ficha técnica. -->
        <!-- Esqueleto: o desenho, fabricante, nome e subtítulo, e as sete leituras com o medidor -->
        <Border x:Name="GpuPlateCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16"
                local:Skeleton.Layout="gap 22; col 24 44; gap 22; row 44: box 44^44; col 88 22%; gap 4; row 16: c *@0.3; gap 4; row 38: h *@0.8^24; gap 4; row 18: t *@0.8; col 30% 68%; row 16: c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6; gap 4; row 38: n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26; gap 6; row 6: box *, - 18, box *, - 18, box *, - 18, box *, - 18, box *, - 18, box *, - 18, box *; gap 7; row 16: c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7; end; gap 22; line; gap 14; row 16: - 24, c *@0.55, - 16, c *@0.55, - 16, c *@0.55, - 16, c *@0.55, - 16, c *@0.55, - 16, c *@0.55, - 24; gap 3; row 18: - 24, t *@0.35, - 16, t *@0.35, - 16, t *@0.35, - 16, t *@0.35, - 16, t *@0.35, - 16, t *@0.35, - 24; gap 16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Faixa da placa: fundo Selected com o fundo claro do canal Gpu e fio LineStrong, como a placa de Sistema -->
                <Border Background="{DynamicResource Selected}" BorderBrush="{DynamicResource LineStrong}" CornerRadius="{StaticResource RadiusPanelTop}" ClipToBounds="True">
                    <!-- O fio de baixo só existe quando há a faixa do driver embaixo (sem ela, ficaria colado na borda do cartão) -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=GpuExtras}" Value="True">
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Border Style="{StaticResource ChannelWash}" local:Ui.Channel="Gpu" CornerRadius="{StaticResource RadiusPanelTop}" />
                        <Grid x:Name="GpuBand" Margin="24,22" SizeChanged="GpuBand_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="GpuIdColumn" Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Gpu" Kind="gpu" Width="44" Height="44" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="20,0,40,0" VerticalAlignment="Center" MaxWidth="420">
                                <TextBlock x:Name="GpuVendor" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Gpu}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                                <TextBlock x:Name="GpuName" Text="Lendo a placa de vídeo…" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <TextBlock x:Name="GpuSubtitle" FontSize="13.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,5,0,0"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                            </StackPanel>
                            <!-- Leituras ao vivo, divididas por igual no que sobra da faixa; sem nenhum sensor, uma frase só no lugar delas -->
                            <TextBlock x:Name="GpuNoSensors" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Sem leituras ao vivo: o driver desta placa não informa uso, clock nem temperatura." />
                            <ItemsControl x:Name="GpuGauges" Grid.Column="2" VerticalAlignment="Center" ItemTemplate="{StaticResource GaugeTile}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" Loaded="GaugeGrid_Loaded" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Leituras do driver (estado de desempenho, limitador...): a faixa só existe quando o driver as informa -->
                <Border Grid.Row="1" Padding="24,14,24,16"
                        Visibility="{Binding HasItems, ElementName=GpuExtras, Converter={StaticResource BoolVis}}">
                    <ItemsControl x:Name="GpuExtras" ItemTemplate="{StaticResource FactCell}" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>

        <!-- Ficha técnica: grupos chave/valor em colunas que dividem a largura; o painel tem a altura do conteúdo e rola por dentro se
             a janela for baixa -->
        <!-- Esqueleto: quatro colunas de grupo, cada uma com o título e as linhas chave/valor -->
        <Border x:Name="GpuSpecCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" VerticalAlignment="Top" local:Skeleton.Top="58"
                local:Skeleton.Layout="pad 24 0 24 20; col 0 23.2%; row 28: s *@0.42; lines 9 34: c 42%@0.6, - 12, t *@0.7; col 25.6% 23.2%; row 28: s *@0.6; lines 8 34: c 42%@0.6, - 12, t *@0.7; gap 24; row 28: s *@0.4; rows 2 34: c 42%@0.6, - 12, t *@0.7; col 51.2% 23.2%; row 28: s *@0.3; lines 7 34: c 42%@0.6, - 12, t *@0.7; gap 24; row 28: s *@0.36; rows 2 34: c 42%@0.6, - 12, t *@0.7; col 76.8% 23.2%; row 28: s *@0.45; lines 8 34: c 42%@0.6, - 12, t *@0.7; gap 24; row 28: s *@0.36; rows 2 34: c 42%@0.6, - 12, t *@0.7; end">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource CardHeader}" Margin="24,20,24,0">
                    <TextBlock Text="Especificações" Style="{StaticResource CardTitle}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,10,0,0">
                    <ItemsControl x:Name="GpuSections" ItemTemplate="{StaticResource GpuSection}" Margin="24,0,24,20" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><inv:ColumnsPanel Columns="4" ColumnGap="40" RowGap="24" Loaded="SpecColumns_Loaded" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
