<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.GraphicsView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Placa de vídeo" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Especificações completas e leituras do driver em tempo real." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <WrapPanel x:Name="GpuChips" Grid.Column="1" VerticalAlignment="Bottom" />
        </Grid>
        <!-- Placa de identificação: nome da GPU com a marca gravada ao fundo -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="26,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Gpu" Kind="gpu" Width="44" Height="44" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GpuName" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="GpuSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <TextBlock x:Name="GpuVendor" Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Line}" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl x:Name="GpuSections" ItemTemplate="{StaticResource GpuSection}" />
            </ScrollViewer>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22,18,10,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Gpu}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Ao vivo" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <ItemsControl x:Name="GpuExtras" DockPanel.Dock="Top" Margin="0,0,12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" />
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GpuLive" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource Faint}" FontSize="11.5" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
