<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.GraphicsView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- Leitura ao vivo, na faixa da placa: rótulo, número de mostrador, medidor segmentado no canal Gpu (a fração da escala:
             100 %, o clock máximo, o limite de energia, a VRAM total) e o complemento (linha reservada, para as sete terem a mesma
             altura). Sem gráfico do último minuto: não dava para ler valor nenhum nele, e a ficha técnica ganha a altura que ele
             ocupava. Separadas por fios. -->
        <DataTemplate x:Key="GaugeTile">
            <!-- Todas iguais: o fio à esquerda (também na primeira, que a separa da identificação) e 18 de cada lado, então os sete
                 medidores têm a mesma largura. O fio é o texto em 18 %, que aparece nos dois temas sobre o fundo da faixa. -->
            <Grid ToolTip="{Binding Tip}" Background="Transparent">
                <Border Width="1" HorizontalAlignment="Left" Background="{DynamicResource PlateWire}" SnapsToDevicePixels="True" />
                <StackPanel Margin="18,0,18,0">
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource LabelFont}" FontSize="13" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                    <!-- Número e unidade no mesmo TextBlock: a mesma linha de base -->
                    <TextBlock x:Name="value" Margin="0,4,0,0" Foreground="{DynamicResource Fg}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="32" FontWeight="Light" /><Run x:Name="gap" Text=" " FontFamily="{StaticResource LabelFont}" FontSize="18" /><Run Text="{Binding Unit, Mode=OneWay}" FontFamily="{StaticResource LabelFont}" FontSize="13" Foreground="{DynamicResource Muted}" />
                    </TextBlock>
                    <!-- Trilho neutro (o texto em 14 %) e o preenchimento cheio no canal -->
                    <Grid Height="8" Margin="0,7,0,0" OpacityMask="{StaticResource SegmentMask}">
                        <Border Background="{DynamicResource PlateTrack}" />
                        <Border x:Name="meter" Background="{DynamicResource Gpu}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Fraction}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="sub" Text="{Binding Sub}" Style="{StaticResource StatSub}" Height="16" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Unit}" Value="">
                    <Setter TargetName="gap" Property="Text" Value="" />
                </DataTrigger>
                <!-- Clock segurado pelo driver (calor ou proteção do hardware): só o aviso embaixo fica âmbar -->
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                    <Setter TargetName="meter" Property="Background" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:PageHeaderPanel Style="{StaticResource PageHead}">
            <TextBlock Text="Placa de vídeo" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Clocks, temperatura e memória da sua placa de vídeo, ao vivo." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
            <!-- Barra de ações: uma pílula por placa, só quando há mais de uma (MainWindow.LoadGpu), e o atalho para os sensores da
                 placa (saiu de baixo do nome para a placa de identificação ficar baixa) -->
            <StackPanel Style="{StaticResource PageActions}">
                <WrapPanel x:Name="GpuChips" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="GpuSensorsLink" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE9D9;" Content="Todos os sensores da placa" Click="GpuSensorsLink_Click" />
            </StackPanel>
        </local:PageHeaderPanel>

        <!-- O painel ao vivo: uma faixa só, com a identificação da placa à esquerda e as leituras ao vivo à direita (abaixo de 1500 px
             de largura, as leituras descem para uma segunda linha, GraphicsView.FitColumns). Os números fixos da placa (memória,
             núcleos, clocks, limite) ficam só na ficha técnica. As leituras de nicho do driver (estado P, controlador de memória,
             NVENC/NVDEC, PCIe em uso) saíram; o limitador do clock só aparece quando segura a placa, sob o clock do núcleo. -->
        <!-- Esqueleto: o desenho, fabricante, nome e subtítulo, e as sete leituras com o medidor -->
        <Border x:Name="GpuPlateCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16"
                local:Skeleton.Layout="gap 28; col 28 44; gap 22; row 44: box 44^44; col 92 22%; gap 4; row 16: c *@0.3; gap 4; row 38: h *@0.8^24; gap 4; row 18: t *@0.8; col 30% 68%; row 16: c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6, - 18, c *@0.6; gap 4; row 38: n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26, - 18, n *@0.7^26; gap 6; row 6: box *, - 18, box *, - 18, box *, - 18, box *, - 18, box *, - 18, box *, - 18, box *; gap 7; row 16: c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7, - 18, c *@0.7; end; gap 31">
            <Grid>
                <!-- Faixa da placa: fundo Selected com o fundo claro do canal Gpu, como a placa da Ficha técnica, nos cantos do cartão -->
                <Border Background="{DynamicResource Selected}" CornerRadius="{StaticResource RadiusPanel}" ClipToBounds="True">
                    <Grid>
                        <Border Style="{StaticResource ChannelWash}" local:Ui.Channel="Gpu" CornerRadius="{StaticResource RadiusPanel}" />
                        <Grid x:Name="GpuBand" Margin="28,28" SizeChanged="GpuBand_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="GpuIdColumn" Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Gpu" Kind="gpu" Width="44" Height="44" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="20,0,24,0" VerticalAlignment="Center" MaxWidth="420">
                                <TextBlock x:Name="GpuVendor" FontFamily="{StaticResource LabelFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Gpu}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                                <TextBlock x:Name="GpuName" Text="Lendo a placa de vídeo…" Style="{StaticResource PlateName}" Margin="0,4,0,0" />
                                <TextBlock x:Name="GpuSubtitle" Style="{StaticResource PlateText}" Margin="0,5,0,0"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                            </StackPanel>
                            <!-- Leituras ao vivo, divididas por igual no que sobra da faixa; sem nenhum sensor, uma frase só no lugar delas -->
                            <TextBlock x:Name="GpuNoSensors" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Sem leituras ao vivo: o driver desta placa não informa uso, clock nem temperatura." />
                            <ItemsControl x:Name="GpuGauges" Grid.Column="2" VerticalAlignment="Center" ItemTemplate="{StaticResource GaugeTile}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" Loaded="GaugeGrid_Loaded" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Ficha técnica: grupos chave/valor em colunas que dividem a largura; o painel tem a altura do conteúdo e rola por dentro se
             a janela for baixa -->
        <!-- Esqueleto: quatro colunas de grupo, cada uma com o título e as linhas chave/valor -->
        <Border x:Name="GpuSpecCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" VerticalAlignment="Top" local:Skeleton.Top="58"
                local:Skeleton.Layout="pad 24 0 24 20; col 0 23.2%; row 28: s *@0.42; lines 9 34: c 42%@0.6, - 12, t *@0.7; col 25.6% 23.2%; row 28: s *@0.6; lines 8 34: c 42%@0.6, - 12, t *@0.7; gap 24; row 28: s *@0.4; rows 2 34: c 42%@0.6, - 12, t *@0.7; col 51.2% 23.2%; row 28: s *@0.3; lines 7 34: c 42%@0.6, - 12, t *@0.7; gap 24; row 28: s *@0.36; rows 2 34: c 42%@0.6, - 12, t *@0.7; col 76.8% 23.2%; row 28: s *@0.45; lines 8 34: c 42%@0.6, - 12, t *@0.7; gap 24; row 28: s *@0.36; rows 2 34: c 42%@0.6, - 12, t *@0.7; end">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource CardHeader}" Margin="24,16,24,0">
                    <TextBlock Text="Especificações" Style="{StaticResource CardTitle}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,10,0,0">
                    <ItemsControl x:Name="GpuSections" ItemTemplate="{StaticResource GpuSection}" Margin="24,0,24,20" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><inv:ColumnsPanel Columns="4" ColumnGap="40" RowGap="24" Loaded="SpecColumns_Loaded" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
