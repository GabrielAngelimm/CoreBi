<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.DisksView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- LED de veredito: cinza sem dado, verde, âmbar ou vermelho -->
        <Style x:Key="DiskLed" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource Faint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Ok}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Warn}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Danger"><Setter Property="Fill" Value="{DynamicResource Danger}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Tecla de disco na faixa de cima (só com mais de um disco): a mesma tecla da bancada de teste (Benchmark), com o ícone
            do armazenamento, o nome, a letra da unidade em destaque (dois discos do mesmo modelo só se distinguem por ela), o LED
            do veredito e as características embaixo. A escolhida leva o sinal, como em toda escolha do app.
        -->
        <Style x:Key="DiskKey" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="face" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInset}" Padding="14,12" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource SignalSoft}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Signal}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DiskBay">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:HwIcon Grid.RowSpan="2" Style="{StaticResource ChannelIcon}" local:Ui.Channel="Storage" Kind="storage" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource ItemTitle}" VerticalAlignment="Center" />
                <!-- Nome (DIN 14) e letra (Bahnschrift 16) no topo, com 1 px a mais na letra: as duas bases coincidem -->
                <TextBlock Grid.Column="2" Text="{Binding Letters}" Style="{StaticResource ReadoutText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,1,0,0" />
                <Ellipse Grid.Column="3" Style="{StaticResource DiskLed}" Margin="10,1,0,0" ToolTip="{Binding VerdictText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Meta}" FontFamily="{StaticResource SmallFont}" FontSize="12" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Unidade (letra), só quando o disco tem mais de uma: nome e quanto está livre, lado a lado sob a barra do espaço -->
        <DataTemplate x:Key="VolumeRow">
            <TextBlock Margin="0,0,28,0" Typography.NumeralAlignment="Tabular">
                <Run Text="{Binding Letter, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" /><Run Text="  " /><Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Muted}" /><Run Text="  ·  " Foreground="{DynamicResource Faint}" /><Run Text="{Binding Line, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
            </TextBlock>
        </DataTemplate>

        <!--
            Linha da integridade, numa lista com fio entre as linhas: LED, o que é verificado (quebra a linha se for longo) e, à
            direita, o valor lido. Saudável fica em tinta (o LED já diz que está bem); atenção e crítico viram um selo na cor, para
            saltar aos olhos. Sem valor (a frase única de "não informa"), sem selo. Rótulo e valor na mesma letra e tamanho
            (Bahnschrift 12,5), no topo da linha: as bases coincidem; o LED desce 5 px para o meio das maiúsculas.
        -->
        <DataTemplate x:Key="CheckRow">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12" Background="Transparent" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Style="{StaticResource DiskLed}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <Border x:Name="pill" Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top" Padding="8,1,8,2" Margin="0,-2,0,0">
                        <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource BadgeText}" FontSize="13" Typography.NumeralAlignment="Tabular" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- A primeira linha não tem fio em cima: o cabeçalho do cartão já separa -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="">
                    <Setter TargetName="pill" Property="Margin" Value="0,-2,-8,0" />
                    <Setter TargetName="pill" Property="Background" Value="Transparent" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Muted}" />
                    <Setter TargetName="value" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="">
                    <Setter TargetName="pill" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="pill" Property="Margin" Value="0,-2,-8,0" />
                    <Setter TargetName="pill" Property="Background" Value="Transparent" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Fg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarnSoft}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource WarnSoft}" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Danger">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource DangerSoft}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource DangerSoft}" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            Linha do odômetro ("Uso desde a fábrica"), no mesmo desenho da lista da Integridade ao lado: o rótulo com a linha de
            contexto embaixo, à esquerda, e a leitura de mostrador à direita, com fio entre as linhas (a primeira sem fio,
            LayoutOdometer). As linhas dividem a altura do cartão; o disco que não informa um valor fica com menos linhas.
        -->
        <Style x:Key="OdoCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="OdoValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <!--
            Leitura do espaço, sob a barra na placa: três colunas iguais na largura toda da barra, cada leitura centrada na sua,
            separadas por fios no tom das leituras da Placa de vídeo (PlateWire: o LineStrong some sobre o fundo da placa)
        -->
        <Style x:Key="SpaceWire" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource PlateWire}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="SpaceCell" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Leituras do topo da temperatura: mesma altura de linha em bloco, para as três bases coincidirem -->
        <Style x:Key="TempValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="LineHeight" Value="44" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- Leitura média (espaço, desgaste, reserva): o tamanho do StatValue do app -->
        <Style x:Key="LifeValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <!--
        Uma tela: com a janela maximizada tudo cabe sem rolar (os instrumentos ocupam a sobra de altura). Em cima, só com mais de
        um disco, a faixa de teclas com um disco por tecla; com um, só o cabeçalho da página. Embaixo, o disco escolhido na largura
        toda: a placa de identificação (nome à esquerda, espaço à direita) e, sob ela, três colunas: vida útil, temperatura e a
        coluna da saúde (integridade em lista e o uso desde a fábrica em blocos). Em janelas menores a coluna da saúde desce para
        uma faixa embaixo, com os dois cartões lado a lado, e a página rola.
    -->
    <ScrollViewer x:Name="DiskScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=DiskScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Discos" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Saúde, temperatura e espaço de cada disco." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                    <StackPanel Style="{StaticResource PageActions}">
                        <TextBlock x:Name="DiskHealthStatus" Text="Lendo os discos…" Style="{StaticResource PageStatus}" Margin="0,0,20,2" Typography.NumeralAlignment="Tabular" />
                        <Button x:Name="BtnDiskRefresh" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" Click="BtnDiskRefresh_Click" />
                    </StackPanel>
                </local:PageHeaderPanel>

                <!--
                    Discos instalados: uma tecla por disco, na largura toda e a 12 uma da outra (6 de cada lado, e a faixa recua 6 nas
                    pontas para as teclas da beira irem até a borda dos painéis). Só existe com mais de um disco, como as pílulas de
                    Placa de vídeo: com um disco só, a tecla repetiria a placa logo abaixo.
                -->
                <ListBox x:Name="DiskCards" Grid.Row="1" Margin="-8,0,-8,16" Padding="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                         ItemTemplate="{StaticResource DiskBay}" ItemContainerStyle="{StaticResource DiskKey}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="DiskCards_SelectionChanged" AutomationProperties.Name="Discos instalados">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Loaded="RackGrid_Loaded" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid x:Name="DiskBody" Grid.Row="2" SizeChanged="DiskBody_SizeChanged">
                    <!-- Disco escolhido -->
                    <Grid x:Name="DiskPanel" Visibility="Hidden">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LifeColumn" Width="400" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SideGap" Width="16" />
                            <ColumnDefinition x:Name="SideColumn" Width="400" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="SideGapRow" Height="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            Placa de identificação no padrão de Sistema e Placa de vídeo (fundo Selected com o fundo claro do canal Storage
                            e fio LineStrong): o ícone do disco de 44 px, o tipo e a conexão como sobretítulo na cor do canal, o modelo em
                            DIN 30 e a especificação numa frase. Sem selo: saudável é silencioso (o veredito fica no cartão Integridade);
                            atenção, crítico e "sem dados" ganham a linha com o motivo sob a frase. À direita, separado por fio, o espaço.
                        -->
                        <!-- Esqueleto: ícone, sobretítulo, modelo e frase; à direita o título do espaço, a barra e as três leituras -->
                        <Border x:Name="DiskPlate" Grid.ColumnSpan="5" Style="{StaticResource CardBorder}" Padding="0" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource LineStrong}"
                                local:Skeleton.Layout="gap 22; col 24 44; row 94: box 44^44; col 88 40%; gap 6; row 16: c *@0.2; gap 4; row 40: h *@0.7^24; gap 7; row 18: t *@0.8; col 60% 38%; row 16: c 64@0.9; gap 12; row 16: box *^16; gap 14; row 16: c 26%@0.6, - 8%, c 26%@0.5, - 8%, c 26%@0.5; gap 4; row 28: n 26%@0.7^22, - 8%, n 26%@0.85^22, - 8%, n 26%@0.85^22; end; gap 22">
                            <Grid>
                                <Border x:Name="PlateWash" Style="{StaticResource ChannelWash}" local:Ui.Channel="Storage" CornerRadius="15" />
                                <Grid Margin="{StaticResource PanelPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition x:Name="SpaceColumn" Width="600" />
                                    </Grid.ColumnDefinitions>
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Storage" Kind="storage" Width="44" Height="44" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="20,0,32,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DiskModel" Style="{StaticResource PlateName}" />
                                        <!-- A especificação numa frase: chave em tom secundário e valor em tinta (DisksView.ShowSpecs) -->
                                        <TextBlock x:Name="DiskSpecs" Style="{StaticResource PlateText}" Margin="0,8,0,0" Background="Transparent" />
                                        <Grid x:Name="DiskReasonRow" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DiskReasonIcon" Style="{StaticResource IconGlyph}" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <TextBlock x:Name="DiskReasons" Grid.Column="1" Style="{StaticResource Body}" />
                                        </Grid>
                                    </StackPanel>
                                    <Border x:Name="SpaceDivider" Grid.Column="2" Width="1" Background="{DynamicResource PlateWire}" SnapsToDevicePixels="True" Margin="0,0,32,0" />
                                    <!-- Espaço: a barra por unidade, as unidades lado a lado (com mais de uma) e os três números embaixo -->
                                    <StackPanel x:Name="DiskSpace" Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="Espaço" Style="{StaticResource GroupTitle}" />
                                        <local:CapacityBar x:Name="DiskCapacity" Margin="0,12,0,0" TrackBrush="{DynamicResource PlateTrack}" />
                                        <ItemsControl x:Name="DiskVolumes" ItemTemplate="{StaticResource VolumeRow}" Focusable="False" Margin="0,10,0,0"
                                                      Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Style="{StaticResource SpaceCell}">
                                                <TextBlock Text="Capacidade" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="SpaceTotal" Style="{StaticResource LifeValue}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SpaceWire}" />
                                            <StackPanel Grid.Column="1" Style="{StaticResource SpaceCell}">
                                                <TextBlock Text="Usado" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="SpaceUsed" Style="{StaticResource LifeValue}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource SpaceWire}" />
                                            <StackPanel Grid.Column="2" Style="{StaticResource SpaceCell}">
                                                <TextBlock Text="Livre" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="SpaceFree" Style="{StaticResource LifeValue}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Vida útil -->
                        <Border x:Name="LifeCard" local:Skeleton.Top="34" local:Skeleton.Layout="foot 30: n 94@0.22^20, n 94@0.22^20, n 94@0.22^20; foot 20: c 94@0.62, c 94@0.5, c 94@0.7; footgap 12; center 280: arc *~" Grid.Row="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Style="{StaticResource CardHeader}">
                                    <TextBlock Text="Vida útil" Style="{StaticResource CardTitle}" />
                                </Grid>
                                <local:LifeGauge x:Name="LifeDial" Grid.Row="1" MinHeight="210" Margin="0,10,0,8" Caption="restante" />
                                <!-- Leituras do pé: colunas iguais, cada uma centrada na sua, sem fio em cima (o mostrador já separa) -->
                                <UniformGrid Grid.Row="2" Rows="1" Margin="0,4,0,0">
                                    <StackPanel Style="{StaticResource SpaceCell}">
                                        <TextBlock Text="Desgaste" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LifeWear" Style="{StaticResource LifeValue}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SpaceCell}">
                                        <TextBlock Text="Reserva" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LifeSpare" Style="{StaticResource LifeValue}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel x:Name="LifeEnduranceBox" Style="{StaticResource SpaceCell}">
                                        <TextBlock Text="Resistência" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LifeEndurance" Style="{StaticResource LifeValue}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Temperatura -->
                        <Border x:Name="TempCard" local:Skeleton.Top="34" local:Skeleton.Layout="gap 12; row 16: c 33%@0.16~, c 33%@0.18~, c 33%@0.28~; gap 6; row 44: n 33%@0.3^28~, n 33%@0.3^28~, n 33%@0.3^28~; gap 16; row 20: box *^18; gap 6; row 14: c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.2, c 10%@0.24; foot 38: c 92@0.95, - 20, s 150@0.95; footgap 10; foot 16: - 44, c 44, - *, c 52~, - *, c 36>; footgap 4; gap 14; col 0 40; gap 6; spaced 4 14: c 32@0.9; col 44; rest: frame *; end" Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Cabeçalho de 34 px (CardHeader): o título e, à direita, de onde vem a leitura -->
                                <Grid Style="{StaticResource CardHeader}">
                                    <TextBlock Text="Temperatura" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse x:Name="TempLiveDot" Style="{StaticResource StatusLed}" Margin="0,1,8,0" />
                                        <TextBlock x:Name="TempLiveText" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Grid>
                                <!--
                                    Três leituras iguais, centradas cada uma no seu terço e separadas por fios (como os instrumentos de Placa
                                    de vídeo): rótulo DIN 12,5 em cima e a leitura de mostrador de 34 px embaixo, inclusive a Situação
                                    ("Ideal", "Alta", "Crítica"), na mesma letra dos números. Mesma altura de linha nos três valores, então as
                                    bases coincidem. Atenção e crítico pintam a Situação; o resto fica em tinta.
                                -->
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Agora" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TempNow" Style="{StaticResource TempValue}" HorizontalAlignment="Center" Text="—" />
                                    </StackPanel>
                                    <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Situação" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="TempState" Style="{StaticResource TempValue}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Máx. registrado" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TempPeak" Style="{StaticResource TempValue}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <local:ThermalScale x:Name="TempScale" Grid.Row="2" Margin="0,16,0,0" />
                                <local:TraceChart x:Name="TempTrace" Grid.Row="3" MinHeight="150" Margin="0,12,0,0" />
                                <!-- Rótulo e leitura na mesma letra e tamanho (as bases coincidem), centrados no pé do gráfico, sem fio em cima -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <TextBlock Text="Atividade agora" Style="{StaticResource StatLabel}" Margin="0,0,20,0" />
                                    <TextBlock x:Name="DiskActivity" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Fg}" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Coluna da saúde: integridade em cima (ocupa a sobra) e o uso desde a fábrica embaixo -->
                        <Grid x:Name="SideGrid" Grid.Row="2" Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="SideInnerGap" Width="0" />
                                <ColumnDefinition x:Name="SideInnerColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <!-- A integridade na altura da lista; o uso desde a fábrica fica com a sobra (os blocos crescem e centram a leitura) -->
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="SideTopRow" Height="Auto" />
                                <RowDefinition x:Name="SideInnerGapRow" Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--
                                Integridade: o veredito no cabeçalho (saudável em tinta com o LED verde, sem selo; atenção e crítico num
                                selo na cor) e a lista de verificações do S.M.A.R.T. e dos contadores de erro
                            -->
                            <Border x:Name="CheckCard" Style="{StaticResource CardBorder}" local:Skeleton.Top="34"
                                    local:Skeleton.Layout="gap 12; lines 4 44: dot 8, - 10, c *@0.6, - 12, pill 64^20>">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Integridade" Style="{StaticResource CardTitle}" />
                                        <StackPanel x:Name="VerdictQuiet" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse x:Name="VerdictLed" Style="{StaticResource StatusLed}" Margin="0,1,8,0" />
                                            <TextBlock x:Name="VerdictText" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Fg}" />
                                        </StackPanel>
                                        <Border x:Name="DiskBadge" Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource BadgeLed}" />
                                                <TextBlock x:Name="DiskBadgeText" Style="{StaticResource BadgeText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ItemsControl x:Name="DiskChecks" Grid.Row="1" ItemTemplate="{StaticResource CheckRow}" Focusable="False" Margin="0,10,0,0" />
                                </Grid>
                            </Border>

                            <!-- Uso desde a fábrica: o odômetro do disco em até quatro blocos (só o que o disco informa) -->
                            <Border x:Name="OdoCard" Grid.Row="2" Style="{StaticResource CardBorder}" local:Skeleton.Top="34"
                                    local:Skeleton.Layout="gap 6; share 4: c 40%@0.8, - *, n 90@0.8^22>">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Uso desde a fábrica" Style="{StaticResource CardTitle}" />
                                    </Grid>
                                    <UniformGrid x:Name="OdoGrid" Grid.Row="1" Columns="1" Margin="0,6,0,0">
                                        <Border x:Name="OdoCell0" Style="{StaticResource OdoCell}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Tempo ligado" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Fg}" />
                                                <TextBlock x:Name="OdoHoursNote" Grid.Row="1" Style="{StaticResource StatSub}" Margin="0,3,0,0" />
                                                <TextBlock x:Name="OdoHours" Style="{StaticResource OdoValue}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="OdoCell1" Style="{StaticResource OdoCell}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Ciclos liga/desliga" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Fg}" />
                                                <TextBlock x:Name="OdoCyclesNote" Grid.Row="1" Style="{StaticResource StatSub}" Margin="0,3,0,0" />
                                                <TextBlock x:Name="OdoCycles" Style="{StaticResource OdoValue}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="OdoCell2" Style="{StaticResource OdoCell}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Total gravado" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Fg}" />
                                                <TextBlock x:Name="OdoWrittenNote" Grid.Row="1" Style="{StaticResource StatSub}" Margin="0,3,0,0" />
                                                <TextBlock x:Name="OdoWritten" Style="{StaticResource OdoValue}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="OdoCell3" Style="{StaticResource OdoCell}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Total lido" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Fg}" />
                                                <TextBlock x:Name="OdoReadNote" Grid.Row="1" Style="{StaticResource StatSub}" Margin="0,3,0,0" />
                                                <TextBlock x:Name="OdoRead" Style="{StaticResource OdoValue}" />
                                            </Grid>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
