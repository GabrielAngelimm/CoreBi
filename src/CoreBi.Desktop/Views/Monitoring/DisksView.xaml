<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.DisksView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- LED de veredito: cinza sem dado, verde, âmbar ou vermelho -->
        <Style x:Key="DiskLed" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource Faint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Ok}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Warn}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Danger"><Setter Property="Fill" Value="{DynamicResource Danger}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Tecla de disco na faixa de cima (só com mais de um disco): a mesma tecla da bancada de teste (Benchmark), com o ícone
            do armazenamento, o nome, a letra da unidade em destaque (dois discos do mesmo modelo só se distinguem por ela), o LED
            do veredito e as características embaixo. A escolhida leva o sinal, como em toda escolha do app.
        -->
        <Style x:Key="DiskKey" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="face" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInset}" Padding="14,12" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource SignalSoft}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Signal}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DiskBay">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:HwIcon Grid.RowSpan="2" Style="{StaticResource ChannelIcon}" local:Ui.Channel="Storage" Kind="storage" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource LabelFont}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <!-- Nome (DIN 14) e letra (Bahnschrift 16) no topo, com 1 px a mais na letra: as duas bases coincidem -->
                <TextBlock Grid.Column="2" Text="{Binding Letters}" Style="{StaticResource ReadoutText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,1,0,0" />
                <Ellipse Grid.Column="3" Style="{StaticResource DiskLed}" Margin="10,1,0,0" ToolTip="{Binding VerdictText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Meta}" FontFamily="{StaticResource SmallFont}" FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Unidade (letra), só quando o disco tem mais de uma: nome e quanto está livre, lado a lado sob a barra do espaço -->
        <DataTemplate x:Key="VolumeRow">
            <TextBlock Margin="0,0,28,0" Typography.NumeralAlignment="Tabular">
                <Run Text="{Binding Letter, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" /><Run Text="  " /><Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Muted}" /><Run Text="  ·  " Foreground="{DynamicResource Faint}" /><Run Text="{Binding Line, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
            </TextBlock>
        </DataTemplate>

        <!-- Linha da integridade: LED, o que é verificado e o valor lido. Saudável fica em tinta (o LED já diz que está bem);
             atenção e crítico viram um selo na cor, para saltar aos olhos. Sem valor (a frase única de "não informa"), sem selo.
             Rótulo e valor na mesma letra e tamanho (Bahnschrift 12,5) e o texto do selo exatamente no centro da caixa: as duas
             bases coincidem. Antes o rótulo era Segoe 12,5 e o valor Bahnschrift 12, com a base do valor 2 px acima.
             Selo: 1 de margem + 1 de fio + 1 de respiro em cima, 1 de fio + 2 de respiro embaixo, o texto fica no meio. -->
        <DataTemplate x:Key="CheckRow">
            <Grid Margin="0,4" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource DiskLed}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource StatLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Border x:Name="pill" Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center" Padding="8,1,8,2" Margin="0,1,0,0">
                    <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource BadgeText}" FontSize="12.5" Typography.NumeralAlignment="Tabular" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="">
                    <Setter TargetName="pill" Property="Background" Value="Transparent" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Muted}" />
                    <Setter TargetName="value" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="">
                    <Setter TargetName="pill" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="pill" Property="Background" Value="Transparent" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Fg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarnSoft}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource WarnSoft}" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Danger">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource DangerSoft}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource DangerSoft}" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            Leitura do odômetro na placa: rótulo, número grande e uma linha de contexto, separadas por fios como as leituras da
            placa de Placa de vídeo (a primeira sem fio, LayoutOdometer)
        -->
        <Style x:Key="OdoCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="28,0,0,0" />
            <Setter Property="Margin" Value="28,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="OdoLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="OdoValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- Leitura do espaço, à direita da barra: rótulo e número, separados por fios -->
        <Style x:Key="SpaceCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="28,0,0,0" />
            <Setter Property="Margin" Value="28,0,0,0" />
        </Style>
        <!-- Leituras do topo da temperatura: mesma altura de linha em bloco, para as três bases coincidirem -->
        <Style x:Key="TempValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="LineHeight" Value="76" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <Style x:Key="LifeValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <!--
        Uma tela: com a janela maximizada tudo cabe sem rolar (os instrumentos ocupam a sobra de altura). Em cima, só com mais de
        um disco, a faixa de teclas com um disco por tecla. Embaixo, o disco escolhido na largura toda: o painel dele (a placa de
        identificação com o odômetro e, sob ela, o espaço), vida útil e temperatura lado a lado e, numa faixa discreta, a
        integridade. Em janelas menores o odômetro desce para baixo do nome e a página rola.
    -->
    <ScrollViewer x:Name="DiskScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=DiskScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Discos" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Saúde, temperatura e espaço de cada disco." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                    <StackPanel Style="{StaticResource PageActions}">
                        <TextBlock x:Name="DiskHealthStatus" Text="Lendo os discos…" Style="{StaticResource PageStatus}" Margin="0,0,20,2" Typography.NumeralAlignment="Tabular" />
                        <Button x:Name="BtnDiskRefresh" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" Click="BtnDiskRefresh_Click" />
                    </StackPanel>
                </local:PageHeaderPanel>

                <!--
                    Discos instalados: uma tecla por disco, na largura toda e a 12 uma da outra (6 de cada lado, e a faixa recua 6 nas
                    pontas para as teclas da beira irem até a borda dos painéis). Só existe com mais de um disco, como as pílulas de
                    Placa de vídeo: com um disco só, a tecla repetiria a placa logo abaixo.
                -->
                <ListBox x:Name="DiskCards" Grid.Row="1" Margin="-6,0,-6,16" Padding="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                         ItemTemplate="{StaticResource DiskBay}" ItemContainerStyle="{StaticResource DiskKey}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="DiskCards_SelectionChanged" AutomationProperties.Name="Discos instalados">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Loaded="RackGrid_Loaded" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid x:Name="DiskBody" Grid.Row="2" SizeChanged="DiskBody_SizeChanged">
                    <!-- Disco escolhido -->
                    <Grid x:Name="DiskPanel" Visibility="Hidden">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LifeColumn" Width="420" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            Painel do disco. Em cima, a placa de identificação no padrão de Sistema e Placa de vídeo (fundo Selected com o
                            fundo claro do canal Storage e fio LineStrong): o ícone do disco de 44 px, o tipo e a conexão como sobretítulo
                            na cor do canal, o modelo em DIN 30 com o selo do veredito, a especificação numa frase e, à direita, o
                            odômetro (uso acumulado desde a fábrica). Embaixo, o espaço: a barra por unidade na largura que sobra e os
                            três números à direita.
                        -->
                        <!-- Esqueleto: a placa (ícone, sobretítulo, modelo, frase e as quatro leituras do odômetro) e a faixa do espaço (título, barra e três leituras) -->
                        <Border x:Name="DiskPlate" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}" Padding="0"
                                local:Skeleton.Layout="gap 20; col 24 44; row 92: box 44^44; col 88 36%; gap 2; row 16: c *@0.22; gap 4; row 40: h *@0.72^24; gap 7; row 18: t *@0.8; col 52% 46%; gap 12; row 16: c 22%@0.6, - 4%, c 22%@0.6, - 4%, c 22%@0.6, - 4%, c 22%@0.6; gap 6; row 46: n 22%@0.75^30, - 4%, n 22%@0.75^30, - 4%, n 22%@0.75^30, - 4%, n 22%@0.75^30; gap 6; row 14: c 22%@0.6, - 4%, c 22%@0.6, - 4%, c 22%@0.6, - 4%, c 22%@0.6; end; gap 20; line; gap 20; col 24 60%; row 22: s 64^14; gap 14; row 16: box *^16; col 66% 32%; gap 2; row 16: c 30%@0.6, - 5%, c 30%@0.5, - 5%, c 30%@0.5; gap 6; row 30: n 30%@0.7^22, - 5%, n 30%@0.8^22, - 5%, n 30%@0.8^22; end; gap 20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="PlateBand" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource RadiusPanelTop}" ClipToBounds="True">
                                    <Grid>
                                        <Border x:Name="PlateWash" Style="{StaticResource ChannelWash}" local:Ui.Channel="Storage" CornerRadius="{StaticResource RadiusPanelTop}" />
                                        <Grid Margin="{StaticResource PanelPadding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Storage" Kind="storage" Width="44" Height="44" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="20,0,40,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DiskKind" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Storage}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock x:Name="DiskModel" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <!-- Texto do selo na base do modelo (DIN 30): 9 px em cima o descem até ela -->
                                                    <Border x:Name="DiskBadge" Style="{StaticResource Badge}" Margin="14,9,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Style="{StaticResource BadgeLed}" />
                                                            <TextBlock x:Name="DiskBadgeText" Style="{StaticResource BadgeText}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <!-- A especificação numa frase: chave em tom secundário e valor em tinta (DisksView.ShowSpecs) -->
                                                <TextBlock x:Name="DiskSpecs" FontSize="13.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,7,0,0" Background="Transparent" />
                                                <Grid x:Name="DiskReasonRow" Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="DiskReasonIcon" Style="{StaticResource IconGlyph}" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0" />
                                                    <TextBlock x:Name="DiskReasons" Grid.Column="1" Style="{StaticResource Body}" />
                                                </Grid>
                                            </StackPanel>
                                            <!-- Odômetro: só o que o disco informa (LayoutOdometer põe as células presentes, a primeira sem fio) -->
                                            <Border x:Name="OdoCard" Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel x:Name="OdoGrid" Orientation="Horizontal">
                                                    <Border x:Name="OdoCell0" Style="{StaticResource OdoCell}">
                                                        <StackPanel>
                                                            <TextBlock Text="Tempo ligado" Style="{StaticResource OdoLabel}" />
                                                            <TextBlock x:Name="OdoHours" Style="{StaticResource OdoValue}" />
                                                            <TextBlock x:Name="OdoHoursNote" Style="{StaticResource StatSub}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="OdoCell1" Style="{StaticResource OdoCell}">
                                                        <StackPanel>
                                                            <TextBlock Text="Ciclos liga/desliga" Style="{StaticResource OdoLabel}" />
                                                            <TextBlock x:Name="OdoCycles" Style="{StaticResource OdoValue}" />
                                                            <TextBlock x:Name="OdoCyclesNote" Style="{StaticResource StatSub}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="OdoCell2" Style="{StaticResource OdoCell}">
                                                        <StackPanel>
                                                            <TextBlock Text="Total gravado" Style="{StaticResource OdoLabel}" />
                                                            <TextBlock x:Name="OdoWritten" Style="{StaticResource OdoValue}" />
                                                            <TextBlock x:Name="OdoWrittenNote" Style="{StaticResource StatSub}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="OdoCell3" Style="{StaticResource OdoCell}">
                                                        <StackPanel>
                                                            <TextBlock Text="Total lido" Style="{StaticResource OdoLabel}" />
                                                            <TextBlock x:Name="OdoRead" Style="{StaticResource OdoValue}" />
                                                            <TextBlock x:Name="OdoReadNote" Style="{StaticResource StatSub}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Espaço: a barra por unidade, as unidades lado a lado embaixo (com mais de uma) e os três números à direita -->
                                <Grid x:Name="DiskSpace" Grid.Row="1" Margin="{StaticResource PanelPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Espaço" Style="{StaticResource SectionTitle}" />
                                        <local:CapacityBar x:Name="DiskCapacity" Margin="0,14,0,0" />
                                        <ItemsControl x:Name="DiskVolumes" ItemTemplate="{StaticResource VolumeRow}" Focusable="False" Margin="0,12,0,0"
                                                      Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border Style="{StaticResource SpaceCell}">
                                            <StackPanel>
                                                <TextBlock Text="Capacidade" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="SpaceTotal" Style="{StaticResource LifeValue}" FontSize="24" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SpaceCell}">
                                            <StackPanel>
                                                <TextBlock Text="Usado" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="SpaceUsed" Style="{StaticResource LifeValue}" FontSize="24" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SpaceCell}">
                                            <StackPanel>
                                                <TextBlock Text="Livre" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="SpaceFree" Style="{StaticResource LifeValue}" FontSize="24" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Vida útil -->
                        <Border x:Name="LifeCard" local:Skeleton.Top="34" local:Skeleton.Layout="foot 30: n 94@0.22^20, n 94@0.22^20, n 94@0.22^20; foot 20: c 94@0.62, c 94@0.5, c 94@0.7; footgap 12; footline; footgap 12; center 280: arc *~" Grid.Row="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Style="{StaticResource CardHeader}">
                                    <TextBlock Text="Vida útil" Style="{StaticResource CardTitle}" />
                                </Grid>
                                <local:LifeGauge x:Name="LifeDial" Grid.Row="1" MinHeight="210" Margin="0,10,0,8" Caption="restante" />
                                <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.4*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Desgaste" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="LifeWear" Style="{StaticResource LifeValue}" FontSize="23" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Reserva" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="LifeSpare" Style="{StaticResource LifeValue}" FontSize="23" />
                                        </StackPanel>
                                        <StackPanel x:Name="LifeEnduranceBox" Grid.Column="2">
                                            <TextBlock Text="Resistência" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="LifeEndurance" Style="{StaticResource LifeValue}" FontSize="23" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Temperatura -->
                        <Border x:Name="TempCard" local:Skeleton.Top="34" local:Skeleton.Layout="gap 10; row 18: c 33%@0.16~, c 33%@0.18~, c 33%@0.28~; gap 30; row 30: n 33%@0.1^20~, h 33%@0.36^22~, n 33%@0.1^20~; gap 32; row 20: box *^18; gap 6; row 14: c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.16, c 10%@0.2, c 10%@0.24; foot 38: c 92@0.95, - 20, s 150@0.95; footline; footgap 10; foot 16: - 44, c 44, - *, c 52~, - *, c 36>; footgap 4; gap 14; col 0 40; gap 6; spaced 4 14: c 32@0.9; col 44; rest: frame *; end" Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Cabeçalho de 34 px (CardHeader): o título e, à direita, de onde vem a leitura -->
                                <Grid Style="{StaticResource CardHeader}">
                                    <TextBlock Text="Temperatura" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse x:Name="TempLiveDot" Style="{StaticResource StatusLed}" Margin="0,1,8,0" />
                                        <TextBlock x:Name="TempLiveText" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Grid>
                                <!--
                                    Três leituras com rótulo, na mesma linha de base: os três valores têm a mesma altura de linha
                                    (bloco de 76 px, fonte Bahnschrift nos três), então a base cai no mesmo ponto em todos.
                                -->
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Agora" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Situação" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Máx. registrado" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TempNow" Grid.Row="1" Style="{StaticResource TempValue}" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" Text="—" />
                                    <TextBlock x:Name="TempState" Grid.Row="1" Grid.Column="1" Style="{StaticResource TempValue}" FontFamily="{StaticResource DisplayFont}" FontStretch="Normal" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TempPeak" Grid.Row="1" Grid.Column="2" Style="{StaticResource TempValue}" FontSize="28" HorizontalAlignment="Center" />
                                </Grid>
                                <local:ThermalScale x:Name="TempScale" Grid.Row="2" Margin="0,16,0,0" />
                                <local:TraceChart x:Name="TempTrace" Grid.Row="3" MinHeight="150" Margin="0,12,0,0" />
                                <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                                    <!-- Rótulo e leitura na mesma letra e tamanho: as bases coincidem (a leitura em Segoe 13 ficava 3 px abaixo) -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Atividade agora" Style="{StaticResource StatLabel}" Margin="0,0,20,0" />
                                        <TextBlock x:Name="DiskActivity" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Fg}" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>



                    <!-- Integridade: S.M.A.R.T. e contadores de erro, numa faixa discreta -->
                        <Border x:Name="CheckCard" local:Skeleton.Layout="row 32: h 96^16, - 16, - *, dot 8, - 8, c 120@0.8, - 8, pill 56^20, - *, dot 8, - 8, c 120@0.8, - 8, pill 56^20, - *, dot 8, - 8, c 120@0.8, - 8, pill 56^20, - *, dot 8, - 8, c 120@0.8, - 8, pill 56^20" Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}" Padding="24,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Título (17) e linhas (12,5) centrados: a base do título cairia 1 px abaixo; 2 px embaixo o sobem 1 -->
                                <TextBlock Text="Integridade" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,2" />
                                <ItemsControl x:Name="DiskChecks" Grid.Column="1" ItemTemplate="{StaticResource CheckRow}" Focusable="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:JustifyPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
