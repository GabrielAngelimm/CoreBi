<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.DisksView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Discos" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="DiskHealthStatus" Text="Saúde, desgaste e temperatura de cada disco." Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <Button x:Name="BtnDiskRefresh" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" VerticalAlignment="Top" Click="BtnDiskRefresh_Click" />
            </Grid>
            <ItemsControl x:Name="DiskCards" ItemTemplate="{StaticResource CardTemplate}" />
            <TextBlock Style="{StaticResource Footnote}" Margin="0,6,0,0" Text="Os dados vêm do Windows (S.M.A.R.T. e API de armazenamento) e dos sensores do disco. Pendrives e alguns HDs externos não informam saúde. O veredito é uma estimativa: faça backup de qualquer disco com aviso, não só dos críticos." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
