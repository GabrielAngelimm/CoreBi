<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.DisksView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- LED de veredito: cinza sem dado, verde, âmbar ou vermelho -->
        <Style x:Key="DiskLed" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource Faint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Ok}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Warn}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Danger"><Setter Property="Fill" Value="{DynamicResource Danger}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Baia do rack: só o nome do disco e as características principais -->
        <DataTemplate x:Key="DiskBay">
            <Grid Margin="4,3,2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="&#xEDA2;" Style="{StaticResource ListNavIcon}" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Ellipse Grid.Column="2" Style="{StaticResource DiskLed}" Margin="10,0,0,0" ToolTip="{Binding VerdictText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Meta}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Selo de especificação na placa do disco -->
        <DataTemplate x:Key="SpecChip">
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8,2,8,3" Margin="0,0,6,6">
                <TextBlock FontSize="12" Typography.NumeralAlignment="Tabular">
                    <Run Text="{Binding Key, Mode=OneWay}" Foreground="{DynamicResource Muted}" /><Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" />
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- Unidade (letra), só quando o disco tem mais de uma: nome e quanto está livre -->
        <DataTemplate x:Key="VolumeRow">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Line}" Foreground="{DynamicResource Muted}" Style="{StaticResource Num}" Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Linha da integridade: LED, o que é verificado e o valor lido -->
        <DataTemplate x:Key="CheckRow">
            <Grid Margin="0,3" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource DiskLed}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Border x:Name="pill" Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center" Padding="8,1,8,2" ToolTip="{Binding Tip}">
                    <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource BadgeText}" Typography.NumeralAlignment="Tabular" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="">
                    <Setter TargetName="pill" Property="Background" Value="Transparent" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Faint}" />
                    <Setter TargetName="value" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource OkSoft}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Ok}" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarnSoft}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Warn}" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Danger">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource DangerSoft}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Danger}" />
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Célula do odômetro: rótulo, leitura grande e uma linha de contexto -->
        <Style x:Key="OdoCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
        <Style x:Key="OdoValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutLarge}">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="LifeValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <!--
        Uma tela: com a janela maximizada tudo cabe sem rolar (os instrumentos ocupam a sobra de altura). À esquerda, o rack
        com uma baia por disco; à direita, o disco escolhido: placa de identificação, vida útil, temperatura, odômetro e, numa faixa
        discreta embaixo, a integridade. Em janelas menores o odômetro desce em faixa 2 × 2 e a página rola.
    -->
    <ScrollViewer x:Name="DiskScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=DiskScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Discos" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="DiskHealthStatus" Text="Saúde, desgaste e temperatura de cada disco." Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <Button x:Name="BtnDiskRefresh" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" VerticalAlignment="Top" Click="BtnDiskRefresh_Click" />
                </Grid>

                <Grid x:Name="DiskBody" Grid.Row="1" SizeChanged="DiskBody_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RackColumn" Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Rack: um disco por baia; embaixo, o conjunto e a fonte dos dados -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="Instalados" Style="{StaticResource Label}" Margin="0" />
                            <TextBlock x:Name="RackCount" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <ListBox x:Name="DiskCards" Grid.Row="1" ItemTemplate="{StaticResource DiskBay}" ItemContainerStyle="{StaticResource ListNavItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="DiskCards_SelectionChanged" AutomationProperties.Name="Discos instalados" />
                    </Grid>

                    <!-- Disco escolhido -->
                    <Grid x:Name="DiskPanel" Grid.Column="2" Visibility="Hidden">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LifeColumn" Width="370" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="OdoGap" Width="16" />
                            <ColumnDefinition x:Name="OdoColumn" Width="170" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="CheckGapRow" Height="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Placa de identificação: modelo, veredito, especificação e espaço por unidade -->
                        <Border x:Name="DiskPlate" Grid.ColumnSpan="5" Style="{StaticResource CardBorder}" Padding="24,18,24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition x:Name="SpaceColumn" Width="520" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DiskModel" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border x:Name="DiskBadge" Style="{StaticResource Badge}" Margin="12,2,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DiskBadgeText" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl x:Name="DiskSpecs" ItemTemplate="{StaticResource SpecChip}" Margin="0,10,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiskReasonIcon" Style="{StaticResource IconGlyph}" FontSize="14" VerticalAlignment="Top" Margin="0,2,9,0" />
                                        <TextBlock x:Name="DiskReasons" Grid.Column="1" Style="{StaticResource Body}" />
                                    </Grid>
                                </Grid>
                                <Border x:Name="SpaceDivider" Grid.Column="1" Width="1" Background="{DynamicResource Line}" Margin="26,0" />
                                <StackPanel x:Name="DiskSpace" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Espaço" Style="{StaticResource SectionTitle}" />
                                    <local:CapacityBar x:Name="DiskCapacity" Margin="0,12,0,14" />
                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Text="Capacidade" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="SpaceTotal" Style="{StaticResource LifeValue}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Usado" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="SpaceUsed" Style="{StaticResource LifeValue}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Livre" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="SpaceFree" Style="{StaticResource LifeValue}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <ItemsControl x:Name="DiskVolumes" ItemTemplate="{StaticResource VolumeRow}" Focusable="False" Margin="0,14,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Vida útil -->
                        <Border x:Name="LifeCard" Grid.Row="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Vida útil" Style="{StaticResource SectionTitle}" />
                                <local:LifeGauge x:Name="LifeDial" Grid.Row="1" MinHeight="210" Margin="0,6" Caption="vida útil restante" />
                                <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.4*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Desgaste" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="LifeWear" Style="{StaticResource LifeValue}" FontSize="23" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Reserva" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="LifeSpare" Style="{StaticResource LifeValue}" FontSize="23" />
                                        </StackPanel>
                                        <StackPanel x:Name="LifeEnduranceBox" Grid.Column="2">
                                            <TextBlock Text="Resistência" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="LifeEndurance" Style="{StaticResource LifeValue}" FontSize="23" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Temperatura -->
                        <Border x:Name="TempCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="Temperatura" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse x:Name="TempLiveDot" Width="7" Height="7" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,1,7,0" />
                                        <TextBlock x:Name="TempLiveText" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TempNow" Style="{StaticResource ReadoutHero}" FontSize="72" Text="—" />
                                        <TextBlock Text="°C" Style="{StaticResource Unit}" FontSize="20" Margin="6,0,0,13" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Situação" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TempState" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Máx. registrado" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TempPeak" Style="{StaticResource ReadoutText}" FontSize="28" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <local:ThermalScale x:Name="TempScale" Grid.Row="2" Margin="0,18,0,0" />
                                <local:TraceChart x:Name="TempTrace" Grid.Row="3" MinHeight="150" Margin="0,12,0,0" />
                                <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,11,0,0" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Atividade agora" Foreground="{DynamicResource Muted}" Margin="0,0,20,0" />
                                        <TextBlock x:Name="DiskActivity" Style="{StaticResource Num}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Odômetro: uso acumulado desde a fábrica -->
                        <Border x:Name="OdoCard" Grid.Row="2" Grid.Column="4" Style="{StaticResource CardBorder}" Padding="0">
                            <UniformGrid x:Name="OdoGrid" Columns="4">
                                <Border x:Name="OdoCell0" Style="{StaticResource OdoCell}" BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Text="Tempo ligado" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="OdoHours" Style="{StaticResource OdoValue}" />
                                        <TextBlock x:Name="OdoHoursNote" Style="{StaticResource Caption}" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OdoCell1" Style="{StaticResource OdoCell}">
                                    <StackPanel>
                                        <TextBlock Text="Ciclos liga/desliga" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="OdoCycles" Style="{StaticResource OdoValue}" />
                                        <TextBlock x:Name="OdoCyclesNote" Style="{StaticResource Caption}" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OdoCell2" Style="{StaticResource OdoCell}">
                                    <StackPanel>
                                        <TextBlock Text="Total gravado" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="OdoWritten" Style="{StaticResource OdoValue}" />
                                        <TextBlock x:Name="OdoWrittenNote" Style="{StaticResource Caption}" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OdoCell3" Style="{StaticResource OdoCell}">
                                    <StackPanel>
                                        <TextBlock Text="Total lido" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="OdoRead" Style="{StaticResource OdoValue}" />
                                        <TextBlock x:Name="OdoReadNote" Style="{StaticResource Caption}" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>
                    <!-- Integridade: S.M.A.R.T. e contadores de erro, numa faixa discreta -->
                        <Border x:Name="CheckCard" Grid.Row="4" Grid.ColumnSpan="5" Style="{StaticResource CardBorder}" Padding="22,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Integridade" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                                <ItemsControl x:Name="DiskChecks" Grid.Column="1" ItemTemplate="{StaticResource CheckRow}" Focusable="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:JustifyPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
