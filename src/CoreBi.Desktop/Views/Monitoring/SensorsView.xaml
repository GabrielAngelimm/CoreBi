<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.SensorsView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- Cabeçalho das colunas de um grupo: miúdo e um tom abaixo, alinhado com os números (à direita) -->
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <!-- Mínimo, média e máximo: mesmos algarismos tabulares da leitura, menores e em tom secundário. Centrados na linha de 32,
             os números em Bahnschrift assentavam 2 px acima do nome em Segoe 13; descem 2 (2 em cima, −2 embaixo), como a leitura. -->
        <Style x:Key="StatCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Readout}" />
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,-2" />
        </Style>

        <!-- Item do índice (11 em cima e embaixo, 6 entre um e outro: sem a memória física e a virtual sobra altura, e o respiro
             deixa a lista mais legível): fundo elevado na seleção; o ícone, sem fundo, na cor do canal do componente (a mesma do filete dos grupos) -->
        <Style x:Key="IndexItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Margin="0,0,0,6">
                            <Border x:Name="hover" CornerRadius="{StaticResource RadiusInset}" Background="{DynamicResource Hover}" Opacity="0" />
                            <Border x:Name="sel" CornerRadius="{StaticResource RadiusInset}" Background="{DynamicResource Selected}" Opacity="0" />
                            <ContentPresenter Margin="10,11" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha de sensor: nome claro, leitura atual com a unidade e as três estatísticas sem unidade (a unidade está ao lado do
             título do grupo). O fio fica em cima de cada linha; o mouse acende o fundo, que avança 8 px para os lados. A dica do
             "Núcleo mais exigido" diz qual núcleo é, na hora (SensorLine_ToolTipOpening). -->
        <DataTemplate x:Key="SensorLine">
            <Grid x:Name="host" Margin="-8,0" Background="Transparent" ToolTip="{Binding Tip}" ToolTipOpening="SensorLine_ToolTipOpening">
                <Border x:Name="bg" Background="{DynamicResource Hover}" CornerRadius="{StaticResource RadiusControl}" Opacity="0" />
                <Border Height="1" VerticalAlignment="Top" Margin="8,0" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
                <Grid Margin="8,0" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,8,0" />
                    <TextBlock x:Name="value" Grid.Column="1" Style="{StaticResource ReadoutText}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,0,-2">
                        <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" " FontSize="11" /><Run x:Name="unit" Text="{Binding Unit, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding MinNumber}" Style="{StaticResource StatCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding AvgNumber}" Style="{StaticResource StatCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding MaxNumber}" Style="{StaticResource StatCell}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="host" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RawValue}" Value="{x:Null}">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Faint}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Nomes das colunas: uma vez por cartão (no topo do corpo), com a mesma geometria das linhas. A dica das estatísticas diz
             desde quando elas contam (SensorsView.StatsNote). -->
        <DataTemplate x:Key="ColumnHeads">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Atual" Style="{StaticResource ColHead}" />
                <TextBlock Grid.Column="2" Text="Mín." Style="{StaticResource ColHead}" ToolTip="{Binding StatsNote, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Grid.Column="3" Text="Média" Style="{StaticResource ColHead}" ToolTip="{Binding StatsNote, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Grid.Column="4" Text="Máx." Style="{StaticResource ColHead}" ToolTip="{Binding StatsNote, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>
        </DataTemplate>

        <!-- Grupo de um tipo: o título é o maior e mais forte do bloco, com um filete na cor do canal do componente (o mesmo da
             Visão geral e da barra lateral) e a unidade do grupo ao lado ("em °C"), que vale para mínimo, média e máximo; sem
             contagem, que o cabeçalho do componente já dá. Os sensores entram recuados embaixo. A segunda metade de um grupo
             longo (coluna da direita) não repete o título, mas guarda a altura dele para as linhas das duas colunas alinharem. -->
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel>
                <StackPanel x:Name="head" Orientation="Horizontal" Margin="0,0,0,8">
                    <!-- Filete centrado na caixa do título: o meio dele cai no meio das maiúsculas (com 1 px a mais em cima ficava 1 abaixo) -->
                    <Border x:Name="mark" Width="3" Height="15" CornerRadius="1.5" Background="{DynamicResource Steel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource GroupTitle}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UnitText, Mode=OneWay}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="8,2,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SensorLine}" Focusable="False" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Continued}" Value="True"><Setter TargetName="head" Property="Visibility" Value="Hidden" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Cpu"><Setter TargetName="mark" Property="Background" Value="{DynamicResource Cpu}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Gpu"><Setter TargetName="mark" Property="Background" Value="{DynamicResource Gpu}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Memory"><Setter TargetName="mark" Property="Background" Value="{DynamicResource Memory}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Storage"><Setter TargetName="mark" Property="Background" Value="{DynamicResource Storage}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Virtual"><Setter TargetName="mark" Property="Background" Value="{DynamicResource Virtual}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Board"><Setter TargetName="mark" Property="Background" Value="{DynamicResource Board}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Net"><Setter TargetName="mark" Property="Background" Value="{DynamicResource Net}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Cabeçalho de componente em duas faixas, de altura fixa (90 + 32), cada uma num tom: em cima, no tom mais forte, o nome em
             destaque com o tipo e a quantidade de sensores embaixo; logo abaixo, num tom intermediário, os nomes das colunas. Os
             sensores ficam no fundo do cartão, o mais claro dos três. É o mesmo modelo no começo de cada
             bloco e no cabeçalho fixo do topo da rolagem, para a troca não dar salto. -->
        <DataTemplate x:Key="ComponentHeader">
            <StackPanel>
                <!-- Fundo claro na cor do componente, uniforme, como a placa de Sistema -->
                <Border Height="90" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                    <Grid>
                    <Border Style="{StaticResource ChannelWash}" local:Ui.Channel="{Binding Tone}" Margin="0,0,-12,0" />
                    <Grid Margin="24,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Nome e tipo com o mesmo respiro dos quatro lados: 24 da borda até a tinta em cima, embaixo e à esquerda (90 de
                             altura; centrado, o bloco ficava 1 px baixo, porque a DIN tem mais folga embaixo, daí os 2 de margem no pé) -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Note}" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular">
                                <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource Faint}" /><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource Fg}" />
                            </TextBlock>
                        </StackPanel>
                        <Button x:Name="toggle" Grid.Column="1" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0" Margin="18,0,0,0" VerticalAlignment="Center" Click="Toggle_Click" ToolTip="Recolher" AutomationProperties.Name="Recolher ou expandir">
                            <TextBlock x:Name="chev" Text="&#xE70E;" Style="{StaticResource IconGlyph}" FontSize="12" />
                        </Button>
                    </Grid>
                    </Grid>
                </Border>
                <!-- Faixa das colunas: a mesma geometria do corpo (24 de cada lado, duas colunas de grupos separadas por 44) -->
                <Border Height="32" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0,24,0" SnapsToDevicePixels="True">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="head1" Content="{Binding}" ContentTemplate="{StaticResource ColumnHeads}" />
                        <ContentPresenter x:Name="head2" Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ColumnHeads}" />
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SectionColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                    <Setter TargetName="head1" Property="Grid.ColumnSpan" Value="3" />
                    <Setter TargetName="head2" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Sections.Count}" Value="1">
                    <Setter TargetName="head2" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanCollapse}" Value="False">
                    <Setter TargetName="toggle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Expanded}" Value="False">
                    <Setter TargetName="chev" Property="Text" Value="&#xE70D;" />
                    <Setter TargetName="toggle" Property="ToolTip" Value="Expandir" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Bloco de componente dentro do cartão único: cabeçalho e, embaixo, os grupos de sensores (em colunas quando há largura) -->
        <DataTemplate x:Key="ComponentBlock">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ComponentHeader}" />
                <Border x:Name="body" Padding="24,18,24,32">
                    <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <inv:ColumnsPanel Columns="{Binding SectionColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" ColumnGap="44" RowGap="32" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Expanded}" Value="False">
                    <Setter TargetName="body" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Monitor de hardware: à esquerda o índice (fixo): "Visão geral" mostra todos os componentes na ordem de uso, e escolher um
        componente mostra só ele. À direita, o filtro por tipo e os cartões, que rolam. Cada cartão identifica o componente no
        cabeçalho e lista os sensores agrupados por tipo, em duas colunas quando há largura. As leituras aparecem só nas
        linhas, uma vez.
    -->
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Cabeçalho padrão: busca e "Zerar estatísticas" na barra de ações. A dica do botão diz desde quando as estatísticas contam
             (SensorsView.UpdateStatsNote). -->
        <local:PageHeaderPanel Style="{StaticResource PageHead}">
            <TextBlock Text="Sensores" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Temperatura, uso e consumo de cada peça, lidos a cada segundo." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
            <StackPanel Style="{StaticResource PageActions}">
                <TextBlock x:Name="StatusText" Text="Lendo sensores…" Style="{StaticResource PageStatus}" local:HeaderMotion.SoftText="False" Margin="0,0,20,2" Typography.NumeralAlignment="Tabular"
                           ToolTip="A leitura é a cada segundo e pausa durante o teste de placa de vídeo." />
                <TextBox x:Name="SensorSearch" Style="{StaticResource SearchField}" local:Ui.Placeholder="Buscar sensor ou componente" Margin="0,0,10,0" TextChanged="SensorSearch_Changed" />
                <Button x:Name="BtnSensorsReset" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE777;" Content="Zerar estatísticas" Click="BtnSensorsReset_Click" />
            </StackPanel>
        </local:PageHeaderPanel>

        <Grid x:Name="SensorBody" Grid.Row="1" SizeChanged="SensorBody_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IndexColumn" Width="300" />
                <ColumnDefinition x:Name="IndexGap" Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Índice: um item por componente, na altura toda da página (a base alinha com a do cartão ao lado); escolher um mostra só ele.
                 14 do cartão + 10 do item = 24, o recuo dos outros painéis; o fundo da seleção avança 10 para os lados. -->
            <!-- Esqueleto: os itens do índice, com o desenho e as duas linhas de cada um -->
            <Border x:Name="IndexCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,20,14,12" local:Skeleton.Top="24"
                    local:Skeleton.Layout="gap 1; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16; col 10 30; gap 13; row 30: box 30^30; col 52 70%; gap 11; row 17: s *@0.62; gap 2; row 16: c *@0.42; end; gap 16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Componentes" Style="{StaticResource Label}" Margin="10,0,10,8" />
                    <ListBox x:Name="SensorIndex" ItemContainerStyle="{StaticResource IndexItem}" SelectionChanged="SensorIndex_Changed" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Note}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="{Binding Tone}" Kind="{Binding Glyph}" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Nome inteiro: quebra em até duas linhas em vez de cortar -->
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="17" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Filtros por tipo: sobre o cartão de sensores, alinhados com ele. O rótulo e as pílulas ficam num mesmo grupo de
                 fundo próprio, para ler como um controle só; o índice e o cartão continuam começando na mesma linha. -->
            <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="14,5,5,5" CornerRadius="18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" SnapsToDevicePixels="True">
                <DockPanel>
                    <!-- O rótulo assenta na linha de base do texto das pílulas (7 em cima; com 5 ficava 2 px acima) e o funil sobe 2, para
                         o meio dele cair no meio das maiúsculas do rótulo -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,7,12,0">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource Signal}" Margin="0,1,8,0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="-2" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Filtrar por tipo de sensor" FontFamily="{StaticResource LabelFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <WrapPanel x:Name="CategoryChips" Margin="0,0,0,-6" />
                </DockPanel>
            </Border>

            <!-- Um cartão só para todos os componentes. O cabeçalho do componente à vista fica fixo no topo e é trocado, ou empurrado
                 pelo seguinte, conforme a rolagem (ver SensorsView.UpdateSticky). -->
            <!-- Esqueleto: cabeçalho do componente, a faixa de colunas e os grupos em duas metades, com as linhas de 32 -->
            <Border x:Name="SensorCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="SensorCard_SizeChanged"
                    local:Skeleton.Layout="gap 23; row 26: - 24, h 280^18, - *, c 12^8, - 30; gap 4; row 18: - 24, c 70, - 12, c 70, - *; gap 19; line; row 31: - 24, - *, c 74@0.4>, c 74@0.36>, c 74@0.48>, c 74@0.42>, - 45, - *, c 74@0.4>, c 74@0.36>, c 74@0.48>, c 74@0.42>, - 24; line; gap 12; col 0 50%; row 30: - 24, c 3^16, - 9, s 44, - 8, c 28, - *; gap 4; lines 2 32: - 24, - 12, t *, s 74@0.6>, c 74@0.5>, c 74@0.5>, c 74@0.55>, - 22; gap 18; row 30: - 24, c 3^16, - 9, s 44, - 8, c 28, - *; gap 4; lines 32: - 24, - 12, t *, s 74@0.6>, c 74@0.5>, c 74@0.5>, c 74@0.55>, - 22; col 50% 50%; row 30: - 23, c 3^16, - 9, s 44, - 8, c 28, - *; gap 4; lines 32: - 23, - 12, t *, s 74@0.6>, c 74@0.5>, c 74@0.5>, c 74@0.55>, - 24; end">
                <Grid>
                    <ScrollViewer x:Name="SensorScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="SensorScroll_ScrollChanged">
                        <!-- A barra de rolagem começa abaixo do cabeçalho fixo (122 = 90 + 32) para o cabeçalho nunca cobrir a barra. O
                             conteúdo ocupa a largura toda e a barra passa por cima da margem direita (24 px): assim os cabeçalhos
                             de cada bloco terminam na mesma borda do cabeçalho fixo, com ou sem barra. -->
                        <ScrollViewer.Template>
                            <ControlTemplate TargetType="ScrollViewer">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.ColumnSpan="2" CanContentScroll="{TemplateBinding CanContentScroll}" />
                                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="0,126,2,4" Orientation="Vertical" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                </Grid>
                            </ControlTemplate>
                        </ScrollViewer.Template>
                        <StackPanel x:Name="SensorStack">
                            <StackPanel x:Name="SensorEmpty" Margin="24,20" Visibility="Collapsed">
                                <TextBlock x:Name="SensorEmptyTitle" Text="Detectando o hardware…" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SensorEmptyText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="SensorCards" ItemTemplate="{StaticResource ComponentBlock}" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="StickyHost" VerticalAlignment="Top" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="StickyShift" />
                        </Grid.RenderTransform>
                        <!-- Fundo das duas faixas na largura toda; a barra de rolagem começa abaixo delas (modelo da rolagem acima), então nada fica escondido -->
                        <StackPanel>
                            <Border Height="90" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True" />
                            <Border Height="32" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True" />
                        </StackPanel>
                        <ContentControl x:Name="StickyHeader" ContentTemplate="{StaticResource ComponentHeader}" Focusable="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
