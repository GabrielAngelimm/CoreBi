<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.SensorsView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- Cabeçalho das colunas de um grupo: miúdo e um tom abaixo, alinhado com os números (à direita) -->
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <!-- Mínimo, média e máximo: mesmos algarismos tabulares da leitura, menores e em tom secundário -->
        <Style x:Key="StatCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Readout}" />
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Linha de sensor: nome claro, leitura atual com a unidade e as três estatísticas sem unidade.
             O fio fica em cima de cada linha; o mouse acende o fundo, que avança 8 px para os lados. -->
        <DataTemplate x:Key="SensorLine">
            <Grid x:Name="host" Margin="-8,0" Background="Transparent" ToolTip="{Binding Tip}">
                <Border x:Name="bg" Background="{DynamicResource Hover}" CornerRadius="6" Opacity="0" />
                <Border Height="1" VerticalAlignment="Top" Margin="8,0" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
                <Grid Margin="8,0" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="value" Grid.Column="1" Style="{StaticResource ReadoutText}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" " FontSize="11" /><Run x:Name="unit" Text="{Binding Unit, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding MinNumber}" Style="{StaticResource StatCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding AvgNumber}" Style="{StaticResource StatCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding MaxNumber}" Style="{StaticResource StatCell}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="host" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RawValue}" Value="{x:Null}">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Faint}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grupo de um tipo: título e quantidade à esquerda, nomes das colunas alinhados com as células das linhas -->
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" /><Run Text="   " /><Run Text="{Binding Rows.Count, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource Faint}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="Atual" Style="{StaticResource ColHead}" />
                    <TextBlock Grid.Column="2" Text="Mín." Style="{StaticResource ColHead}" />
                    <TextBlock Grid.Column="3" Text="Média" Style="{StaticResource ColHead}" />
                    <TextBlock Grid.Column="4" Text="Máx." Style="{StaticResource ColHead}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SensorLine}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- Cartão de componente: ícone, tipo e nome; as leituras ficam só nos grupos, embaixo, em colunas -->
        <DataTemplate x:Key="ComponentCard">
            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="24,18,18,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="tile" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                            <TextBlock x:Name="glyph" Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" FontSize="20" Foreground="{DynamicResource Accent}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular">
                                <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource Faint}" /><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource Faint}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="toggle" Grid.Column="3" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0" Margin="18,0,0,0" VerticalAlignment="Center" Click="Toggle_Click" ToolTip="Recolher" AutomationProperties.Name="Recolher ou expandir">
                            <TextBlock x:Name="chev" Text="&#xE70E;" Style="{StaticResource IconGlyph}" FontSize="12" />
                        </Button>
                    </Grid>
                    <Border x:Name="body" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,18,24,20">
                        <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <inv:ColumnsPanel Columns="{Binding SectionColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" ColumnGap="44" RowGap="26" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Channel}" Value="1">
                    <Setter TargetName="tile" Property="Background" Value="{DynamicResource CopperSoft}" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Copper}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Channel}" Value="2">
                    <Setter TargetName="tile" Property="Background" Value="{DynamicResource Raised}" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Steel}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Expanded}" Value="False">
                    <Setter TargetName="body" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="chev" Property="Text" Value="&#xE70D;" />
                    <Setter TargetName="toggle" Property="ToolTip" Value="Expandir" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Monitor de hardware: à esquerda o índice dos componentes (fixo, só nomes); à direita o filtro por tipo e os cartões,
        que rolam. Cada cartão identifica o componente no cabeçalho e lista os sensores agrupados por tipo, em duas colunas
        quando há largura. As leituras aparecem só nas linhas, uma vez.
    -->
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Sensores" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="StatusText" Text="Lendo sensores…" Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox x:Name="SensorSearch" Width="280" local:Ui.Icon="&#xE721;" local:Ui.Placeholder="Buscar sensor ou componente" TextChanged="SensorSearch_Changed" />
                <Button x:Name="BtnSensorsReset" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE777;" Content="Zerar estatísticas" Margin="10,0,0,0" Click="BtnSensorsReset_Click" ToolTip="Recomeça o mínimo, a média e o máximo de todos os sensores a partir de agora." />
            </StackPanel>
        </Grid>

        <Grid x:Name="SensorBody" Grid.Row="1" SizeChanged="SensorBody_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IndexColumn" Width="300" />
                <ColumnDefinition x:Name="IndexGap" Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Índice: um item por componente; clicar leva ao cartão, e rolar a lista acende o componente à vista -->
            <Border x:Name="IndexCard" Style="{StaticResource CardBorder}" Padding="10,14,10,10" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, ElementName=SensorBody}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Componentes" Style="{StaticResource Label}" Margin="10,0,10,8" />
                    <ListBox x:Name="SensorIndex" ItemContainerStyle="{StaticResource ListNavItem}" SelectionChanged="SensorIndex_Changed" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource ListNavIcon}" FontSize="15" Width="18" Margin="0,1,12,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Nome inteiro: quebra em até duas linhas em vez de cortar -->
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="17" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Kind}" FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel x:Name="CategoryChips" Margin="0,0,0,12" />
                <ScrollViewer x:Name="SensorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="SensorScroll_Changed">
                    <StackPanel x:Name="SensorStack">
                        <Border x:Name="SensorEmpty" Style="{StaticResource CardBorder}" Padding="24,22" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="SensorEmptyTitle" Text="Detectando o hardware…" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SensorEmptyText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="SensorCards" ItemTemplate="{StaticResource ComponentCard}" Focusable="False" />
                        <TextBlock x:Name="SensorFootnote" Style="{StaticResource Footnote}" MaxWidth="900" Margin="2,2,0,6" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
