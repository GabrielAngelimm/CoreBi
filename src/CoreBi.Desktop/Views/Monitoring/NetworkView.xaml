<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.NetworkView" xmlns:local="clr-namespace:CoreBi.Desktop"
             FontSize="14" IsVisibleChanged="NetworkView_IsVisibleChanged">
    <!--
        Rede: o teste é comandado por um console ao lado do título (botão, estado com a etapa, barra com as três estações e
        porcentagem; barra e porcentagem só durante o teste). O diagnóstico tem duas metades: à esquerda o instrumento (download e upload em dois arcos espelhados de
        escala logarítmica, com a unidade no centro); à direita a latência em destaque e as grandezas de apoio (jitter, perda,
        latência sob carga e resolução de nome) numa grade compacta; o veredito fecha o painel. Abaixo, ocupando a sobra de
        altura: o caminho PC → roteador → internet (onde está o atraso), com o traço dos pings, o histórico dos testes (clicar
        num deles mostra aquele teste) e os dados da conexão. O último teste guardado já abre na página.
        Cabe numa tela com a janela maximizada; em janelas menores o instrumento diminui e a página rola, e em janelas
        estreitas o console desce para baixo do título.
    -->
    <UserControl.Resources>
        <!-- Nome de uma estação do teste sobre o trecho dela na barra (NetworkView.ShowStages pinta conforme a etapa) -->
        <Style x:Key="NetStage" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
        </Style>
        <Style x:Key="NetReadout" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="96" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="LineHeight" Value="96" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <!-- Grandezas de apoio no degrau dos instrumentos (34) da escala de mostrador -->
        <Style x:Key="NetStatValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>
        <!-- Célula da grade de apoio: rótulo, valor e uma linha de contexto; o fio separa as células. A unidade ao lado do valor
             leva 4 px no pé: com 5 a base dela ficava 1 px acima da do número (medido na captura de 1920 × 1032). -->
        <Style x:Key="NetStatCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,16,16,16" />
        </Style>
        <Style x:Key="NetNodeValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="NetNodeSub" TargetType="TextBlock" BasedOn="{StaticResource StatSub}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Dados da conexão: linhas com fio entre elas, valor à direita -->
        <DataTemplate x:Key="NetInfoRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,4">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Style="{StaticResource Num}" ToolTip="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="NetScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=NetScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" MinHeight="250" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho padrão (PageHeaderPanel), o mesmo de Ferramentas: o estado do teste no subtítulo, com a etapa ao lado ("2 de 3 ·
                     Download"), e na barra de ações o medidor (com cortes nas três estações, nas frações do motor, e a porcentagem), que só
                     aparece durante o teste, e a ação principal. -->
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Rede" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Velocidade, latência e estabilidade da sua conexão." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                    <StackPanel Style="{StaticResource PageActions}">
                        <!--
                            Medidor do teste: as três estações escritas em cima de cada trecho da barra (a da vez acesa no sinal, as feitas no tom do
                            texto, as que faltam apagadas), a barra de 6 px com os cortes nas frações do motor (NetworkTest.LatencyEnd e DownloadEnd)
                            e a porcentagem grande à direita. Só aparece durante o teste; parado, o espaço fica reservado.
                        -->
                        <Grid x:Name="NetTrack" Style="{StaticResource TaskMeter}" Width="400" Margin="0,0,22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="33*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="38*" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="29*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NetStage1" Text="Latência" Style="{StaticResource NetStage}" />
                                <TextBlock x:Name="NetStage2" Grid.Column="2" Text="Download" Style="{StaticResource NetStage}" />
                                <TextBlock x:Name="NetStage3" Grid.Column="4" Text="Upload" Style="{StaticResource NetStage}" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,7,0,0">
                                    <Grid Style="{StaticResource ProgressTrack}" Height="6">
                                        <Border x:Name="NetProgressFill" Style="{StaticResource ProgressFill}">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="NetProgress" ScaleX="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <!-- Cortes entre as estações, na cor da página -->
                                    <Grid Margin="0,-1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="33*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="38*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="29*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Background="{DynamicResource Bg}" />
                                        <Border Grid.Column="3" Background="{DynamicResource Bg}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                            <!-- A porcentagem conta junto com a barra (HeaderMotion) -->
                            <TextBlock x:Name="NetPercent" Grid.Column="1" Style="{StaticResource TaskPercent}" FontSize="24" FontWeight="Light" MinWidth="72" Margin="16,0,0,0" />
                        </Grid>
                        <DockPanel Style="{StaticResource PageStatusSlot}">
                            <TextBlock x:Name="NetDetail" Style="{StaticResource PageDetail}" DockPanel.Dock="Right" />
                            <TextBlock x:Name="NetStatus" Text="Pronto para testar" Style="{StaticResource PageStatus}" Typography.NumeralAlignment="Tabular" TextAlignment="Right" />
                        </DockPanel>
                        <Button x:Name="BtnNetTest" Style="{StaticResource HeaderPrimary}" local:Ui.Icon="&#xE768;" Content="Testar a rede" Click="BtnNetTest_Click"
                                ToolTip="Envia pings ao roteador e aos DNS 1.1.1.1 e 8.8.8.8 e transfere dados para medir a velocidade. O consumo pode chegar a centenas de MB." />
                    </StackPanel>
                </local:PageHeaderPanel>

                <!-- Diagnóstico: à esquerda o instrumento, à direita a latência e as grandezas de apoio (em janelas estreitas elas descem para uma faixa embaixo do instrumento) -->
                <Border x:Name="NetDiagCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="NetDiagCard_SizeChanged">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Cabeçalho de 34 px (CardHeader): o título e, à direita, de onde vem o resultado e o selo do veredito -->
                        <Grid Style="{StaticResource CardHeader}" Margin="24,16,24,0">
                            <TextBlock Text="Diagnóstico de rede" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="NetDiagTitle" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="NetMeta" Text="Ainda não testado nesta sessão" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <Border x:Name="NetBadge" Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource BadgeLed}" />
                                        <TextBlock x:Name="NetBadgeText" Style="{StaticResource BadgeText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="NetDiagBody" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition x:Name="NetMetricsColumn" Width="2*" MinWidth="380" MaxWidth="520" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Instrumento: download e upload grandes, nos dois arcos espelhados; a unidade é uma só, no centro. Cresce até 330 px de
                                 altura, centrado na sua metade (rente à margem sobrava um vão morto à esquerda do download), e diminui junto com a janela. -->
                            <Viewbox x:Name="NetInstrument" Stretch="Uniform" StretchDirection="Both" MaxHeight="330" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,8">
                                <Grid Width="860" Height="290">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="270" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="270" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Canal A: download -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Download" Style="{StaticResource StatLabel}" />
                                            <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource NetDown}" Margin="8,1,0,0" Width="16" Height="4" />
                                        </StackPanel>
                                        <TextBlock x:Name="NetDown" Text="—" Style="{StaticResource NetReadout}" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" Margin="0,14,0,0" />
                                    </StackPanel>
                                    <!-- Mostrador: arcos desenhados em código (NetworkView.DrawDial) -->
                                    <Grid Grid.Column="1" Width="320" Height="260">
                                        <Canvas x:Name="NetDial" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Mbps" Style="{StaticResource ReadoutText}" FontSize="24" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                            <TextBlock Text="1 Mbps a 1 Gbps" Style="{StaticResource StatSub}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Canal B: upload -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource NetUp}" Margin="0,1,8,0" Width="16" Height="4" />
                                            <TextBlock Text="Upload" Style="{StaticResource StatLabel}" />
                                        </StackPanel>
                                        <TextBlock x:Name="NetUp" Text="—" Style="{StaticResource NetReadout}" Foreground="{DynamicResource Faint}" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <!-- Latência em destaque e grandezas de apoio -->
                            <Border x:Name="NetMetricsPanel" Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Margin="0,8,0,16" Padding="32,0,24,0">
                                <Grid x:Name="NetMetricsGrid" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="NetHero" Grid.ColumnSpan="2" Background="Transparent" ToolTip="Tempo de ida e volta até a internet. Quanto menor, mais rápida a resposta em jogos e chamadas.">
                                        <TextBlock Text="Latência" Style="{StaticResource StatLabel}" />
                                        <!-- Leitura e unidade como Runs do mesmo TextBlock: a mesma linha de base por construção (alinhada pelo pé
                                             com margem, a unidade ficava 3 px abaixo da base do número). O espaço médio a 14 px dá 7 px. -->
                                        <TextBlock x:Name="NetLatencyLine" Style="{StaticResource ReadoutText}" FontSize="54" FontWeight="Light" Margin="0,4,0,16">
                                            <Run x:Name="NetLatency" Text="—" Foreground="{DynamicResource Faint}" /><Run x:Name="NetLatencyCaption" Text="&#x2002;ms" FontFamily="{StaticResource LabelFont}" FontStretch="Normal" FontWeight="Normal" FontSize="14" Foreground="{DynamicResource Muted}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <UniformGrid x:Name="NetCells" Grid.Row="1" Grid.ColumnSpan="2" Columns="2">
                                        <Border x:Name="NetCell1" Style="{StaticResource NetStatCell}" Background="Transparent" ToolTip="Quanto a latência varia de um ping para outro. Alto, causa engasgos em jogos e chamadas.">
                                            <StackPanel>
                                                <TextBlock Text="Jitter" Style="{StaticResource StatLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock x:Name="NetJitter" Text="—" Style="{StaticResource NetStatValue}" />
                                                    <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="5,0,0,4" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="NetCell2" Style="{StaticResource NetStatCell}" BorderThickness="1,1,0,0" Padding="20,16,0,16" Background="Transparent" ToolTip="Parte dos pings que não voltou. Acima de zero, pode cortar o som de chamadas e travar jogos.">
                                            <StackPanel>
                                                <TextBlock Text="Perda de pacotes" Style="{StaticResource StatLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock x:Name="NetLoss" Text="—" Style="{StaticResource NetStatValue}" />
                                                    <TextBlock Text="%" Style="{StaticResource Unit}" Margin="5,0,0,4" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="NetCell3" Style="{StaticResource NetStatCell}" Background="Transparent" ToolTip="A latência com a conexão cheia, durante o download. Se sobe muito, a rede fica lenta quando alguém baixa algo.">
                                            <StackPanel>
                                                <TextBlock Text="Latência sob carga" Style="{StaticResource StatLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock x:Name="NetLoaded" Text="—" Style="{StaticResource NetStatValue}" />
                                                    <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="5,0,0,4" />
                                                </StackPanel>
                                                <TextBlock x:Name="NetLoadedSub" Style="{StaticResource StatSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="NetCell4" Style="{StaticResource NetStatCell}" BorderThickness="1,1,0,0" Padding="20,16,0,16" Background="Transparent" ToolTip="Tempo para descobrir o servidor de um endereço de site antes de abrir a página.">
                                            <StackPanel>
                                                <TextBlock Text="Resolução de nome" Style="{StaticResource StatLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock x:Name="NetDns" Text="—" Style="{StaticResource NetStatValue}" />
                                                    <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="5,0,0,4" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Veredito: um achado por linha, com o ícone na cor do estado, no respiro de 24 das laterais e 14 em cima e embaixo -->
                        <Border x:Name="NetVerdict" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14,24,14" Visibility="Collapsed">
                            <StackPanel x:Name="NetNotes" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Onde está o atraso, histórico dos testes e dados da conexão: ocupam a sobra de altura. Em larguras menores o histórico
                     sai da fila (NetBottom_SizeChanged) e o caminho fica com a largura dele. -->
                <Grid x:Name="NetBottom" Grid.Row="3" SizeChanged="NetBottom_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="NetHistoryGap" Width="16" />
                        <ColumnDefinition x:Name="NetHistoryColumn" Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}" Padding="{StaticResource CardPadding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="70" />
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource CardHeader}">
                                <TextBlock Text="Caminho até a internet" Style="{StaticResource CardTitle}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Net" Kind="desktop" Width="40" Height="40" />
                                    <TextBlock Text="Este PC" Style="{StaticResource GroupTitle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="NetPcLink" Text="—" Style="{StaticResource NetNodeValue}" />
                                        <TextBlock x:Name="NetPcLinkUnit" Text="de link" Style="{StaticResource Unit}" Margin="4,0,0,3" />
                                    </StackPanel>
                                    <TextBlock x:Name="NetPcDetail" Text="—" Style="{StaticResource NetNodeSub}" />
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="Rede local" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <Border x:Name="NetLinkLocal" Height="2" CornerRadius="1" Background="{DynamicResource LineStrong}" VerticalAlignment="Top" Margin="0,26,0,0" />
                                    <TextBlock x:Name="NetLinkLocalText" Text="—" Style="{StaticResource StatSub}" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0" />
                                </Grid>
                                <StackPanel Grid.Column="2">
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Net" Kind="router" Width="40" Height="40" />
                                    <TextBlock Text="Roteador" Style="{StaticResource GroupTitle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="NetRouterMs" Text="—" Style="{StaticResource NetNodeValue}" />
                                        <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="4,0,0,3" />
                                    </StackPanel>
                                    <TextBlock x:Name="NetRouterIp" Text="—" Style="{StaticResource NetNodeSub}" />
                                </StackPanel>
                                <Grid Grid.Column="3" Margin="4,0">
                                    <TextBlock Text="Provedor" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <Border x:Name="NetLinkWan" Height="2" CornerRadius="1" Background="{DynamicResource LineStrong}" VerticalAlignment="Top" Margin="0,26,0,0" />
                                    <TextBlock x:Name="NetLinkWanText" Text="—" Style="{StaticResource StatSub}" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0" />
                                </Grid>
                                <StackPanel Grid.Column="4">
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Net" Kind="&#xE774;" Width="40" Height="40" />
                                    <TextBlock Text="Internet" Style="{StaticResource GroupTitle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="NetWanMs" Text="—" Style="{StaticResource NetNodeValue}" />
                                        <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="4,0,0,3" />
                                    </StackPanel>
                                    <TextBlock x:Name="NetWanDetail" Text="1.1.1.1 e 8.8.8.8" Style="{StaticResource NetNodeSub}" />
                                </StackPanel>
                            </Grid>

                            <!-- Pings até 1.1.1.1 em repouso e com a conexão cheia: o bufferbloat aparece como o salto entre os dois blocos -->
                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Border Style="{StaticResource Divider}" VerticalAlignment="Top" />
                                <Grid Margin="0,16,0,0">
                                    <Canvas x:Name="NetTrace" ClipToBounds="True" SizeChanged="NetTrace_SizeChanged" />
                                    <TextBlock x:Name="NetTraceEmpty" Text="Os pings aparecem aqui ao fim do teste." Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Histórico: um teste por linha (quando, download, upload, latência), o mais recente em cima; o escolhido é o que o
                         diagnóstico mostra. Fica guardado em AppSettings.NetRuns e rola dentro do cartão. -->
                    <Border x:Name="NetHistoryCard" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24,16,16,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource CardHeader}" Margin="0,0,8,0">
                                <TextBlock Text="Histórico" Style="{StaticResource CardTitle}" ToolTip="Os últimos 30 testes deste PC. Clique num deles para ver o diagnóstico daquele teste." />
                                <TextBlock x:Name="NetHistoryCount" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Cabeçalho da tabela nas mesmas colunas das linhas (10 px de recuo, o do conteúdo da linha) -->
                            <Grid x:Name="NetHistoryHead" Grid.Row="1" Margin="10,12,18,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quando" Style="{StaticResource TableHead}" />
                                <TextBlock Grid.Column="1" Text="Download" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="Em Mbps" />
                                <TextBlock Grid.Column="2" Text="Upload" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="Em Mbps" />
                                <TextBlock Grid.Column="3" Text="Latência" Style="{StaticResource TableHead}" HorizontalAlignment="Right" ToolTip="Até a internet, em ms" />
                            </Grid>
                            <local:SpareHeightBox Grid.Row="2">
                                <ListBox x:Name="NetHistory" ItemContainerStyle="{StaticResource ListNavItem}" Padding="0" Margin="0,0,0,0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="NetHistory_SelectionChanged" Focusable="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding When}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Grid.Column="1" Text="{Binding Down}" Style="{StaticResource Num}" HorizontalAlignment="Right" Foreground="{DynamicResource Fg}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Up}" Style="{StaticResource Num}" HorizontalAlignment="Right" Foreground="{DynamicResource Fg}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Ping}" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <!-- Teste com atenção ou ruim: a latência leva a cor do veredito -->
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Danger">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </local:SpareHeightBox>
                            <TextBlock x:Name="NetHistoryEmpty" Grid.Row="2" Text="Cada teste fica guardado aqui, para comparar com os próximos." Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource Faint}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,16,0" />
                        </Grid>
                    </Border>

                    <!-- Esqueleto: as seis linhas da conexão espalhadas pela altura, nome à esquerda e valor à direita -->
                    <Border x:Name="NetInfoCard" Grid.Column="4" Style="{StaticResource CardBorder}" Padding="24,16,24,12" local:Skeleton.Top="40"
                            local:Skeleton.Layout="spread 6: c *@0.5, t *@0.6&gt;">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource CardHeader}" Margin="0,0,0,6">
                                <TextBlock Text="Conexão" Style="{StaticResource CardTitle}" />
                            </Grid>
                            <ItemsControl x:Name="NetInfo" Grid.Row="1" ItemTemplate="{StaticResource NetInfoRow}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:SpreadPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
