<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.NetworkView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Rede" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Descubra se o lag vem do seu PC, do Wi-Fi ou do provedor." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button x:Name="BtnNetTest" Grid.Column="1" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Testar a rede" VerticalAlignment="Top" Click="BtnNetTest_Click" />
            </Grid>
            <!-- Progresso do teste: barra contínua (tarefa), não medidor -->
            <Border Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="NetStatus" Text="Pronto. O teste leva cerca de 30 segundos." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
                    <Grid Style="{StaticResource ProgressTrack}">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="NetProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="NetCards" ItemTemplate="{StaticResource CardTemplate}" />
            <TextBlock Style="{StaticResource Footnote}" Margin="0,6,0,0" Text="O teste envia pings ao roteador e aos DNS públicos 1.1.1.1 e 8.8.8.8 e baixa e envia dados de teste do servidor público speed.cloudflare.com (cerca de 100 MB no total). Feche downloads, streaming e jogos antes para um resultado fiel." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
