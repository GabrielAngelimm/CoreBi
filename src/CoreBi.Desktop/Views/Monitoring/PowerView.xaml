<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.PowerView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Seção do painel de alimentação: separadas por um fio, sem cartões dentro do cartão -->
        <Style x:Key="FeedSection" TargetType="Border">
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style x:Key="Dash" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>
        <Style x:Key="ChannelValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="RulerValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RulerCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="22,14,16,16" />
        </Style>
        <Style x:Key="Led" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Faint}" />
        </Style>

        <!-- Plano instalado: anel de seleção, nome e "em uso" no ativo -->
        <DataTemplate x:Key="PlanRow">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="ring" Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5" />
                    <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="used" Grid.Column="2" Text="em uso" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}" />
                    <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="used" Property="Visibility" Value="Visible" />
                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Fg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Regulagem do plano: rótulo e valor, duas por linha -->
        <DataTemplate x:Key="SettingCell">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9,14,9">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Capacidade de suspensão: LED aceso quando o PC oferece -->
        <DataTemplate x:Key="SleepCap">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8" ToolTip="{Binding Tip}">
                <Ellipse x:Name="led" Style="{StaticResource Led}" Margin="0,1,8,0" />
                <TextBlock x:Name="text" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Faint}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding On}" Value="True">
                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Accent}" />
                    <Setter TargetName="text" Property="Foreground" Value="{DynamicResource Fg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Trilho da fonte: nome, régua de tolerância, leitura e desvio do nominal -->
        <DataTemplate x:Key="RailRow">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,0,0" />
                <local:RailGauge Grid.Column="1" Nominal="{Binding Nominal}" Value="{Binding Value}" Min="{Binding Min}" Max="{Binding Max}" ShowScale="{Binding First}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="{Binding Tip}" />
                <TextBlock x:Name="value" Grid.Column="2" Style="{StaticResource ReadoutText}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,0,0">
                    <Run Text="{Binding ValueText, Mode=OneWay}" /><Run Text=" V" FontSize="12" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" />
                </TextBlock>
                <TextBlock x:Name="dev" Grid.Column="3" Text="{Binding DeviationText}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Off}" Value="True">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                    <Setter TargetName="dev" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tensão de componente: nome, posição na faixa usual e leitura -->
        <DataTemplate x:Key="VoltRow">
            <Grid Height="27">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <local:RangeStrip Grid.Column="1" Value="{Binding Value}" Min="{Binding Min}" Max="{Binding Max}" Lo="{Binding Lo}" Hi="{Binding Hi}" Low="{Binding Low}" VerticalAlignment="Center" ToolTip="{Binding Tip}" />
                <TextBlock x:Name="value" Grid.Column="2" Style="{StaticResource ReadoutText}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="{Binding ValueText, Mode=OneWay}" /><Run Text=" V" FontSize="12" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource UiFont}" />
                </TextBlock>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Low}" Value="True">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Uma tela: com a janela maximizada tudo cabe sem rolar. À esquerda, a alimentação (fonte ou bateria, plano de energia com a
        regulagem e o que o PC oferece de suspensão); à direita, o consumo ao vivo com o histórico de 5 min e a sessão, e embaixo as
        tensões e quando o PC ficou ligado nos últimos 7 dias. Em janelas menores os painéis descem e a página rola.
    -->
    <ScrollViewer x:Name="EnergyScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=EnergyScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Energia" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="EnergyStatus" Text="Fonte, plano de energia, consumo e tensões." Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <Button x:Name="BtnEnergyRefresh" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" VerticalAlignment="Top" Click="BtnEnergyRefresh_Click" />
                </Grid>

                <Grid x:Name="EnergyBody" Grid.Row="1" SizeChanged="EnergyBody_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FeedColumn" Width="372" />
                        <ColumnDefinition x:Name="FeedGap" Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="FeedGapRow" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Alimentação -->
                    <Border x:Name="FeedCard" Style="{StaticResource CardBorder}" Padding="0">
                        <StackPanel>
                            <!-- Fonte: tomada ou bateria -->
                            <Border Style="{StaticResource FeedSection}" BorderThickness="0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource AccentSoft}">
                                            <TextBlock x:Name="SourceGlyph" Text="&#xE945;" Style="{StaticResource IconGlyph}" FontSize="21" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="SourceTitle" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SourceCaption" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bateria (notebook ou nobreak): carga, estado e saúde -->
                                    <StackPanel x:Name="BatteryPanel" Visibility="Collapsed" Margin="0,18,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BatteryPct" Style="{StaticResource ReadoutHero}" FontSize="56" />
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="BatteryState" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="BatteryTime" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Grid>
                                        <local:BatteryMeter x:Name="BatteryGauge" Margin="0,10,0,0" />
                                        <StackPanel x:Name="BatteryHealth" Margin="0,18,0,0">
                                            <Grid>
                                                <TextBlock Text="Saúde da bateria" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                                                <Border x:Name="BatteryBadge" Style="{StaticResource Badge}" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="BatteryBadgeText" Style="{StaticResource BadgeText}" />
                                                </Border>
                                            </Grid>
                                            <local:CapacityStack x:Name="BatteryCapacity" Margin="0,10,0,6" />
                                            <TextBlock x:Name="BatteryCapacityText" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" />
                                            <UniformGrid x:Name="BatteryStats" Columns="3" Margin="0,12,0,0" />
                                            <TextBlock x:Name="BatteryReason" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Plano de energia: os instalados, com troca em um clique -->
                            <Border Style="{StaticResource FeedSection}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Plano de energia" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="PlanCount" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListBox x:Name="PlanList" Margin="-2,10,-2,0" ItemTemplate="{StaticResource PlanRow}" ItemContainerStyle="{StaticResource ListNavItem}"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="PlanList_SelectionChanged" AutomationProperties.Name="Planos de energia" />
                                    <Grid x:Name="WindowsModeRow" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="Em Configurações &gt; Energia. Só vale com o plano Equilibrado.">
                                        <TextBlock Text="Modo de energia do Windows" Style="{StaticResource StatLabel}" FontSize="12.5" />
                                        <TextBlock x:Name="WindowsMode" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Regulagem do plano ativo -->
                            <Border x:Name="RegSection" Style="{StaticResource FeedSection}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Regulagem do plano" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="RegCaption" Text="na tomada" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel x:Name="ProcBox" Margin="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="Estado do processador" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="ProcText" FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                        <local:SpanMeter x:Name="ProcMeter" Margin="0,9,0,0" />
                                        <Grid Margin="0,5,0,0">
                                            <TextBlock Text="0" FontFamily="{StaticResource Readout}" FontSize="11" Foreground="{DynamicResource Faint}" />
                                            <TextBlock x:Name="ProcNote" FontSize="11.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0" />
                                            <TextBlock Text="100" FontFamily="{StaticResource Readout}" FontSize="11" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                    <ItemsControl x:Name="PlanSettings" ItemTemplate="{StaticResource SettingCell}" Margin="0,12,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Suspensão e partida -->
                            <Border Style="{StaticResource FeedSection}">
                                <StackPanel>
                                    <TextBlock Text="Suspensão e partida" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl x:Name="SleepCaps" ItemTemplate="{StaticResource SleepCap}" Margin="0,12,0,2" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ItemsControl x:Name="BootFacts" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,14,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" ToolTip="{Binding Value}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Consumo, tensões e histórico -->
                    <Grid x:Name="RightArea" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PowerCard" Style="{StaticResource CardBorder}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="22,20,22,0">
                                    <StackPanel>
                                        <TextBlock Text="Consumo" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="PowerCaption" Text="Processador e placa de vídeo, pelos sensores. A fonte do PC não é medida." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse x:Name="LiveDot" Style="{StaticResource Led}" Margin="0,1,7,0" />
                                        <TextBlock x:Name="LiveText" Text="Aguardando os sensores" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="22,12,22,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ReadoutColumn" Width="300" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TotalNow" Style="{StaticResource ReadoutHero}" FontSize="88" Text="—" />
                                        <TextBlock x:Name="TotalCaption" Text="agora, no processador e na placa de vídeo" Style="{StaticResource Caption}" Margin="0,6,0,18" />
                                        <local:SplitBar x:Name="Split" Margin="0,0,0,14" />
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Dash}" Background="{DynamicResource Accent}" />
                                                    <TextBlock Text="Processador" Foreground="{DynamicResource Muted}" />
                                                </StackPanel>
                                                <TextBlock x:Name="CpuNow" Style="{StaticResource ChannelValue}" Text="—" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="CpuCaption" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Dash}" Background="{DynamicResource Copper}" />
                                                    <TextBlock Text="Placa de vídeo" Foreground="{DynamicResource Muted}" />
                                                </StackPanel>
                                                <TextBlock x:Name="GpuNow" Style="{StaticResource ChannelValue}" Text="—" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="GpuCaption" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <local:PowerTrace x:Name="Trace" Grid.Column="2" MinHeight="200" EmptyText="Coletando as primeiras amostras…" />
                                </Grid>

                                <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <UniformGrid x:Name="Ruler" Rows="1">
                                        <Border Style="{StaticResource RulerCell}" BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock Text="Energia nesta sessão" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="SessionEnergy" Style="{StaticResource RulerValue}" Text="—" />
                                                <TextBlock x:Name="SessionSince" Style="{StaticResource StatSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource RulerCell}">
                                            <StackPanel>
                                                <TextBlock Text="Média" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="SessionAverage" Style="{StaticResource RulerValue}" Text="—" />
                                                <TextBlock x:Name="SessionLength" Style="{StaticResource StatSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource RulerCell}">
                                            <StackPanel>
                                                <TextBlock Text="Pico" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="SessionPeak" Style="{StaticResource RulerValue}" Text="—" />
                                                <TextBlock x:Name="SessionPeakAt" Style="{StaticResource StatSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="GpuLimitCell" Style="{StaticResource RulerCell}">
                                            <StackPanel>
                                                <TextBlock Text="Limite da placa de vídeo" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="GpuLimit" Style="{StaticResource RulerValue}" Text="—" />
                                                <TextBlock x:Name="GpuLimitNote" Style="{StaticResource StatSub}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid x:Name="LowerGrid" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="LowerGap" Width="16" />
                                <ColumnDefinition x:Name="LowerRight" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="LowerGapRow" Height="0" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Tensões -->
                            <Border x:Name="VoltCard" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Tensões" Style="{StaticResource SectionTitle}" />
                                            <TextBlock x:Name="VoltCaption" Text="Trilhos da fonte, lidos pela placa-mãe" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel x:Name="VoltLive" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="Collapsed">
                                            <Ellipse Style="{StaticResource Led}" Fill="{DynamicResource Accent}" Margin="0,1,7,0" />
                                            <TextBlock Text="Ao vivo" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="RailRows" ItemTemplate="{StaticResource RailRow}" Margin="0,16,0,0" Focusable="False" />
                                    <Border x:Name="VoltDivider" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,4,0,8" />
                                    <TextBlock x:Name="VoltComponentsTitle" Text="Componentes" Style="{StaticResource Label}" Foreground="{DynamicResource Faint}" Margin="0,0,0,2" />
                                    <ItemsControl x:Name="VoltRows" ItemTemplate="{StaticResource VoltRow}" Focusable="False" />
                                    <TextBlock x:Name="VoltEmpty" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,14,0,4" Visibility="Collapsed" />
                                    <Button x:Name="VoltAll" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,8,0,-6" Click="VoltAll_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="VoltAllText" Text="Todas as tensões em Sensores" />
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Ligado nos últimos 7 dias -->
                            <Border x:Name="DaysCard" Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Ligado nos últimos 7 dias" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="DaysCaption" Text="Pelo registro de eventos do Windows" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <StackPanel Margin="0,0,34,0">
                                            <TextBlock Text="Hoje" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="DaysToday" Style="{StaticResource RulerValue}" FontSize="26" Text="—" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,34,0" ToolTip="Média dos dias anteriores a hoje que o registro cobre">
                                            <TextBlock Text="Média por dia" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="DaysAverage" Style="{StaticResource RulerValue}" FontSize="26" Text="—" />
                                        </StackPanel>
                                        <StackPanel ToolTip="O Windows reiniciou sem desligar antes: queda de energia, travamento ou botão de energia segurado (Kernel-Power 41).">
                                            <TextBlock Text="Desligamentos inesperados" Style="{StaticResource StatLabel}" />
                                            <TextBlock x:Name="DaysCrashes" Style="{StaticResource RulerValue}" FontSize="26" Text="—" />
                                        </StackPanel>
                                    </StackPanel>
                                    <local:UptimeChart x:Name="Uptime" Margin="0,14,0,0" />
                                    <TextBlock x:Name="DaysEmpty" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
