<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.PowerView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Energia" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="EnergyStatus" Text="Bateria, fonte de energia e consumo." Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <Button x:Name="BtnEnergyRefresh" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" VerticalAlignment="Top" Click="BtnEnergyRefresh_Click" />
            </Grid>
            <ItemsControl x:Name="EnergyCards" ItemTemplate="{StaticResource CardTemplate}" />
            <TextBlock Style="{StaticResource Footnote}" Margin="0,6,0,0" Text="Os dados vêm do Windows (WMI). Alguns notebooks não informam ciclos de carga nem a capacidade de projeto. O consumo mostrado vem dos sensores de CPU e GPU, não da fonte (PSU) do PC." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
