<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.SystemView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- LED de veredito: cinza neutro, verde ou âmbar -->
        <Style x:Key="NoteLed" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource Faint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Ok}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Warn}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SheetLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Índice: uma célula por categoria com o nome do componente; a escolhida ganha fundo elevado e o fio verde-água embaixo -->
        <Style x:Key="IndexCell" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="hover" Background="{DynamicResource Hover}" Opacity="0" />
                            <Border x:Name="sel" Background="{DynamicResource Raised}" Opacity="0" />
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,1" SnapsToDevicePixels="True" />
                            <Border x:Name="bar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Opacity="0" SnapsToDevicePixels="True" />
                            <StackPanel Margin="20,16,20,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Steel}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="cat" Grid.Column="1" Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource Warn}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding WarnTip}"
                                             Visibility="{Binding Warn, Converter={StaticResource BoolVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Spec}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="cat" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leitura da placa: rótulo e número grande; a primeira não tem fio à esquerda -->
        <DataTemplate x:Key="ReadoutCell">
            <Border x:Name="cell" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="28,0,0,0" Margin="28,0,0,0" MinWidth="96" ToolTip="{Binding Tip}" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource ReadoutText}" FontSize="38" FontWeight="Light" />
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Unit}" FontSize="13" Margin="5,0,0,6" Visibility="{Binding Unit, Converter={StaticResource NotEmptyVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                    <Setter TargetName="cell" Property="BorderThickness" Value="0" />
                    <Setter TargetName="cell" Property="Padding" Value="0" />
                    <Setter TargetName="cell" Property="Margin" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Linha chave/valor: o fio fica sob o texto; o fundo do mouse avança 10 px para os lados. Clique copia o valor. -->
        <DataTemplate x:Key="SpecRowTemplate">
            <Grid x:Name="host" Margin="-10,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}" MouseLeftButtonUp="SpecRow_Click">
                <Border x:Name="bg" Background="{DynamicResource Hover}" CornerRadius="6" Opacity="0" />
                <Border Height="1" VerticalAlignment="Top" Margin="10,0" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
                <Grid Margin="10,10,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="56*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Fg}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource Faint}" />
                    </TextBlock>
                    <TextBlock x:Name="copy" Grid.Column="3" Tag="copy" Text="&#xE8C8;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="host" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="1" />
                    <Setter TargetName="copy" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SpecGroupTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SheetLabel}" Margin="0,8,0,8" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                <!-- Instruções: lista em linha; as que o processador não tem ficam apagadas -->
                <Border x:Name="tokens" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,2">
                    <ItemsControl ItemsSource="{Binding Tokens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="t" Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,0,14,6" ToolTip="Suportada" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding On}" Value="False">
                                        <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Faint}" />
                                        <Setter TargetName="t" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="t" Property="ToolTip" Value="Não suportada por este processador" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tokens}" Value="{x:Null}">
                    <Setter TargetName="tokens" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="NoteTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource NoteLed}" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="10,0,0,0">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" /> <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ===== Figuras (uma por categoria) ===== -->

        <!-- Processador: um ladrilho por núcleo com as threads dele em gomos; L3 compartilhado embaixo -->
        <DataTemplate DataType="{x:Type inv:CpuFigure}">
            <StackPanel Width="416">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Cores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,9,10,10" ToolTip="{Binding Tip}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Label}" Style="{StaticResource ReadoutText}" FontSize="14" Foreground="{DynamicResource Faint}" />
                                            <ItemsControl x:Name="pips" ItemsSource="{Binding Threads}" VerticalAlignment="Bottom" Height="8" OpacityMask="{StaticResource SegmentMask}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="pip" Background="{DynamicResource Accent}" Margin="0,0,3,0" />
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.Efficient, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter TargetName="pip" Property="Background" Value="{DynamicResource Steel}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="4" Height="52" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,0">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="L3 compartilhado" FontSize="12" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="{Binding L3}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,12,0,0">
                    <Border Width="12" Height="6" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ThreadLabel}" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" />
                    <Border Width="12" Height="6" CornerRadius="2" Background="{DynamicResource Steel}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding Hybrid, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="núcleo de eficiência" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" Visibility="{Binding Hybrid, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Legend}" FontSize="11.5" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Memória: os slots por canal; ocupado com os contatos em gomos, vazio tracejado -->
        <DataTemplate DataType="{x:Type inv:RamFigure}">
            <ItemsControl ItemsSource="{Binding Channels}" Width="416">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Faint}" Margin="0,0,0,0" />
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0" ToolTip="{Binding Tip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="name" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                            <Grid x:Name="stick" Grid.Column="1" Height="44">
                                                <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="5" />
                                                <Grid Margin="12,8,12,0" VerticalAlignment="Top">
                                                    <TextBlock FontSize="12">
                                                        <Run Text="{Binding Capacity, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" /><Run Text="  ·  " Foreground="{DynamicResource Faint}" /><Run Text="{Binding Maker, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Speed}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                                <!-- Contatos dourados do módulo, com o chanfro fora do centro -->
                                                <Grid Height="5" Margin="10,0,10,4" VerticalAlignment="Bottom" OpacityMask="{StaticResource SegmentMask}" Opacity="0.85">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44*" />
                                                        <ColumnDefinition Width="9" />
                                                        <ColumnDefinition Width="56*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource Accent}" />
                                                    <Border Grid.Column="2" Background="{DynamicResource Accent}" />
                                                </Grid>
                                            </Grid>
                                            <Grid x:Name="empty" Grid.Column="1" Height="44" Visibility="Collapsed">
                                                <Rectangle Stroke="{DynamicResource LineStrong}" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True" />
                                                <TextBlock Text="vazio" FontSize="12" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Filled}" Value="False">
                                                <Setter TargetName="stick" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="empty" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Faint}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Telas: na posição e proporção em que o Windows as organiza; contorno cobre (canal da placa de vídeo) na principal -->
        <DataTemplate DataType="{x:Type inv:ScreenFigure}">
            <Grid Width="416">
                <TextBlock x:Name="none" Text="{Binding Empty}" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" Visibility="Collapsed" />
                <ItemsControl ItemsSource="{Binding Screens}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="7,0" VerticalAlignment="Bottom">
                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                    <Border x:Name="frame" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5" CornerRadius="6" />
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource ReadoutText}" FontSize="13" Foreground="{DynamicResource Faint}" Margin="10,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding Monitor}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Resolution}" Style="{StaticResource ReadoutText}" FontSize="24" FontWeight="Light" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        <TextBlock x:Name="detail" Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Width="46" Height="14" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5,0,1.5,1.5" CornerRadius="0,0,4,4" HorizontalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Primary}" Value="True">
                                    <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Copper}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Warn}" Value="True">
                                    <Setter TargetName="detail" Property="Foreground" Value="{DynamicResource Warn}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Screens.Count}" Value="0">
                    <Setter TargetName="none" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Placa-mãe: a corrente da inicialização segura, um elo por requisito -->
        <DataTemplate DataType="{x:Type inv:ChainFigure}">
            <ItemsControl ItemsSource="{Binding Steps}" Width="416">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="gap" Grid.Row="1" Height="24" />
                            <Rectangle x:Name="wire" Grid.RowSpan="2" Width="1" Fill="{DynamicResource LineStrong}" Margin="0,24,0,2" HorizontalAlignment="Center" />
                            <Grid Width="22" Height="22" VerticalAlignment="Top">
                                <Ellipse x:Name="ring" Stroke="{DynamicResource Faint}" StrokeThickness="1.5" />
                                <TextBlock x:Name="mark" Text="&#xE738;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="{DynamicResource Faint}" />
                            </Grid>
                            <StackPanel Grid.Column="2" Margin="0,2,12,0">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="17" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Value}" FontSize="12.5" Foreground="{DynamicResource Fg}" Margin="0,4,0,0" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Ok}" />
                                <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Ok}" />
                                <Setter TargetName="mark" Property="Text" Value="&#xE73E;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Warn}" />
                                <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Warn}" />
                                <Setter TargetName="mark" Property="Text" Value="&#xE8C9;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Last}" Value="True">
                                <Setter TargetName="wire" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="gap" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Sistema operacional: instalação, última atualização, boot e agora -->
        <DataTemplate DataType="{x:Type inv:TimelineFigure}">
            <ItemsControl ItemsSource="{Binding Events}" Width="416">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="gap" Grid.Row="1" Height="26" />
                            <Rectangle x:Name="wire" Grid.RowSpan="2" Width="1" Fill="{DynamicResource LineStrong}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                            <Ellipse x:Name="dot" Width="9" Height="9" Fill="{DynamicResource Surface}" Stroke="{DynamicResource Steel}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource ReadoutText}" FontSize="20" FontWeight="Light" />
                                    <TextBlock Text="{Binding Note}" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,2" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Now}" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="wire" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="gap" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Armazenamento: um disco por linha, com as unidades dele em proporção ao tamanho -->
        <DataTemplate x:Key="DiskTemplate">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8,2,8,3" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Volumes}" Height="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><inv:WeightPanel Gap="6" Total="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="inv:WeightPanel.Weight" Value="{Binding Weight}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid OpacityMask="{StaticResource SegmentMask}" ToolTip="{Binding Tip}" Background="Transparent">
                                        <Border Background="{DynamicResource Line}" />
                                        <Border Background="{DynamicResource Steel}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Used}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Letter}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Line}" FontSize="12.5" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Size}" Style="{StaticResource ReadoutText}" FontSize="26" FontWeight="Light" />
                            <TextBlock Text="{Binding Unit}" Style="{StaticResource Unit}" FontSize="12.5" Margin="4,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding Free}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Leva a outra página: texto discreto com seta -->
        <Style x:Key="SheetLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="{TemplateBinding Foreground}" Margin="7,1,0,0" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Sistema" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SystemSub" Text="Lendo informações do sistema…" Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <Button x:Name="BtnReport" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72D;" Content="Exportar relatório" VerticalAlignment="Top" Click="BtnReport_Click" ToolTip="Salva um relatório (HTML ou JSON) com sistema, memória, discos, GPU, sensores e benchmarks. Números de série ficam de fora." />
        </Grid>

        <!-- Um painel só: o índice da máquina em cima e a ficha do componente escolhido embaixo -->
        <Border x:Name="SheetCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="SheetCard_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListBox x:Name="SysIndex" ItemContainerStyle="{StaticResource IndexCell}" Margin="-1,0,0,0" SelectionChanged="SysIndex_Changed"
                         KeyboardNavigation.DirectionalNavigation="Cycle">
                    <!-- Sem rolagem nem borda própria: as células encostam no contorno do painel -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid x:Name="IndexGrid" Rows="1" Loaded="IndexGrid_Loaded" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid x:Name="Sheet" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Placa: quem é o componente e as quatro leituras que o resumem -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="32,28,32,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,40,0">
                                <TextBlock x:Name="SheetEyebrow" Style="{StaticResource SheetLabel}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SheetTitle" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <TextBlock x:Name="SheetSub" FontSize="13.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,7,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="SheetReadouts" Grid.Column="1" VerticalAlignment="Bottom" AlternationCount="100" ItemTemplate="{StaticResource ReadoutCell}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FigColumn" Width="480" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Palco da figura: um tom abaixo do painel; a figura fica no centro e os vereditos no rodapé -->
                        <Grid x:Name="FigStage">
                            <Rectangle Fill="{DynamicResource Bg}" Opacity="0.45" />
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" />
                            <DockPanel Margin="32,26,32,22">
                                <TextBlock x:Name="FigTitle" DockPanel.Dock="Top" Style="{StaticResource SheetLabel}" />
                                <ItemsControl x:Name="SheetNotes" DockPanel.Dock="Bottom" ItemTemplate="{StaticResource NoteTemplate}" Margin="0,18,0,0" />
                                <Viewbox StretchDirection="DownOnly" Margin="0,18,0,0" VerticalAlignment="Center">
                                    <ContentControl x:Name="SheetFigure" Focusable="False" />
                                </Viewbox>
                            </DockPanel>
                        </Grid>

                        <ScrollViewer x:Name="SpecScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="32,18,32,26">
                                <ItemsControl x:Name="SpecGroups" ItemTemplate="{StaticResource SpecGroupTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><inv:ColumnsPanel Loaded="SpecColumns_Loaded" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl x:Name="DiskList" ItemTemplate="{StaticResource DiskTemplate}" AlternationCount="100" Margin="0,-8,0,0" Focusable="False" />
                                <StackPanel x:Name="TablePanel" Margin="0,26,0,0">
                                    <TextBlock x:Name="TableTitle" Style="{StaticResource SheetLabel}" Margin="0,8,0,4" />
                                    <Grid x:Name="SpecTableGrid" />
                                </StackPanel>
                                <TextBlock x:Name="SheetFootnote" Style="{StaticResource Footnote}" Margin="0,14,0,0" />
                                <Button x:Name="SheetLink" Style="{StaticResource SheetLink}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="SheetLink_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
