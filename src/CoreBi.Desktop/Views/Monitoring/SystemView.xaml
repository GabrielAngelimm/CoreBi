<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.SystemView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- O que fazer, embaixo do valor de uma linha âmbar ("Ative na BIOS"): um ponto menor e um tom abaixo do valor. A
             explicação do que o dado é fica na dica da linha, não na tela. -->
        <Style x:Key="Explain" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SheetLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Fabricante no alto da placa, em tom de texto secundário: a cor do componente já está no fundo da placa, e o verde ou o
             bege em letra de 13 px sobre ele ficava sem contraste no tema claro -->
        <Style x:Key="PlateEyebrow" TargetType="TextBlock" BasedOn="{StaticResource SheetLabel}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Índice: seis abas numa faixa um tom abaixo do painel, com o ícone do componente, sem fundo, na cor do canal dele (a
             mesma dos gráficos) e a categoria na letra de instrumento; o nome da peça está na ficha logo abaixo. Cada uma tem
             fundo e contorno próprios, sem seta (seta é de link que leva a outra página); o mouse clareia o fundo; a escolhida
             ganha o fundo da placa logo abaixo, contorno mais forte e texto aceso. -->
        <Style x:Key="IndexCell" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="face" Margin="6" CornerRadius="{StaticResource RadiusInset}" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" SnapsToDevicePixels="True" Padding="12,12,14,12">
                            <DockPanel>
                                <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="{Binding Channel}" Kind="{Binding Glyph}" Width="32" Height="32" />
                                <TextBlock x:Name="cat" Text="{Binding Category}" FontFamily="{StaticResource LabelFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,3,0,0" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter TargetName="cat" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Focus}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Faint}" />
                                <Setter TargetName="cat" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leitura da placa: rótulo e número grande; a primeira não tem fio à esquerda. Sem largura mínima, para o
             espaço entre uma leitura e o fio seguinte ser o mesmo em todas. -->
        <DataTemplate x:Key="ReadoutCell">
            <Border x:Name="cell" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,0,0" Padding="28,0,0,0" Margin="28,0,0,0" ToolTip="{Binding Tip}" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource LabelFont}" FontSize="12.5" Foreground="{DynamicResource Muted}" />
                    <!-- Número e unidade num texto só, para a unidade assentar na linha de base do número (em dois blocos ela ficava 1 px abaixo).
                         UnitSuffix já traz o espaço antes da unidade e fica vazio sem ela. -->
                    <TextBlock x:Name="num" Style="{StaticResource ReadoutText}" FontSize="38" FontWeight="Light" Margin="0,6,0,0">
                        <Run Text="{Binding Value, Mode=OneWay}" /><Run Text="{Binding UnitSuffix, Mode=OneWay}" FontFamily="{StaticResource LabelFont}" FontSize="13" FontWeight="Normal" FontStretch="Normal" Foreground="{DynamicResource Muted}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="cell" Property="BorderThickness" Value="0" />
                    <Setter TargetName="cell" Property="Padding" Value="0" />
                    <Setter TargetName="cell" Property="Margin" Value="0" />
                </DataTrigger>
                <!-- Sem dado: o travessão da letra Light a 38 px vira uma barra larga; encolhe e fica um tom abaixo, na mesma altura de linha -->
                <DataTrigger Binding="{Binding Value}" Value="—">
                    <Setter TargetName="num" Property="FontSize" Value="24" />
                    <Setter TargetName="num" Property="LineHeight" Value="48" />
                    <Setter TargetName="num" Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Faint}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Linha chave/valor: o fio fica sob o texto; o fundo do mouse avança 10 px para os lados. Clique copia o valor.
             Tudo em texto: a explicação fica na dica; embaixo, em letra menor, só o que fazer numa linha âmbar. A ficha é o
             conteúdo da página, por isso em 13,5 (o corpo do app é 13), o mesmo degrau do subtítulo da página. -->
        <DataTemplate x:Key="SpecRowTemplate">
            <Grid x:Name="host" Margin="-10,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding Hint}" MouseLeftButtonUp="SpecRow_Click">
                <Border x:Name="bg" Background="{DynamicResource Hover}" CornerRadius="{StaticResource RadiusControl}" Opacity="0" />
                <Border Height="1" VerticalAlignment="Top" Margin="10,0" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
                <Grid Margin="10,8,8,8" TextElement.FontSize="13.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="56*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="key" Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="value" Grid.Column="2" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" Visibility="Collapsed">
                        <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Fg}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                    </TextBlock>
                    <!-- Módulos lado a lado: chave mais estreita (30/70) para cada célula caber um part number inteiro -->
                    <Grid x:Name="cells" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="70*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" Margin="0,0,10,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock x:Name="copy" Grid.Column="3" Tag="copy" Text="&#xE8C8;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Action}" Style="{StaticResource Explain}" Margin="0,6,0,0"
                               Visibility="{Binding Action, Converter={StaticResource NotEmptyVis}}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="host" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="1" />
                    <Setter TargetName="copy" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding Cells}" Value="{x:Null}">
                    <Setter TargetName="key" Property="Visibility" Value="Visible" />
                    <Setter TargetName="value" Property="Visibility" Value="Visible" />
                    <Setter TargetName="cells" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SpecGroupTemplate">
            <StackPanel>
                <!-- A frase que explica o assunto do grupo, para quem não é do ramo, é a dica do título -->
                <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitle}" Margin="0,8,0,8" HorizontalAlignment="Left" Background="Transparent" ToolTip="{Binding Help}" />
                <!-- Cabeçalho das colunas (módulos lado a lado), alinhado com as células das linhas -->
                <Grid x:Name="columns" Margin="0,0,30,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="70*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Columns}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                <!-- Instruções: lista em linha; as que o processador não tem ficam apagadas -->
                <Border x:Name="tokens" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,2">
                    <ItemsControl ItemsSource="{Binding Tokens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="t" Text="{Binding Text}" FontFamily="{StaticResource LabelFont}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,0,14,6" ToolTip="Suportada" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding On}" Value="False">
                                        <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Faint}" />
                                        <Setter TargetName="t" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="t" Property="ToolTip" Value="Não suportada por este processador" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tokens}" Value="{x:Null}">
                    <Setter TargetName="tokens" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Columns}" Value="{x:Null}">
                    <Setter TargetName="columns" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Armazenamento: um disco por linha, com as unidades dele em proporção ao tamanho -->
        <DataTemplate x:Key="DiskTemplate">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meta}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Volumes}" Height="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><inv:WeightPanel Gap="6" Total="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="inv:WeightPanel.Weight" Value="{Binding Weight}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid OpacityMask="{StaticResource SegmentMask}" ToolTip="{Binding Tip}" Background="Transparent">
                                        <Border Background="{DynamicResource Line}" />
                                        <Border Background="{DynamicResource Storage}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Used}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Letter}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Line}" FontSize="12.5" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                        <!-- Tamanho e unidade num texto só: a unidade assenta na linha de base do número -->
                        <TextBlock Style="{StaticResource ReadoutText}" FontSize="26" FontWeight="Light" HorizontalAlignment="Right">
                            <Run Text="{Binding Size, Mode=OneWay}" /><Run Text="{Binding UnitSuffix, Mode=OneWay}" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="Normal" FontStretch="Normal" Foreground="{DynamicResource Muted}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Free}" FontSize="12.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0"
                                   Visibility="{Binding Free, Converter={StaticResource NotEmptyVis}}" />
                        <!-- Saúde que o Windows informa para o disco -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{Binding Health, Converter={StaticResource NotEmptyVis}}"
                                    ToolTip="Estado que o Windows informa. Detalhes de vida útil e temperatura em Discos.">
                            <TextBlock Text="{Binding Health}" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Leva às leituras ao vivo (outra página, por isso a seta): botão discreto no pé do painel, com ícone de pulso e a mesma face
             das abas do índice (fundo do painel sobre a faixa um tom abaixo) -->
        <Style x:Key="SheetLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="12,8,12,8" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Signal}" VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource LabelFont}" FontSize="13.5" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="8,0,0,1" />
                                <TextBlock x:Name="arrow" Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter TargetName="arrow" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:PageHeaderPanel Style="{StaticResource PageHead}">
            <TextBlock Text="Sistema" Style="{StaticResource PageTitle}" />
            <TextBlock Text="A ficha completa do seu computador, peça por peça." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
            <StackPanel Style="{StaticResource PageActions}">
                <TextBlock x:Name="SystemSub" Text="Lendo informações do sistema…" Style="{StaticResource PageStatus}" Margin="0,0,20,2" Typography.NumeralAlignment="Tabular" />
                <Button x:Name="BtnReport" Style="{StaticResource HeaderPrimary}" local:Ui.Icon="&#xE896;" Content="Exportar relatório" Click="BtnReport_Click"
                        ToolTip="Salva a ficha do computador em HTML, PDF (A4) ou JSON. Números de série e o nome do usuário ficam de fora." />
            </StackPanel>
        </local:PageHeaderPanel>

        <!-- Um painel só: o índice da máquina em cima e a ficha do componente escolhido embaixo. Vai até o pé da página em toda
             aba, de propósito: a ficha muda de altura de uma aba para outra, e um painel que encolhesse ao conteúdo faria a borda
             de baixo pular a cada troca; as fichas longas (vários discos, quatro módulos de memória) rolam dentro dele. -->
        <!-- Esqueleto: as seis abas, a placa com as quatro leituras, os grupos em três colunas e o atalho no pé -->
        <Border x:Name="SheetCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="SheetCard_SizeChanged"
                local:Skeleton.Layout="gap 12; row 56: - 12, btn *^56, - 12, btn *^56, - 12, btn *^56, - 12, btn *^56, - 12, btn *^56, - 12, btn *^56, - 12; gap 11; line; gap 20; col 24 45%; row 18: c *@0.1; row 40: h *@0.42^24; gap 6; row 20: t *@0.5; col 72% 26%; gap 18; row 16: c *@0.55, - 24, c *@0.55, - 24, c *@0.55, - 24, c *@0.55; row 46: n *@0.5^30, - 24, n *@0.5^30, - 24, n *@0.6^30, - 24, n *@0.5^30; end; gap 20; line; gap 20; col 24 30.5%; row 22: s *@0.36; gap 6; lines 2 34: c 42%@0.55, t 58%@0.5; gap 24; row 22: s *@0.28; gap 6; lines 2 34: c 42%@0.55, t 58%@0.5; col 34.7% 30.5%; row 22: s *@0.3; gap 6; lines 6 34: c 42%@0.55, t 58%@0.5; col 67.9% 30.5%; row 22: s *@0.22; gap 6; lines 4 34: c 42%@0.55, t 58%@0.5; gap 24; row 22: s *@0.3; gap 6; row 30: c 40, - 14, c 30, - 14, c 34, - 14, c 36, - 14, c 50, - 14, c 50, - 14, c 38, - 14, c 44; end; foot 58: - 12, btn 400^34; footline">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Faixa do índice: tom intermediário (o mesmo da faixa de colunas de Sensores), para os botões se destacarem.
                     6 da lista + 6 da margem de cada aba = 12 em todos os sentidos: da borda do painel às abas, em cima, embaixo e
                     entre uma aba e outra, para o contorno das abas acompanhar o do painel. Também na grade de 3 × 2 das janelas
                     estreitas. O atalho do pé repete os mesmos 12. -->
                <Rectangle Fill="{DynamicResource Raised}" />
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" />
                <ListBox x:Name="SysIndex" ItemContainerStyle="{StaticResource IndexCell}" Margin="6" SelectionChanged="SysIndex_Changed"
                         KeyboardNavigation.DirectionalNavigation="Cycle">
                    <!-- Sem rolagem nem borda própria -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid x:Name="IndexGrid" Rows="1" Loaded="IndexGrid_Loaded" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid x:Name="Sheet" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Placa: quem é o componente e as quatro leituras que o resumem. No tom mais forte, como o cabeçalho de
                         componente em Sensores (o botão escolhido usa o mesmo fundo), com o fundo claro da cor do componente. -->
                    <Border Background="{DynamicResource Selected}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1" ClipToBounds="True">
                        <Grid>
                        <Border Style="{StaticResource ChannelWash}" local:Ui.Channel="{Binding SelectedItem.Channel, ElementName=SysIndex}" />
                        <Grid Margin="{StaticResource PanelPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,40,0">
                                <TextBlock x:Name="SheetEyebrow" Style="{StaticResource PlateEyebrow}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SheetTitle" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <TextBlock x:Name="SheetSub" FontSize="13.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,8,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="SheetReadouts" Grid.Column="1" VerticalAlignment="Bottom" ItemTemplate="{StaticResource ReadoutCell}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        </Grid>
                    </Border>

                    <!-- Os dados na largura toda, em grupos que se distribuem em colunas; o atalho para as leituras ao vivo fica fixo no
                         pé do painel, embaixo. Recuo de 24 nas laterais, como
                         a placa e as abas; em cima 12 + os 8 do título do grupo = 20 (PanelPadding). -->
                    <ScrollViewer x:Name="SpecScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="24,12,24,20">
                            <!-- Armazenamento: os discos em cima, com as unidades; a ficha de cada um vem nos grupos abaixo -->
                            <ItemsControl x:Name="DiskList" ItemTemplate="{StaticResource DiskTemplate}" Margin="0,-8,0,20" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Focusable="False" />
                            <ItemsControl x:Name="SpecGroups" ItemTemplate="{StaticResource SpecGroupTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><inv:ColumnsPanel RowGap="24" Loaded="SpecColumns_Loaded" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="inv:ColumnsPanel.Column" Value="{Binding Column}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Atalho para as leituras ao vivo: no pé do painel, à esquerda, no mesmo lugar em toda aba (o painel vai sempre até
                         o pé da página), separado da ficha por um fio. A ficha rola por cima dele, nunca o empurra. Faixa no mesmo tom
                         da do índice e o botão a 12 da borda em cima, embaixo e à esquerda, como as abas: fecha o painel como a
                         faixa de cima o abre. -->
                    <Border x:Name="SheetFooter" Grid.Row="2" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12">
                        <Button x:Name="SheetLink" Style="{StaticResource SheetLink}" HorizontalAlignment="Left" Click="SheetLink_Click" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
