<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.SystemView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- LED de veredito antes do valor: verde (está certo) ou âmbar (vale ajustar); some quando a linha não tem veredito -->
        <Style x:Key="RowLed" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Ok}" /><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Warn}" /><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SheetLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Índice: seis botões numa faixa um tom abaixo do painel, só com ícone e categoria (o nome da peça está na ficha
             logo abaixo). O mouse acende o contorno; o escolhido fica claro, com contorno e ícone verde-água. -->
        <Style x:Key="IndexCell" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="face" Margin="4" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="Transparent" SnapsToDevicePixels="True" Padding="12,10,14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="tile" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Muted}" />
                                </Border>
                                <TextBlock x:Name="cat" Text="{Binding Category}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,1" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="cat" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="tile" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="cat" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leitura da placa: rótulo e número grande; a primeira não tem fio à esquerda -->
        <DataTemplate x:Key="ReadoutCell">
            <Border x:Name="cell" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="28,0,0,0" Margin="28,0,0,0" MinWidth="96" ToolTip="{Binding Tip}" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource ReadoutText}" FontSize="38" FontWeight="Light" />
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Unit}" FontSize="13" Margin="5,0,0,6" Visibility="{Binding Unit, Converter={StaticResource NotEmptyVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="cell" Property="BorderThickness" Value="0" />
                    <Setter TargetName="cell" Property="Padding" Value="0" />
                    <Setter TargetName="cell" Property="Margin" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Linha chave/valor: o fio fica sob o texto; o fundo do mouse avança 10 px para os lados. Clique copia o valor.
             O veredito acende um LED antes do valor; a explicação, quando há, vem embaixo em letra menor. -->
        <DataTemplate x:Key="SpecRowTemplate">
            <Grid x:Name="host" Margin="-10,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}" MouseLeftButtonUp="SpecRow_Click">
                <Border x:Name="bg" Background="{DynamicResource Hover}" CornerRadius="6" Opacity="0" />
                <Border Height="1" VerticalAlignment="Top" Margin="10,0" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
                <Grid Margin="10,10,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="56*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                    <DockPanel x:Name="value" Grid.Column="2" Visibility="Collapsed">
                        <Ellipse DockPanel.Dock="Left" Style="{StaticResource RowLed}" VerticalAlignment="Top" Margin="0,6,8,0" />
                        <TextBlock TextWrapping="Wrap" Typography.NumeralAlignment="Tabular">
                            <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Fg}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                        </TextBlock>
                    </DockPanel>
                    <!-- Módulos lado a lado: uma célula por coluna do grupo -->
                    <ItemsControl x:Name="cells" Grid.Column="2" ItemsSource="{Binding Cells}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" Margin="0,0,12,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="copy" Grid.Column="3" Tag="copy" Text="&#xE8C8;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Help}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Help, Converter={StaticResource NotEmptyVis}}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="host" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="1" />
                    <Setter TargetName="copy" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding Cells}" Value="{x:Null}">
                    <Setter TargetName="value" Property="Visibility" Value="Visible" />
                    <Setter TargetName="cells" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SpecGroupTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,8,0,8" />
                <!-- Uma frase que explica o assunto do grupo, para quem não é do ramo -->
                <TextBlock Text="{Binding Help}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,-3,0,10"
                           Visibility="{Binding Help, Converter={StaticResource NotEmptyVis}}" />
                <!-- Cabeçalho das colunas (módulos lado a lado), alinhado com as células das linhas -->
                <Grid x:Name="columns" Margin="0,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="56*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Columns}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                <!-- Instruções: lista em linha; as que o processador não tem ficam apagadas -->
                <Border x:Name="tokens" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,2">
                    <ItemsControl ItemsSource="{Binding Tokens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="t" Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,0,14,6" ToolTip="Suportada" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding On}" Value="False">
                                        <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Faint}" />
                                        <Setter TargetName="t" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="t" Property="ToolTip" Value="Não suportada por este processador" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tokens}" Value="{x:Null}">
                    <Setter TargetName="tokens" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Columns}" Value="{x:Null}">
                    <Setter TargetName="columns" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Armazenamento: um disco por linha, com as unidades dele em proporção ao tamanho -->
        <DataTemplate x:Key="DiskTemplate">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8,2,8,3" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Volumes}" Height="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><inv:WeightPanel Gap="6" Total="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="inv:WeightPanel.Weight" Value="{Binding Weight}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid OpacityMask="{StaticResource SegmentMask}" ToolTip="{Binding Tip}" Background="Transparent">
                                        <Border Background="{DynamicResource Line}" />
                                        <Border Background="{DynamicResource Steel}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Used}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Letter}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Line}" FontSize="12.5" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Size}" Style="{StaticResource ReadoutText}" FontSize="26" FontWeight="Light" />
                            <TextBlock Text="{Binding Unit}" Style="{StaticResource Unit}" FontSize="12.5" Margin="4,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding Free}" FontSize="12.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0" />
                        <!-- Saúde que o Windows informa para o disco -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{Binding Health, Converter={StaticResource NotEmptyVis}}"
                                    ToolTip="Estado que o Windows informa. Detalhes de vida útil e temperatura em Discos.">
                            <Ellipse Style="{StaticResource RowLed}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Health}" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Leva a outra página: texto discreto com seta -->
        <Style x:Key="SheetLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="{TemplateBinding Foreground}" Margin="7,1,0,0" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Sistema" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SystemSub" Text="Lendo informações do sistema…" Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <Button x:Name="BtnReport" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72D;" Content="Exportar relatório" VerticalAlignment="Top" Click="BtnReport_Click" ToolTip="Salva um relatório (HTML ou JSON) com sistema, memória, discos, GPU, sensores e benchmarks. Números de série ficam de fora." />
        </Grid>

        <!-- Um painel só: o índice da máquina em cima e a ficha do componente escolhido embaixo -->
        <Border x:Name="SheetCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="SheetCard_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Faixa do índice: um tom abaixo do painel, como o palco da figura, para os botões se destacarem -->
                <Rectangle Fill="{DynamicResource Bg}" Opacity="0.45" />
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" />
                <ListBox x:Name="SysIndex" ItemContainerStyle="{StaticResource IndexCell}" Margin="8" SelectionChanged="SysIndex_Changed"
                         KeyboardNavigation.DirectionalNavigation="Cycle">
                    <!-- Sem rolagem nem borda própria -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid x:Name="IndexGrid" Rows="1" Loaded="IndexGrid_Loaded" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid x:Name="Sheet" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Placa: quem é o componente e as quatro leituras que o resumem -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="32,28,32,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,40,0">
                                <TextBlock x:Name="SheetEyebrow" Style="{StaticResource SheetLabel}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SheetTitle" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <TextBlock x:Name="SheetSub" FontSize="13.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,7,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="SheetReadouts" Grid.Column="1" VerticalAlignment="Bottom" ItemTemplate="{StaticResource ReadoutCell}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Os dados na largura toda, em grupos que se distribuem em colunas -->
                    <ScrollViewer x:Name="SpecScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="32,20,32,28">
                            <ItemsControl x:Name="SpecGroups" ItemTemplate="{StaticResource SpecGroupTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><inv:ColumnsPanel Loaded="SpecColumns_Loaded" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="DiskList" ItemTemplate="{StaticResource DiskTemplate}" Margin="0,-8,0,0" Focusable="False" />
                            <Button x:Name="SheetLink" Style="{StaticResource SheetLink}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="SheetLink_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
