<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.SystemView" xmlns:local="clr-namespace:CoreBi.Desktop" xmlns:inv="clr-namespace:CoreBi.Desktop.Features.Monitoring.Inventory">
    <UserControl.Resources>
        <!-- Explicação: complemento do dado, nunca o dado. Itálico, um ponto menor e um tom abaixo, com mais ar acima,
             para a hierarquia ficar chave → valor → explicação. -->
        <Style x:Key="Explain" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Opacity" Value="0.82" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SheetLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Fabricante no alto da placa: na cor do canal do componente, como a etiqueta de uma peça -->
        <Style x:Key="PlateEyebrow" TargetType="TextBlock" BasedOn="{StaticResource SheetLabel}">
            <Style.Triggers>
                <Trigger Property="local:Ui.Channel" Value="Cpu"><Setter Property="Foreground" Value="{DynamicResource Cpu}" /></Trigger>
                <Trigger Property="local:Ui.Channel" Value="Gpu"><Setter Property="Foreground" Value="{DynamicResource Gpu}" /></Trigger>
                <Trigger Property="local:Ui.Channel" Value="Memory"><Setter Property="Foreground" Value="{DynamicResource Memory}" /></Trigger>
                <Trigger Property="local:Ui.Channel" Value="Storage"><Setter Property="Foreground" Value="{DynamicResource StorageHi}" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Índice: seis botões numa faixa um tom abaixo do painel, com o ladrilho do componente na cor do canal dele (a
             mesma dos gráficos) e a categoria na letra de instrumento; o nome da peça está na ficha logo abaixo. Cada um tem
             fundo e contorno próprios e uma seta discreta, para ler como botão; o mouse clareia o fundo; o escolhido ganha o
             fundo da placa logo abaixo, contorno mais forte e texto aceso, e perde a seta. -->
        <Style x:Key="IndexCell" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="face" Margin="5" CornerRadius="{StaticResource RadiusInset}" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" SnapsToDevicePixels="True" Padding="12,12,14,12">
                            <DockPanel>
                                <TextBlock x:Name="chev" DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="10" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Border x:Name="tile" Style="{StaticResource ChannelTile}" local:Ui.Channel="{Binding Channel}" Width="38" Height="38">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" FontSize="18" />
                                </Border>
                                <TextBlock x:Name="cat" Text="{Binding Category}" FontFamily="{StaticResource LabelFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="13,0,0,1" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter TargetName="cat" Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Focus}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Faint}" />
                                <Setter TargetName="cat" Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="chev" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leitura da placa: rótulo e número grande; a primeira não tem fio à esquerda. Sem largura mínima, para o
             espaço entre uma leitura e o fio seguinte ser o mesmo em todas. -->
        <DataTemplate x:Key="ReadoutCell">
            <Border x:Name="cell" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,0,0" Padding="28,0,0,0" Margin="28,0,0,0" ToolTip="{Binding Tip}" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource LabelFont}" FontSize="12.5" Foreground="{DynamicResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource ReadoutText}" FontSize="38" FontWeight="Light" />
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Unit}" FontSize="13" Margin="5,0,0,6" Visibility="{Binding Unit, Converter={StaticResource NotEmptyVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="cell" Property="BorderThickness" Value="0" />
                    <Setter TargetName="cell" Property="Padding" Value="0" />
                    <Setter TargetName="cell" Property="Margin" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Linha chave/valor: o fio fica sob o texto; o fundo do mouse avança 10 px para os lados. Clique copia o valor.
             Tudo em texto: a explicação, quando há, vem embaixo em letra menor. -->
        <DataTemplate x:Key="SpecRowTemplate">
            <Grid x:Name="host" Margin="-10,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}" MouseLeftButtonUp="SpecRow_Click">
                <Border x:Name="bg" Background="{DynamicResource Hover}" CornerRadius="6" Opacity="0" />
                <Border Height="1" VerticalAlignment="Top" Margin="10,0" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
                <Grid Margin="10,9,8,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="56*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="key" Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="value" Grid.Column="2" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" Visibility="Collapsed">
                        <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Fg}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                    </TextBlock>
                    <!-- Módulos lado a lado: chave mais estreita (30/70) para cada célula caber um part number inteiro -->
                    <Grid x:Name="cells" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="70*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" Margin="0,0,10,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock x:Name="copy" Grid.Column="3" Tag="copy" Text="&#xE8C8;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Help}" Style="{StaticResource Explain}" Margin="0,8,0,1"
                               Visibility="{Binding Help, Converter={StaticResource NotEmptyVis}}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="host" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="1" />
                    <Setter TargetName="copy" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding Cells}" Value="{x:Null}">
                    <Setter TargetName="key" Property="Visibility" Value="Visible" />
                    <Setter TargetName="value" Property="Visibility" Value="Visible" />
                    <Setter TargetName="cells" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SpecGroupTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitle}" Margin="0,8,0,8" />
                <!-- Uma frase que explica o assunto do grupo, para quem não é do ramo -->
                <TextBlock Text="{Binding Help}" Style="{StaticResource Explain}" Margin="0,-2,0,12"
                           Visibility="{Binding Help, Converter={StaticResource NotEmptyVis}}" />
                <!-- Cabeçalho das colunas (módulos lado a lado), alinhado com as células das linhas -->
                <Grid x:Name="columns" Margin="0,0,30,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="70*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Columns}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource LabelFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                <!-- Instruções: lista em linha; as que o processador não tem ficam apagadas -->
                <Border x:Name="tokens" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,2">
                    <ItemsControl ItemsSource="{Binding Tokens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="t" Text="{Binding Text}" FontFamily="{StaticResource LabelFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,0,14,6" ToolTip="Suportada" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding On}" Value="False">
                                        <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Faint}" />
                                        <Setter TargetName="t" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="t" Property="ToolTip" Value="Não suportada por este processador" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tokens}" Value="{x:Null}">
                    <Setter TargetName="tokens" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Columns}" Value="{x:Null}">
                    <Setter TargetName="columns" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Armazenamento: um disco por linha, com as unidades dele em proporção ao tamanho -->
        <DataTemplate x:Key="DiskTemplate">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meta}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Volumes}" Height="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><inv:WeightPanel Gap="6" Total="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="inv:WeightPanel.Weight" Value="{Binding Weight}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid OpacityMask="{StaticResource SegmentMask}" ToolTip="{Binding Tip}" Background="Transparent">
                                        <Border Background="{DynamicResource Line}" />
                                        <Border Background="{DynamicResource Storage}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Used}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Letter}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Line}" FontSize="12.5" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Size}" Style="{StaticResource ReadoutText}" FontSize="26" FontWeight="Light" />
                            <TextBlock Text="{Binding Unit}" Style="{StaticResource Unit}" FontSize="12.5" Margin="4,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding Free}" FontSize="12.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0"
                                   Visibility="{Binding Free, Converter={StaticResource NotEmptyVis}}" />
                        <!-- Saúde que o Windows informa para o disco -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{Binding Health, Converter={StaticResource NotEmptyVis}}"
                                    ToolTip="Estado que o Windows informa. Detalhes de vida útil e temperatura em Discos.">
                            <TextBlock Text="{Binding Health}" FontSize="12.5" Foreground="{DynamicResource Fg}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Exportar relatório: a ação principal da página, em tinta como toda ação principal. Ícone num ladrilho translúcido e
             texto seminegrito; o mouse clareia, o clique afunda 1 px e, enquanto gera, o botão apaga e diz o que está fazendo. -->
        <Style x:Key="ReportButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SignalFill}" />
            <Setter Property="Foreground" Value="{DynamicResource SignalFg}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusInset}" Padding="6,6,18,6" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="30" Height="30">
                                    <Border CornerRadius="5" Background="{DynamicResource SignalFg}" Opacity="0.12" />
                                    <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" Margin="11,0,0,1" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource SignalFillHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Margin" Value="0,1,0,-1" />
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource SignalFill}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="face" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Wait" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leva às leituras ao vivo: botão discreto no rodapé do card, com ícone de pulso e seta -->
        <Style x:Key="SheetLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="Transparent" Padding="12,8,12,8" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Signal}" VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource LabelFont}" FontSize="13.5" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="9,0,0,1" />
                                <TextBlock x:Name="arrow" Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter TargetName="arrow" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Sistema" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SystemSub" Text="Lendo informações do sistema…" Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <Button x:Name="BtnReport" Grid.Column="1" Style="{StaticResource ReportButton}" Content="Exportar relatório" VerticalAlignment="Center" Click="BtnReport_Click"
                    ToolTip="Salva a ficha completa do computador em HTML (abre no navegador, com tema claro e escuro e botão de imprimir), em PDF (A4, pronto para enviar) ou em JSON (dados). Números de série e o nome do usuário ficam de fora." />
        </Grid>

        <!-- Um painel só: o índice da máquina em cima e a ficha do componente escolhido embaixo -->
        <Border x:Name="SheetCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" SizeChanged="SheetCard_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Faixa do índice: tom intermediário (o mesmo da faixa de colunas de Sensores), para os botões se destacarem -->
                <Rectangle Fill="{DynamicResource Raised}" />
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" />
                <ListBox x:Name="SysIndex" ItemContainerStyle="{StaticResource IndexCell}" Margin="8" SelectionChanged="SysIndex_Changed"
                         KeyboardNavigation.DirectionalNavigation="Cycle">
                    <!-- Sem rolagem nem borda própria -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid x:Name="IndexGrid" Rows="1" Loaded="IndexGrid_Loaded" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid x:Name="Sheet" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Placa: quem é o componente e as quatro leituras que o resumem -->
                    <!-- No tom mais forte, como o cabeçalho de componente em Sensores; o botão escolhido usa o mesmo fundo -->
                    <!-- A luz do canal do componente escolhido acende a placa por trás do nome -->
                    <Border Background="{DynamicResource Selected}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1" ClipToBounds="True">
                        <Grid>
                        <Border Style="{StaticResource Glow}" local:Ui.Channel="{Binding SelectedItem.Channel, ElementName=SysIndex}" HorizontalAlignment="Left" Width="760" Margin="-150,0,0,0" />
                        <Grid Margin="32,28,32,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,40,0">
                                <TextBlock x:Name="SheetEyebrow" Style="{StaticResource PlateEyebrow}" local:Ui.Channel="{Binding SelectedItem.Channel, ElementName=SysIndex}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SheetTitle" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <TextBlock x:Name="SheetSub" FontSize="13.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Margin="0,7,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="SheetReadouts" Grid.Column="1" VerticalAlignment="Bottom" ItemTemplate="{StaticResource ReadoutCell}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        </Grid>
                    </Border>

                    <!-- Os dados na largura toda, em grupos que se distribuem em colunas -->
                    <ScrollViewer x:Name="SpecScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="32,18,32,14">
                            <!-- Armazenamento: os discos em cima, com as unidades; a ficha de cada um vem nos grupos abaixo -->
                            <ItemsControl x:Name="DiskList" ItemTemplate="{StaticResource DiskTemplate}" Margin="0,-8,0,20" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Focusable="False" />
                            <ItemsControl x:Name="SpecGroups" ItemTemplate="{StaticResource SpecGroupTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><inv:ColumnsPanel Loaded="SpecColumns_Loaded" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="inv:ColumnsPanel.Column" Value="{Binding Column}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Rodapé do card: atalho para as leituras ao vivo, no canto inferior esquerdo -->
                    <Border x:Name="SheetFooter" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,12,32,14">
                        <Button x:Name="SheetLink" Style="{StaticResource SheetLink}" HorizontalAlignment="Left" Click="SheetLink_Click" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
