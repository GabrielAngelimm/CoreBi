<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.SystemView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Sistema" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SystemSub" Text="Hardware e software detectados" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button x:Name="BtnReport" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72D;" Content="Exportar relatório" VerticalAlignment="Top" Click="BtnReport_Click" ToolTip="Salva um relatório (HTML ou JSON) com sistema, memória, discos, GPU, sensores e benchmarks. Números de série ficam de fora." />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Índice de categorias: cada uma com o glifo do componente -->
            <ListBox x:Name="InfoCategories" ItemContainerStyle="{StaticResource ListNavItem}" SelectionChanged="InfoCategories_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Header, Converter={StaticResource CategoryIcon}}" Style="{StaticResource ListNavIcon}" FontSize="14" Width="18" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,28,26">
                        <TextBlock x:Name="InfoTitle" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <StackPanel x:Name="DrivesPanel" Visibility="Collapsed" Margin="0,4,0,8">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Unidades" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="DrivesSummary" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl x:Name="DriveCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetBorder}" Padding="16,14" Margin="0,0,12,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Ocupação: anel em arco, como um mostrador -->
                                                <Grid Width="84" Height="84" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <Ellipse Width="72" Height="72" Stroke="{DynamicResource Line}" StrokeThickness="7" />
                                                    <Path Data="{Binding UsedFraction, Converter={StaticResource DriveArc}}" Stroke="{DynamicResource Accent}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock Text="{Binding UsedPercent}" Style="{StaticResource ReadoutText}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Sizes}" Style="{StaticResource Caption}" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Footnote}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Discos físicos" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                        </StackPanel>
                        <ItemsControl x:Name="InfoDetails" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
