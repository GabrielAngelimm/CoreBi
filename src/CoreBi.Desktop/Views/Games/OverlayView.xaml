                                                        <Ellipse Canvas.Left="654" Canvas.Top="92" Width="116" Height="116" Fill="{StaticResource HudSceneHalo}" />
                                                        <Ellipse Canvas.Left="672" Canvas.Top="110" Width="80" Height="80" Fill="{StaticResource HudSceneMoon}" />
                                                        <Path Fill="{StaticResource HudSceneFar}" Data="M0,300 L60,262 L96,276 L170,206 L214,236 L262,214 L330,262 L420,190 L470,222 L540,174 L610,238 L680,210 L742,248 L820,196 L880,232 L984,250 L984,554 L0,554 Z" />
                                                        <Path Fill="{StaticResource HudSceneFarShade}" Data="M60,262 L96,276 L87.0,416 L70.8,416 Z M170,206 L214,236 L203.0,376 L183.2,376 Z M262,214 L330,262 L313.0,402 L282.4,402 Z M420,190 L470,222 L457.5,362 L435.0,362 Z M540,174 L610,238 L592.5,378 L561.0,378 Z M680,210 L742,248 L726.5,388 L698.6,388 Z M820,196 L880,232 L865.0,372 L838.0,372 Z" />
                                                        <Path Fill="{StaticResource HudSceneSnow}" Data="M170,206 L183.2,215.0 L176.6,211.0 L172.0,213.5 L158.9,224.0 L147.8,227.0 Z M262,214 L282.4,228.4 L272.2,224.4 L264.0,224.2 L254.8,217.6 L247.6,220.6 Z M420,190 L435.0,199.6 L427.5,195.6 L422.0,197.8 L406.5,208.6 L393.0,211.6 Z M540,174 L561.0,193.2 L550.5,189.2 L542.0,186.6 L529.5,185.4 L519.0,188.4 Z M680,210 L698.6,221.4 L689.3,217.4 L682.0,218.7 L669.5,215.4 L659.0,218.4 Z M820,196 L838.0,206.8 L829.0,202.8 L822.0,204.4 L808.3,208.6 L796.6,211.6 Z" />
                                                        <Path Fill="{StaticResource HudSceneNear}" Data="M0,350 L80,302 L140,326 L230,270 L300,318 L370,292 L450,338 L560,276 L640,322 L720,288 L820,334 L900,300 L984,330 L984,554 L0,554 Z" />
                                                        <Path Fill="{StaticResource HudSceneNearShade}" Data="M80,302 L140,326 L125.0,476 L98.0,476 Z M230,270 L300,318 L282.5,468 L251.0,468 Z M370,292 L450,338 L430.0,488 L394.0,488 Z M560,276 L640,322 L620.0,472 L584.0,472 Z M720,288 L820,334 L795.0,484 L750.0,484 Z M900,300 L984,330 L963.0,480 L925.2,480 Z" />
