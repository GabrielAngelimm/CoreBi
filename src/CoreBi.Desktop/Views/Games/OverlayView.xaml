<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.OverlayView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!--
            Canto da tela: a própria prévia é o seletor. Clicar num canto do "monitor" posiciona o overlay ali;
            o canto escolhido mostra uma miniatura da leitura de FPS.
        -->
        <Style x:Key="CornerSpot" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Width="104" Height="50" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="9,6">
                            <Grid>
                                <StackPanel x:Name="mini" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="144" FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="17" Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="FPS" FontSize="9" Foreground="#9FB0BC" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                                    </StackPanel>
                                    <Border Height="3" Width="70" HorizontalAlignment="Left" Background="#2C3B47" CornerRadius="1.5" Margin="0,3,0,0" />
                                    <Border Height="3" Width="52" HorizontalAlignment="Left" Background="#2C3B47" CornerRadius="1.5" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="hint" Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#5E6E7A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3A4A56" />
                                <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#CC0F1820" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="mini" Property="Visibility" Value="Visible" />
                                <Setter TargetName="hint" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}">
                <StackPanel>
                    <TextBlock Text="Overlay" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="FPS, frametime e sensores por cima do jogo, sem injetar nada no processo." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </Grid>

            <!-- Interruptor principal + atalho -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <CheckBox x:Name="ChkOverlay" Style="{StaticResource Switch}" Content="Mostrar overlay" FontSize="15" FontWeight="SemiBold" Checked="ChkOverlay_Changed" Unchecked="ChkOverlay_Changed" />
                        <TextBlock Text="Funciona em tela cheia sem bordas e na maioria dos jogos DirectX 11 e 12." Style="{StaticResource Caption}" Margin="49,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Atalho global" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Style="{StaticResource KeyCapText}" /></Border>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift" Style="{StaticResource KeyCapText}" /></Border>
                        <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="O" Style="{StaticResource KeyCapText}" /></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="Posição e tamanho" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Clique no canto do monitor onde o overlay deve ficar." Style="{StaticResource Caption}" Margin="0,3,0,14" />
                        <!-- Monitor em miniatura (16:9) -->
                        <Border Width="384" Height="216" CornerRadius="10" Background="#0A1015" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" HorizontalAlignment="Left">
                            <Grid x:Name="OvCornerPanel" Margin="8">
                                <RadioButton Style="{StaticResource CornerSpot}" GroupName="OvCorner" Tag="TL" ToolTip="Superior esquerdo" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="OvOption_Changed" />
                                <RadioButton Style="{StaticResource CornerSpot}" GroupName="OvCorner" Tag="TR" ToolTip="Superior direito" HorizontalAlignment="Right" VerticalAlignment="Top" Checked="OvOption_Changed" />
                                <RadioButton Style="{StaticResource CornerSpot}" GroupName="OvCorner" Tag="BL" ToolTip="Inferior esquerdo" HorizontalAlignment="Left" VerticalAlignment="Bottom" Checked="OvOption_Changed" />
                                <RadioButton Style="{StaticResource CornerSpot}" GroupName="OvCorner" Tag="BR" ToolTip="Inferior direito" HorizontalAlignment="Right" VerticalAlignment="Bottom" Checked="OvOption_Changed" />
                            </Grid>
                        </Border>
                        <Border Width="64" Height="10" Background="{DynamicResource LineStrong}" CornerRadius="0,0,4,4" HorizontalAlignment="Left" Margin="160,0,0,0" />
                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Tamanho" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Right">
                                <StackPanel x:Name="OvScalePanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Pequeno" Tag="0.85" Checked="OvOption_Changed" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Médio" Tag="1" Checked="OvOption_Changed" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Grande" Tag="1.3" Checked="OvOption_Changed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="Detecção de FPS" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="OvStatus" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" />
                        <Border Style="{StaticResource Divider}" Margin="0,16" />
                        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Text="O FPS é medido pelos eventos de apresentação do Windows (ETW): nada é injetado no jogo, mas a compatibilidade com cada anti-cheat depende do jogo." />
                        <TextBlock Style="{StaticResource Footnote}" Margin="0,10,0,0" Text="Funciona com DirectX 9 a 12. Jogos em Vulkan ou OpenGL só aparecem se o driver apresentar via DXGI. A tela cheia exclusiva antiga não mostra o overlay." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="O que mostrar" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="A mudança vale na hora e fica salva. Cada componente vira uma linha só com os itens marcados." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="Predefinições" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Só FPS" Tag="min" Click="OvPreset_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="Padrão" Tag="default" Click="OvPreset_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="Tudo" Tag="all" Click="OvPreset_Click" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="OvItemsPanel" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Footnote}" Margin="0,14,0,0" Text="Clock da memória, hotspot e ventoinha dependem da placa. O limitador (PerfCap) é só NVIDIA. Clock e temperatura da CPU precisam do CoreBi aberto como administrador." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
