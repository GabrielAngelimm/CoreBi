<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.OverlayView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!--
            Canto da tela: cada quarto da tela do monitor é um botão. O canto livre mostra um contorno tracejado
            (o lugar onde o overlay pode ficar); sob o mouse ele acende no sinal com "Mover para cá". O canto escolhido some
            e dá lugar à prévia do próprio overlay. A tela é um "jogo", então as cores aqui são fixas, como no overlay.
        -->
        <Style x:Key="CornerZone" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid x:Name="zone" Width="150" Height="86" Margin="14"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Rectangle x:Name="dash" RadiusX="8" RadiusY="8" Stroke="{StaticResource HudZone}" StrokeThickness="1.5" StrokeDashArray="3 2.5" Fill="{StaticResource HudZoneFill}" />
                                <TextBlock x:Name="plus" Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource HudZoneMark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel x:Name="hint" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                                    <TextBlock Text="&#xE7C2;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource HudSignal}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Mover para cá" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HudFg}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <!-- Foco de teclado: o mesmo contorno, cheio e claro -->
                            <Rectangle x:Name="focus" Width="158" Height="94" Margin="10" RadiusX="11" RadiusY="11" Stroke="{StaticResource HudFg}" StrokeThickness="2" Visibility="Collapsed"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dash" Property="Stroke" Value="{StaticResource HudSignal}" />
                                <Setter TargetName="dash" Property="Fill" Value="{StaticResource HudZoneHover}" />
                                <Setter TargetName="plus" Property="Visibility" Value="Collapsed" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="focus" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="zone" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controle deslizante fino: trilho, parte preenchida acesa no sinal e botão redondo -->
        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Line}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource Signal}" /></Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="e" Width="16" Height="16" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Raised}" StrokeThickness="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Fill" Value="{DynamicResource Fg}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compatibilidade da detecção de FPS: selo com glifo e cor de veredito -->
        <Style x:Key="CompatText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CompatGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>
        <Style x:Key="CompatRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,5,12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <!--
        Uma tela: com a janela maximizada tudo cabe sem rolar (o monitor ocupa a sobra de altura);
        em janelas menores a página volta a rolar e os dois painéis do meio ficam um embaixo do outro.
    -->
    <ScrollViewer x:Name="OvScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=OvScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho padrão: o interruptor e o atalho ficam num grupo de 36 px na barra de ações, na linha do título -->
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="OverlayBi" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource ActionGroup}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkOverlay" Style="{StaticResource Switch}" Content="Mostrar overlay" FontSize="14" FontWeight="SemiBold"
                                      Checked="ChkOverlay_Changed" Unchecked="ChkOverlay_Changed" />
                            <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="16,0" />
                            <!-- A tecla é a letra O: na fonte da interface ela é redonda e não se confunde com o zero da DIN -->
                            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="Ctrl + Shift + O (a letra O) liga e desliga o overlay de qualquer lugar, inclusive dentro do jogo.">
                                <!--
                                    Tudo na base de "Mostrar overlay" (medido): centrado, o rótulo ficava 2 px acima e as teclas 1 px;
                                    4 px de margem em cima descem o rótulo 2 e 2 px descem as teclas 1.
                                -->
                                <TextBlock Text="Atalho global" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,4,8,0" />
                                <Border Style="{StaticResource KeyCap}" Margin="0,2,4,0"><TextBlock Text="Ctrl" Style="{StaticResource KeyCapText}" /></Border>
                                <Border Style="{StaticResource KeyCap}" Margin="0,2,4,0"><TextBlock Text="Shift" Style="{StaticResource KeyCapText}" /></Border>
                                <Border Style="{StaticResource KeyCap}" Margin="0,2,0,0"><TextBlock Text="O" Style="{StaticResource KeyCapText}" FontFamily="{StaticResource UiFont}" /></Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="FPS, frametime e sensores por cima do jogo." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                </local:PageHeaderPanel>

                <!-- Meio: posição (com a prévia) e o que mostrar, lado a lado -->
                <Grid x:Name="OvMain" Grid.Row="1" SizeChanged="OvMain_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="OvPositionCard" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="34" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--
                                Título à esquerda; à direita, o estado da detecção de FPS (LED e uma linha, só quando há o que dizer) e, sem jogo
                                medido, a nota da prévia. O estado mora aqui, e não numa faixa sob os cartões, para a página terminar na mesma
                                linha que as outras.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Posição e tamanho" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Ellipse x:Name="OvStatusDot" Style="{StaticResource StatusLed}" Margin="0,1,8,0" />
                                    <TextBlock x:Name="OvStatus" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="460" Style="{StaticResource Num}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Estado real: sem jogo medido, o FPS da prévia é de exemplo (os sensores são ao vivo) -->
                                <TextBlock x:Name="OvSampleNote" Grid.Column="2" Text="Prévia com FPS de exemplo" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,0,0"
                                           ToolTip="Enquanto o CoreBi não mede um jogo, a prévia mostra 144 FPS de exemplo. Os sensores são lidos ao vivo." Visibility="Collapsed" />
                            </Grid>

                            <!-- Monitor: desenho fixo em 820 de largura, escalado para o espaço que sobrar -->
                            <local:FillBox x:Name="OvMonitorBox" Grid.Row="1" MinHeight="300" Margin="0,16">
                                <Viewbox Stretch="Uniform">
                                    <StackPanel Width="820">
                                        <Border CornerRadius="16" Background="{StaticResource HudScreenBezel}" BorderBrush="{StaticResource HudScreenEdge}" BorderThickness="1" Padding="10,10,10,0">
                                            <StackPanel>
                                                <Grid Width="798" Height="449">
                                                    <Grid.Clip>
                                                        <RectangleGeometry Rect="0,0,798,449" RadiusX="7" RadiusY="7" />
                                                    </Grid.Clip>
                                                    <!-- Cena de jogo: céu, duas serras e chão, em planos chapados e apagados para não brigar com o overlay -->
                                                    <Rectangle Fill="{StaticResource HudScene}" />
                                                    <Canvas IsHitTestVisible="False">
                                                        <Path Fill="{StaticResource HudSceneFar}" Data="M0,292 L64,250 L122,272 L204,212 L282,258 L352,228 L440,276 L532,222 L612,254 L694,214 L798,258 L798,449 L0,449 Z" />
                                                        <Path Fill="{StaticResource HudSceneNear}" Data="M0,334 L86,286 L168,318 L258,272 L346,326 L428,296 L516,338 L606,292 L698,326 L798,296 L798,449 L0,449 Z" />
                                                        <Path Fill="{StaticResource HudSceneGround}" Data="M0,388 C150,362 292,378 418,370 C556,360 676,382 798,366 L798,449 L0,449 Z" />
                                                    </Canvas>

                                                    <!-- Os quatro cantos (um quarto da tela cada) -->
                                                    <Grid x:Name="OvCornerPanel">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="TL" ToolTip="Canto superior esquerdo"
                                                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Checked="OvOption_Changed" />
                                                        <RadioButton Grid.Column="1" Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="TR" ToolTip="Canto superior direito"
                                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Top" Checked="OvOption_Changed" />
                                                        <RadioButton Grid.Row="1" Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="BL" ToolTip="Canto inferior esquerdo"
                                                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom" Checked="OvOption_Changed" />
                                                        <RadioButton Grid.Row="1" Grid.Column="1" Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="BR" ToolTip="Canto inferior direito"
                                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom" Checked="OvOption_Changed" />
                                                    </Grid>

                                                    <!-- Prévia: a mesma caixa do overlay real, com os itens marcados e os sensores ao vivo -->
                                                    <Grid x:Name="OvPreviewHost" IsHitTestVisible="False" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <Rectangle Margin="-5" RadiusX="11" RadiusY="11" Stroke="{StaticResource HudZoneMark}" StrokeThickness="1.5" StrokeDashArray="3 2.5" />
                                                        <Decorator>
                                                            <Decorator.LayoutTransform>
                                                                <ScaleTransform x:Name="OvPreviewScale" ScaleX="0.72" ScaleY="0.72" />
                                                            </Decorator.LayoutTransform>
                                                            <local:OverlayPanel x:Name="OvPreview" />
                                                        </Decorator>
                                                    </Grid>
                                                </Grid>
                                                <!-- Moldura inferior com o LED: aceso quando o overlay está ligado -->
                                                <Grid Height="22">
                                                    <Ellipse x:Name="OvLed" Width="5" Height="5" Fill="{StaticResource HudSep}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <!-- Pé: coluna afunilada e base -->
                                        <Path HorizontalAlignment="Center" Data="M14,0 L110,0 L124,58 L0,58 Z" Stretch="None" Fill="{StaticResource HudStand}" />
                                        <Border Width="270" Height="12" CornerRadius="6,6,8,8" HorizontalAlignment="Center" Background="{StaticResource HudStandBase}" BorderBrush="{StaticResource HudScreenEdge}" BorderThickness="0,1,0,0" />
                                    </StackPanel>
                                </Viewbox>
                            </local:FillBox>

                            <!-- Controles: três blocos de geometria fixa (posição, opacidade, tamanho) numa faixa só; nada muda de lugar ao trocar de opção -->
                            <Border Grid.Row="2" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusInset}" Padding="16,0" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Rótulo e valor como Runs do mesmo TextBlock: a mesma linha de base por construção (em dois TextBlocks
                                         centrados o rótulo ficava 1 px acima). O espaço (um médio e um fino, a 12 px) dá ≈ 8 px. -->
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="Posição" FontFamily="{StaticResource SmallFont}" FontSize="12" Foreground="{DynamicResource Muted}" /><Run Text="&#x2002;&#x2009;" FontSize="12" /><Run x:Name="OvCornerName" Text="Canto superior esquerdo" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Border Grid.Column="1" Width="1" Height="22" Background="{DynamicResource Line}" Margin="16,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Opacidade" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider x:Name="OvOpacity" Style="{StaticResource OpacitySlider}" Minimum="30" Maximum="100" SmallChange="1" LargeChange="10"
                                                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Width="130" VerticalAlignment="Center"
                                                ValueChanged="OvOpacity_Changed" PreviewMouseWheel="OvOpacity_Wheel" ToolTip="Também ajusta com a roda do mouse" />
                                        <TextBlock x:Name="OvOpacityText" Text="100 %" Style="{StaticResource Num}" Foreground="{DynamicResource Muted}" FontSize="12"
                                                   Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Height="22" Background="{DynamicResource Line}" Margin="16,0" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tamanho" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border Style="{StaticResource SegmentGroup}">
                                            <local:SlidingSelectionPanel x:Name="OvScalePanel" Style="{StaticResource SegmentRail}">
                                                <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Pequeno" Tag="1" Checked="OvOption_Changed" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Médio" Tag="1.35" Checked="OvOption_Changed" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Grande" Tag="1.75" Checked="OvOption_Changed" />
                                            </local:SlidingSelectionPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- O que mostrar: uma linha por componente, com os itens em pílulas (marcado = fio e visto no sinal, fundo tingido) -->
                    <Border x:Name="OvItemsCard" Grid.Column="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="O que mostrar" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Top">
                                    <local:SlidingSelectionPanel x:Name="OvPresetPanel" Style="{StaticResource SegmentRail}">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Essencial" Tag="default" Click="OvPreset_Click">
                                            <RadioButton.ToolTip>
                                                <StackPanel MaxWidth="290">
                                                    <TextBlock Text="Essencial" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="O básico para jogar sem poluir a tela: o que a placa de vídeo e o processador estão fazendo agora, e quanta memória está em uso." />
                                                    <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS, frametime e 1% low · GPU: uso, temperatura, clock e consumo · VRAM · CPU: uso, temperatura, clock e consumo · RAM · nome do hardware" />
                                                </StackPanel>
                                            </RadioButton.ToolTip>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Só FPS" Tag="min" Click="OvPreset_Click">
                                            <RadioButton.ToolTip>
                                                <StackPanel MaxWidth="290">
                                                    <TextBlock Text="Só FPS" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="O overlay mais discreto possível: só o contador e a estabilidade dos quadros." />
                                                    <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS, frametime e 1% low" />
                                                </StackPanel>
                                            </RadioButton.ToolTip>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Gargalo" Tag="gargalo" Click="OvPreset_Click">
                                            <RadioButton.ToolTip>
                                                <StackPanel MaxWidth="290">
                                                    <TextBlock Text="Gargalo" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Para descobrir quem está limitando o jogo: compara o uso da GPU com o do núcleo de CPU mais ocupado e mostra se a memória aperta." />
                                                    <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS, 1% low e gráfico · GPU: uso, clock e limitador · VRAM · CPU: uso, núcleo mais ocupado e clock · RAM em %" />
                                                </StackPanel>
                                            </RadioButton.ToolTip>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Térmico" Tag="termico" Click="OvPreset_Click">
                                            <RadioButton.ToolTip>
                                                <StackPanel MaxWidth="290">
                                                    <TextBlock Text="Térmico" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Para acompanhar calor e consumo em sessões longas e testar a refrigeração." />
                                                    <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS · GPU: temperatura, hotspot, consumo e ventoinha · CPU: temperatura, consumo e clock · hora" />
                                                </StackPanel>
                                            </RadioButton.ToolTip>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Tudo" Tag="all" Click="OvPreset_Click">
                                            <RadioButton.ToolTip>
                                                <StackPanel MaxWidth="290">
                                                    <TextBlock Text="Tudo" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Liga todos os itens disponíveis. Fica grande: combina melhor com o tamanho Pequeno." />
                                                    <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="Todos os grupos: FPS, GPU, VRAM, CPU, RAM e rodapé" />
                                                </StackPanel>
                                            </RadioButton.ToolTip>
                                        </RadioButton>
                                    </local:SlidingSelectionPanel>
                                </Border>
                            </Grid>
                            <local:SpreadPanel x:Name="OvItemsPanel" Grid.Row="1" Margin="0,16,0,8" />
                            <!-- Só sem administrador: é o único motivo de um item marcado da CPU aparecer com travessão (os da placa ficam na dica de cada item) -->
                            <TextBlock x:Name="OvAdminNote" Grid.Row="2" Style="{StaticResource Footnote}"
                                       Text="Temperatura, clock e consumo da CPU precisam do CoreBi aberto como administrador." />
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
