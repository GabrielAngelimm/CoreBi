<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.OverlayView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!--
            Canto da tela: cada quarto da tela do monitor é um botão. O canto livre mostra um contorno tracejado pequeno, de tamanho
            fixo (o lugar onde o overlay pode ficar); sob o mouse ele acende no sinal com "Mover para cá". No clique a prévia vai até
            ele, encolhida ao tamanho do tracejado, e então cresce até o tamanho escolhido (OverlayView.LayoutPreview). O canto
            escolhido some e dá lugar à prévia; um canto que a prévia grande cobriria também some. As cores aqui são fixas, como no
            overlay: a tela é um "jogo".
        -->
        <Style x:Key="CornerZone" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid x:Name="zone" Width="184" Height="104" Margin="16"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Rectangle x:Name="dash" RadiusX="10" RadiusY="10" Stroke="{StaticResource HudZone}" StrokeThickness="1.5" StrokeDashArray="3 2.5" Fill="{StaticResource HudZoneFill}" />
                                <TextBlock x:Name="plus" Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource HudZoneMark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel x:Name="hint" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                                    <TextBlock Text="&#xE7C2;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource HudSignal}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Mover para cá" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HudFg}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <!-- Foco de teclado: o mesmo contorno, cheio e claro -->
                            <Rectangle x:Name="focus" Width="192" Height="112" Margin="12" RadiusX="12" RadiusY="12" Stroke="{StaticResource HudFg}" StrokeThickness="2" Visibility="Collapsed"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dash" Property="Stroke" Value="{StaticResource HudSignal}" />
                                <Setter TargetName="dash" Property="Fill" Value="{StaticResource HudZoneHover}" />
                                <Setter TargetName="plus" Property="Visibility" Value="Collapsed" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="focus" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="zone" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controle deslizante fino: trilho, parte preenchida acesa no sinal e botão redondo -->
        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Line}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource Signal}" /></Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="e" Width="16" Height="16" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Raised}" StrokeThickness="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Fill" Value="{DynamicResource Fg}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Item do overlay: uma pílula sem fio, com um LED e o nome; a pílula inteira é o alvo do clique. Apagado = anel, nome em
            tom baixo e fundo só sob o mouse; aceso = ponto no sinal, nome em tinta e a pílula tingida do sinal. Os itens de um
            grupo ficam numa grade de três colunas.
        -->
        <Style x:Key="OvItem" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1,4,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="b" Height="36" Padding="11,0,6,0" CornerRadius="18" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="led" Width="8" Height="8" VerticalAlignment="Center" Stroke="{DynamicResource Faint}" StrokeThickness="1.5" Fill="Transparent" />
                                <!-- 2 px abaixo do centro: a DIN fica alta numa linha centrada (medido nas pílulas) -->
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Margin="9,2,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="led" Property="Stroke" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SignalSoft}" />
                                <Setter TargetName="led" Property="Fill" Value="{DynamicResource Signal}" />
                                <Setter TargetName="led" Property="Stroke" Value="{DynamicResource Signal}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Onde funciona: tópicos separados por um fio. Cada um tem um LED (verde: funciona; âmbar: falta algo; vermelho: falhou;
            apagado: opcional), o caso e o estado à direita. Quando falta algo, a linha ganha embaixo o que fazer e, se der, o botão
            que resolve; vários avisos são vários tópicos, cada um no seu lugar.
        -->
        <Style x:Key="WhereRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,9,0,9" />
        </Style>
        <Style x:Key="WhereLed" TargetType="Ellipse" BasedOn="{StaticResource StatusLed}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource Ok}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="2,7,14,0" />
        </Style>
        <Style x:Key="WhereName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="WhereState" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,1,0,0" />
        </Style>
        <Style x:Key="WhereHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="WhereButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <!--
        Uma tela: com a janela maximizada tudo cabe sem rolar (o monitor ocupa a sobra de altura);
        em janelas menores a página volta a rolar e os dois painéis do meio ficam um embaixo do outro.
    -->
    <ScrollViewer x:Name="OvScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=OvScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho padrão: o interruptor e o atalho ficam num grupo de 36 px na barra de ações, na linha do título -->
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="OverlayBi" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource ActionGroup}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkOverlay" Style="{StaticResource Switch}" Content="Mostrar overlay" FontSize="14" FontWeight="SemiBold"
                                      Checked="ChkOverlay_Changed" Unchecked="ChkOverlay_Changed" />
                            <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="16,0" />
                            <!-- A tecla é a letra O: na fonte da interface ela é redonda e não se confunde com o zero da DIN -->
                            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="Ctrl + Shift + O (a letra O) liga e desliga o overlay de qualquer lugar, inclusive dentro do jogo.">
                                <!--
                                    Tudo na base de "Mostrar overlay" (medido): centrado, o rótulo ficava 2 px acima e as teclas 1 px;
                                    4 px de margem em cima descem o rótulo 2 e 2 px descem as teclas 1.
                                -->
                                <TextBlock Text="Atalho global" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,4,8,0" />
                                <Border Style="{StaticResource KeyCap}" Margin="0,2,4,0"><TextBlock Text="Ctrl" Style="{StaticResource KeyCapText}" /></Border>
                                <Border Style="{StaticResource KeyCap}" Margin="0,2,4,0"><TextBlock Text="Shift" Style="{StaticResource KeyCapText}" /></Border>
                                <Border Style="{StaticResource KeyCap}" Margin="0,2,0,0"><TextBlock Text="O" Style="{StaticResource KeyCapText}" FontFamily="{StaticResource UiFont}" /></Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="FPS, frametime e sensores por cima do jogo." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                </local:PageHeaderPanel>

                <!-- Meio: posição (com a prévia) e o que mostrar, lado a lado -->
                <Grid x:Name="OvMain" Grid.Row="1" SizeChanged="OvMain_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2.4*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="OvPositionCard" Style="{StaticResource CardBorder}" local:Skeleton.Top="34"
                            local:Skeleton.Layout="gap 16; foot 50: box *; footgap 16; rest: box *">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="34" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--
                                Título à esquerda; à direita, o estado da detecção de FPS (LED e uma linha, só quando há o que dizer) e, sem jogo
                                medido, a nota da prévia. O estado mora aqui, e não numa faixa sob os cartões, para a página terminar na mesma
                                linha que as outras.
                            -->
                            <!-- Cabeçalho de 34 px (CardHeader), na mesma altura do "O que mostrar" ao lado, que tem as pílulas -->
                            <Grid Style="{StaticResource CardHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Posição e tamanho" Style="{StaticResource CardTitle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Ellipse x:Name="OvStatusDot" Style="{StaticResource StatusLed}" Margin="0,1,8,0" />
                                    <TextBlock x:Name="OvStatus" FontSize="13" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="460" Style="{StaticResource Num}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Estado real: sem jogo medido, o FPS da prévia é de exemplo (os sensores são ao vivo) -->
                                <TextBlock x:Name="OvSampleNote" Grid.Column="2" Text="Prévia com FPS de exemplo" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,0,0"
                                           ToolTip="Enquanto o CoreBi não mede um jogo, a prévia mostra 144 FPS de exemplo. Os sensores são lidos ao vivo." Visibility="Collapsed" />
                            </Grid>

                            <!--
                                Monitor: desenho fixo de 1000 × 712 (tela 16:9 de 984 × 554, bordas de 8 px, queixo com o LED, haste e base),
                                escalado para o espaço que sobrar. A haste e a base ficam atrás do painel, como num monitor de verdade.
                            -->
                            <local:FillBox x:Name="OvMonitorBox" Grid.Row="1" MinHeight="300" Margin="0,16">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="1000" Height="712">
                                        <Canvas IsHitTestVisible="False">
                                            <!-- Sombra de contato no tom da bancada, para o pé assentar no cartão nos dois temas -->
                                            <Ellipse Canvas.Left="290" Canvas.Top="698" Width="420" Height="14" Fill="{DynamicResource Bg}" />
                                            <!-- Haste: frente e a lateral um tom abaixo, com o furo do cabo -->
                                            <Path Fill="{StaticResource HudStand}" Data="M462,586 L538,586 L546,690 L454,690 Z" />
                                            <Path Fill="{StaticResource HudStandSide}" Data="M538,586 L546,690 L536,690 L530,586 Z" />
                                            <Rectangle Canvas.Left="487" Canvas.Top="622" Width="26" Height="30" RadiusX="13" RadiusY="13" Fill="{StaticResource HudStandHole}" />
                                            <!-- Base: tampo e borda da frente -->
                                            <Rectangle Canvas.Left="320" Canvas.Top="682" Width="360" Height="18" RadiusX="9" RadiusY="9" Fill="{StaticResource HudStandBase}" />
                                            <Path Fill="{StaticResource HudStandEdge}" Data="M320,691 L680,691 L680,694 Q680,704 670,704 L330,704 Q320,704 320,694 Z" />
                                        </Canvas>
                                        <Border Height="590" VerticalAlignment="Top" CornerRadius="12" Background="{StaticResource HudScreenBezel}"
                                                BorderBrush="{StaticResource HudScreenEdge}" BorderThickness="1" Padding="7,7,7,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="554" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid x:Name="OvScreen" Width="984" Height="554">
                                                    <Grid.Clip>
                                                        <RectangleGeometry Rect="0,0,984,554" RadiusX="4" RadiusY="4" />
                                                    </Grid.Clip>
                                                    <!--
                                                        Papel de parede: a lua e quatro serras em planos chapados (low poly), do fundo claro para a frente escura. A face de cada
                                                        pico oposta à lua fica um tom abaixo, fechada por uma aresta que desce do cume. Gerado por um script, sem árvores nem detalhes
                                                        soltos: o overlay é o que importa na tela.
                                                    -->
                                                    <Rectangle Fill="{StaticResource HudScene}" />
                                                    <Canvas IsHitTestVisible="False">
                                                        <Ellipse Canvas.Left="620" Canvas.Top="26" Width="192" Height="192" Fill="{StaticResource HudSceneGlow}" />
                                                        <Ellipse Canvas.Left="654" Canvas.Top="60" Width="124" Height="124" Fill="{StaticResource HudSceneHalo}" />
                                                        <Ellipse Canvas.Left="676" Canvas.Top="82" Width="80" Height="80" Fill="{StaticResource HudSceneMoon}" />
                                                        <Path Fill="{StaticResource HudSceneFar}" Data="M0,554 L0,236 L70,200 L120,214 L186,150 L262,104 L318,150 L352,140 L410,196 L470,178 L540,226 L600,206 L660,240 L770,250 L850,182 L904,206 L984,170 L984,554 Z" />
                                                        <Path Fill="{StaticResource HudSceneFarShade}" Data="M70,200 L0,236 L0.0,460 L79.0,460 Z M262,104 L186,150 L216.1,364 L272.1,364 Z M352,140 L318,150 L333.6,400 L362.4,400 Z M470,178 L410,196 L435.4,438 L482.6,438 Z M600,206 L540,226 L564.8,466 L610.8,466 Z M850,182 L770,250 L801.4,442 L859.7,442 Z" />
                                                        <Path Fill="{StaticResource HudSceneMid}" Data="M0,554 L0,300 L60,284 L150,240 L214,268 L270,262 L360,318 L470,270 L520,286 L600,250 L690,320 L780,300 L860,276 L984,322 L984,554 Z" />
                                                        <Path Fill="{StaticResource HudSceneMidShade}" Data="M150,240 L60,284 L95.5,480 L161.5,480 Z M270,262 L214,268 L239.3,502 L286.2,502 Z M470,270 L360,318 L401.6,510 L479.0,510 Z M600,250 L520,286 L553.7,490 L616.2,490 Z M860,276 L780,300 L815.8,516 L882.3,516 Z" />
                                                        <Path Fill="{StaticResource HudSceneNear}" Data="M0,554 L0,350 L96,330 L220,396 L330,376 L430,412 L520,400 L640,428 L760,370 L840,390 L984,354 L984,554 Z" />
                                                        <Path Fill="{StaticResource HudSceneNearShade}" Data="M96,330 L0,350 L0.0,530 L118.3,530 Z M330,376 L220,396 L264.8,576 L348.0,576 Z M520,400 L430,412 L469.1,600 L541.6,600 Z M760,370 L640,428 L687.0,570 L774.4,570 Z" />
                                                        <Path Fill="{StaticResource HudSceneFront}" Data="M0,554 L0,438 L110,470 L230,500 L380,520 L540,526 L680,512 L820,478 L920,452 L984,440 L984,554 Z" />
                                                    </Canvas>

                                                    <!-- Os quatro cantos (um quarto da tela cada) -->
                                                    <Grid x:Name="OvCornerPanel">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="TL" ToolTip="Mover para o canto superior esquerdo"
                                                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Checked="OvOption_Changed" />
                                                        <RadioButton Grid.Column="1" Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="TR" ToolTip="Mover para o canto superior direito"
                                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Top" Checked="OvOption_Changed" />
                                                        <RadioButton Grid.Row="1" Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="BL" ToolTip="Mover para o canto inferior esquerdo"
                                                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom" Checked="OvOption_Changed" />
                                                        <RadioButton Grid.Row="1" Grid.Column="1" Style="{StaticResource CornerZone}" GroupName="OvCorner" Tag="BR" ToolTip="Mover para o canto inferior direito"
                                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom" Checked="OvOption_Changed" />
                                                    </Grid>

                                                    <!-- Prévia: a mesma caixa do overlay real, com os itens marcados e os sensores ao vivo; desliza ao trocar de canto -->
                                                    <Grid x:Name="OvPreviewHost" IsHitTestVisible="False" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top" SizeChanged="OvPreviewHost_SizeChanged">
                                                        <Grid.RenderTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform x:Name="OvPreviewZoom" />
                                                                <TranslateTransform x:Name="OvPreviewShift" />
                                                            </TransformGroup>
                                                        </Grid.RenderTransform>
                                                        <Rectangle Margin="-5" RadiusX="11" RadiusY="11" Stroke="{StaticResource HudZoneMark}" StrokeThickness="1.5" StrokeDashArray="3 2.5" />
                                                        <Decorator>
                                                            <Decorator.LayoutTransform>
                                                                <ScaleTransform x:Name="OvPreviewScale" ScaleX="0.72" ScaleY="0.72" />
                                                            </Decorator.LayoutTransform>
                                                            <local:OverlayPanel x:Name="OvPreview" />
                                                        </Decorator>
                                                    </Grid>
                                                </Grid>
                                                <!-- Queixo com o LED de energia à direita: aceso no sinal quando o overlay está ligado -->
                                                <Ellipse x:Name="OvLed" Grid.Row="1" Width="5" Height="5" Fill="{StaticResource HudSep}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                                                         ToolTip="Aceso com o overlay ligado" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Viewbox>
                            </local:FillBox>

                            <!-- Controles: três blocos de geometria fixa (posição, opacidade, tamanho) numa faixa só; nada muda de lugar ao trocar de opção -->
                            <Border Grid.Row="2" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusInset}" Padding="20,0,7,0" Height="50">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Rótulo e valor como Runs do mesmo TextBlock: a mesma linha de base por construção (em dois TextBlocks
                                         centrados o rótulo ficava 1 px acima). O espaço (um médio e um fino, a 13 px) dá ≈ 9 px. -->
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="Posição" FontFamily="{StaticResource LabelFont}" FontSize="13" Foreground="{DynamicResource Muted}" /><Run Text="&#x2002;&#x2009;" FontSize="13" /><Run x:Name="OvCornerName" Text="Superior esquerdo" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Border Grid.Column="1" Width="1" Height="22" Background="{DynamicResource Line}" Margin="16,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Opacidade" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Slider x:Name="OvOpacity" Style="{StaticResource OpacitySlider}" Minimum="30" Maximum="100" SmallChange="1" LargeChange="10"
                                                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Width="150" VerticalAlignment="Center"
                                                ValueChanged="OvOpacity_Changed" PreviewMouseWheel="OvOpacity_Wheel" ToolTip="Também ajusta com a roda do mouse" />
                                        <TextBlock x:Name="OvOpacityText" Text="100 %" Style="{StaticResource Num}" Foreground="{DynamicResource Fg}" FontSize="14"
                                                   Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Height="22" Background="{DynamicResource Line}" Margin="16,0" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tamanho" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Border Style="{StaticResource SegmentGroup}">
                                            <local:SlidingSelectionPanel x:Name="OvScalePanel" Style="{StaticResource SegmentRail}">
                                                <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Pequeno" Tag="1" Checked="OvOption_Changed" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Médio" Tag="1.35" Checked="OvOption_Changed" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="OvScale" Content="Grande" Tag="1.75" Checked="OvOption_Changed" />
                                            </local:SlidingSelectionPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Lado direito: o que mostrar (ocupa a sobra) e, embaixo, onde funciona -->
                    <Grid x:Name="OvSide" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- O que mostrar: um grupo por componente (nome à esquerda, itens em LED numa grade de três colunas), separados por um fio -->
                        <Border x:Name="OvItemsCard" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Style="{StaticResource CardHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="O que mostrar" Style="{StaticResource CardTitle}" Margin="0,0,16,0" />
                                    <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                                        <local:SlidingSelectionPanel x:Name="OvPresetPanel" Style="{StaticResource SegmentRail}">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Essencial" Tag="default" Click="OvPreset_Click">
                                                <RadioButton.ToolTip>
                                                    <StackPanel MaxWidth="290">
                                                        <TextBlock Text="Essencial" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="O básico para jogar sem poluir a tela: o que a placa de vídeo e o processador estão fazendo agora, e quanta memória está em uso." />
                                                        <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS, frametime e 1% low · GPU: uso, temperatura, clock e consumo · VRAM · CPU: uso, temperatura, clock e consumo · RAM · nome do hardware" />
                                                    </StackPanel>
                                                </RadioButton.ToolTip>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Só FPS" Tag="min" Click="OvPreset_Click">
                                                <RadioButton.ToolTip>
                                                    <StackPanel MaxWidth="290">
                                                        <TextBlock Text="Só FPS" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="O overlay mais discreto possível: só o contador e a estabilidade dos quadros." />
                                                        <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS, frametime e 1% low" />
                                                    </StackPanel>
                                                </RadioButton.ToolTip>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Gargalo" Tag="gargalo" Click="OvPreset_Click">
                                                <RadioButton.ToolTip>
                                                    <StackPanel MaxWidth="290">
                                                        <TextBlock Text="Gargalo" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Para descobrir quem está limitando o jogo: compara o uso da GPU com o do núcleo de CPU mais ocupado e mostra se a memória aperta." />
                                                        <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS, 1% low e gráfico · GPU: uso, clock e limitador · VRAM · CPU: uso, núcleo mais ocupado e clock · RAM em %" />
                                                    </StackPanel>
                                                </RadioButton.ToolTip>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Térmico" Tag="termico" Click="OvPreset_Click">
                                                <RadioButton.ToolTip>
                                                    <StackPanel MaxWidth="290">
                                                        <TextBlock Text="Térmico" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Para acompanhar calor e consumo em sessões longas e testar a refrigeração." />
                                                        <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="FPS · GPU: temperatura, hotspot, consumo e ventoinha · CPU: temperatura, consumo e clock · hora" />
                                                    </StackPanel>
                                                </RadioButton.ToolTip>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="OvPreset" Content="Tudo" Tag="all" Click="OvPreset_Click">
                                                <RadioButton.ToolTip>
                                                    <StackPanel MaxWidth="290">
                                                        <TextBlock Text="Tudo" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Liga todos os itens disponíveis. Fica grande: combina melhor com o tamanho Pequeno." />
                                                        <TextBlock Style="{StaticResource Footnote}" Margin="0,8,0,0" Text="Todos os grupos: FPS, GPU, VRAM, CPU, RAM e rodapé" />
                                                    </StackPanel>
                                                </RadioButton.ToolTip>
                                            </RadioButton>
                                        </local:SlidingSelectionPanel>
                                    </Border>
                                </Grid>
                                <local:SpreadPanel x:Name="OvItemsPanel" Grid.Row="1" Margin="0,12,0,0" />
                            </Grid>
                        </Border>

                        <!--
                            Onde funciona: o overlay do CoreBi é uma janela por cima do jogo, então funciona em janela e em tela cheia sem borda.
                            Em tela cheia exclusiva o Windows não deixa outra janela por cima: ali quem desenha é o RTSS, se estiver aberto.
                            Os sensores da CPU pedem administrador; o FPS vem dos eventos do Windows.
                        -->
                        <Border x:Name="OvWhereCard" Grid.Row="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Style="{StaticResource CardHeader}">
                                    <TextBlock Text="Onde funciona" Style="{StaticResource CardTitle}" />
                                </Grid>
                                <Grid Style="{StaticResource WhereRow}" Background="Transparent" ToolTip="O overlay é uma janela do CoreBi por cima do jogo.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Ellipse Style="{StaticResource WhereLed}" Fill="{DynamicResource Ok}" />
                                    <TextBlock Grid.Column="1" Text="Janela e tela cheia sem borda" Style="{StaticResource WhereName}" />
                                    <TextBlock Grid.Column="2" Text="Funciona" Style="{StaticResource WhereState}" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource WhereRow}" Background="Transparent" x:Name="OvRtssRow" ToolTip="Em tela cheia exclusiva o Windows não deixa outra janela por cima do jogo: quem desenha o overlay é o RTSS, se estiver aberto.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Ellipse x:Name="OvRtssLed" Style="{StaticResource WhereLed}" Fill="{DynamicResource Faint}" />
                                    <TextBlock Grid.Column="1" Text="Tela cheia exclusiva" Style="{StaticResource WhereName}" />
                                    <TextBlock x:Name="OvRtssState" Grid.Column="2" Text="Precisa do RTSS" Style="{StaticResource WhereState}" />
                                    <TextBlock x:Name="OvRtssHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource WhereHint}" />
                                    <Button x:Name="OvRtssAction" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource WhereButton}" Click="OvReadyAction_Click" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource WhereRow}" Background="Transparent" ToolTip="Temperatura, clock e consumo da CPU.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Ellipse x:Name="OvAdminLed" Style="{StaticResource WhereLed}" Fill="{DynamicResource Ok}" />
                                    <TextBlock Grid.Column="1" Text="Sensores da CPU" Style="{StaticResource WhereName}" />
                                    <TextBlock x:Name="OvAdminState" Grid.Column="2" Text="Funciona" Style="{StaticResource WhereState}" />
                                    <TextBlock x:Name="OvAdminHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource WhereHint}" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource WhereRow}" Background="Transparent" ToolTip="O FPS vem dos eventos de apresentação do Windows (ETW): o CoreBi não injeta nada nem lê a memória do jogo.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Ellipse x:Name="OvFpsLed" Style="{StaticResource WhereLed}" Fill="{DynamicResource Ok}" />
                                    <TextBlock Grid.Column="1" Text="Contagem de FPS" Style="{StaticResource WhereName}" />
                                    <TextBlock x:Name="OvFpsState" Grid.Column="2" Text="Funciona" Style="{StaticResource WhereState}" />
                                    <TextBlock x:Name="OvFpsHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource WhereHint}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
