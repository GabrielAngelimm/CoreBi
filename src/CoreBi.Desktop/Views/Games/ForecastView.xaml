<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.ForecastView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <Grid Style="{StaticResource PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FPS estimado" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="GamesSub" Text="FPS esperado no seu PC." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <TextBox x:Name="GameSearch" Grid.Column="1" Width="260" VerticalAlignment="Bottom" local:Ui.Icon="&#xE721;" local:Ui.Placeholder="Buscar jogo" TextChanged="GameSearch_Changed" />
        </Grid>

        <!-- Cenário da estimativa + origem dos números -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="22,18">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,28,12">
                        <TextBlock Text="Resolução" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentGroup}">
                            <local:SlidingSelectionPanel x:Name="GameResPanel" Style="{StaticResource SegmentRail}">
                                <RadioButton Style="{StaticResource Segment}" GroupName="GameRes" Content="1080p" Tag="1920x1080" IsChecked="True" Checked="GameOption_Changed" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="GameRes" Content="1440p" Tag="2560x1440" Checked="GameOption_Changed" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="GameRes" Content="4K" Tag="3840x2160" Checked="GameOption_Changed" />
                            </local:SlidingSelectionPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="GamePresetBox" Margin="0,0,28,12">
                        <TextBlock Text="Qualidade gráfica" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentGroup}">
                            <local:SlidingSelectionPanel x:Name="GamePresetPanel" Style="{StaticResource SegmentRail}">
                                <RadioButton Style="{StaticResource Segment}" GroupName="GamePreset" Content="Baixo" Tag="Baixo" Checked="GameOption_Changed" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="GamePreset" Content="Médio" Tag="Médio" Checked="GameOption_Changed" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="GamePreset" Content="Alto" Tag="Alto" IsChecked="True" Checked="GameOption_Changed" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="GamePreset" Content="Ultra" Tag="Ultra" Checked="GameOption_Changed" />
                            </local:SlidingSelectionPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,12">
                        <TextBlock Text="Upscaling (DLSS ou FSR)" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource SegmentGroup}">
                            <local:SlidingSelectionPanel x:Name="GameUpscalePanel" Style="{StaticResource SegmentRail}">
                                <RadioButton Style="{StaticResource Segment}" GroupName="GameUp" Content="Nativo" Tag="Native" IsChecked="True" Checked="GameOption_Changed" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="GameUp" Content="Qualidade" Tag="Quality" Checked="GameOption_Changed" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="GameUp" Content="Desempenho" Tag="Performance" Checked="GameOption_Changed" />
                            </local:SlidingSelectionPanel>
                        </Border>
                    </StackPanel>
                </WrapPanel>
                <Border Style="{StaticResource Divider}" Margin="0,4,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:HwIcon Kind="&#xE9D9;" Foreground="{DynamicResource Steel}" Width="30" Height="30" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="GameSourceTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="GameSourceText" Style="{StaticResource Caption}" Margin="0,3,0,0" MaxWidth="640" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="240" Margin="0,0,8,0">
                            <PasswordBox x:Name="ApiKeyBox" ToolTip="Chave da API HowManyFPS (opcional)" PasswordChanged="ApiKeyBox_Changed" />
                            <TextBlock x:Name="ApiKeyHint" Text="Chave da API HowManyFPS" Foreground="{DynamicResource Faint}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="BtnApiKey" Style="{StaticResource SecondaryButton}" Content="Salvar chave" Click="BtnApiKey_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl x:Name="GameList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12" Padding="18,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Genre}" Style="{StaticResource Footnote}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border x:Name="badge" Grid.Column="1" Style="{StaticResource Badge}" Visibility="{Binding Rating, Converter={StaticResource NotEmptyVis}}">
                                        <TextBlock x:Name="badgeText" Text="{Binding Rating, Converter={StaticResource Sentence}}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding FpsText}" Style="{StaticResource ReadoutLarge}" />
                                    <TextBlock Text="FPS" Style="{StaticResource Unit}" Margin="6,0,0,7" />
                                </StackPanel>
                                <!-- Medidor segmentado até 240 FPS, com marcas em 60 e 144 -->
                                <Grid Height="8" Margin="0,10,0,4">
                                    <Grid Background="{DynamicResource Line}" OpacityMask="{StaticResource SegmentMask}">
                                        <Border Background="{DynamicResource Signal}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Bar}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60*" />
                                        <ColumnDefinition Width="84*" />
                                        <ColumnDefinition Width="96*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="60" Style="{StaticResource Footnote}" FontSize="10" Margin="-6,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="144" Style="{StaticResource Footnote}" FontSize="10" Margin="-8,0,0,0" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{Binding LowText}" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Footnote}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Footnote}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Rating}" Value="EXCELENTE">
                                <Setter TargetName="badge" Property="Background" Value="{DynamicResource OkSoft}" />
                                <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Ok}" />
                                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Ok}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rating}" Value="ÓTIMO">
                                <Setter TargetName="badge" Property="Background" Value="{DynamicResource OkSoft}" />
                                <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Ok}" />
                                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Ok}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rating}" Value="JOGÁVEL">
                                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Fg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rating}" Value="FRACO">
                                <Setter TargetName="badge" Property="Background" Value="{DynamicResource WarnSoft}" />
                                <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Warn}" />
                                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rating}" Value="INJOGÁVEL">
                                <Setter TargetName="badge" Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Danger}" />
                                <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
