<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.BottleneckView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}">
                <StackPanel>
                    <TextBlock Text="Gargalo" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="O que está limitando o seu FPS agora: placa de vídeo, processador, memória ou temperatura." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </Grid>

            <!-- Leitura principal: o limitador do momento, com o jogo em primeiro plano -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="BnLiveCard" Style="{StaticResource CardBorder}" Padding="26,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="BnLiveLabel" Text="Agora" Style="{StaticResource Label}" Margin="0" />
                        </StackPanel>
                        <TextBlock x:Name="BnLiveTitle" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="BnLiveGame" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,14" Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="BnLiveAdvice" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24,22">
                    <StackPanel>
                        <TextBlock Text="Equilíbrio do hardware" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <TextBlock x:Name="BnCpuName" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="BnGpuName" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <!-- Régua logarítmica: centro = equilibrado -->
                        <Grid Height="26" Margin="0,8,0,4">
                            <Border Height="8" Background="{DynamicResource Line}" OpacityMask="{StaticResource SegmentMask}" VerticalAlignment="Center" />
                            <Border Width="2" Height="16" Background="{DynamicResource Steel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Canvas x:Name="BnBalanceCanvas" SizeChanged="BnBalanceCanvas_SizeChanged">
                                <Ellipse x:Name="BnBalanceDot" Width="16" Height="16" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Surface}" StrokeThickness="3" Canvas.Top="5" />
                            </Canvas>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Limita a GPU" Style="{StaticResource Footnote}" />
                            <TextBlock Text="Equilibrado" Style="{StaticResource Footnote}" HorizontalAlignment="Center" />
                            <TextBlock Text="Limita a CPU" Style="{StaticResource Footnote}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="BnBalanceText" Style="{StaticResource Body}" Margin="0,16,0,0" />
                        <TextBlock Text="Estimativa pelo desempenho relativo típico. O detector ao vivo mostra a realidade de cada jogo." Style="{StaticResource Footnote}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20,24,8">
                <StackPanel>
                    <TextBlock Text="Leituras ao vivo" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <ItemsControl x:Name="BnMeters" ItemTemplate="{StaticResource Meter}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,28,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Análise de sessão" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Inicie, abra o jogo e jogue normalmente. No fim você recebe o diagnóstico da sessão inteira." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SegmentGroup}" Margin="0,0,10,0">
                                <StackPanel x:Name="BnDurationPanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BnDur" Content="1 min" Tag="1" IsChecked="True" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BnDur" Content="3 min" Tag="3" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BnDur" Content="5 min" Tag="5" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnBnSession" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar análise" Click="BtnBnSession_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="BnSessionStatus" Style="{StaticResource Caption}" Margin="0,14,0,0" Typography.NumeralAlignment="Tabular" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                    <StackPanel x:Name="BnResult" Visibility="Collapsed" Margin="0,18,0,0">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,18" />
                        <TextBlock x:Name="BnResultTitle" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="BnResultSummary" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,16" Typography.NumeralAlignment="Tabular" />
                        <ItemsControl x:Name="BnDistribution" ItemTemplate="{StaticResource Meter}" HorizontalAlignment="Left" Width="640" />
                        <TextBlock x:Name="BnResultAdvice" Style="{StaticResource Body}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
