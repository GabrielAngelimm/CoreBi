<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.BottleneckView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Medidor do Gargalo: rótulo e leitura, medidor segmentado na cor do componente (trilho em LineStrong, que não some no
             tema claro) e a marca do ponto em que o CoreBi considera a peça no limite (a mesma regra que dá o veredito; legenda sob
             "Leituras" e o número na dica). A linha de complemento fica reservada, para todos terem a mesma altura.
             Rótulo (DIN 12,5) e leitura (DIN semicondensada 20) em colunas, os dois no topo: o rótulo termina num espaço na fonte e no
             tamanho da leitura, então as duas linhas têm a mesma subida e a mesma linha de base (alinhados embaixo, o rótulo ficava
             1 px acima). A sigla ganha o nome por extenso ao lado, em Segoe 11,5 (Hint). -->
        <DataTemplate x:Key="LimitMeter">
            <Grid Margin="0,6" ToolTip="{Binding Tip}" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource StatLabel}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="{Binding Hint, Mode=OneWay}" FontFamily="{StaticResource SmallFont}" FontSize="11.5" /><Run Text=" " FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="20" />
                </TextBlock>
                <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource ReadoutText}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Grid Grid.Row="1" Height="8" Margin="0,8,0,0">
                    <Grid OpacityMask="{StaticResource SegmentMask}">
                        <Border Background="{DynamicResource LineStrong}" />
                        <Border x:Name="fill" Background="{DynamicResource Steel}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Fraction}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <!-- Marca do limite -->
                    <Grid x:Name="mark" Visibility="{Binding HasMark, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding MarkLeft}" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="{Binding MarkRight}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Height="16" Margin="0,-4" Background="{DynamicResource Muted}" SnapsToDevicePixels="True" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="sub" Grid.Row="2" Text="{Binding Sub}" Style="{StaticResource StatSub}" Height="16" Margin="0,6,0,0" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Channel}" Value="Cpu"><Setter TargetName="fill" Property="Background" Value="{DynamicResource Cpu}" /></DataTrigger>
                <DataTrigger Binding="{Binding Channel}" Value="Gpu"><Setter TargetName="fill" Property="Background" Value="{DynamicResource Gpu}" /></DataTrigger>
                <DataTrigger Binding="{Binding Channel}" Value="Memory"><Setter TargetName="fill" Property="Background" Value="{DynamicResource Memory}" /></DataTrigger>
                <DataTrigger Binding="{Binding Channel}" Value="Danger"><Setter TargetName="fill" Property="Background" Value="{DynamicResource Danger}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Warn}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger">
                    <Setter TargetName="value" Property="Foreground" Value="{DynamicResource Danger}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Sub}" Value="">
                    <Setter TargetName="sub" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Leitura em régua: rótulo e número, separadas por fios; a primeira sem fio. Número e unidade são Runs de um TextBlock só
             (mesma linha de base; um espaço em 20 px, uns 5 px, entre eles, que some sem unidade). O que a sigla quer dizer vai ao lado
             do rótulo, em Segoe 11,5 (Hint). -->
        <DataTemplate x:Key="RulerCell">
            <Border x:Name="cell" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="24,0,0,0" Margin="24,0,0,0" ToolTip="{Binding Tip}" Background="Transparent">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}">
                        <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="{Binding Hint, Mode=OneWay}" FontFamily="{StaticResource SmallFont}" FontSize="11.5" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Fg}" /><Run x:Name="gap" Text=" " FontFamily="{StaticResource LabelFont}" FontSize="20" /><Run Text="{Binding Unit, Mode=OneWay}" FontFamily="{StaticResource LabelFont}" FontSize="13" Foreground="{DynamicResource Muted}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Unit}" Value="">
                    <Setter TargetName="gap" Property="Text" Value="" />
                </DataTrigger>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter TargetName="cell" Property="BorderThickness" Value="0" />
                    <Setter TargetName="cell" Property="Padding" Value="0" />
                    <Setter TargetName="cell" Property="Margin" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Com a janela maximizada a página cabe inteira (a altura mínima é a da janela e as linhas "*" ocupam a sobra); em
         janelas baixas ou estreitas ela rola. -->
    <ScrollViewer x:Name="BnScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border MinHeight="{Binding ViewportHeight, ElementName=BnScroll}">
            <Grid x:Name="BnPage" Style="{StaticResource PageGrid}" SizeChanged="BnPage_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Gargalo" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Descobre qual peça segura o FPS enquanto você joga." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                </local:PageHeaderPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="BnGapColumn" Width="16" />
                        <ColumnDefinition x:Name="BnSideColumn" Width="540" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <!-- Em janelas estreitas o painel de leituras desce para cá -->
                        <RowDefinition x:Name="BnStackGap" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Coluna principal: o veredito em cima e a análise de sessão na sobra de altura -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Veredito: o que limita agora, em grande; cor só quando há limitação -->
                        <Border x:Name="BnLiveCard" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel x:Name="BnGameLine" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                                    <Ellipse x:Name="BnLiveDot" Style="{StaticResource StatusLed}" Fill="{DynamicResource Signal}" Margin="0,1,8,0" ToolTip="Medindo o FPS do programa em primeiro plano" />
                                    <TextBlock x:Name="BnLiveGame" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                                <!-- Manchete (DIN 44) só para veredito; sem veredito, DIN 17 seminegrito no tom secundário, o tamanho do título de painel,
                                     centrada na linha de 34 px dos cabeçalhos para assentar na mesma altura que "Leituras", no painel vizinho
                                     (MainWindow.SetLiveTitle). A manchete grande passa dos 34 e a linha cresce com ela. -->
                                <Grid MinHeight="34">
                                    <TextBlock x:Name="BnLiveTitle" Text="Nenhum jogo em primeiro plano" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="BnLiveAdvice" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <ItemsControl x:Name="BnFrameStats" ItemTemplate="{StaticResource RulerCell}" Margin="0,24,0,0" Focusable="False" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Análise de sessão: a única ação da página. Sem resultado, o espaço dela diz o que fazer, centrado; com resultado,
                             o relatório vem logo abaixo do estado. -->
                        <Border x:Name="BnSessionCard" Grid.Row="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Análise de sessão" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,12,0" ToolTip="Duração da análise">
                                            <local:SlidingSelectionPanel x:Name="BnDurationPanel" Style="{StaticResource SegmentRail}">
                                                <RadioButton Style="{StaticResource Segment}" GroupName="BnDur" Content="1 min" Tag="1" IsChecked="True" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="BnDur" Content="3 min" Tag="3" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="BnDur" Content="5 min" Tag="5" />
                                            </local:SlidingSelectionPanel>
                                        </Border>
                                        <Button x:Name="BtnBnSession" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE768;" Content="Iniciar análise" Click="BtnBnSession_Click"
                                                ToolTip="Precisa de um jogo aberto em primeiro plano. Mede pelo tempo escolhido e mostra por quanto tempo cada peça limitou o FPS." />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1">
                                    <TextBlock x:Name="BnSessionStatus" Style="{StaticResource Caption}" Margin="0,16,0,0" Typography.NumeralAlignment="Tabular" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                                    <Grid x:Name="BnSessionBar" Style="{StaticResource ProgressTrack}" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Border Style="{StaticResource ProgressFill}">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="BnSessionProgress" ScaleX="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <!-- Sem resultado (antes, durante, cancelada ou sem amostras): o que a análise pede e o que ela entrega, no estado vazio
                                     padrão (título DIN 15 em tinta, frase de 13 no tom secundário, centrados) -->
                                <StackPanel x:Name="BnSessionEmpty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="0,24,0,0">
                                    <TextBlock Text="A análise precisa de um jogo aberto" Style="{StaticResource GroupTitle}" TextAlignment="Center" />
                                    <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,8,0,0"
                                               Text="Deixe-o em primeiro plano até o fim. Depois, o CoreBi mostra por quanto tempo cada peça limitou o FPS." />
                                </StackPanel>
                                <StackPanel x:Name="BnResult" Grid.Row="2" Visibility="Collapsed" Margin="0,20,0,0">
                                    <Border Style="{StaticResource Divider}" Margin="0,0,0,20" />
                                    <TextBlock x:Name="BnResultTitle" Style="{StaticResource TestPlateTitle}" TextTrimming="None" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="BnResultStats" ItemTemplate="{StaticResource RulerCell}" Margin="0,18,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="Tempo em cada situação" Style="{StaticResource Label}" Margin="0,24,0,2" />
                                    <ItemsControl x:Name="BnDistribution" ItemTemplate="{StaticResource LimitMeter}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="0,0,32,0" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <TextBlock x:Name="BnResultAdvice" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- As leituras que provam o veredito e, embaixo, o equilíbrio estimado pela tabela de desempenho -->
                    <Border x:Name="BnSideCard" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                        <DockPanel>
                            <!-- Esqueleto só no equilíbrio, que espera os nomes da CPU e da placa de vídeo: os dois nomes, a régua, as três marcas e a frase -->
                            <Border x:Name="BnBalanceCard" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="{StaticResource PanelPadding}"
                                    Background="{DynamicResource Surface}" CornerRadius="{StaticResource RadiusPanelBottom}" local:Skeleton.Top="34"
                                    local:Skeleton.Layout="gap 10; row 18: t 45%@0.62, - 10%, t 45%@0.62&gt;; gap 10; row 24: box *^8; gap 4; row 16: c 20%@0.75, - 20%, c 20%@0.8, - 20%, c 20%@0.75&gt;; gap 14; row 20: t *@0.95; row 20: t *@0.55">
                                <StackPanel>
                                    <Grid Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Equilíbrio estimado" Style="{StaticResource CardTitle}"
                                               ToolTip="Estimativa pela tabela de desempenho relativo de processadores e placas de vídeo do CoreBi, não uma medição. Cada jogo pesa diferente; as leituras ao vivo mostram o que acontece de fato." />
                                    </Grid>
                                    <StackPanel x:Name="BnBalanceRuler" Margin="0,10,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource Cpu}" Margin="0,1,8,0" />
                                                <TextBlock x:Name="BnCpuName" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="BnGpuName" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg}" />
                                                <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource Gpu}" Margin="8,1,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Régua logarítmica da razão GPU/CPU: centro = equilibrado -->
                                        <Grid Height="24" Margin="0,10,0,4">
                                            <Border Height="8" Background="{DynamicResource LineStrong}" OpacityMask="{StaticResource SegmentMask}" VerticalAlignment="Center" />
                                            <Border Width="2" Height="16" Background="{DynamicResource Steel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Canvas x:Name="BnBalanceCanvas" SizeChanged="BnBalanceCanvas_SizeChanged">
                                                <Ellipse x:Name="BnBalanceDot" Width="16" Height="16" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Surface}" StrokeThickness="3" Canvas.Top="4" />
                                            </Canvas>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Limita a GPU" Style="{StaticResource Footnote}" />
                                            <TextBlock Text="Equilibrado" Style="{StaticResource Footnote}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Limita a CPU" Style="{StaticResource Footnote}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock x:Name="BnBalanceText" Style="{StaticResource Body}" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                            <!-- Leituras em espaçamento fixo, de cima para baixo; a sobra fica entre elas e o equilíbrio, que fecha o painel -->
                            <StackPanel Margin="24,20,24,14">
                                <!-- Cabeçalho de 34 px (CardHeader); a legenda da marca de cada medidor fica à direita, como a de um gráfico -->
                                <Grid Style="{StaticResource CardHeader}" Margin="0,0,0,10">
                                    <TextBlock Text="Leituras" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                ToolTip="A marca em cada medidor é o limite a partir do qual a peça segura o FPS.">
                                        <Border Width="2" Height="12" Background="{DynamicResource Muted}" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                        <TextBlock Text="Limite do FPS" Style="{StaticResource Footnote}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="BnMeters" ItemTemplate="{StaticResource LimitMeter}" Focusable="False">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
