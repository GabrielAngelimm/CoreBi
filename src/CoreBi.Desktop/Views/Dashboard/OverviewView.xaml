<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.OverviewView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <!--
        Painel de uma tela: com a janela maximizada tudo cabe sem rolar (o gráfico e a atividade recente ocupam a sobra);
        em janelas menores a página volta a rolar, com os componentes em duas colunas.
    -->
    <ScrollViewer x:Name="DashScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=DashScroll}">
            <Grid Margin="36,10,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="364" />
                </Grid.ColumnDefinitions>

                <Grid Grid.ColumnSpan="3" Style="{StaticResource PageHeader}" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Visão geral" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="DashMachine" Text="Leituras ao vivo do processador, da placa de vídeo, da memória e do disco do sistema." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </Grid>

                <!-- Coluna da esquerda: o gráfico ocupa a sobra, os componentes ficam embaixo -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Instrumento principal: osciloscópio de dois canais -->
                    <Border Style="{StaticResource CardBorder}" Padding="24,20,24,16" MinHeight="330">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DashChartLabel" Text="Temperatura" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="DashChartDelta" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,8,0">
                                        <StackPanel x:Name="DashMetricPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Temperatura" Tag="temp" IsChecked="True" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Carga" Tag="load" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Consumo" Tag="power" Checked="DashOption_Checked" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <StackPanel x:Name="DashRangePanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="1 min" Tag="60" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="5 min" Tag="300" IsChecked="True" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="15 min" Tag="900" Checked="DashOption_Checked" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <!-- Leituras atuais por canal -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,8">
                                <StackPanel Margin="0,0,40,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="Processador" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                    <TextBlock x:Name="DashChartValue" Text="—" Style="{StaticResource ReadoutHero}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="3" CornerRadius="1.5" Background="{DynamicResource Copper}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="Placa de vídeo" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                    <TextBlock x:Name="DashChartValue2" Text="—" Style="{StaticResource ReadoutHero}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Canvas x:Name="DashChart" MinHeight="150" ClipToBounds="True" SizeChanged="DashChart_SizeChanged" />
                        </DockPanel>
                    </Border>

                    <!-- Componentes: medidores de uso (processador, placa de vídeo) e de ocupação (memória, disco) -->
                    <ItemsControl x:Name="DashComponents" Grid.Row="2" Margin="0,0,-16,-16" Focusable="False" SizeChanged="DashComponents_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,16,16" Padding="18,16,18,18">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconTile}">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{Binding Channel}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Model}" Style="{StaticResource StatSub}" Margin="0,1,0,0" ToolTip="{Binding Model}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE76C;" Tag="{Binding Target}" Click="DashGo_Click" ToolTip="Abrir detalhes" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <!-- Uso ao vivo: leitura grande, medidor segmentado e grandezas do componente -->
                                            <StackPanel x:Name="live" VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Hero}" Style="{StaticResource ReadoutLarge}" />
                                                    <TextBlock Text="{Binding HeroUnit}" Style="{StaticResource Unit}" Margin="8,0,0,7" />
                                                </StackPanel>
                                                <Grid Height="6" Margin="0,8,0,14" OpacityMask="{StaticResource SegmentMask}">
                                                    <Border Background="{DynamicResource Line}" />
                                                    <Border Background="{Binding Channel}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Key}" Style="{StaticResource StatLabel}" FontSize="11.5" />
                                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Num}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <!-- Ocupação: anel com a fração usada, quantidade em uso e o que sobra -->
                                            <Grid x:Name="capacity" Visibility="Collapsed" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="84" Height="84" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <Ellipse Width="72" Height="72" Stroke="{DynamicResource Line}" StrokeThickness="7" />
                                                    <Path Data="{Binding Fraction, Converter={StaticResource DriveArc}}" Stroke="{Binding Channel}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock Text="{Binding Hero}" Style="{StaticResource ReadoutText}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Amount}" Style="{StaticResource ReadoutText}" FontSize="24" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding HeroUnit}" Style="{StaticResource StatSub}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Capacity}" Value="True">
                                        <Setter TargetName="live" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="capacity" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Coluna da direita: desempenho, saúde e atividade (a atividade ocupa o que sobra) -->
                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" MinHeight="150" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Padding="22,18,22,18">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Desempenho" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Render de CPU, multi-core" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE768;" Content="Rodar benchmark" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-10,0" Click="DashBench_Click" ToolTip="Abrir o benchmark" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DashScore" Text="—" Style="{StaticResource ReadoutHero}" />
                                    <TextBlock Text="pts" Style="{StaticResource Unit}" Margin="6,0,0,9" />
                                </StackPanel>
                                <TextBlock x:Name="DashScoreDelta" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                            </Grid>
                            <TextBlock x:Name="DashScoreSub" Text="nenhum teste ainda" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" />
                            <Border Style="{StaticResource Divider}" Margin="0,14,0,8" />
                            <ItemsControl x:Name="DashScores" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="22,18,22,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Saúde do PC" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Border x:Name="DashHealthBadge" Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="DashHealthBadgeText" Style="{StaticResource BadgeText}" />
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="DashHealth" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="dot" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource WarnSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <TextBlock x:Name="chk" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter TargetName="chk" Property="Text" Value="&#xE73E;" />
                                                <Setter TargetName="chk" Property="Foreground" Value="{DynamicResource Ok}" />
                                                <Setter TargetName="dot" Property="Background" Value="{DynamicResource OkSoft}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE9D9;" Content="Ver todos os sensores" HorizontalAlignment="Left" Margin="-10,10,0,0" Click="DashSensors_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="22,18,22,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Atividade recente" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <Grid>
                                <TextBlock x:Name="DashEventsEmpty" Text="Benchmarks, testes de carga e dispositivos conectados aparecem aqui assim que acontecerem." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                <ItemsControl x:Name="DashEvents" ClipToBounds="True" Focusable="False" SizeChanged="DashEvents_SizeChanged">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10" Height="{x:Static local:MainWindow.DashEventHeight}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource Accent}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource StatSub}" ToolTip="{Binding Detail}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource Num}" />
                                                        <TextBlock Text="{Binding When}" Style="{StaticResource StatSub}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
