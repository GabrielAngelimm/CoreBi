<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.OverviewView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <!--
        Painel de uma tela: com a janela maximizada tudo cabe sem rolar (o gráfico e a atividade recente ocupam a sobra);
        em janelas menores a página volta a rolar, com os componentes em duas colunas.
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="DashEventTemplate">
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10" Height="{x:Static local:MainWindow.DashEventHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="{Binding Channel}" Kind="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource StatSub}" ToolTip="{Binding Detail}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource Num}" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource StatSub}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
        <!-- Linha chave/valor do Desempenho com a altura padrão de 32 px (o KeyValueRow comum, de 27, segue nas outras telas) -->
        <DataTemplate x:Key="DashScoreRow">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource Num}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="DashScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=DashScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="364" />
                </Grid.ColumnDefinitions>

                <local:PageHeaderPanel Grid.ColumnSpan="3" Style="{StaticResource PageHead}">
                    <TextBlock Text="Visão geral" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="DashMachine" Text="Leituras ao vivo deste computador." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                </local:PageHeaderPanel>

                <!-- Coluna da esquerda: o gráfico ocupa a sobra, os componentes ficam embaixo -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--
                        Instrumento principal: osciloscópio de dois canais. Na abertura, até a primeira leitura dos sensores, o
                        esqueleto fica abaixo do cabeçalho (título e filtros à vista): os dois mostradores, a legenda e a área do gráfico
                    -->
                    <Border x:Name="DashChartCard" Style="{StaticResource CardBorder}" MinHeight="330" local:Skeleton.Top="34"
                            local:Skeleton.Layout="gap 18; row 50: n 104^34, - 96, n 104^34, - *; gap 4; row 18: dot 10, - 8, c 72, - 110, dot 10, - 8, c 86, - *; gap 26; rest: frame *">
                        <DockPanel>
                            <!-- Cabeçalho de 34 px, igual em todos os cartões: o título centrado na linha e, à direita, os filtros em pílula -->
                            <Grid DockPanel.Dock="Top" Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DashChartLabel" Text="Temperatura" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,8,0">
                                        <local:SlidingSelectionPanel x:Name="DashMetricPanel" Style="{StaticResource SegmentRail}">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Temperatura" Tag="temp" IsChecked="True" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Carga" Tag="load" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Consumo" Tag="power" Checked="DashOption_Checked" />
                                        </local:SlidingSelectionPanel>
                                    </Border>
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <local:SlidingSelectionPanel x:Name="DashRangePanel" Style="{StaticResource SegmentRail}">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="1 min" Tag="60" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="5 min" Tag="300" IsChecked="True" Checked="DashOption_Checked" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="15 min" Tag="900" Checked="DashOption_Checked" />
                                        </local:SlidingSelectionPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <!--
                                Leituras atuais por canal: o número grande e, embaixo, a marca e o nome do canal (a legenda do gráfico).
                                Sem leitura o mostrador fica no travessão, e a dica diz por quê.
                            -->
                            <!--
                                Grade fixa: colunas de 200 e linha do número de 68, então trocar de métrica (°C, %, W) ou cair no
                                travessão não move nada. Margens medidas na tinta: 28 px do título ao número e 28 da legenda ao gráfico.
                            -->
                            <Grid DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,4,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DashChartValue" Text="—" Style="{StaticResource ReadoutHero}" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="DashChartValue2" Grid.Column="1" Text="—" Style="{StaticResource ReadoutHero}" VerticalAlignment="Bottom" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="1,-2,0,0">
                                    <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource Cpu}" Margin="0,0,8,0" />
                                    <TextBlock Text="Processador" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="1,-2,0,0">
                                    <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource Gpu}" Margin="0,0,8,0" />
                                    <TextBlock Text="Placa de vídeo" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="DashChart" MinHeight="150" ClipToBounds="True" Background="Transparent" SizeChanged="DashChart_SizeChanged" MouseMove="DashChart_MouseMove" MouseLeave="DashChart_MouseLeave" />
                        </DockPanel>
                    </Border>

                    <!--
                        Componentes: uso ao vivo do processador e da placa de vídeo, e um mostrador de anéis para o que é
                        ocupação (RAM, VRAM e disco do sistema). Em janelas estreitas os anéis descem para uma linha própria.
                    -->
                    <Grid x:Name="DashComponentsRow" Grid.Row="2" SizeChanged="DashComponentsRow_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Os dois cartões acendem juntos na cascata da entrada (PageMotion.Group) -->
                        <ItemsControl x:Name="DashComponents" Focusable="False" local:PageMotion.Group="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Esqueleto até o nome e a primeira leitura: ícone, nome e modelo, atalho, leitura grande, medidor e as três grandezas -->
                                    <Border Style="{StaticResource CardBorder}" Padding="{StaticResource PanelPadding}" Margin="0,0,16,0"
                                            local:Skeleton.Active="{Binding Loading}"
                                            local:Skeleton.Layout="col 0 36; row 36: box 36^36; col 48 52%; gap 2; row 20: h *@0.55^15; gap 2; row 14: c *@0.8; col 0 100%; row 36: - *, dot 32&gt;; end; foot 20: n 54^13, - *, n 54^13, - *, n 54^13; footgap 4; foot 17: c 44, - *, c 44, - *, c 44; footgap 16; foot 6: box *^6; footgap 8; foot 46: n 118^30">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="{Binding Channel}" Kind="{Binding Icon}" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Model}" Style="{StaticResource StatSub}" ToolTip="{Binding Model}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource CardLink}" Tag="{Binding Target}" Click="DashGo_Click" ToolTip="{Binding LinkTip}" />
                                            </Grid>
                                            <!-- Uso ao vivo: leitura grande, medidor segmentado e grandezas do componente -->
                                            <StackPanel Margin="0,16,0,0" VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Hero}" Style="{StaticResource ReadoutLarge}" />
                                                    <TextBlock Text="{Binding HeroUnit}" Style="{StaticResource Unit}" Margin="8,0,0,7" />
                                                </StackPanel>
                                                <Grid Height="6" Margin="0,8,0,16" OpacityMask="{StaticResource SegmentMask}">
                                                    <Border Background="{DynamicResource Line}" />
                                                    <Border Background="{Binding Meter}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <local:EdgeRowPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- De ponta a ponta (EdgeRowPanel): a primeira no recuo da esquerda, a última no da direita -->
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Key}" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Num}" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Esqueleto na abertura até RAM, VRAM e disco estarem lidos: o aro, o título e as três linhas da legenda -->
                        <Border x:Name="DashMemoryCard" Grid.Column="1" Style="{StaticResource CardBorder}" Padding="{StaticResource PanelPadding}"
                                local:Skeleton.Layout="col 0 150; center 150: ring 150; col 174 *; row 24: h 50%^16; gap 8; share 3: dot 10, - 8, t *@0.7, - 12, n 40^14&gt;; end">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Canvas x:Name="DashRings" Width="150" Height="150" VerticalAlignment="Center" Margin="0,0,24,0" />
                                <!-- Título no topo, alinhado com os de Processador e Placa de vídeo; a legenda assenta no pé, como as grandezas deles -->
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="Memória e disco" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                    <!-- Cada linha leva à seção do item: RAM ao Sistema, VRAM à Placa de vídeo, disco a Discos -->
                                    <ItemsControl x:Name="DashRingLegend" Margin="-8,0,-8,-4" VerticalAlignment="Bottom" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Tag="{Binding Target}" Click="DashGo_Click" ToolTip="Abrir detalhes">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Swatch}" Margin="0,4,8,0" VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Label}" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource StatSub}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource ReadoutText}" FontSize="17" VerticalAlignment="Top" Margin="12,0,0,0" />
                                                        <!-- Seta no meio da altura das maiúsculas da porcentagem (centrada na linha dupla ela ficava 10 px abaixo; medido na tinta) -->
                                                        <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Faint}" VerticalAlignment="Top" Margin="12,3,0,0" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Coluna da direita: desempenho, saúde e atividade (a atividade ocupa o que sobra) -->
                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" MinHeight="170" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Height="34">
                                <TextBlock Text="Benchmark" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource CardLink}" ToolTip="Abrir Benchmark" Click="DashBench_Click" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <!-- A nota e o "pts" são Runs do mesmo TextBlock (montados no código): a mesma linha de base por construção -->
                                <TextBlock x:Name="DashScore" Text="—" Style="{StaticResource ReadoutHero}" />
                                <TextBlock x:Name="DashScoreDelta" Style="{StaticResource Caption}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                            </Grid>
                            <!-- O que a nota mede e quando, numa linha só (no lugar do subtítulo do cartão) -->
                            <TextBlock x:Name="DashScoreSub" Text="Nenhum teste ainda" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" />
                            <Border Style="{StaticResource Divider}" Margin="0,16,0,4" />
                            <ItemsControl x:Name="DashScores" ItemTemplate="{StaticResource DashScoreRow}" Focusable="False" />
                        </StackPanel>
                    </Border>

                    <!--
                        Saúde do PC: cada item com o ícone do assunto (termômetro para os sensores, placa para os erros), que fica
                        âmbar quando pede atenção (o detalhe diz o quê). O atalho para os sensores
                        é o mesmo círculo dos outros cartões. Esqueleto abaixo do título até o registro de eventos do Windows
                        responder (lido fora da janela).
                    -->
                    <Border x:Name="DashHealthCard" Grid.Row="2" Style="{StaticResource CardBorder}" local:Skeleton.Top="34"
                            local:Skeleton.Layout="gap 14; col 0 26; row 26: box 26; col 40; row 20: s *@0.45; gap 3; row 16: c *@0.9; end; gap 14; col 0 26; row 26: box 26; col 40; row 20: s *@0.42; gap 3; row 16: c *@0.85; end">
                        <StackPanel>
                            <Grid Height="34">
                                <TextBlock Text="Saúde do PC" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource CardLink}" ToolTip="Ver todos os sensores" Click="DashSensors_Click" />
                            </Grid>
                            <ItemsControl x:Name="DashHealth" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <local:HwIcon x:Name="icon" Style="{StaticResource ChannelIcon}" Kind="{Binding Icon}" Width="26" Height="26" Margin="0,-2,14,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Warn}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="24,16,24,12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="34" Margin="0,0,0,2">
                                <TextBlock Text="Atividade recente" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <!-- Ação centrada na altura das maiúsculas do título (a DIN assenta 1,5 px acima do centro da caixa) -->
                                <Button x:Name="DashEventsMore" Style="{StaticResource GhostButton}" Content="Ver histórico" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,0" Visibility="Collapsed" Click="DashEventsMore_Click" />
                            </Grid>
                            <!-- O host não pede altura: a lista mostra só as linhas que cabem, sem esticar a página -->
                            <local:FitHost SizeChanged="DashEvents_SizeChanged">
                                <!--
                                    Sem nenhum evento: a frase e os três testes que ainda não rodaram, cada um numa linha da mesma altura
                                    das linhas de evento (a lista já tem o formato que vai ter). Some com o primeiro evento.
                                -->
                                <StackPanel VerticalAlignment="Top" Visibility="{Binding Visibility, ElementName=DashEventsEmpty}">
                                    <TextBlock x:Name="DashEventsEmpty" Text="Nenhum teste ainda. Os resultados e os dispositivos conectados aparecem aqui." Style="{StaticResource Caption}" Margin="0,10,0,8" />
                                    <ItemsControl Margin="-8,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Tag="{Binding Target}" Click="DashStart_Click" Height="{x:Static local:MainWindow.DashEventHeight}" ToolTip="{Binding Tip}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <local:HwIcon Kind="{Binding Icon}" Foreground="{DynamicResource Muted}" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource StatSub}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsSource>
                                            <x:Array Type="local:DashStart">
                                                <local:DashStart Icon="&#xE945;" Title="Teste de carga" Detail="Processador, memória e placa no limite" Target="PageStress" Tip="Abrir Teste de carga" />
                                                <local:DashStart Icon="gpu" Title="Cena de jogo" Detail="FPS da placa de vídeo numa cena 3D" Target="PageBench:gpu" Tip="Abrir o benchmark da placa de vídeo" />
                                                <local:DashStart Icon="storage" Title="Benchmark de disco" Detail="Leitura e escrita do disco" Target="PageBench:disk" Tip="Abrir o benchmark de disco" />
                                            </x:Array>
                                        </ItemsControl.ItemsSource>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl x:Name="DashEvents" ItemTemplate="{StaticResource DashEventTemplate}" VerticalAlignment="Top" ClipToBounds="True" Focusable="False" />
                                <!-- Histórico: o próprio cartão passa a rolar, sem mudar de tamanho -->
                                <!-- Rola de linha em linha (painel virtualizado) e a altura é sempre múltipla da linha, então nada fica cortado -->
                                <ItemsControl x:Name="DashEventsAll" ItemTemplate="{StaticResource DashEventTemplate}" VerticalAlignment="Top" Visibility="Collapsed" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer x:Name="HistoryScroll" CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False">
                                                <ItemsPresenter Margin="0,0,16,0" />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                </ItemsControl>
                            </local:FitHost>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
