<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.OverviewView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}">
                <StackPanel>
                    <TextBlock Text="Visão geral" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="DashMachine" Text="Leituras ao vivo do processador, da placa de vídeo, da memória e do disco do sistema." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </Grid>

            <!-- Linha 1: telemetria (instrumento principal) + desempenho -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="24,20,24,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="DashChartLabel" Text="Temperatura" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="DashChartDelta" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,8,0">
                                    <StackPanel x:Name="DashMetricPanel" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Temperatura" Tag="temp" IsChecked="True" Checked="DashOption_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Carga" Tag="load" Checked="DashOption_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DashMetric" Content="Consumo" Tag="power" Checked="DashOption_Checked" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SegmentGroup}">
                                    <StackPanel x:Name="DashRangePanel" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="1 min" Tag="60" Checked="DashOption_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="5 min" Tag="300" IsChecked="True" Checked="DashOption_Checked" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="15 min" Tag="900" Checked="DashOption_Checked" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!-- Leituras atuais por canal -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,6">
                            <StackPanel Margin="0,0,40,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Processador" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="DashChartValue" Text="—" Style="{StaticResource ReadoutHero}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="3" CornerRadius="1.5" Background="{DynamicResource Copper}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Placa de vídeo" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="DashChartValue2" Text="—" Style="{StaticResource ReadoutHero}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Canvas x:Name="DashChart" Height="220" ClipToBounds="True" SizeChanged="DashChart_SizeChanged" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE768;" Content="Rodar benchmark" Margin="0,16,0,0" Click="DashBench_Click" />
                        <StackPanel>
                            <TextBlock Text="Desempenho" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Render de CPU, multi-core" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <Grid Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DashScore" Text="—" Style="{StaticResource ReadoutHero}" />
                                    <TextBlock Text="pts" Style="{StaticResource Unit}" Margin="6,0,0,9" />
                                </StackPanel>
                                <TextBlock x:Name="DashScoreDelta" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                            </Grid>
                            <TextBlock x:Name="DashScoreSub" Text="nenhum teste ainda" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" />
                            <Border Style="{StaticResource Divider}" Margin="0,16,0,10" />
                            <ItemsControl x:Name="DashScores" ItemTemplate="{StaticResource KeyValueRow}" />
                            <Border Style="{StaticResource InsetBorder}" Margin="0,14,0,0" Padding="14,4">
                                <StackPanel>
                                    <Grid Margin="0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" />
                                        <TextBlock x:Name="DashCpuName" Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Margin="0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" />
                                        <TextBlock x:Name="DashGpuName" Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Linha 2: componentes -->
            <ItemsControl x:Name="DashComponents" Margin="0,0,-12,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="18,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Muted}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Model}" Style="{StaticResource StatSub}" Margin="0,1,0,0" ToolTip="{Binding Model}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE76C;" Tag="{Binding Target}" Click="DashGo_Click" ToolTip="Abrir detalhes" VerticalAlignment="Top" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding Load}" Style="{StaticResource ReadoutLarge}" />
                                    <TextBlock Text="em uso" Style="{StaticResource Unit}" Margin="8,0,0,7" />
                                </StackPanel>
                                <UniformGrid Columns="3" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Temp." Style="{StaticResource StatLabel}" FontSize="11.5" />
                                        <TextBlock Text="{Binding Temp}" Style="{StaticResource Num}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Clock" Style="{StaticResource StatLabel}" FontSize="11.5" />
                                        <TextBlock Text="{Binding Clock}" Style="{StaticResource Num}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Consumo / uso" Style="{StaticResource StatLabel}" FontSize="11.5" />
                                        <TextBlock Text="{Binding Power}" Style="{StaticResource Num}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Linha 3: memória, eventos e saúde -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Memória e disco" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="DashMemHero" Text="—" Style="{StaticResource ReadoutLarge}" />
                        </StackPanel>
                        <TextBlock x:Name="DashMemSub" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" Margin="0,2,0,6" />
                        <Canvas x:Name="DashRings" Width="190" Height="190" HorizontalAlignment="Center" Margin="0,6,0,10" />
                        <ItemsControl x:Name="DashRingLegend">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Swatch}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource Num}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Atividade recente" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <TextBlock x:Name="DashEventsEmpty" Text="Benchmarks, testes de carga e dispositivos conectados aparecem aqui assim que acontecerem." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <ItemsControl x:Name="DashEvents">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource StatSub}" ToolTip="{Binding Detail}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource Num}" />
                                                <TextBlock Text="{Binding When}" Style="{StaticResource StatSub}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE9D9;" Content="Ver todos os sensores" HorizontalAlignment="Left" Margin="-10,12,0,-6" Click="DashSensors_Click" />
                        <StackPanel>
                            <TextBlock Text="Saúde do PC" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="DashHealth">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="dot" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource WarnSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                    <TextBlock x:Name="chk" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter TargetName="chk" Property="Text" Value="&#xE73E;" />
                                                <Setter TargetName="chk" Property="Foreground" Value="{DynamicResource Ok}" />
                                                <Setter TargetName="dot" Property="Background" Value="{DynamicResource OkSoft}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
