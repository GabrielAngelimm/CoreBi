<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.DriversView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Grupo da tabela sem o recuo de 5 px do modelo padrão: título do grupo, linhas e cabeçalho começam na mesma x -->
        <Style x:Key="DrvGroup" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ContentPresenter />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Linha de veredito sobre a tabela (dispositivos com problema ou "todos funcionando"): LED, o que é e o que fazer à direita -->
        <Style x:Key="DrvVerdictLed" TargetType="Ellipse" BasedOn="{StaticResource StatusLed}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,1,12,0" />
        </Style>
        <!--
            Placa de números dos cartões da esquerda: um painel embutido (tom Raised, cantos de 14) com duas leituras em colunas
            iguais, centradas, separadas por um fio vertical. É o que dá a cada cartão os três andares: quem é, os números e o que fazer.
        -->
        <Style x:Key="DrvPlate" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Raised}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInset}" />
            <Setter Property="Padding" Value="0,14,0,14" />
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>
        <Style x:Key="DrvPlateRule" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{DynamicResource Line}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="DrvPlateCell" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="DrvPlateLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DrvPlateValue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!--
        Drivers: backup e restauração no cabeçalho da página (cada um abre a sua janela de confirmação). À esquerda, numa coluna de
        520, as peças que pedem driver do fabricante, cada cartão com a mesma anatomia (cabeçalho com ícone e atalho, nome e
        fabricante, a placa de números e, na placa de vídeo, o veredito e as ações), e o Windows Update na sobra, com a lista rolando
        por dentro. À direita, em altura total, os drivers instalados: tipos e busca no cabeçalho, a linha dos dispositivos com
        problema e a tabela agrupada por tipo. Em janelas estreitas a tabela desce para baixo da coluna e a página rola.
    -->
    <ScrollViewer x:Name="DrvScroll" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="DrvRoot" Height="{Binding ViewportHeight, ElementName=DrvScroll}" MinHeight="760">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Mantém em dia, guarda e devolve os drivers do seu PC." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                    <StackPanel Style="{StaticResource PageActions}">
                        <Grid x:Name="DrvMeter" Style="{StaticResource TaskMeter}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Style="{StaticResource ProgressTrack}" VerticalAlignment="Center">
                                <Border x:Name="DrvProgressFill" Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="DrvProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DrvPercent" Grid.Column="1" Style="{StaticResource TaskPercent}" />
                        </Grid>
                        <DockPanel Style="{StaticResource PageStatusSlot}">
                            <TextBlock x:Name="DrvDetail" Style="{StaticResource PageDetail}" DockPanel.Dock="Right" />
                            <TextBlock x:Name="DrvStatus" Text="Lendo drivers instalados…" Style="{StaticResource PageStatus}" Typography.NumeralAlignment="Tabular" TextAlignment="Right" />
                        </DockPanel>
                        <!-- Backup e restauração: cada um abre a janela que confirma (onde salvar / qual backup) antes de mexer em qualquer coisa -->
                        <Button x:Name="BtnDrvBackup" Style="{StaticResource HeaderSecondary}" Margin="0,0,10,0" local:Ui.Icon="&#xE74E;" Content="Fazer backup" Click="BtnDrvBackup_Click"
                                ToolTip="Guarda uma cópia dos drivers das suas peças, para reinstalar tudo depois de formatar." />
                        <Button x:Name="BtnDrvRestore" Style="{StaticResource HeaderSecondary}" Margin="0,0,10,0" local:Ui.Icon="&#xE777;" Content="Restaurar" Click="BtnDrvRestore_Click"
                                ToolTip="Reinstala os drivers de um backup. O Windows só usa os que forem melhores que os atuais." />
                        <Button x:Name="BtnDrvScan" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" Click="BtnDrvScan_Click"
                                ToolTip="Lê tudo de novo e consulta a versão mais nova da placa de vídeo." />
                    </StackPanel>
                </local:PageHeaderPanel>

                <Grid x:Name="DrvBody" Grid.Row="1" SizeChanged="DrvBody_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DrvSideColumn" Width="520" />
                        <ColumnDefinition x:Name="DrvGap" Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="DrvSide">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" MinHeight="190" />
                        </Grid.RowDefinitions>

                        <!--
                            Placa de vídeo: o nome e a linha do driver; na placa, instalado e mais recente lado a lado; embaixo, o veredito com
                            LED e, no pé, a ação (que vale para a primeira com download automático) com o Studio à direita
                        -->
                        <Border x:Name="DrvGpuCard" Style="{StaticResource CardBorder}" Padding="{StaticResource PanelPadding}" local:Skeleton.Top="36"
                                local:Skeleton.Layout="gap 20; row 20: s 58%; gap 4; row 16: c 30%; gap 18; row 80: box *@1^14; gap 14; row 20: dot 8, - 9, t *@0.6; gap 20; row 34: btn 200, - *, pill 40@1^20, - 8, c 50">
                            <StackPanel>
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- O desenho da placa sobe 4 (fica 1 px abaixo do meio da caixa): o centro cai no meio das maiúsculas do título (medido) -->
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Gpu" Kind="gpu" Width="36" Height="36" VerticalAlignment="Center" Margin="0,-4,0,4" />
                                    <TextBlock Grid.Column="1" Text="Placa de vídeo" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    <Button x:Name="BtnDrvGpuPage" Grid.Column="2" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE8A7;" Content="Site oficial" Margin="0,-6,-10,0"
                                            VerticalAlignment="Center" Click="BtnDrvGpuPage_Click" Visibility="Collapsed"
                                            ToolTip="Abre a página de drivers do fabricante da placa." />
                                </Grid>
                                <ItemsControl x:Name="DrvGpus" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,20,0,0">
                                                <TextBlock Text="{Binding GpuName}" Style="{StaticResource GroupTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Caption, Converter={StaticResource NotEmptyVis}}" />
                                                <Border Style="{StaticResource DrvPlate}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Style="{StaticResource DrvPlateCell}" ToolTip="A versão que está no seu PC agora.">
                                                            <TextBlock Text="Instalado" Style="{StaticResource DrvPlateLabel}" />
                                                            <TextBlock Text="{Binding Installed}" Style="{StaticResource DrvPlateValue}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Style="{StaticResource DrvPlateRule}" />
                                                        <StackPanel Grid.Column="2" Style="{StaticResource DrvPlateCell}" ToolTip="A versão mais nova no site do fabricante, consultada agora.">
                                                            <TextBlock Text="Mais recente" Style="{StaticResource DrvPlateLabel}" />
                                                            <TextBlock x:Name="latest" Style="{StaticResource DrvPlateValue}">
                                                                <Run Text="{Binding Latest, Mode=OneWay}" /><Run x:Name="size" Text="{Binding SizeText, Mode=OneWay}" FontSize="13"
                                                                    Foreground="{DynamicResource Faint}" FontFamily="{StaticResource LabelFont}" FontStretch="Normal" />
                                                            </TextBlock>
                                                            <TextBlock x:Name="unknown" Text="—" Style="{StaticResource DrvPlateValue}" Foreground="{DynamicResource Faint}" Visibility="Collapsed" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Grid Margin="0,14,0,0" Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="led" Style="{StaticResource StatusLed}" Margin="0,7,10,0" VerticalAlignment="Top" Fill="{DynamicResource Faint}" />
                                                    <TextBlock x:Name="msg" Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Latest}" Value="">
                                                    <Setter TargetName="latest" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="unknown" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Vendor}" Value="NVIDIA" />
                                                        <Condition Binding="{Binding Latest, Converter={StaticResource NotEmptyVis}}" Value="Visible" />
                                                        <Condition Binding="{Binding UpdateAvailable}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Ok}" />
                                                    <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Fg}" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Warn}" />
                                                    <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Warn}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="DrvGpuEmpty" Text="Nenhuma placa de vídeo encontrada." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,20,0,0" Visibility="Collapsed" />
                                <Grid x:Name="DrvGpuActions" Margin="0,20,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnDrvInstall" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE896;" Content="Baixar e instalar"
                                            Click="BtnDrvInstall_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Baixa do site oficial, confere a assinatura e cria um ponto de restauração antes de instalar." />
                                    <CheckBox x:Name="DrvStudio" Grid.Column="2" Style="{StaticResource Switch}" Content="Studio" VerticalAlignment="Center" Visibility="Collapsed"
                                              local:Ui.SwitchMotion="True" Click="DrvStudio_Click"
                                              ToolTip="Studio: driver da NVIDIA pensado para edição de vídeo e 3D. Desligado: Game Ready, pensado para jogos." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Placa-mãe: o modelo e o fabricante; na placa, a versão da BIOS e a data dela lado a lado; o suporte do modelo no cabeçalho -->
                        <Border x:Name="DrvBoardCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="{StaticResource PanelPadding}" local:Skeleton.Top="36"
                                local:Skeleton.Layout="gap 20; row 20: s 52%; gap 4; row 16: c 34%; gap 18; row 80: box *@1^14">
                            <StackPanel>
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- O desenho da placa-mãe sobe 2 (margens -2 e 2, a linha continua com 36): o centro cai no meio das maiúsculas do título (medido) -->
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Board" Kind="board" Width="36" Height="36" VerticalAlignment="Center" Margin="0,-2,0,2" />
                                    <TextBlock Grid.Column="1" Text="Placa-mãe" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    <Button x:Name="BtnDrvBoardPage" Grid.Column="2" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE8A7;" Content="Suporte do fabricante" Margin="0,-6,-10,0"
                                            VerticalAlignment="Center" Click="BtnDrvBoardPage_Click" Visibility="Collapsed"
                                            ToolTip="Abre o site do fabricante já no seu modelo: drivers de chipset, áudio, rede e a BIOS." />
                                </Grid>
                                <TextBlock x:Name="DrvBoard" Style="{StaticResource GroupTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,20,0,0" />
                                <TextBlock x:Name="DrvBoardMaker" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <Border x:Name="DrvBiosBox" Style="{StaticResource DrvPlate}" Visibility="Collapsed"
                                        ToolTip="BIOS: o programa da placa-mãe que liga o PC antes do Windows. Atualize só pelo site do fabricante, e só se ele recomendar.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Style="{StaticResource DrvPlateCell}">
                                            <TextBlock Text="BIOS" Style="{StaticResource DrvPlateLabel}" />
                                            <TextBlock x:Name="DrvBoardBios" Style="{StaticResource DrvPlateValue}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource DrvPlateRule}" />
                                        <StackPanel Grid.Column="2" Style="{StaticResource DrvPlateCell}">
                                            <TextBlock Text="Lançada em" Style="{StaticResource DrvPlateLabel}" />
                                            <TextBlock x:Name="DrvBoardBiosDate" Style="{StaticResource DrvPlateValue}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="DrvBoardNote" Text="Busque o modelo no site do fabricante para achar os drivers dela." Style="{StaticResource Caption}"
                                           Margin="0,14,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!--
                            Windows Update: ocupa a sobra da coluna. A ação fica no cabeçalho ("Procurar"; "Instalar n" quando acha). Embaixo, o
                            que a busca faz, o esqueleto pulsando enquanto ela roda, o resultado ou a lista, que rola por dentro do cartão.
                        -->
                        <Border x:Name="DrvWuCard" Grid.Row="4" Style="{StaticResource CardBorder}" Padding="24,16,24,16" local:Skeleton.Top="44"
                                local:Skeleton.Layout="lines 36: t *@0.62, - *, c 52&gt;">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Style="{StaticResource CardHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardTitle}" ToolTip="Drivers que a Microsoft testou para as peças deste PC. Nada é instalado sem você confirmar.">
                                        <Run Text="Windows Update" /><InlineUIContainer><Border Width="10" /></InlineUIContainer><Run x:Name="DrvWuCount"
                                            FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource Faint}"
                                            Typography.NumeralAlignment="Tabular" />
                                    </TextBlock>
                                    <Button x:Name="BtnDrvWuSearch" Grid.Column="1" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE721;" Content="Procurar"
                                            VerticalAlignment="Center" Click="BtnDrvWuSearch_Click"
                                            ToolTip="Pergunta ao Windows Update se há drivers novos. Leva até 1 minuto e não instala nada." />
                                    <Button x:Name="BtnDrvWuInstall" Grid.Column="2" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE896;" Content="Instalar" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Click="BtnDrvWuInstall_Click" IsEnabled="False" Visibility="Collapsed"
                                            ToolTip="Instala pelo próprio Windows Update. Pode pedir para reiniciar." />
                                </Grid>
                                <TextBlock x:Name="DrvWuList" Grid.Row="1" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,8" TextWrapping="Wrap"
                                           Text="Drivers testados pela Microsoft para este PC." />
                                <ScrollViewer x:Name="DrvWuScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="DrvWuItems" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="36">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Num}" Foreground="{DynamicResource Muted}" Margin="16,0,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Drivers instalados: busca no cabeçalho, a linha dos dispositivos com problema e a tabela agrupada por classe -->
                    <Border x:Name="DrvTableCard" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,16,16,8" local:Skeleton.Top="34"
                            local:Skeleton.Layout="gap 10; row 40: - 8, dot 8, - 12, t 40%, - *, c 140@0.6&gt;, - 8; gap 2; row 32: - 8, c *@0.1, c 220@0.36, c 170@0.3, c 96@0.42&gt;, - 8; row 40: - 8, s 64, - *; rows 1 36: - 8, t *, t 220, t 170, c 96@0.8&gt;, - 8; row 40: - 8, s 52, - *; lines 6 36: - 8, t *, t 220, t 170, c 96@0.8&gt;, - 8; row 40: - 8, s 58, - *; lines 36: - 8, t *, t 220, t 170, c 96@0.8&gt;, - 8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--
                                Cabeçalho: título com a quantidade, os tipos de peça num trilho de segmentos (o destaque desliza até o escolhido)
                                e a busca. Quando o cartão é estreito demais para os três numa linha, o trilho desce para uma linha só dele.
                            -->
                            <Grid x:Name="DrvTableHead" Margin="8,0,8,0" SizeChanged="DrvTableHead_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center" ToolTip="Os programas que deixam o Windows usar cada peça, separados por tipo.">
                                    <Run Text="Drivers instalados" /><InlineUIContainer><Border Width="10" /></InlineUIContainer><Run x:Name="DrvCount"
                                        FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="16" FontWeight="Normal" Foreground="{DynamicResource Faint}"
                                        Typography.NumeralAlignment="Tabular" />
                                </TextBlock>
                                <Border x:Name="DrvGroupBox" Grid.Column="1" Style="{StaticResource SegmentGroup}" Margin="16,0,0,0" Visibility="Collapsed">
                                    <local:SlidingSelectionPanel x:Name="DrvGroups" Style="{StaticResource SegmentRail}" ToggleButton.Checked="DrvGroup_Checked" />
                                </Border>
                                <TextBox x:Name="DrvSearch" Grid.Column="2" Style="{StaticResource CardSearch}" Width="200" Margin="12,0,0,0" VerticalAlignment="Center"
                                         local:Ui.Placeholder="Buscar driver" TextChanged="DrvSearch_TextChanged"
                                         ToolTip="Busca pelo nome do dispositivo ou pelo fabricante." />
                            </Grid>

                            <!--
                                Saúde dos dispositivos, sem caixa: uma linha por dispositivo com problema (LED âmbar, o nome, o que o Windows
                                diz e, na primeira, o atalho para o Gerenciador de Dispositivos) ou uma linha só dizendo que todos funcionam
                            -->
                            <StackPanel Grid.Row="1" Margin="8,10,8,0">
                                <Grid x:Name="DrvHealthy" Height="40" Visibility="Collapsed"
                                      ToolTip="Nenhum dispositivo conectado aparece com o ponto de exclamação do Gerenciador de Dispositivos.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource DrvVerdictLed}" Fill="{DynamicResource Ok}" />
                                    <TextBlock Grid.Column="1" Text="Todos os dispositivos estão funcionando." FontSize="14" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl x:Name="DrvProblems" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="40" Background="Transparent" ToolTip="{Binding Tip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Style="{StaticResource DrvVerdictLed}" Fill="{DynamicResource Warn}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                                <TextBlock Grid.Column="2" Text="{Binding Meaning}" FontSize="14" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="3" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE8A7;" Content="Gerenciador de Dispositivos" Margin="12,0,-10,0"
                                                        VerticalAlignment="Center" Click="BtnDrvDeviceManager_Click" Visibility="{Binding First, Converter={StaticResource BoolVis}}"
                                                        ToolTip="Abre o Gerenciador de Dispositivos, onde dá para ver o problema e atualizar o driver." />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Grid x:Name="DrvHead" Grid.Row="2" Height="32" Margin="8,2,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dispositivo" Style="{StaticResource TableHead}" />
                                <TextBlock Grid.Column="1" Text="Fabricante" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                                <TextBlock Grid.Column="2" Text="Versão" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                                <TextBlock Grid.Column="3" Text="Data" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                            </Grid>
                            <ScrollViewer x:Name="DrvListScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" ScrollChanged="DrvListScroll_ScrollChanged">
                                <StackPanel>
                                    <ItemsControl x:Name="DrvList" Focusable="False">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle ContainerStyle="{StaticResource DrvGroup}">
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="40" Margin="8,0">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="36" Padding="8,0">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="200" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="96" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Device}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device}" VerticalAlignment="Center" />
                                                            <Border x:Name="unsigned" Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoft}"
                                                                    VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="O Windows não encontrou assinatura digital neste driver.">
                                                                <TextBlock Text="Sem assinatura" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{Binding Vendor}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Vendor}" Margin="16,0,0,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource Num}" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Date}" Style="{StaticResource Num}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" ToolTip="{Binding DateTip}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Signed}" Value="False">
                                                        <Setter TargetName="unsigned" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="DrvEmpty" Text="Nenhum driver encontrado." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="8,14,8,0" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
