<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.DriversView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Verifique, baixe e instale drivers. NVIDIA e AMD de forma automática; placa-mãe pela página oficial do fabricante." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button x:Name="BtnDrvScan" Grid.Column="1" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE72C;" Content="Verificar tudo" VerticalAlignment="Top" Click="BtnDrvScan_Click" />
            </Grid>
            <Border Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="DrvStatus" Text="Clique em Verificar tudo para comparar os drivers instalados com as versões mais recentes." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
                    <Grid Style="{StaticResource ProgressTrack}">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DrvProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="24,20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource CopperSoft}" BorderBrush="{x:Null}">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Copper}" />
                                </Border>
                                <TextBlock Text="Placa de vídeo" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="DrvGpus" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,14,0,0">
                                            <TextBlock Text="{Binding GpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Instalado" Style="{StaticResource StatLabel}" />
                                                    <TextBlock Text="{Binding Installed}" Style="{StaticResource ReadoutText}" FontSize="20" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Mais recente" Style="{StaticResource StatLabel}" />
                                                    <TextBlock Text="{Binding Latest}" Style="{StaticResource ReadoutText}" FontSize="20" Foreground="{DynamicResource Accent}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox x:Name="DrvStudio" Style="{StaticResource Switch}" Content="Driver Studio (criação) em vez de Game Ready" Margin="0,16,0,0" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="BtnDrvInstall" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE896;" Content="Baixar e instalar" Margin="0,0,8,8" Click="BtnDrvInstall_Click" IsEnabled="False" />
                                <Button x:Name="BtnDrvGpuPage" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE8A7;" Content="Abrir página oficial" Margin="0,0,8,8" Click="BtnDrvGpuPage_Click" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Footnote}" Margin="0,4,0,0" Text="NVIDIA: o instalador vem do servidor oficial, a assinatura digital é conferida e um ponto de restauração é criado antes de abrir. AMD: o CoreBi procura o instalador na página oficial do seu modelo (RX 4000 a 9000); se o site bloquear, use Abrir página oficial. Intel: só a página oficial." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="24,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock Text="&#xE964;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource Steel}" />
                                </Border>
                                <TextBlock Text="Placa-mãe e fabricante" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="DrvBoard" Style="{StaticResource Body}" Margin="0,14,0,0" />
                            <Button x:Name="BtnDrvBoardPage" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE8A7;" Content="Abrir suporte do fabricante" Margin="0,14,0,10" HorizontalAlignment="Left" Click="BtnDrvBoardPage_Click" IsEnabled="False" />
                            <TextBlock Style="{StaticResource Footnote}" Text="ASUS, MSI, Gigabyte e outros não têm API pública de versões. O CoreBi abre o suporte oficial do fabricante detectado (chipset, áudio, rede, BIOS). Se a página não abrir no seu modelo, busque o modelo mostrado acima no site." />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}" Padding="24,20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Windows Update" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Drivers certificados pela Microsoft." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <TextBlock x:Name="DrvWuList" Style="{StaticResource Body}" Margin="0,14,0,0" Text="Ainda não pesquisado." />
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="BtnDrvWuSearch" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE721;" Content="Procurar" Margin="0,0,8,8" Click="BtnDrvWuSearch_Click" />
                                <Button x:Name="BtnDrvWuInstall" Style="{StaticResource PrimaryButton}" Content="Instalar todos" Margin="0,0,8,8" Click="BtnDrvWuInstall_Click" IsEnabled="False" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="Backup dos drivers" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Text="Exporta todos os drivers de terceiros para Documentos\CoreBi-Drivers. Útil antes de formatar ou de trocar um driver." />
                            <Button x:Name="BtnDrvBackup" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE74E;" Content="Fazer backup" Margin="0,16,0,0" HorizontalAlignment="Left" Click="BtnDrvBackup_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Padding="24,20,24,10">
                <StackPanel>
                    <TextBlock Text="Drivers instalados" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <ItemsControl x:Name="DrvList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Device}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Footnote}" Margin="0,2,0,0">
                                                <Run Text="{Binding Class, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Vendor, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" />
                                            <TextBlock Style="{StaticResource Footnote}" HorizontalAlignment="Right" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular">
                                                <Run Text="{Binding Date, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding SignedText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
