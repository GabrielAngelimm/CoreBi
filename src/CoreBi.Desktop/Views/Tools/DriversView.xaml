<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.DriversView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <Style x:Key="DrvReadout" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Grupo da tabela sem o recuo de 5 px do modelo padrão: título do grupo, linhas e cabeçalho começam na mesma x -->
        <Style x:Key="DrvGroup" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ContentPresenter />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Drivers: o console ao lado do título acompanha a leitura, o download e o backup. À esquerda, numa coluna de 520 px,
        a placa de vídeo (instalado e mais recente como leituras de mostrador, a ação de instalar), a placa-mãe (modelo, BIOS e o
        suporte oficial) e o Windows Update, que ocupa a sobra e rola por dentro; antes de procurar, ele mostra o que faz e o
        botão no meio da área. À direita, os drivers instalados numa tabela agrupada por classe, com busca, filtro e o backup no
        título e uma linha que diz o que é um driver; ela ocupa a altura toda e rola por dentro. Em janelas estreitas a tabela desce para baixo da coluna e a página rola.
    -->
    <ScrollViewer x:Name="DrvScroll" VerticalScrollBarVisibility="Auto">
        <!-- Altura da janela (e não mínima): a tabela longa rola dentro do painel; em janelas estreitas ou abaixo de 700 px a página rola (DrvBody_SizeChanged) -->
        <Grid x:Name="DrvRoot" Height="{Binding ViewportHeight, ElementName=DrvScroll}" MinHeight="700">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="560" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho padrão (PageHeaderPanel): título, estado vivo embaixo e a barra de ações à direita, na linha do título -->
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Mantém em dia os drivers da placa de vídeo, da placa-mãe e do Windows." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                    <StackPanel Style="{StaticResource PageActions}">
                        <Grid x:Name="DrvMeter" Style="{StaticResource TaskMeter}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Style="{StaticResource ProgressTrack}" VerticalAlignment="Center">
                                <Border x:Name="DrvProgressFill" Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="DrvProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DrvPercent" Grid.Column="1" Style="{StaticResource TaskPercent}" />
                        </Grid>
                        <DockPanel Style="{StaticResource PageStatusSlot}">
                            <TextBlock x:Name="DrvDetail" Style="{StaticResource PageDetail}" DockPanel.Dock="Right" />
                            <TextBlock x:Name="DrvStatus" Text="Lendo drivers instalados…" Style="{StaticResource PageStatus}" Typography.NumeralAlignment="Tabular" TextAlignment="Right" />
                        </DockPanel>
                        <Button x:Name="BtnDrvBackup" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE74E;" Content="Fazer backup" Margin="0,0,10,0"
                                Click="BtnDrvBackup_Click" ToolTip="Exporta os drivers de terceiros para Documentos\CoreBi-Drivers, para reinstalar depois de formatar." />
                        <Button x:Name="BtnDrvScan" Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE72C;" Content="Ler drivers de novo" Click="BtnDrvScan_Click"
                                ToolTip="Lê de novo os drivers instalados, a placa de vídeo e a placa-mãe e consulta a versão mais recente na NVIDIA ou na AMD. Para atualizações do Windows, use Procurar atualizações." />
                    </StackPanel>
                </local:PageHeaderPanel>

                <Grid x:Name="DrvBody" Grid.Row="1" SizeChanged="DrvBody_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DrvSideColumn" Width="520" />
                        <ColumnDefinition x:Name="DrvGap" Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="DrvSide">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" MinHeight="150" />
                        </Grid.RowDefinitions>

                        <!-- Placa de vídeo: uma ficha por placa; a ação vale para a primeira que tem download automático -->
                        <Border x:Name="DrvGpuCard" Style="{StaticResource CardBorder}" local:Skeleton.Top="44" local:Skeleton.Shape="Text">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        Medido: o meio das maiúsculas do título fica 2,5 px acima do centro da linha de 36. O desenho da placa
                                        sobe 4 (o desenho fica 1 px abaixo do meio da caixa) e o interruptor sobe 2: os dois centros caem no meio
                                        das maiúsculas e "Studio" fica na base do título. As margens se compensam (-4 em cima, 4 embaixo), para a
                                        linha continuar com 36.
                                    -->
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Gpu" Kind="gpu" Width="36" Height="36" VerticalAlignment="Center" Margin="0,-4,0,4" />
                                    <TextBlock Grid.Column="1" Text="Placa de vídeo" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    <CheckBox x:Name="DrvStudio" Grid.Column="2" Style="{StaticResource Switch}" Content="Studio" VerticalAlignment="Center" Margin="0,-2,0,2" Visibility="Collapsed"
                                              Click="DrvStudio_Click" ToolTip="Driver Studio da NVIDIA, para criação de conteúdo, em vez do Game Ready." />
                                </Grid>
                                <ItemsControl x:Name="DrvGpus" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="{Binding GpuName}" FontFamily="{StaticResource LabelFont}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Instalado" Style="{StaticResource StatLabel}" />
                                                        <TextBlock Text="{Binding Installed}" Style="{StaticResource DrvReadout}" ToolTip="{Binding Installed}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Visibility="{Binding Latest, Converter={StaticResource NotEmptyVis}}">
                                                        <TextBlock Text="Mais recente" Style="{StaticResource StatLabel}" />
                                                        <TextBlock Text="{Binding Latest}" Style="{StaticResource DrvReadout}" ToolTip="{Binding Latest}" />
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource StatSub}" Visibility="{Binding SizeText, Converter={StaticResource NotEmptyVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,12,0,0" Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="led" Style="{StaticResource StatusLed}" Margin="0,7,9,0" VerticalAlignment="Top" Visibility="Collapsed" />
                                                    <TextBlock x:Name="msg" Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" />
                                                </Grid>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Vendor}" Value="NVIDIA" />
                                                        <Condition Binding="{Binding Latest, Converter={StaticResource NotEmptyVis}}" Value="Visible" />
                                                        <Condition Binding="{Binding UpdateAvailable}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="led" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Ok}" />
                                                    <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Fg}" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                    <Setter TargetName="led" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="led" Property="Fill" Value="{DynamicResource Warn}" />
                                                    <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Warn}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="DrvGpuEmpty" Text="Nenhuma placa de vídeo encontrada." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,16,0,0" Visibility="Collapsed" />
                                <WrapPanel Margin="0,18,0,-8">
                                    <Button x:Name="BtnDrvInstall" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE896;" Content="Baixar e instalar" Margin="0,0,8,8"
                                            Click="BtnDrvInstall_Click" IsEnabled="False" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Baixa do servidor oficial do fabricante, confere a assinatura digital e cria um ponto de restauração antes de abrir o instalador." />
                                    <Button x:Name="BtnDrvGpuPage" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE8A7;" Content="Página oficial" Margin="0,0,8,8"
                                            Click="BtnDrvGpuPage_Click" Visibility="Collapsed" ToolTip="Para placas Intel ou quando a consulta automática não acha o driver." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Placa-mãe: modelo e BIOS; os drivers dela (chipset, áudio, rede) vêm do suporte do fabricante -->
                        <Border x:Name="DrvBoardCard" Grid.Row="2" Style="{StaticResource CardBorder}" local:Skeleton.Top="44" local:Skeleton.Shape="Text">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- O desenho da placa-mãe sobe 2 (margens -2 e 2, a linha continua com 36): o centro dele cai no meio das maiúsculas do título (medido) -->
                                    <local:HwIcon Style="{StaticResource ChannelIcon}" local:Ui.Channel="Board" Kind="board" Width="36" Height="36" VerticalAlignment="Center" Margin="0,-2,0,2" />
                                    <TextBlock Grid.Column="1" Text="Placa-mãe" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                                <!-- O modelo é o que identifica a placa; a BIOS vem embaixo, como uma linha de ficha, no tom do conteúdo -->
                                <TextBlock x:Name="DrvBoard" FontFamily="{StaticResource LabelFont}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,16,0,0" />
                                <TextBlock x:Name="DrvBoardMaker" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                <Grid x:Name="DrvBiosBox" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        Rótulo e versão num TextBlock só (Runs: mesma base, antes a versão ficava 3 px abaixo de "BIOS"); a data,
                                        Segoe como a versão, tem a mesma caixa de 18 (BlockLineHeight), e por isso a mesma base (antes, 2 px abaixo).
                                    -->
                                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Num}" FontSize="13" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <Run Text="BIOS" FontFamily="{StaticResource LabelFont}" FontSize="12.5" Foreground="{DynamicResource Muted}" /><InlineUIContainer><Border Width="12" /></InlineUIContainer><Run x:Name="DrvBoardBios" />
                                    </TextBlock>
                                    <TextBlock x:Name="DrvBoardBiosDate" Grid.Column="2" Style="{StaticResource Num}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"
                                               LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                                </Grid>
                                <Button x:Name="BtnDrvBoardPage" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE8A7;" Content="Suporte do fabricante" Margin="0,16,0,0"
                                        HorizontalAlignment="Left" Click="BtnDrvBoardPage_Click" Visibility="Collapsed"
                                        ToolTip="Abre o suporte oficial, com chipset, áudio, rede e BIOS. Se a página não abrir no seu modelo, busque o modelo no site." />
                                <TextBlock x:Name="DrvBoardNote" Text="Sem página de suporte conhecida para esta placa." Style="{StaticResource Caption}" Margin="0,16,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!--
                            Windows Update: ocupa a sobra da coluna; a lista rola por dentro. Antes de procurar (ou sem nada novo), a área
                            mostra o que a busca faz e o botão dela no meio, em vez de um cartão alto e vazio.
                        -->
                        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="24,20,24,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Título e contagem num TextBlock só: Runs de fontes diferentes na mesma base -->
                                <TextBlock Style="{StaticResource SectionTitle}" TextWrapping="NoWrap">
                                    <Run Text="Windows Update" /><InlineUIContainer><Border Width="10" /></InlineUIContainer><Run x:Name="DrvWuCount"
                                        FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Faint}"
                                        Typography.NumeralAlignment="Tabular" />
                                </TextBlock>
                                <StackPanel x:Name="DrvWuEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="0,16,0,8">
                                    <TextBlock x:Name="DrvWuList" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" TextAlignment="Center"
                                               Text="Procura drivers certificados pela Microsoft para este PC." />
                                    <Button x:Name="BtnDrvWuSearch" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE721;" Content="Procurar atualizações" Margin="0,14,0,0"
                                            HorizontalAlignment="Center" Click="BtnDrvWuSearch_Click"
                                            ToolTip="Consulta o Windows Update; pode levar 1 minuto. Nada é instalado sem você confirmar." />
                                </StackPanel>
                                <ScrollViewer x:Name="DrvWuScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="DrvWuItems" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="36">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Num}" Foreground="{DynamicResource Muted}" Margin="16,0,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button x:Name="BtnDrvWuInstall" Grid.Row="2" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE896;" Content="Instalar todos" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Click="BtnDrvWuInstall_Click" IsEnabled="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Drivers instalados: tabela agrupada por classe, com busca e filtro; o cabeçalho de colunas tem a geometria das linhas -->
                    <Border x:Name="DrvTableCard" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,20,16,8" local:Skeleton.Top="60" local:Skeleton.RowHeight="36">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--
                                O título fica na mesma linha de base do de "Placa de vídeo", ao lado: lá a linha de 36 começa a 20 da borda e o
                                título (caixa de 24) fica centrado nela, 6 abaixo; aqui o padding é 20 e o título desce 6. A frase de explicação fica
                                embaixo do título. A busca filtra só esta tabela, então mora nela, à direita do título (no cabeçalho da página ela
                                apertava a barra de ações, e o medidor abria em cima do subtítulo); o backup fica na barra de ações.
                            -->
                            <Grid Margin="8,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DrvSearch" Grid.Column="1" Style="{StaticResource SearchField}" Width="280" VerticalAlignment="Top" Margin="16,0,0,0"
                                         local:Ui.Placeholder="Buscar dispositivo ou fabricante" TextChanged="DrvSearch_TextChanged" />
                                <StackPanel Margin="0,6,0,0">
                                    <!-- Título e contagem num TextBlock só: Runs de fontes diferentes na mesma base (antes a contagem descia 1 px) -->
                                    <TextBlock Style="{StaticResource SectionTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="Drivers instalados" /><InlineUIContainer><Border Width="10" /></InlineUIContainer><Run x:Name="DrvCount"
                                            FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Faint}"
                                            Typography.NumeralAlignment="Tabular" />
                                    </TextBlock>
                                    <TextBlock Text="Programas que deixam o Windows usar cada peça do computador." Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="DrvChips" Grid.Row="1" Margin="8,14,8,0" />
                            <Grid x:Name="DrvHead" Grid.Row="2" Height="32" Margin="8,2,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dispositivo" Style="{StaticResource TableHead}" />
                                <TextBlock Grid.Column="1" Text="Fabricante" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                                <TextBlock Grid.Column="2" Text="Versão" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                                <TextBlock Grid.Column="3" Text="Data" Style="{StaticResource TableHead}" HorizontalAlignment="Right" />
                            </Grid>
                            <ScrollViewer x:Name="DrvListScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" ScrollChanged="DrvListScroll_ScrollChanged">
                                <StackPanel>
                                    <ItemsControl x:Name="DrvList" Focusable="False">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle ContainerStyle="{StaticResource DrvGroup}">
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Height="40" Margin="8,0">
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource LabelFont}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                                            <TextBlock Text="{Binding ItemCount}" Style="{StaticResource Num}" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Bottom" Margin="8,0,0,9" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="36" Padding="8,0">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="200" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="96" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Device}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device}" VerticalAlignment="Center" />
                                                            <Border x:Name="unsigned" Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoft}"
                                                                    VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="O Windows não encontrou assinatura digital neste driver.">
                                                                <TextBlock Text="Sem assinatura" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{Binding Vendor}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Vendor}" Margin="16,0,0,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource Num}" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Date}" Style="{StaticResource Num}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" ToolTip="{Binding DateTip}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Signed}" Value="False">
                                                        <Setter TargetName="unsigned" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="DrvEmpty" Text="Nenhum driver encontrado." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="8,14,8,0" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
