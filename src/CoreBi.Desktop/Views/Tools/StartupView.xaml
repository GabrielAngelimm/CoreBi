<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.StartupView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Remover da lista: só o glifo, discreto; acende em vermelho sob o mouse porque apaga a entrada -->
        <Style x:Key="RowRemove" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusControl}">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Inicialização: o console ao lado do título diz o que acabou de acontecer (leitura, interruptor, remoção) e o painel é uma
        tabela de linhas de 44 px: interruptor, programa (com o selo só quando o arquivo sumiu), descrição, origem, o comando em
        mono e a lixeira discreta no fim. A contagem e quantos estão desligados ficam ao lado do título da tabela, uma linha
        embaixo dele diz o que é a lista, e restaurar só aparece quando há algo removido. A tabela ocupa a altura que sobra e
        rola por dentro.
    -->
    <ScrollViewer x:Name="StartupScroll" VerticalScrollBarVisibility="Auto">
        <!-- Altura da janela (e não mínima): assim a lista longa rola dentro do painel; abaixo de 520 px a página rola -->
        <Grid Height="{Binding ViewportHeight, ElementName=StartupScroll}" MinHeight="520">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="320" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho padrão (PageHeaderPanel): título, estado vivo embaixo e a barra de ações à direita, na linha do título -->
                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Inicialização" Style="{StaticResource PageTitle}" />
                    <StackPanel Style="{StaticResource PageActions}">
                        <Grid x:Name="StartupMeter" Style="{StaticResource TaskMeter}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Style="{StaticResource ProgressTrack}" VerticalAlignment="Center">
                                <Border x:Name="StartupProgressFill" Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="StartupProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="StartupPercent" Grid.Column="1" Style="{StaticResource TaskPercent}" />
                        </Grid>
                        <Button Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" Height="36" Click="BtnStartupScan_Click"
                                ToolTip="Lê de novo as chaves Run do registro e as pastas Inicializar do usuário e de todos os usuários." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" local:PageHeaderPanel.Subtitle="True">
                        <TextBlock x:Name="StartupSummary" Text="Lendo programas…" Style="{StaticResource PageSubtitle}" Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="StartupResult" Style="{StaticResource PageDetail}" />
                    </StackPanel>
                </local:PageHeaderPanel>

                <!-- Tabela: as larguras das colunas são as mesmas no cabeçalho e nas linhas -->
                <Border x:Name="StartupCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,16,16,8" local:Skeleton.Top="34" local:Skeleton.RowHeight="44">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- O título fica a 20 da borda do painel (16 do padding e 4 aqui), na mesma altura do de Instalar apps -->
                        <Grid Margin="8,4,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <!--
                                    Título, quantos são e quantos estão desligados ("24  21 desligados") num TextBlock só: os Runs de
                                    fontes e tamanhos diferentes ficam na mesma linha de base (antes, em três TextBlocks centrados, a
                                    contagem descia 1 px e o texto 2 px). Os vãos de 10 px são caixas vazias, sem altura.
                                -->
                                <TextBlock Style="{StaticResource SectionTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                    <Run Text="Programas de inicialização" /><InlineUIContainer><Border Width="10" /></InlineUIContainer><Run x:Name="StartupCount"
                                        FontFamily="{StaticResource Readout}" FontStretch="SemiCondensed" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Faint}"
                                        Typography.NumeralAlignment="Tabular" /><InlineUIContainer><Border Width="10" /></InlineUIContainer><Run x:Name="StartupOff"
                                        FontFamily="{StaticResource SmallFont}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource Muted}" />
                                </TextBlock>
                                <TextBlock Text="Programas que abrem junto com o Windows. Desligue os que não usa." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- Como "Abrir benchmark" na Visão geral: o botão de 32 sobe 4 para o centro dele cair no da linha do título (24) -->
                            <Button x:Name="BtnStartupRestore" Grid.Column="1" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE7A7;" Content="Restaurar removidos"
                                    VerticalAlignment="Top" Margin="0,-4,0,0" Visibility="Collapsed" Click="BtnStartupRestore_Click"
                                    ToolTip="Devolve à inicialização os programas removidos por aqui, do jeito que estavam (ligados ou desligados)." />
                        </Grid>

                        <Grid x:Name="StartupHead" Grid.Row="1" Height="32" Margin="8,10,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="3*" MinWidth="160" />
                                <ColumnDefinition Width="4*" MinWidth="140" />
                                <ColumnDefinition Width="232" />
                                <ColumnDefinition Width="5*" MinWidth="160" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Programa" Style="{StaticResource TableHead}" />
                            <TextBlock Grid.Column="2" Text="Descrição" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                            <TextBlock Grid.Column="3" Text="Origem" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                            <TextBlock Grid.Column="4" Text="Comando" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                        </Grid>

                        <ScrollViewer x:Name="StartupListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" ScrollChanged="StartupListScroll_ScrollChanged">
                            <StackPanel>
                                <ItemsControl x:Name="StartupList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}" Height="44" Padding="8,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="3*" MinWidth="160" />
                                                        <ColumnDefinition Width="4*" MinWidth="140" />
                                                        <ColumnDefinition Width="232" />
                                                        <ColumnDefinition Width="5*" MinWidth="160" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- O interruptor desce 1 px (2 em cima): o centro dele cai no meio da altura das maiúsculas do nome -->
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="StartupToggle_Click"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,2,0,0" AutomationProperties.Name="{Binding Name}"
                                                              ToolTip="Abrir com o Windows. Desligado, o programa continua na lista para religar quando quiser." />
                                                    <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                        <Border x:Name="missing" Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoft}"
                                                                VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"
                                                                ToolTip="O programa desta entrada não está mais no disco.">
                                                            <TextBlock Text="Arquivo ausente" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="{Binding Detail}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Source}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="{Binding Source}" />
                                                    <!-- Mono 12 centrado ficava com a base 2 px acima da Segoe 13 das outras colunas: 4 em cima o desce 2 -->
                                                    <TextBlock Grid.Column="4" Text="{Binding Command}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Faint}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,4,0,0" ToolTip="{Binding Command}" />
                                                    <Button Grid.Column="5" Style="{StaticResource RowRemove}" Tag="{Binding}" Click="StartupRemove_Click" HorizontalAlignment="Right"
                                                            AutomationProperties.Name="Remover da inicialização"
                                                            ToolTip="Remover da inicialização. Sai da lista; dá para desfazer em Restaurar removidos." />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding FileMissing}" Value="True">
                                                    <Setter TargetName="missing" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="StartupEmpty" Text="Nenhum programa abre com o Windows." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}"
                                           Margin="8,14,8,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
