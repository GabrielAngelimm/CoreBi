<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.StartupView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Ação de linha: só o glifo, discreto, num círculo de 32 que acende sob o mouse; a lixeira acende em vermelho porque apaga a entrada -->
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="16">
                            <TextBlock Text="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource IconGlyph}" FontSize="14"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="danger" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmento com a quantidade depois do nome (a mesma voz dos números da página, um tom abaixo); a largura nasce em seminegrito -->
        <Style x:Key="CountSegment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="12,5,12,3" MinHeight="26">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" Visibility="Hidden" HorizontalAlignment="Center" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="count" Text="{Binding Path=(local:Ui.Suffix), RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Readout}"
                                           FontStretch="SemiCondensed" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource Faint}" Typography.NumeralAlignment="Tabular"
                                           MinWidth="16" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="count" Property="Foreground" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="local:Ui.SlidingGroup" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ícone do programa: 24 px sobre a vaga de 24; sem ícone, o glifo neutro de app no lugar -->
        <DataTemplate x:Key="ProgramIcon">
            <Grid Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock x:Name="glyph" Text="&#xE71D;" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource Faint}" Visibility="Collapsed" />
                <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Legenda das partes do início: traço na cor da parte, o nome e o tempo à direita, numa linha de 30 -->
        <Style x:Key="BootPart" TargetType="Grid">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="BootPartName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="BootPartValue" TargetType="TextBlock" BasedOn="{StaticResource ReadoutText}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <!--
        Inicialização: à esquerda, a tabela dos programas que abrem com o Windows (interruptor, ícone, nome, fabricante, comando e as
        ações da linha), com o filtro Todos / Ligados / Desligados no cabeçalho. À direita, numa coluna de 440, o tempo do último início
        medido pelo próprio Windows (BIOS, Windows e programas) com os inícios anteriores em barras, e os programas removidos por aqui,
        cada um com "Devolver". Tudo cabe numa tela; a tabela e os removidos rolam por dentro.
    -->
    <ScrollViewer x:Name="StartupScroll" VerticalScrollBarVisibility="Auto">
        <!-- Altura da janela (e não mínima): assim a lista longa rola dentro do painel; abaixo de 720 px a página rola -->
        <Grid Height="{Binding ViewportHeight, ElementName=StartupScroll}" MinHeight="720">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:PageHeaderPanel Style="{StaticResource PageHead}">
                    <TextBlock Text="Inicialização" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Escolha o que abre com o Windows e veja quanto o início demora." Style="{StaticResource PageSubtitle}" local:PageHeaderPanel.Subtitle="True" />
                    <StackPanel Style="{StaticResource PageActions}">
                        <Grid x:Name="StartupMeter" Style="{StaticResource TaskMeter}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Style="{StaticResource ProgressTrack}" VerticalAlignment="Center">
                                <Border x:Name="StartupProgressFill" Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="StartupProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="StartupPercent" Grid.Column="1" Style="{StaticResource TaskPercent}" />
                        </Grid>
                        <DockPanel Style="{StaticResource PageStatusSlot}">
                            <TextBlock x:Name="StartupResult" Style="{StaticResource PageDetail}" DockPanel.Dock="Right" />
                            <TextBlock x:Name="StartupSummary" Text="Lendo programas…" Style="{StaticResource PageStatus}" Typography.NumeralAlignment="Tabular" TextAlignment="Right" />
                        </DockPanel>
                        <Button Style="{StaticResource HeaderSecondary}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" Click="BtnStartupScan_Click"
                                ToolTip="Lê de novo as chaves Run do registro, as pastas Inicializar, os apps da Microsoft Store e o tempo dos últimos inícios." />
                    </StackPanel>
                </local:PageHeaderPanel>

                <Grid x:Name="StartupBody" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="440" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Programas: a tabela tem 16 de respiro e as linhas mais 8 por dentro, então a primeira letra e o interruptor ficam a 24
                        da borda, como nos outros cartões. O cabeçalho de colunas tem a geometria das linhas.
                    -->
                    <Border x:Name="StartupCard" Style="{StaticResource CardBorder}" Padding="16,16,16,8" local:Skeleton.Top="34"
                            local:Skeleton.Layout="gap 10; row 32: - 8, - 56, - 36, c 3*@0.24, - 16, c 2*@0.3, - 16, c 4*@0.2, - 80, - 8; lines 48: - 8, pill 40@1^20, - 16, dot 24, - 12, s 3*, - 16, t 2*, - 16, c 4*, c 80@0.4^14&gt;, - 8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource CardHeader}" Margin="8,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Programas de inicialização" Style="{StaticResource CardTitle}"
                                           ToolTip="Programas que abrem sozinhos quando você entra no Windows. Desligar deixa o início mais leve e não desinstala nada." />
                                <!-- Filtro que não tira nada do lugar enquanto se mexe: a linha que muda de estado só sai do filtro na próxima escolha -->
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                    <local:SlidingSelectionPanel Style="{StaticResource SegmentRail}" ToggleButton.Checked="StartupFilter_Checked">
                                        <RadioButton x:Name="FilterAll" Style="{StaticResource CountSegment}" GroupName="StartupFilter" Content="Todos" Tag="all" IsChecked="True"
                                                     ToolTip="Todos os programas da inicialização." />
                                        <RadioButton x:Name="FilterOn" Style="{StaticResource CountSegment}" GroupName="StartupFilter" Content="Ligados" Tag="on"
                                                     ToolTip="Só os que abrem com o Windows." />
                                        <RadioButton x:Name="FilterOff" Style="{StaticResource CountSegment}" GroupName="StartupFilter" Content="Desligados" Tag="off"
                                                     ToolTip="Só os que estão na lista mas não abrem." />
                                    </local:SlidingSelectionPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="StartupHead" Grid.Row="1" Height="32" Margin="8,10,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="3*" MinWidth="150" />
                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                    <ColumnDefinition Width="4*" MinWidth="140" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="Programa" Style="{StaticResource TableHead}" />
                                <TextBlock Grid.Column="3" Text="Fabricante" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                                <TextBlock Grid.Column="4" Text="Comando" Style="{StaticResource TableHead}" Margin="16,0,0,0"
                                           ToolTip="O que o Windows executa. Passe o mouse num comando para ver inteiro e de onde ele vem." />
                            </Grid>

                            <ScrollViewer x:Name="StartupListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" ScrollChanged="StartupListScroll_ScrollChanged">
                                <StackPanel>
                                    <ItemsControl x:Name="StartupList" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="48" Padding="8,0">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="3*" MinWidth="150" />
                                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                                            <ColumnDefinition Width="4*" MinWidth="140" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- O interruptor desce 1 px (2 em cima): o centro dele cai no meio da altura das maiúsculas do nome -->
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Entry.Enabled, Mode=OneWay}" Tag="{Binding Entry}" Click="StartupToggle_Click"
                                                                  local:Ui.SwitchMotion="True" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                  AutomationProperties.Name="{Binding Entry.Title}"
                                                                  ToolTip="Abrir com o Windows. Desligado, o programa continua na lista para religar quando quiser." />
                                                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}" />
                                                        <Grid Grid.Column="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding NameTip}" />
                                                            <Border x:Name="missing" Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoft}"
                                                                    VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"
                                                                    ToolTip="O programa desta entrada não está mais no disco. Dá para remover da lista sem medo.">
                                                                <TextBlock Text="Arquivo ausente" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="3" Text="{Binding Entry.Publisher}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   Margin="16,0,0,0" ToolTip="{Binding Entry.Publisher}" />
                                                        <!-- Mono 12 centrado ficava com a base 2 px acima da Segoe 14 das outras colunas: 4 em cima o desce 2 -->
                                                        <TextBlock x:Name="command" Grid.Column="4" Text="{Binding Entry.Command}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Faint}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,4,0,0" ToolTip="{Binding CommandTip}" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button x:Name="open" Style="{StaticResource RowAction}" local:Ui.Icon="&#xE838;" Tag="{Binding Entry}" Click="StartupOpen_Click" Margin="0,0,4,0"
                                                                    AutomationProperties.Name="Abrir local do arquivo" ToolTip="Abrir a pasta do programa no Explorador de Arquivos." />
                                                            <Button x:Name="remove" Style="{StaticResource RowAction}" local:Ui.Icon="&#xE74D;" Tag="danger" DataContext="{Binding Entry}" Click="StartupRemove_Click"
                                                                    AutomationProperties.Name="Remover da inicialização"
                                                                    ToolTip="Tirar da inicialização. O programa continua instalado e vai para Removidos, de onde dá para devolver." />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Entry.FileMissing}" Value="True">
                                                        <Setter TargetName="missing" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Entry.Location}" Value="{x:Null}">
                                                        <Setter TargetName="open" Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <!-- App da Store: a tarefa é do pacote; dá para desligar, não remover. O comando vira a origem, em texto comum -->
                                                    <DataTrigger Binding="{Binding Entry.Store}" Value="True">
                                                        <Setter TargetName="remove" Property="Visibility" Value="Hidden" />
                                                        <Setter TargetName="open" Property="Visibility" Value="Hidden" />
                                                        <Setter TargetName="command" Property="Text" Value="App da Microsoft Store" />
                                                        <Setter TargetName="command" Property="FontFamily" Value="{StaticResource UiFont}" />
                                                        <Setter TargetName="command" Property="FontSize" Value="14" />
                                                        <Setter TargetName="command" Property="Margin" Value="16,0,0,0" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="StartupEmpty" Text="Nenhum programa abre com o Windows." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}"
                                               Margin="8,14,8,0" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                            Tempo de início: o total em mostrador (BIOS + Windows + programas), a barra das três partes na proporção e a
                            legenda com o tempo de cada uma; embaixo, os últimos dez inícios em barras (Windows e programas empilhados), da
                            esquerda para a direita, o mais novo aceso. O cartão tem altura fixa: sem registro, a mesma área diz por quê.
                        -->
                        <Border x:Name="BootCard" Style="{StaticResource CardBorder}" local:Skeleton.Top="34"
                                local:Skeleton.Layout="gap 14; row 56: n 96, - *; row 18: c 62%; gap 16; row 12: box *@1^12; gap 14; rows 3 30: - 2, dot 10, - 12, t 52%, - *, n 44&gt;; gap 20; row 18: c 40%; gap 10; row 96: box *; gap 8; row 16: c *@0.9">
                            <StackPanel>
                                <Grid Style="{StaticResource CardHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tempo de início" Style="{StaticResource CardTitle}"
                                               ToolTip="Medido pelo próprio Windows toda vez que o PC liga: do botão de ligar até o computador ficar pronto para usar." />
                                    <TextBlock x:Name="BootWhen" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,1,0,0" />
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <StackPanel x:Name="BootShown">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="BootTotal" Text="—" Style="{StaticResource ReadoutHero}" />
                                            <TextBlock x:Name="BootUnit" Text="s" Style="{StaticResource Unit}" FontSize="20" Margin="6,0,0,11" />
                                        </StackPanel>
                                        <TextBlock x:Name="BootSub" Text="do botão de ligar até o PC ficar pronto" Style="{StaticResource Caption}" Margin="0,0,0,0" />

                                        <!-- As três partes na proporção, numa trilha de 12 px com cantos redondos -->
                                        <Border Height="12" CornerRadius="6" Background="{DynamicResource Raised}" Margin="0,16,0,0" ClipToBounds="True">
                                            <Grid x:Name="BootBar">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="BootBarBios" Width="0*" />
                                                    <ColumnDefinition x:Name="BootBarMain" Width="0*" />
                                                    <ColumnDefinition x:Name="BootBarPost" Width="0*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource Board}" CornerRadius="6,0,0,6" />
                                                <Border Grid.Column="1" Background="{DynamicResource Signal}" Margin="2,0,0,0" />
                                                <Border Grid.Column="2" Background="{DynamicResource Steel}" CornerRadius="0,6,6,0" Margin="2,0,0,0" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Margin="0,12,0,0">
                                            <Grid x:Name="BootBiosRow" Style="{StaticResource BootPart}"
                                                  ToolTip="O tempo da placa-mãe antes do Windows: teste da memória, logo do fabricante e escolha do disco. Não depende do Windows nem dos programas.">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource Board}" />
                                                <TextBlock Grid.Column="1" Text="Placa-mãe (BIOS)" Style="{StaticResource BootPartName}" />
                                                <TextBlock x:Name="BootBios" Grid.Column="2" Text="—" Style="{StaticResource BootPartValue}" />
                                            </Grid>
                                            <Grid Style="{StaticResource BootPart}"
                                                  ToolTip="Do carregamento do Windows até a área de trabalho aparecer: drivers, serviços e a entrada na sua conta.">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource Signal}" />
                                                <TextBlock Grid.Column="1" Text="Windows" Style="{StaticResource BootPartName}" />
                                                <TextBlock x:Name="BootMain" Grid.Column="2" Text="—" Style="{StaticResource BootPartValue}" />
                                            </Grid>
                                            <Grid Style="{StaticResource BootPart}"
                                                  ToolTip="Da área de trabalho até o PC ficar ocioso. É aqui que os programas de inicialização pesam: cada um desligado encurta esta parte.">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource ChannelMark}" Background="{DynamicResource Steel}" />
                                                <TextBlock Grid.Column="1" Text="Programas e área de trabalho" Style="{StaticResource BootPartName}" />
                                                <TextBlock x:Name="BootPost" Grid.Column="2" Text="—" Style="{StaticResource BootPartValue}" />
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Text="Últimos inícios" Style="{StaticResource StatLabel}" Margin="0,20,0,0"
                                                   ToolTip="Cada barra é um início do Windows (sem a BIOS, que o Windows só guarda do último). O tom claro em cima é a parte dos programas." />
                                        <ItemsControl x:Name="BootBars" Height="96" Margin="0,10,0,0" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Background="Transparent" ToolTip="{Binding Tip}">
                                                        <Border Width="18" CornerRadius="5" Background="{DynamicResource Raised}" />
                                                        <StackPanel Width="18" VerticalAlignment="Bottom">
                                                            <Border x:Name="post" Height="{Binding PostHeight}" Background="{DynamicResource Steel}" CornerRadius="5,5,0,0" Opacity="0.75" />
                                                            <Border x:Name="main" Height="{Binding MainHeight}" Background="{DynamicResource Signal}" CornerRadius="0,0,5,5" Opacity="0.75" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Last}" Value="True">
                                                            <Setter TargetName="post" Property="Opacity" Value="1" />
                                                            <Setter TargetName="main" Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl x:Name="BootDays" Margin="0,8,0,0" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="day" Text="{Binding Day}" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"
                                                               Typography.NumeralAlignment="Tabular" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Last}" Value="True">
                                                            <Setter TargetName="day" Property="Foreground" Value="{DynamicResource Fg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- Sem registro: a mesma área (o painel não muda de altura) diz por quê, no meio -->
                                    <TextBlock x:Name="BootMissing" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" TextAlignment="Center" MaxWidth="320"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Removidos: o que saiu da inicialização por aqui, o mais recente em cima, cada um com "Devolver" -->
                        <Border x:Name="RemovedCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="24,16,24,16" local:Skeleton.Top="34"
                                local:Skeleton.Layout="gap 10; lines 3 48: dot 24, - 12, s 46%, - *, btn 96&gt;">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Style="{StaticResource CardHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Removidos" Style="{StaticResource CardTitle}"
                                               ToolTip="Programas tirados da inicialização pela lixeira. O CoreBi guarda como estavam (ligados ou desligados) para devolver quando quiser." />
                                    <Button x:Name="BtnStartupRestore" Grid.Column="1" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE7A7;" Content="Devolver todos"
                                            VerticalAlignment="Center" Margin="0,0,-10,0" Visibility="Collapsed" Click="BtnStartupRestore_Click"
                                            ToolTip="Devolve todos à inicialização, do jeito que estavam." />
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <ItemsControl x:Name="RemovedList" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="48">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}" />
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}">
                                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding When, Mode=OneWay}" FontSize="12"
                                                                Foreground="{DynamicResource Faint}" />
                                                        </TextBlock>
                                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE7A7;" Content="Devolver" Tag="{Binding Backup}"
                                                                Click="StartupRestoreOne_Click" Margin="12,0,-10,0" ToolTip="Volta para a inicialização do jeito que estava." />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="RemovedEmpty" Grid.Row="1" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" TextAlignment="Center" MaxWidth="330"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8"
                                           Text="Nada removido. A lixeira de um programa tira ele da inicialização e guarda aqui, para devolver quando quiser." />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
