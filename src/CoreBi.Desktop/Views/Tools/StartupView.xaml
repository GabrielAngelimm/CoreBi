<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.StartupView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Inicialização" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Programas que abrem junto com o Windows. Desligue ou remova o que você não usa." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnStartupRestore" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE7A7;" Content="Restaurar removidos" Margin="0,0,8,0" Click="BtnStartupRestore_Click" />
                    <Button Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" Click="BtnStartupScan_Click" />
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource CardBorder}" Padding="24,20,24,12">
                <StackPanel>
                    <TextBlock x:Name="StartupSummary" Text="Programas de inicialização" Style="{StaticResource SectionTitle}" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" Text="O interruptor liga e desliga na hora, do mesmo jeito que o Gerenciador de Tarefas: a entrada continua lá e pode ser religada. Remover apaga a entrada (o programa continua instalado) e dá para desfazer em Restaurar removidos. Vale na próxima vez que o Windows iniciar." />
                    <ItemsControl x:Name="StartupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="StartupToggle_Click" VerticalAlignment="Top" Margin="0,1,16,0" ToolTip="Ligar ou desligar na inicialização" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                                <Border x:Name="badge" Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="badgeText" Text="{Binding State, Converter={StaticResource Sentence}}" Style="{StaticResource BadgeText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Command}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Footnote}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource DangerGhostButton}" local:Ui.Icon="&#xE74D;" Content="Remover" Tag="{Binding}" Click="StartupRemove_Click" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                        <Setter TargetName="badge" Property="Background" Value="{DynamicResource SignalSoft}" />
                                        <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Signal}" />
                                        <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Signal}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FileMissing}" Value="True">
                                        <Setter TargetName="badge" Property="Background" Value="{DynamicResource WarnSoft}" />
                                        <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Warn}" />
                                        <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Warn}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="StartupResult" Style="{StaticResource Body}" Margin="0,8,0,4" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
