<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.StartupView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!-- Remover da lista: só o glifo, discreto; acende em vermelho sob o mouse porque apaga a entrada -->
        <Style x:Key="RowRemove" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusControl}">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Inicialização: o console ao lado do título diz o que acabou de acontecer (leitura, interruptor, remoção) e o painel é uma
        tabela de linhas de 44 px: interruptor, programa, descrição, origem e o comando em mono, com o selo só quando o arquivo
        sumiu e a lixeira discreta no fim. A tabela ocupa a altura que sobra e rola por dentro; restaurar fica no título dela.
    -->
    <ScrollViewer x:Name="StartupScroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=StartupScroll}">
            <Grid Style="{StaticResource PageGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="320" />
                </Grid.RowDefinitions>

                <Grid x:Name="StartupHeader" Style="{StaticResource PageHeader}" SizeChanged="StartupHeader_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Inicialização" Style="{StaticResource PageTitle}" VerticalAlignment="Top" />

                    <Border x:Name="StartupConsole" Grid.Column="1" Style="{StaticResource TaskConsole}" Margin="40,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE72C;" Content="Ler novamente" MinWidth="172" Height="46" FontSize="14"
                                    VerticalAlignment="Center" Click="BtnStartupScan_Click"
                                    ToolTip="Lê de novo as chaves Run do registro e as pastas Inicializar do usuário e de todos os usuários." />
                            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StartupSummary" Text="Lendo programas…" Style="{StaticResource TaskStatus}" />
                                    <TextBlock x:Name="StartupResult" Grid.Column="1" Style="{StaticResource TaskDetail}" />
                                </Grid>
                                <Grid Style="{StaticResource ProgressTrack}">
                                    <Border x:Name="StartupProgressFill" Style="{StaticResource ProgressFill}">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="StartupProgress" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tabela: as larguras das colunas são as mesmas no cabeçalho e nas linhas -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,16,16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="8,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Programas de inicialização" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StartupCount" Style="{StaticResource TitleCount}" />
                            </StackPanel>
                            <Button x:Name="BtnStartupRestore" Grid.Column="1" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE7A7;" Content="Restaurar removidos"
                                    IsEnabled="False" Click="BtnStartupRestore_Click"
                                    ToolTip="Devolve à inicialização os programas removidos por aqui, do jeito que estavam (ligados ou desligados)." />
                        </Grid>

                        <Grid x:Name="StartupHead" Grid.Row="1" Height="32" Margin="8,10,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="2*" MinWidth="160" />
                                <ColumnDefinition Width="2*" MinWidth="140" />
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="3*" MinWidth="160" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Programa" Style="{StaticResource TableHead}" />
                            <TextBlock Grid.Column="2" Text="Descrição" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                            <TextBlock Grid.Column="3" Text="Origem" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                            <TextBlock Grid.Column="4" Text="Comando" Style="{StaticResource TableHead}" Margin="16,0,0,0" />
                        </Grid>

                        <ScrollViewer x:Name="StartupListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" ScrollChanged="StartupListScroll_ScrollChanged">
                            <StackPanel>
                                <ItemsControl x:Name="StartupList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}" Height="44" Padding="8,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="2*" MinWidth="160" />
                                                        <ColumnDefinition Width="2*" MinWidth="140" />
                                                        <ColumnDefinition Width="250" />
                                                        <ColumnDefinition Width="3*" MinWidth="160" />
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="StartupToggle_Click"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="Abrir com o Windows" AutomationProperties.Name="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="{Binding Detail}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Source}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Command}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Faint}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="{Binding Command}" />
                                                    <Border x:Name="missing" Grid.Column="5" Style="{StaticResource Badge}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnSoft}"
                                                            VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"
                                                            ToolTip="O programa desta entrada não está mais no disco.">
                                                        <TextBlock Text="Arquivo ausente" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}" />
                                                    </Border>
                                                    <Button Grid.Column="6" Style="{StaticResource RowRemove}" Tag="{Binding}" Click="StartupRemove_Click" HorizontalAlignment="Right"
                                                            ToolTip="Remover da inicialização" AutomationProperties.Name="Remover da inicialização" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding FileMissing}" Value="True">
                                                    <Setter TargetName="missing" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="StartupEmpty" Text="Nenhum programa abre com o Windows." Style="{StaticResource Body}" Foreground="{DynamicResource Muted}"
                                           Margin="8,14,8,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
