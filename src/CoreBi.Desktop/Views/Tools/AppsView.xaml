<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.AppsView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Page}">
            <Grid Style="{StaticResource PageHeader}" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Instalar apps" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Os essenciais depois de formatar o PC, na versão oficial mais recente e com instalação silenciosa." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button x:Name="BtnAppsInstall" Grid.Column="1" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE896;" Content="Instalar selecionados" VerticalAlignment="Top" Click="BtnAppsInstall_Click" />
            </Grid>
            <Border Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="AppsStatus" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" Text="Marque os apps e clique em Instalar selecionados." />
                    <Grid Style="{StaticResource ProgressTrack}">
                        <Border Style="{StaticResource ProgressFill}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="AppsProgress" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Aplicativos" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Text="Usa o winget, o instalador de pacotes da Microsoft que já vem no Windows 10 e 11: baixa do site oficial de cada fabricante e confere o arquivo antes de instalar, um app de cada vez e sem janelas." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource GhostButton}" Content="Marcar todos" Click="BtnAppsAll_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="Desmarcar" Click="BtnAppsNone_Click" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="AppsList" Margin="0,16,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="tile" Style="{StaticResource InsetBorder}" Padding="14,12" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Signal}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Status, Converter={StaticResource NotEmptyVis}}" />
                                        </StackPanel>
                                        <Border x:Name="badge" Grid.Column="2" Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="Collapsed" Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                <TextBlock Text="Instalado" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Ok}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                        <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource Muted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnAppsStore" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE719;" Content="Atualizar o Instalador de Aplicativo (Microsoft Store)" Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnAppsStore_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
