<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CoreBi.Desktop.Views.AppsView" xmlns:local="clr-namespace:CoreBi.Desktop">
    <UserControl.Resources>
        <!--
            Cartão de app: o cartão inteiro marca e desmarca. Nome em DIN e descrição em até duas linhas; o canto de cima à direita
            é sempre o do estado: o marcador redondo enquanto dá para escolher e, no lugar dele, o estado de verdade em texto
            curto ("Na fila", "Instalando…", "Instalado", "Falhou"). Marcado leva o sinal (borda e realce); já instalado perde o
            marcador e não reage ao mouse, para não parecer uma opção. Desmarcado e instalado têm o fundo do painel: só o
            marcado ganha realce.
        -->
        <Style x:Key="AppCard" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInset}" Padding="16,13,14,14" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Nome numa linha só: "7-Zip" não quebra no hífen -->
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource LabelFont}" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Height="20" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Border x:Name="dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" HorizontalAlignment="Right"
                                            BorderBrush="{DynamicResource LineStrong}" VerticalAlignment="Center">
                                        <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   Foreground="{DynamicResource SignalFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Border>
                                    <!-- Estado real do app (o DataContext é o item da lista), no lugar do marcador -->
                                    <TextBlock x:Name="state" Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path=(local:Ui.Caption), RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource Caption}" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Signal}" />
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SignalSoft}" />
                                <Setter TargetName="dot" Property="Background" Value="{DynamicResource Signal}" />
                                <Setter TargetName="dot" Property="BorderBrush" Value="{DynamicResource Signal}" />
                                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- Com estado a mostrar, o texto ocupa o canto do marcador -->
                            <DataTrigger Binding="{Binding StateText, Converter={StaticResource NotEmptyVis}}" Value="Visible">
                                <Setter TargetName="dot" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="state" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Signal">
                                <Setter TargetName="state" Property="Foreground" Value="{DynamicResource Signal}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Danger">
                                <Setter TargetName="state" Property="Foreground" Value="{DynamicResource Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Faint">
                                <Setter TargetName="state" Property="Foreground" Value="{DynamicResource Faint}" />
                            </DataTrigger>
                            <!-- Já instalado: nada a marcar; sem marcador, o cartão continua legível e o canto diz "Instalado" -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Instalar apps: o console ao lado do título instala os marcados (a contagem vai no próprio botão) e mostra o app da vez e
        a barra, que só aparece durante a instalação e avança um app por vez. O catálogo é uma grade de cartões da altura do
        conteúdo, com as colunas escolhidas para fechar a grade quando a largura deixa (7 apps: uma linha de 7 ou 4 e 3).
    -->
    <ScrollViewer x:Name="AppsScroll" VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PageGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppsHeader" Style="{StaticResource PageHeader}" SizeChanged="AppsHeader_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Cabeçalho de altura fixa: título no topo como nas outras páginas; o console (62 px) fica rente ao topo, na faixa de título e subtítulo -->
                <TextBlock Text="Instalar apps" Style="{StaticResource PageTitle}" VerticalAlignment="Top" />

                <Border x:Name="AppsConsole" Grid.Column="1" Style="{StaticResource TaskConsole}" Margin="40,0,0,0" Height="62" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnAppsInstall" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE896;" Content="Instalar apps" MinWidth="164" Height="36"
                                VerticalAlignment="Center" IsEnabled="False" Click="BtnAppsInstall_Click" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Instala pelo winget, um app de cada vez e sem janelas: cada instalador vem do site oficial do fabricante e é conferido antes de abrir." />
                        <!-- O estado fica no meio da altura do console; o trilho, que só aparece durante a tarefa, corre rente ao pé -->
                        <Grid Grid.Column="1" Margin="22,0,0,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppsStatus" Text="Lendo aplicativos instalados…" Style="{StaticResource TaskStatus}" />
                                <TextBlock x:Name="AppsDetail" Grid.Column="1" Style="{StaticResource TaskDetail}" />
                            </Grid>
                            <Grid Style="{StaticResource ProgressTrack}" Visibility="Hidden" VerticalAlignment="Bottom">
                                <Border x:Name="AppsProgressFill" Style="{StaticResource ProgressFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="AppsProgress" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                        <!-- Sem o winget não há como instalar: o atalho para atualizá-lo fica no próprio console -->
                        <Button x:Name="BtnAppsStore" Grid.Column="2" Style="{StaticResource SecondaryButton}" local:Ui.Icon="&#xE719;" Content="Abrir na Microsoft Store"
                                Margin="22,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="BtnAppsStore_Click"
                                ToolTip="Abre o Instalador de Aplicativo, que traz o winget." />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="24,20,12,8">
                <StackPanel>
                    <Grid Margin="0,0,12,16" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Aplicativos" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AppsCount" Style="{StaticResource TitleCount}" />
                        </StackPanel>
                        <!--
                            Um link só (o mesmo de "Abrir benchmark" da Visão geral: glifo no sinal), que diz o que vai fazer: marca os
                            que faltam ou, com todos marcados, desmarca. A margem negativa alinha o texto com a borda dos cartões.
                        -->
                        <Button x:Name="BtnAppsToggleAll" Grid.Column="1" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE8B3;" Content="Marcar todos"
                                VerticalAlignment="Center" Margin="0,0,-10,0"
                                Click="BtnAppsToggleAll_Click" ToolTip="Marca os que ainda não estão instalados." />
                    </Grid>
                    <ItemsControl x:Name="AppsList" Focusable="False" SizeChanged="AppsList_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding AppColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource AppCard}" Content="{Binding App.Name}" local:Ui.Caption="{Binding App.Description}"
                                          IsChecked="{Binding App.Selected}" IsEnabled="{Binding App.CanSelect}" ToolTip="{Binding Tip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
