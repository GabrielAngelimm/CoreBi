root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,slnx,manifest,iss,xml}]
indent_size = 2

# Windows PowerShell 5.1 e o Inno Setup leem arquivo sem BOM como ANSI e estragam os acentos.
[*.{ps1,iss}]
charset = utf-8-bom
